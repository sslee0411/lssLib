<!-- ══════════════════════════════════════════════════════════
     IIoT.UI.Themes.Demo · MainWindow.xaml
     역할: 8가지 테마 + 전체 컴포넌트 라이브 데모
     수정: 2025-05-17 v1.5
       · 헤더 ◀▶ 버튼 → ThemePickerButton 단일 교체
       · Tab7 "피커 버튼" 추가
     FIX: 2025-05-17
       · 혼합 콘텐츠 TextBlock 오류 수정 (원시 텍스트 + Run + LineBreak 혼용)
         → 모든 코드 스니펫을 StackPanel + 개별 TextBlock 으로 교체
         WPF BAML 컴파일러는 Run/LineBreak 와 원시 텍스트 노드 혼용 시
         MC3501 / XLS0403 오류 발생 가능
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.UI.Themes.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        Title="IIoT.UI.Themes — 테마 데모"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ 상단 헤더 바 ══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="16,8">

                <!-- 로고 (좌측) -->
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="36" Height="36"
                            Background="{DynamicResource AccFaintBrush}"
                            BorderBrush="{DynamicResource AccBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Margin="0,0,10,0">
                        <TextBlock x:Name="LogoIcon"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="IIoT.UI.Themes"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccBrush}"/>
                        <TextBlock Text="테마 컴포넌트 데모 v1.5"
                                   FontSize="10"
                                   Foreground="{DynamicResource Text3Brush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ★ v1.5: ThemePickerButton (우측) — 기존 ◀▶ 버튼 대체 -->
                <uc:ThemePickerButton DockPanel.Dock="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0"/>

                <!-- 탭 네비게이션 (가운데) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="Tab1Btn" Content="🎨  테마 선택"
                            Style="{DynamicResource ToolbarBtn}"
                            Click="OnTabClick" Tag="1" Margin="2,0"/>
                    <Button x:Name="Tab2Btn" Content="🔘  버튼 &amp; 입력"
                            Style="{DynamicResource ToolbarBtn}"
                            Click="OnTabClick" Tag="2" Margin="2,0"/>
                    <Button x:Name="Tab3Btn" Content="🃏  카드 &amp; 배지"
                            Style="{DynamicResource ToolbarBtn}"
                            Click="OnTabClick" Tag="3" Margin="2,0"/>
                    <Button x:Name="Tab4Btn" Content="🌲  트리 &amp; 목록"
                            Style="{DynamicResource ToolbarBtn}"
                            Click="OnTabClick" Tag="4" Margin="2,0"/>
                    <Button x:Name="Tab5Btn" Content="⚙  속성 패널"
                            Style="{DynamicResource ToolbarBtn}"
                            Click="OnTabClick" Tag="5" Margin="2,0"/>
                    <Button x:Name="Tab6Btn" Content="📋  데이터 그리드"
                            Style="{DynamicResource ToolbarBtn}"
                            Click="OnTabClick" Tag="6" Margin="2,0"/>
                    <Button x:Name="Tab7Btn" Content="🎛  피커 버튼"
                            Style="{DynamicResource ToolbarBtn}"
                            Click="OnTabClick" Tag="7" Margin="2,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ 메인 콘텐츠 ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ① 테마 선택 탭 -->
            <ScrollViewer x:Name="Tab1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock Text="테마 선택"
                               Style="{DynamicResource CardTitle}"
                               FontSize="16" Margin="0,0,0,4"/>
                    <TextBlock Text="카드를 클릭하면 즉시 전환됩니다. 헤더의 ThemePickerButton 또는 Ctrl+T / Ctrl+Shift+T 로도 순환 가능합니다."
                               Foreground="{DynamicResource Text2Brush}"
                               FontSize="12" Margin="0,0,0,20"/>
                    <Border Style="{DynamicResource Card}" Padding="0">
                        <uc:ThemeSelectorPanel/>
                    </Border>
                    <TextBlock Text="현재 테마 색상 팔레트"
                               Style="{DynamicResource CardTitle}"
                               FontSize="14" Margin="0,28,0,12"/>
                    <Border Style="{DynamicResource Card}">
                        <UniformGrid Columns="7" Rows="2">
                            <Border Height="60" CornerRadius="4" Margin="3" Background="{DynamicResource BgBrush}"      ToolTip="BgBrush">
                                <TextBlock Text="Bg"      FontSize="9" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </Border>
                            <Border Height="60" CornerRadius="4" Margin="3" Background="{DynamicResource SurfaceBrush}" ToolTip="SurfaceBrush">
                                <TextBlock Text="Surface" FontSize="9" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </Border>
                            <Border Height="60" CornerRadius="4" Margin="3" Background="{DynamicResource CardBrush}"    ToolTip="CardBrush">
                                <TextBlock Text="Card"    FontSize="9" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </Border>
                            <Border Height="60" CornerRadius="4" Margin="3" Background="{DynamicResource AccBrush}"     ToolTip="AccBrush">
                                <TextBlock Text="Accent"  FontSize="9" Foreground="White"                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </Border>
                            <Border Height="60" CornerRadius="4" Margin="3" Background="{DynamicResource GreenBrush}"   ToolTip="GreenBrush">
                                <TextBlock Text="Green"   FontSize="9" Foreground="White"                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </Border>
                            <Border Height="60" CornerRadius="4" Margin="3" Background="{DynamicResource YellowBrush}"  ToolTip="YellowBrush">
                                <TextBlock Text="Yellow"  FontSize="9" Foreground="#333"                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </Border>
                            <Border Height="60" CornerRadius="4" Margin="3" Background="{DynamicResource RedBrush}"     ToolTip="RedBrush">
                                <TextBlock Text="Red"     FontSize="9" Foreground="White"                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </Border>
                            <Border Height="40" CornerRadius="4" Margin="3" Background="{DynamicResource Border2Brush}"    ToolTip="Border2Brush">
                                <TextBlock Text="Border2"    FontSize="9" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Height="40" CornerRadius="4" Margin="3" Background="{DynamicResource BorderBrush}"     ToolTip="BorderBrush">
                                <TextBlock Text="Border"     FontSize="9" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Height="40" CornerRadius="4" Margin="3" Background="{DynamicResource CardBrush}"       ToolTip="TextBrush">
                                <TextBlock Text="Text 주"    FontSize="9" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Height="40" CornerRadius="4" Margin="3" Background="{DynamicResource CardBrush}"       ToolTip="Acc2Brush">
                                <TextBlock Text="Acc2"       FontSize="9" Foreground="{DynamicResource Acc2Brush}"  FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Height="40" CornerRadius="4" Margin="3" Background="{DynamicResource GreenFaintBrush}" ToolTip="GreenFaint">
                                <TextBlock Text="GreenFaint" FontSize="9" Foreground="{DynamicResource GreenBrush}"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Height="40" CornerRadius="4" Margin="3" Background="{DynamicResource YellowFaintBrush}" ToolTip="YellowFaint">
                                <TextBlock Text="YellowFaint" FontSize="9" Foreground="{DynamicResource YellowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Height="40" CornerRadius="4" Margin="3" Background="{DynamicResource RedFaintBrush}"   ToolTip="RedFaint">
                                <TextBlock Text="RedFaint"   FontSize="9" Foreground="{DynamicResource RedBrush}"    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ② 버튼 & 입력 탭 -->
            <ScrollViewer x:Name="Tab2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="버튼 스타일 (Buttons)" Style="{DynamicResource CardTitle}"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="💾  저장 (PrimaryBtn)" Style="{DynamicResource PrimaryBtn}" Margin="0,0,8,8"/>
                                <Button Content="✅  확인 (SuccessBtn)" Style="{DynamicResource SuccessBtn}" Margin="0,0,8,8"/>
                                <Button Content="🗑  삭제 (DangerBtn)"  Style="{DynamicResource DangerBtn}"  Margin="0,0,8,8"/>
                                <Button Content="⚙  설정 (ToolbarBtn)" Style="{DynamicResource ToolbarBtn}" Margin="0,0,8,8"/>
                                <Button Content="+ 그룹" Style="{DynamicResource TreeBtn}" Margin="0,0,8,8"/>
                                <Button Content="비활성화됨" Style="{DynamicResource ToolbarBtn}" IsEnabled="False" Margin="0,0,8,8"/>
                            </WrapPanel>
                            <Button Content="✓  변경사항 적용 (ApplyBtn)" Style="{DynamicResource ApplyBtn}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Text="TextBox 스타일" Style="{DynamicResource CardTitle}"/>
                                <TextBlock Text="Tag 이름" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="온도 (Temperature)" Style="{DynamicResource PropInput}" Margin="0,0,0,10"/>
                                <TextBlock Text="Modbus 주소 (MonoPropInput)" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="D100" Style="{DynamicResource MonoPropInput}" Margin="0,0,0,10"/>
                                <TextBlock Text="포커스 상태" Style="{DynamicResource FieldLabel}"/>
                                <TextBox Text="클릭하면 파란 테두리" Style="{DynamicResource PropInput}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Text="ComboBox / CheckBox" Style="{DynamicResource CardTitle}"/>
                                <TextBlock Text="데이터 타입" Style="{DynamicResource FieldLabel}"/>
                                <ComboBox Style="{DynamicResource PropCombo}" SelectedIndex="0" Margin="0,0,0,10">
                                    <ComboBoxItem>Float32</ComboBoxItem>
                                    <ComboBoxItem>Int16</ComboBoxItem>
                                    <ComboBoxItem>Int32</ComboBoxItem>
                                    <ComboBoxItem>Bool</ComboBoxItem>
                                    <ComboBoxItem>String</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Text="변환 방식" Style="{DynamicResource FieldLabel}"/>
                                <ComboBox Style="{DynamicResource PropCombo}" SelectedIndex="0" Margin="0,0,0,12">
                                    <ComboBoxItem>Linear</ComboBoxItem>
                                    <ComboBoxItem>None</ComboBoxItem>
                                    <ComboBoxItem>Expression</ComboBoxItem>
                                </ComboBox>
                                <CheckBox Content="알람 사용" Style="{DynamicResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,8"/>
                                <CheckBox Content="가상 Tag"  Style="{DynamicResource DarkCheckBox}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="폰트 &amp; 텍스트 계층" Style="{DynamicResource CardTitle}"/>
                            <TextBlock Text="주 텍스트 (TextBrush)" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="보조 텍스트 (Text2Brush) — 설명, 레이블" Foreground="{DynamicResource Text2Brush}" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="흐린 텍스트 (Text3Brush) — 힌트, 타임스탬프" Foreground="{DynamicResource Text3Brush}" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="150.3 °C  |  7.42 bar  |  1842 rpm"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource GreenBrush}"
                                       FontSize="18" FontWeight="Bold" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="ProgressBar 스타일" Style="{DynamicResource CardTitle}"/>
                            <TextBlock Text="Standard" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5"/>
                            <ProgressBar Style="{DynamicResource ProgressStandard}" Value="72" Margin="0,0,0,4"/>
                            <ProgressBar Style="{DynamicResource ProgressStandard}" Value="38" Margin="0,0,0,12"/>
                            <TextBlock Text="Slim (파이프라인)" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5"/>
                            <ProgressBar Style="{DynamicResource ProgressSlim}" Value="99" Margin="0,0,0,4"/>
                            <ProgressBar Style="{DynamicResource ProgressSlim}" Value="57" Margin="0,0,0,12"/>
                            <TextBlock Text="Indeterminate (로딩 중)" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5"/>
                            <ProgressBar Style="{DynamicResource ProgressSlim}" IsIndeterminate="True"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ③ 카드 & 배지 탭 -->
            <ScrollViewer x:Name="Tab3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock Text="카드 스타일 (Cards)" Style="{DynamicResource CardTitle}" FontSize="14" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Border Style="{DynamicResource Card}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Card (기본)" Style="{DynamicResource CardTitle}"/>
                                <TextBlock Text="기본 컨텐츠 박스. 배경 CardBrush, 테두리 Border2Brush."
                                           Foreground="{DynamicResource Text2Brush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardHH}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="CardHH — 위험 알람" Style="{DynamicResource CardTitle}" Foreground="{DynamicResource RedBrush}"/>
                                <TextBlock Text="왼쪽 4px 빨간 강조선. HH 알람 상세 표시에 사용."
                                           Foreground="{DynamicResource Text2Brush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardH}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="CardH — 주의 알람" Style="{DynamicResource CardTitle}" Foreground="{DynamicResource OrangeBrush}"/>
                                <TextBlock Text="왼쪽 4px 주황 강조선."
                                           Foreground="{DynamicResource Text2Brush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardWarning}">
                            <StackPanel>
                                <TextBlock Text="CardWarning — 경고/예측" Style="{DynamicResource CardTitle}" Foreground="{DynamicResource YellowBrush}"/>
                                <TextBlock Text="왼쪽 4px 노랑 강조선."
                                           Foreground="{DynamicResource Text2Brush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="배지 (Badges)" Style="{DynamicResource CardTitle}"/>
                            <WrapPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource BadgeGreen}"  Margin="0,0,8,8"><TextBlock Text="● GOOD"    Style="{DynamicResource BadgeGreenText}"/></Border>
                                <Border Style="{DynamicResource BadgeYellow}" Margin="0,0,8,8"><TextBlock Text="● 경고"    Style="{DynamicResource BadgeYellowText}"/></Border>
                                <Border Style="{DynamicResource BadgeRed}"    Margin="0,0,8,8"><TextBlock Text="● HH 알람" Style="{DynamicResource BadgeRedText}"/></Border>
                                <Border Style="{DynamicResource BadgeAccent}" Margin="0,0,8,8"><TextBlock Text="● 정보"    Style="{DynamicResource BadgeAccentText}"/></Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <UniformGrid Columns="4">
                        <Border Style="{DynamicResource StatCard}" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="TPS"    Style="{DynamicResource StatLabel}"/>
                                <TextBlock Text="847"    Style="{DynamicResource StatValue}" Foreground="{DynamicResource AccBrush}"/>
                                <TextBlock Text="태그/초" Style="{DynamicResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource StatCard}" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="SDT 압축" Style="{DynamicResource StatLabel}"/>
                                <TextBlock Text="94.3%"    Style="{DynamicResource StatValue}" Foreground="{DynamicResource GreenBrush}"/>
                                <TextBlock Text="저장 절감" Style="{DynamicResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource StatCard}" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="오류율" Style="{DynamicResource StatLabel}"/>
                                <TextBlock Text="0.12%" Style="{DynamicResource StatValue}" Foreground="{DynamicResource YellowBrush}"/>
                                <TextBlock Text="통신"  Style="{DynamicResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource StatCard}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="활성 Tag"  Style="{DynamicResource StatLabel}"/>
                                <TextBlock Text="142"       Style="{DynamicResource StatValue}"/>
                                <TextBlock Text="/ 148 전체" Style="{DynamicResource StatSub}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- ④ 트리 & 목록 탭 -->
            <ScrollViewer x:Name="Tab4" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="10,8">
                                <TextBlock Text="장비 구조 트리" Style="{DynamicResource PanelHeader}"/>
                            </Border>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                        Background="{DynamicResource CardBrush}" Margin="6,5">
                                <Button Content="+ 그룹" Style="{DynamicResource TreeBtn}"/>
                                <Button Content="+ 장비" Style="{DynamicResource TreeBtn}"/>
                                <Button Content="+ Tag"  Style="{DynamicResource TreeBtn}"/>
                            </StackPanel>
                            <TreeView Style="{DynamicResource DeviceTreeView}">
                                <TreeViewItem Style="{DynamicResource DeviceTreeItem}" IsSelected="True">
                                    <TreeViewItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🏭" Style="{DynamicResource TreeNodeIcon}"/>
                                            <TextBlock Text="제1공장" Style="{DynamicResource TreeGroupName}"/>
                                            <Border Style="{DynamicResource BadgeAccent}" Margin="8,0,0,0">
                                                <TextBlock Text="3장비" Style="{DynamicResource BadgeAccentText}"/>
                                            </Border>
                                        </StackPanel>
                                    </TreeViewItem.Header>
                                    <TreeViewItem Style="{DynamicResource DeviceTreeItem}">
                                        <TreeViewItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚙" Style="{DynamicResource TreeNodeIcon}"/>
                                                <TextBlock Text="압출기 #1" Style="{DynamicResource TreeNodeName}"/>
                                            </StackPanel>
                                        </TreeViewItem.Header>
                                        <TreeViewItem Style="{DynamicResource DeviceTreeItem}">
                                            <TreeViewItem.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔌" Style="{DynamicResource TreeNodeIcon}"/>
                                                    <TextBlock Text="ModbusTCP" Style="{DynamicResource TreeNodeName}"/>
                                                    <Border Style="{DynamicResource BadgeAccent}" Margin="6,0,0,0">
                                                        <TextBlock Text="6T" Style="{DynamicResource BadgeAccentText}"/>
                                                    </Border>
                                                </StackPanel>
                                            </TreeViewItem.Header>
                                        </TreeViewItem>
                                    </TreeViewItem>
                                    <TreeViewItem Style="{DynamicResource DeviceTreeItem}">
                                        <TreeViewItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚙" Style="{DynamicResource TreeNodeIcon}"/>
                                                <TextBlock Text="사출기 #1" Style="{DynamicResource TreeNodeName}"/>
                                            </StackPanel>
                                        </TreeViewItem.Header>
                                        <TreeViewItem Style="{DynamicResource DeviceTreeItem}">
                                            <TreeViewItem.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔌" Style="{DynamicResource TreeNodeIcon}"/>
                                                    <TextBlock Text="OPC-UA" Style="{DynamicResource TreeNodeName}"/>
                                                    <Border Style="{DynamicResource BadgeRed}" Margin="6,0,0,0">
                                                        <TextBlock Text="오류" Style="{DynamicResource BadgeRedText}"/>
                                                    </Border>
                                                </StackPanel>
                                            </TreeViewItem.Header>
                                        </TreeViewItem>
                                    </TreeViewItem>
                                </TreeViewItem>
                            </TreeView>
                        </DockPanel>
                    </Border>
                    <StackPanel Grid.Column="2">
                        <Border Style="{DynamicResource Card}" Padding="0" Margin="0,0,0,16">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="10,8">
                                    <TextBlock Text="수집 태그 목록 (TagListRow)" Style="{DynamicResource PanelHeader}"/>
                                </Border>
                                <StackPanel>
                                    <Border Style="{DynamicResource TagListRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="60"/><ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Style="{DynamicResource DotGreen}"/>
                                            <TextBlock Grid.Column="1" Text="온도" Style="{DynamicResource TagName}" Margin="8,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="150.3" Style="{DynamicResource TagValue}"/>
                                            <Border Grid.Column="3" Style="{DynamicResource BadgeGreen}" Margin="4,0">
                                                <TextBlock Text="GOOD" Style="{DynamicResource BadgeGreenText}"/>
                                            </Border>
                                            <TextBlock Grid.Column="4" Text="0.3s" Style="{DynamicResource TagTimestamp}"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{DynamicResource TagListRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="60"/><ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
