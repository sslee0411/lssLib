                                           Style="{DynamicResource FieldLabel}" Margin="0,0,0,6"/>
                                <Border Background="{DynamicResource BgBrush}"
                                        CornerRadius="{DynamicResource RadiusSm}"
                                        Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="&lt;uc:ThemePickerButton"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                                   Foreground="{DynamicResource AccBrush}"/>
                                        <TextBlock Text='  DockPanel.Dock="Right"'
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                                   Foreground="{DynamicResource Text2Brush}"/>
                                        <TextBlock Text='  Margin="0,0,8,0"/&gt;'
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                                   Foreground="{DynamicResource Text2Brush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 설계 특징 + 단축키 -->
                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Text="설계 특징 &amp; 주의사항" Style="{DynamicResource CardTitle}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="20" Height="20" CornerRadius="10"
                                            Background="{DynamicResource AccFaintBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="1" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="StaysOpen=False"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="{DynamicResource UiFont}"
                                                   FontSize="{DynamicResource FontBase}"/>
                                        <TextBlock Text="외부 클릭 시 WPF 자동 닫힘"
                                                   Foreground="{DynamicResource Text3Brush}"
                                                   FontFamily="{DynamicResource UiFont}"
                                                   FontSize="{DynamicResource FontSm}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="20" Height="20" CornerRadius="10"
                                            Background="{DynamicResource AccFaintBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="2" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="IDisposable 자동 호출"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="{DynamicResource UiFont}"
                                                   FontSize="{DynamicResource FontBase}"/>
                                        <TextBlock Text="Unloaded → ViewModel.Dispose()"
                                                   Foreground="{DynamicResource Text3Brush}"
                                                   FontFamily="{DynamicResource UiFont}"
                                                   FontSize="{DynamicResource FontSm}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="20" Height="20" CornerRadius="10"
                                            Background="{DynamicResource AccFaintBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="3" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="DynamicResource 전용"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="{DynamicResource UiFont}"
                                                   FontSize="{DynamicResource FontBase}"/>
                                        <TextBlock Text="테마 전환 시 팝업도 즉시 갱신"
                                                   Foreground="{DynamicResource Text3Brush}"
                                                   FontFamily="{DynamicResource UiFont}"
                                                   FontSize="{DynamicResource FontSm}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="20" Height="20" CornerRadius="10"
                                            Background="{DynamicResource AccFaintBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="4" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="IsNotSelected 반전 프로퍼티"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="{DynamicResource UiFont}"
                                                   FontSize="{DynamicResource FontBase}"/>
                                        <TextBlock Text="미선택 빈공간 정렬 유지용"
                                                   Foreground="{DynamicResource Text3Brush}"
                                                   FontFamily="{DynamicResource UiFont}"
                                                   FontSize="{DynamicResource FontSm}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Style="{DynamicResource Divider}"/>

                                <TextBlock Text="키보드 단축키"
                                           Style="{DynamicResource FieldLabel}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Style="{DynamicResource BadgeAccent}" Margin="0,0,8,0">
                                        <TextBlock Text="Ctrl+T" Style="{DynamicResource BadgeAccentText}"/>
                                    </Border>
                                    <TextBlock Text="다음 테마 순환"
                                               Foreground="{DynamicResource Text2Brush}"
                                               FontFamily="{DynamicResource UiFont}"
                                               FontSize="{DynamicResource FontBase}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Style="{DynamicResource BadgeAccent}" Margin="0,0,8,0">
                                        <TextBlock Text="Ctrl+Shift+T" Style="{DynamicResource BadgeAccentText}"/>
                                    </Border>
                                    <TextBlock Text="이전 테마 순환"
                                               Foreground="{DynamicResource Text2Brush}"
                                               FontFamily="{DynamicResource UiFont}"
                                               FontSize="{DynamicResource FontBase}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{DynamicResource BadgeAccent}" Margin="0,0,8,0">
                                        <TextBlock Text="1 ~ 7" Style="{DynamicResource BadgeAccentText}"/>
                                    </Border>
                                    <TextBlock Text="탭 이동"
                                               Foreground="{DynamicResource Text2Brush}"
                                               FontFamily="{DynamicResource UiFont}"
                                               FontSize="{DynamicResource FontBase}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- ══ 하단 상태바 ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Ellipse Style="{DynamicResource DotGreen}" Margin="0,0,6,0"/>
                    <TextBlock Text="IIoT.UI.Themes v1.5"
                               Foreground="{DynamicResource Text3Brush}"
                               FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="Ctrl+T: 다음 테마  |  Ctrl+Shift+T: 이전 테마  |  숫자 1~7: 탭 이동"
                           Foreground="{DynamicResource Text3Brush}"
                           FontSize="10" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           Text="Dark Navy 테마 적용됨"
                           Foreground="{DynamicResource Text2Brush}"
                           FontSize="10" VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
