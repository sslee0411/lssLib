<!-- ══════════════════════════════════════════════════════════
     IIoT.UI.Themes · Controls/ThemeSelectorPanel.xaml
     역할: 툴바 또는 설정 패널에 배치하는 테마 선택 UI
           7가지 테마를 색상 카드 형태로 표시하고 즉시 전환
     사용:
       <themes:ThemeSelectorPanel/>
     생성: 2025-05-16
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.UI.Themes.Controls.ThemeSelectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:IIoT.UI.Themes"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.Resources>

        <!-- ── 테마 카드 스타일 ───────────────────────────── -->
        <Style x:Key="ThemeCard" TargetType="Button">
            <Setter Property="Width"       Value="148"/>
            <Setter Property="Height"      Value="88"/>
            <Setter Property="Margin"      Value="6"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataTemplate: 개별 테마 카드 ──────────────── -->
        <DataTemplate DataType="{x:Type themes:ThemeItemViewModel}">
            <Button Style="{StaticResource ThemeCard}"
                    Command="{Binding DataContext.SelectThemeCommand,
                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">

                <!-- 선택된 테마는 액센트 테두리 -->
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ThemeCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource AccBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <!-- 카드 내부 레이아웃 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>  <!-- 색상 프리뷰 영역 -->
                        <RowDefinition Height="*"/>   <!-- 이름 영역 -->
                    </Grid.RowDefinitions>

                    <!-- 색상 프리뷰 (액센트 + 배경 시뮬레이션) -->
                    <Border Grid.Row="0" CornerRadius="4,4,0,0" ClipToBounds="True">
                        <Grid>
                            <!-- 배경색 시뮬레이션 (어두운/밝은) -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <SolidColorBrush>
                                        <SolidColorBrush.Color>
                                            <MultiBinding Converter="{StaticResource ThemePreviewBgConverter}">
                                                <Binding Path="IsDark"/>
                                            </MultiBinding>
                                        </SolidColorBrush.Color>
                                    </SolidColorBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- 액센트 색상 점 + 그라디언트 -->
                            <Ellipse Width="36" Height="36"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Bottom"
                                     Margin="8,0,0,8">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding AccentHex,
                                        Converter={StaticResource HexToColorConverter}}"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- 선택 체크 마크 -->
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,6,6,0"
                                    Width="18" Height="18"
                                    CornerRadius="9"
                                    Visibility="{Binding IsSelected,
                                        Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding AccentHex,
                                        Converter={StaticResource HexToColorConverter}}"/>
                                </Border.Background>
                                <TextBlock Text="✓" FontSize="10" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Dark / Light 레이블 -->
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="6,6,0,0"
                                    Padding="4,1"
                                    CornerRadius="3"
                                    Background="#33000000">
                                <TextBlock Text="{Binding ModeLabel}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 테마 이름 / 설명 -->
                    <StackPanel Grid.Row="1"
                                Background="{DynamicResource CardBrush}">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="9"
                                   Foreground="{DynamicResource Text3Brush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ── 메인 레이아웃 ─────────────────────────────────── -->
    <DockPanel>

        <!-- 헤더 -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <TextBlock Text="테마 설정"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccBrush}"
                           VerticalAlignment="Center"/>

                <!-- 현재 테마 표시 -->
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding CurrentThemeDisplay}"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center"/>

                <!-- 순환 버튼 -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Content="◀" ToolTip="이전 테마"
                            Style="{DynamicResource ToolbarBtn}"
                            Command="{Binding PrevThemeCommand}"
                            Padding="6,4" Margin="0,0,3,0"/>
                    <Button Content="▶" ToolTip="다음 테마"
                            Style="{DynamicResource ToolbarBtn}"
                            Command="{Binding NextThemeCommand}"
                            Padding="6,4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 테마 카드 그리드 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Themes}" Margin="6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
