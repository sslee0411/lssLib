<!-- ══════════════════════════════════════════════════════════
     IIoT.UI.Themes · Themes/Theme.WarmAmber.xaml
     테마: ④ Warm Amber — 정유공장 레거시 제어실 / 아날로그 감성
     분위기: 황금 앰버 + 따뜻한 오렌지, 격자 배경, 브론즈 포인트
     ※ 키 이름은 Theme.DarkNavy.xaml과 100% 동일 유지
     생성: 2025-05-16
     ══════════════════════════════════════════════════════════ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- §1 ─ 배경 색상 계층 -->
    <Color x:Key="BgColor">#110F0C</Color>
    <Color x:Key="SurfaceColor">#1A1714</Color>
    <Color x:Key="CardColor">#221E18</Color>
    <Color x:Key="BorderColor">#2E2820</Color>
    <Color x:Key="Border2Color">#3D3528</Color>

    <SolidColorBrush x:Key="BgBrush"      Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush"    Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="BorderBrush"  Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Border2Brush" Color="{StaticResource Border2Color}"/>

    <!-- §2 ─ 포인트 색상 -->
    <Color x:Key="AccColor">#F59E0B</Color>   <!-- 황금 앰버 -->
    <Color x:Key="Acc2Color">#FB923C</Color>  <!-- 따뜻한 오렌지 -->

    <SolidColorBrush x:Key="AccBrush"      Color="{StaticResource AccColor}"/>
    <SolidColorBrush x:Key="Acc2Brush"     Color="{StaticResource Acc2Color}"/>
    <SolidColorBrush x:Key="AccFaintBrush"  Color="#1AF59E0B"/>
    <SolidColorBrush x:Key="Acc2FaintBrush" Color="#1AFB923C"/>

    <!-- §3 ─ 상태 색상 -->
    <Color x:Key="GreenColor">#86EFAC</Color>   <!-- 부드러운 초록 -->
    <Color x:Key="YellowColor">#FCD34D</Color>  <!-- 밝은 노랑 -->
    <Color x:Key="RedColor">#F87171</Color>     <!-- 부드러운 빨강 -->
    <Color x:Key="OrangeColor">#FB923C</Color>
    <Color x:Key="BlueColor">#93C5FD</Color>
    <Color x:Key="PurpleColor">#C4B5FD</Color>

    <SolidColorBrush x:Key="GreenBrush"  Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}"/>
    <SolidColorBrush x:Key="RedBrush"    Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}"/>
    <SolidColorBrush x:Key="BlueBrush"   Color="{StaticResource BlueColor}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>

    <SolidColorBrush x:Key="GreenFaintBrush"  Color="#1A86EFAC"/>
    <SolidColorBrush x:Key="YellowFaintBrush" Color="#1AFCD34D"/>
    <SolidColorBrush x:Key="RedFaintBrush"    Color="#1AF87171"/>
    <SolidColorBrush x:Key="OrangeFaintBrush" Color="#1AFB923C"/>

    <!-- §4 ─ 텍스트 -->
    <Color x:Key="TextColor">#FDF3E7</Color>
    <Color x:Key="Text2Color">#C9A96E</Color>
    <Color x:Key="Text3Color">#6B5A40</Color>

    <SolidColorBrush x:Key="TextBrush"  Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}"/>
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}"/>

    <!-- §5 ─ 그라디언트 -->
    <LinearGradientBrush x:Key="ScaleArrowBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Acc2Color}" Offset="0"/>
        <GradientStop Color="{StaticResource AccColor}"  Offset="0.5"/>
        <GradientStop Color="{StaticResource GreenColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PipelineBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource AccColor}"   Offset="0"/>
        <GradientStop Color="{StaticResource OrangeColor}" Offset="0.6"/>
        <GradientStop Color="{StaticResource GreenColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TopBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1F1A14" Offset="0"/>
        <GradientStop Color="#1A1714" Offset="1"/>
    </LinearGradientBrush>

    <!-- §6 ─ 격자 배경 (따뜻한 격자) -->
    <DrawingBrush x:Key="GridDotBrush" TileMode="Tile"
                  Viewport="0,0,24,24" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#2E2820">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="1,1" RadiusX="0.8" RadiusY="0.8"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="FlowCanvasGridBrush" TileMode="Tile"
                  Viewport="0,0,24,24" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#2E282088">
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,24" EndPoint="24,24"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#2E282088">
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="24,0" EndPoint="24,24"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- §7 ─ 폰트 -->
    <FontFamily x:Key="MonoFont">JetBrains Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI, Malgun Gothic, sans-serif</FontFamily>

    <!-- §8 ─ 치수 -->
    <CornerRadius x:Key="Radius">5</CornerRadius>
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <Thickness x:Key="PanelPadding">12,8</Thickness>
    <Thickness x:Key="CardPadding">14</Thickness>
    <Thickness x:Key="FieldMargin">0,0,0,9</Thickness>
    <x:Double x:Key="LeftPanelWidth">220</x:Double>
    <x:Double x:Key="RightPanelWidth">268</x:Double>
    <x:Double x:Key="TopBarHeight">42</x:Double>
    <x:Double x:Key="SubTabHeight">38</x:Double>
    <x:Double x:Key="PanelHeaderHeight">32</x:Double>
    <x:Double x:Key="FontSm">10</x:Double>
    <x:Double x:Key="FontBase">12</x:Double>
    <x:Double x:Key="FontMd">13</x:Double>
    <x:Double x:Key="FontLg">15</x:Double>
    <x:Double x:Key="FontXl">18</x:Double>
    <x:Double x:Key="FontData">22</x:Double>

</ResourceDictionary>
