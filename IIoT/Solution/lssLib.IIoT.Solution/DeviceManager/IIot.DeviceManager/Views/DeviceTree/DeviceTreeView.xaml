<!--
 ══════════════════════════════════════════════════════════
  IIoT.DeviceManager · DeviceTreeView.xaml
  역할: 장비 트리뷰 — Group/Device/PLC/Tag 계층 표시 + CRUD 툴바
  생성: 2025-05-22
  수정: 2025-05-22 v1 — XDG0008 수정 (BasedOn StaticResource 제거)
  수정: 2025-05-22 v2 — DeviceTreeView 스타일 키 수정
  수정: 2025-05-23 v3 — vm: → conv:, vm:: → vm:
  수정: 2025-05-23 v4 — ResourceDictionary 구조 수정 (모든 리소스 내부로 이동)
  수정: 2025-05-23 v5 — XLS0509 수정: Style.Triggers 를 Style 내 마지막으로 이동
                         XLS0414 재확인: conv: 접두사 명시적 적용
  수정: 2025-05-23 v6 — 트리 구조 유연화 반영
        ToolTip / ContextMenu 텍스트를 새 동작에 맞게 수정
        · 장비 추가: 선택 없으면 루트에 추가, Device/Plc 하위에도 추가 가능
        · PLC 추가: 선택 없으면 루트에 추가, Device/Plc 하위에도 추가 가능
  수정: 2025-05-23 v7 — 같은 레벨(Sibling) 추가 버튼/메뉴 추가
        툴바: [하위 추가] 그룹 | 장비 | PLC | 태그  ──  [같은레벨] 그룹 | 장비 | PLC
        컨텍스트: 하위에 추가 / 같은 레벨에 추가 분리
 ══════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="IIoT.DeviceManager.Views.DeviceTree.DeviceTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:IIoT.DeviceManager.ViewModels.DeviceTree"
    xmlns:conv="clr-namespace:IIoT.DeviceManager.Views.DeviceTree"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="280">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IIoT.UI.Themes;component/Styles/Styles.Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IIoT.UI.Themes;component/Styles/Styles.TreeView.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IIoT.UI.Themes;component/Themes/Theme.DarkNavy.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ★ conv: 접두사 사용 — Views.DeviceTree 네임스페이스 (TreeConverters.cs) -->
            <conv:BoolToVisibilityConverter       x:Key="BoolToVisibilityConverter"/>
            <conv:BoolToVisibilityInvertConverter x:Key="BoolToVisibilityInvertConverter"/>
            <conv:NullToVisibilityConverter       x:Key="NullToVisibilityConverter"/>

            <!-- ── 노드 스타일 ── -->
            <Style x:Key="NodeLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
            </Style>

            <Style x:Key="NodeEditBoxStyle" TargetType="TextBox">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,1,4,1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="3,1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccBrush}"/>
            </Style>

            <Style x:Key="NodeBadgeStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="5,1"/>
                <Setter Property="Margin" Value="5,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource AccBrush}"/>
            </Style>

            <!-- ── 공통 노드 헤더 ── -->
            <DataTemplate x:Key="NodeHeaderTemplate">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconGlyph}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource NodeLabelStyle}"
                               Visibility="{Binding IsEditing,
                                   Converter={StaticResource BoolToVisibilityInvertConverter}}"/>
                    <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource NodeEditBoxStyle}"
                             Width="130"
                             Visibility="{Binding IsEditing,
                                 Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Border Style="{StaticResource NodeBadgeStyle}"
                            Visibility="{Binding Badge,
                                Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding Badge}" FontSize="10"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <HierarchicalDataTemplate DataType="{x:Type vm:GroupNodeViewModel}"
                                       ItemsSource="{Binding Children}">
                <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                                  Content="{Binding}"/>
            </HierarchicalDataTemplate>

            <HierarchicalDataTemplate DataType="{x:Type vm:DeviceItemViewModel}"
                                       ItemsSource="{Binding Children}">
                <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                                  Content="{Binding}"/>
            </HierarchicalDataTemplate>

            <HierarchicalDataTemplate DataType="{x:Type vm:PlcNodeViewModel}"
                                       ItemsSource="{Binding Children}">
                <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                                  Content="{Binding}"/>
            </HierarchicalDataTemplate>

            <DataTemplate DataType="{x:Type vm:TagNodeViewModel}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconGlyph}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource NodeLabelStyle}"
                               Visibility="{Binding IsEditing,
                                   Converter={StaticResource BoolToVisibilityInvertConverter}}"/>
                    <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource NodeEditBoxStyle}"
                             Width="120"
                             Visibility="{Binding IsEditing,
                                 Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Border CornerRadius="4" Padding="4,1" Margin="5,0,0,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BufType}" FontSize="9"
                                   Foreground="{DynamicResource Text2Brush}"/>
                    </Border>
                    <TextBlock Text="{Binding Address, StringFormat='@ {0}'}"
                               FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text3Brush}"/>
                </StackPanel>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>

        <!-- ══════════════════════════════════════════════════
             상단 툴바
             ─────────────────────────────────────────────────
             [하위 추가] 그룹·장비·PLC·태그
             ─ Separator ─
             [같은레벨] 그룹·장비·PLC
             ─ Separator ─
             ▲ ▼ ─ Separator ─ 삭제
             ─ Separator ─
             ⊞ ⊟ ─ Separator ─ 샘플
        ══════════════════════════════════════════════════ -->
        <ToolBar DockPanel.Dock="Top"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="0,0,0,1">

            <!-- ── 구분 레이블: 하위 추가 ── -->
            <TextBlock Text="하위"
                       FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource Text3Brush}"
                       VerticalAlignment="Center"
                       Margin="4,0,2,0"/>

            <!-- 하위: 그룹 추가 -->
            <Button Command="{Binding AddGroupCommand}"
                    ToolTip="하위 그룹 추가&#x0a;· 그룹 선택 → 하위 그룹&#x0a;· 그 외 → 루트 그룹"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" FontSize="13"/>
                    <TextBlock Text=" 그룹" FontSize="11"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <!-- 하위: 장비 추가 -->
            <Button Command="{Binding AddDeviceCommand}"
                    ToolTip="하위 장비 추가&#x0a;· 선택 없음 → 루트&#x0a;· 그룹/장비/PLC → 하위"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📟" FontSize="13"/>
                    <TextBlock Text=" 장비" FontSize="11"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <!-- 하위: PLC 추가 -->
            <Button Command="{Binding AddPlcCommand}"
                    ToolTip="하위 PLC 추가&#x0a;· 선택 없음 → 루트&#x0a;· 그룹/장비/PLC → 하위"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙️" FontSize="13"/>
                    <TextBlock Text=" PLC" FontSize="11"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <!-- 하위: 태그 추가 -->
            <Button Command="{Binding AddTagCommand}"
                    ToolTip="태그 추가 (장비 또는 PLC 선택 필요)"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏷️" FontSize="13"/>
                    <TextBlock Text=" 태그" FontSize="11"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <Separator/>

            <!-- ── 구분 레이블: 같은 레벨 추가 ── -->
            <TextBlock Text="동레벨"
                       FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource AccBrush}"
                       VerticalAlignment="Center"
                       Margin="4,0,2,0"/>

            <!-- 같은 레벨: 그룹 추가 -->
            <Button Command="{Binding AddSiblingGroupCommand}"
                    ToolTip="같은 레벨에 그룹 추가&#x0a;선택 노드 바로 다음에 그룹 삽입"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" FontSize="13"/>
                    <TextBlock Text="=" FontSize="9"
                               Foreground="{DynamicResource AccBrush}"
                               VerticalAlignment="Bottom" Margin="1,0,0,2"/>
                </StackPanel>
            </Button>

            <!-- 같은 레벨: 장비 추가 -->
            <Button Command="{Binding AddSiblingDeviceCommand}"
                    ToolTip="같은 레벨에 장비 추가&#x0a;선택 노드 바로 다음에 장비 삽입"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📟" FontSize="13"/>
                    <TextBlock Text="=" FontSize="9"
                               Foreground="{DynamicResource AccBrush}"
                               VerticalAlignment="Bottom" Margin="1,0,0,2"/>
                </StackPanel>
            </Button>

            <!-- 같은 레벨: PLC 추가 -->
            <Button Command="{Binding AddSiblingPlcCommand}"
                    ToolTip="같은 레벨에 PLC 추가&#x0a;선택 노드 바로 다음에 PLC 삽입"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙️" FontSize="13"/>
                    <TextBlock Text="=" FontSize="9"
                               Foreground="{DynamicResource AccBrush}"
                               VerticalAlignment="Bottom" Margin="1,0,0,2"/>
                </StackPanel>
            </Button>

            <Separator/>

            <!-- 위/아래 이동 -->
            <Button Command="{Binding MoveUpCommand}"
                    ToolTip="위로 이동"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <TextBlock Text="▲" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Button Command="{Binding MoveDownCommand}"
                    ToolTip="아래로 이동"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <TextBlock Text="▼" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Separator/>

            <!-- 삭제 -->
            <Button Command="{Binding DeleteNodeCommand}"
                    ToolTip="선택 노드 삭제 (하위 전체 포함)"
                    Style="{DynamicResource SecondaryBtn}" Padding="5,3"
                    Foreground="{DynamicResource RedBrush}"
                    BorderBrush="{DynamicResource RedBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" FontSize="13"/>
                    <TextBlock Text=" 삭제" FontSize="11"
                               Foreground="{DynamicResource RedBrush}"/>
                </StackPanel>
            </Button>

            <Separator/>

            <!-- 전체 펼치기/접기 -->
            <Button Command="{Binding ExpandAllCommand}"
                    ToolTip="전체 펼치기"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <TextBlock Text="⊞" FontSize="13"
                           Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Button Command="{Binding CollapseAllCommand}"
                    ToolTip="전체 접기"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <TextBlock Text="⊟" FontSize="13"
                           Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Separator/>

            <!-- 샘플 로드 -->
            <Button Command="{Binding LoadSampleCommand}"
                    ToolTip="샘플 데이터 로드 (테스트용)"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <TextBlock Text="↺ 샘플" FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"/>
            </Button>

        </ToolBar>

        <!-- ── 하단 상태바 ── -->
        <StatusBar DockPanel.Dock="Bottom" Height="22"
                   Background="{DynamicResource SurfaceBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock FontSize="11" Foreground="{DynamicResource Text2Brush}">
                    <Run Text="전체:"/>
                    <Run Text="{Binding TotalNodeCount, Mode=OneWay}"/>
                    <Run Text="개"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock FontSize="11" Foreground="{DynamicResource Text2Brush}">
                    <Run Text="선택:"/>
                    <Run Text="{Binding SelectedNode.Name, Mode=OneWay, FallbackValue=없음}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- ── 트리뷰 본체 ── -->
        <TreeView
            x:Name="DeviceTree"
            ItemsSource="{Binding RootNodes}"
            Background="{DynamicResource BgBrush}"
            BorderThickness="0"
            Style="{DynamicResource DeviceTreeView}"
            SelectedItemChanged="DeviceTree_SelectedItemChanged"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">

                    <Setter Property="IsExpanded"  Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected"  Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="Padding"      Value="2,3"/>
                    <Setter Property="MinHeight"    Value="26"/>
                    <Setter Property="Foreground"   Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Background"   Value="Transparent"/>

                    <!--
                    ★ ContextMenu 커맨드 바인딩 핵심 패턴 (v7 Fix)
                    ══════════════════════════════════════════════
                    문제: ContextMenu는 Visual Tree 밖 별도 Popup으로 생성됨
                         → RelativeSource AncestorType=TreeView 로 TreeView 탐색 불가 → null
                    해결: TreeViewItem.Tag 에 DeviceTreeViewModel을 바인딩 (ElementName 사용)
                         ContextMenu.PlacementTarget = TreeViewItem (WPF 자동 설정)
                         → PlacementTarget.Tag = DeviceTreeViewModel 항상 접근 가능
                    ──────────────────────────────────────────────
                    노드 자체 커맨드 (BeginEditCommand):
                      DataContext = PlacementTarget.DataContext = 해당 NodeViewModel
                      → {Binding BeginEditCommand} 그대로 사용
                    트리 전체 커맨드 (Add*/Delete/Move*):
                      → {Binding PlacementTarget.Tag.커맨드명,
                             RelativeSource={RelativeSource AncestorType=ContextMenu}}
                    ══════════════════════════════════════════════
                    컨텍스트 메뉴 구조:
                      ✏️ 이름 변경
                      ───
                      ▼ 하위에 추가
                        📁 하위 그룹
                        📟 하위 장비
                        ⚙️ 하위 PLC
                        🏷️ 태그
                      ───
                      ↔ 같은 레벨에 추가
                        📁 같은 레벨 그룹
                        📟 같은 레벨 장비
                        ⚙️ 같은 레벨 PLC
                      ───
                      ▲ 위로 이동
                      ▼ 아래로 이동
                      ───
                      🗑 삭제
                    ══════════════════════════════════════════════
                    -->
                    <!--
                    Tag 에 DeviceTreeViewModel 바인딩
                    ElementName=DeviceTree → TreeView.DataContext = DeviceTreeViewModel
                    -->
                    <Setter Property="Tag"
                            Value="{Binding DataContext, ElementName=DeviceTree}"/>

                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                             RelativeSource={RelativeSource Self}}">

                                <!-- 이름 변경 — 노드 자체 커맨드 (DataContext = NodeViewModel) -->
                                <MenuItem Header="✏️  이름 변경"
                                          Command="{Binding BeginEditCommand}"/>

                                <Separator/>

                                <!--
                                하위에 추가 / 같은 레벨에 추가
                                PlacementTarget.Tag = DeviceTreeViewModel (Tag 패턴)
                                -->

                                <!-- 하위에 추가 (SubMenu) -->
                                <MenuItem Header="↓  하위에 추가">
                                    <MenuItem Header="📁  하위 그룹"
                                              Command="{Binding PlacementTarget.Tag.AddGroupCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="📟  하위 장비"
                                              Command="{Binding PlacementTarget.Tag.AddDeviceCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="⚙️  하위 PLC"
                                              Command="{Binding PlacementTarget.Tag.AddPlcCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="🏷️  태그"
                                              Command="{Binding PlacementTarget.Tag.AddTagCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </MenuItem>

                                <!-- 같은 레벨에 추가 (SubMenu) -->
                                <MenuItem Header="↔  같은 레벨에 추가">
                                    <MenuItem Header="📁  같은 레벨 그룹"
                                              Command="{Binding PlacementTarget.Tag.AddSiblingGroupCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="📟  같은 레벨 장비"
                                              Command="{Binding PlacementTarget.Tag.AddSiblingDeviceCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="⚙️  같은 레벨 PLC"
                                              Command="{Binding PlacementTarget.Tag.AddSiblingPlcCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </MenuItem>

                                <Separator/>

                                <!-- 이동 -->
                                <MenuItem Header="▲  위로 이동"
                                          Command="{Binding PlacementTarget.Tag.MoveUpCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="▼  아래로 이동"
                                          Command="{Binding PlacementTarget.Tag.MoveDownCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                <Separator/>

                                <!-- 삭제 -->
                                <MenuItem Header="🗑  삭제"
                                          Command="{Binding PlacementTarget.Tag.DeleteNodeCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                            </ContextMenu>
                        </Setter.Value>
                    </Setter>

                    <EventSetter Event="MouseDoubleClick"
                                 Handler="TreeViewItem_MouseDoubleClick"/>
                    <EventSetter Event="KeyDown"
                                 Handler="TreeViewItem_KeyDown"/>

                    <!-- ★ Style.Triggers — 항상 마지막 -->
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected"        Value="True"/>
                                <Condition Property="IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource Border2Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </MultiTrigger>
                    </Style.Triggers>

                </Style>
            </TreeView.ItemContainerStyle>

        </TreeView>

    </DockPanel>
</UserControl>

