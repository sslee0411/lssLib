<!--
 ══════════════════════════════════════════════════════════
  IIoT.DeviceManager · DeviceTreeView.xaml
  역할: 장비 트리뷰 — Group/Device/PLC/Tag 계층 표시 + CRUD 툴바
  생성: 2025-05-22
  수정: 2025-05-22 v1 — XDG0008 수정 (BasedOn StaticResource 제거)
  수정: 2025-05-22 v2 — DeviceTreeView 스타일 키 수정
  수정: 2025-05-23 v3 — vm: → conv:, vm:: → vm:
  수정: 2025-05-23 v4 — ResourceDictionary 구조 수정 (모든 리소스 내부로 이동)
  수정: 2025-05-23 v5 — XLS0509 수정: Style.Triggers 를 Style 내 마지막으로 이동
                         XLS0414 재확인: conv: 접두사 명시적 적용
 ══════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="IIoT.DeviceManager.Views.DeviceTree.DeviceTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:IIoT.DeviceManager.ViewModels.DeviceTree"
    xmlns:conv="clr-namespace:IIoT.DeviceManager.Views.DeviceTree"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="280">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IIoT.UI.Themes;component/Styles/Styles.Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IIoT.UI.Themes;component/Styles/Styles.TreeView.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IIoT.UI.Themes;component/Themes/Theme.DarkNavy.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ★ conv: 접두사 사용 — Views.DeviceTree 네임스페이스 (TreeConverters.cs) -->
            <conv:BoolToVisibilityConverter       x:Key="BoolToVisibilityConverter"/>
            <conv:BoolToVisibilityInvertConverter x:Key="BoolToVisibilityInvertConverter"/>
            <conv:NullToVisibilityConverter       x:Key="NullToVisibilityConverter"/>

            <Style x:Key="NodeLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
            </Style>

            <Style x:Key="NodeEditBoxStyle" TargetType="TextBox">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,1,4,1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="3,1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccBrush}"/>
            </Style>

            <Style x:Key="NodeBadgeStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="5,1"/>
                <Setter Property="Margin" Value="5,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource AccBrush}"/>
            </Style>

            <DataTemplate x:Key="NodeHeaderTemplate">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconGlyph}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource NodeLabelStyle}"
                               Visibility="{Binding IsEditing,
                                   Converter={StaticResource BoolToVisibilityInvertConverter}}"/>
                    <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource NodeEditBoxStyle}"
                             Width="130"
                             Visibility="{Binding IsEditing,
                                 Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Border Style="{StaticResource NodeBadgeStyle}"
                            Visibility="{Binding Badge,
                                Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding Badge}" FontSize="10"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <HierarchicalDataTemplate DataType="{x:Type vm:GroupNodeViewModel}"
                                       ItemsSource="{Binding Children}">
                <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                                  Content="{Binding}"/>
            </HierarchicalDataTemplate>

            <HierarchicalDataTemplate DataType="{x:Type vm:DeviceItemViewModel}"
                                       ItemsSource="{Binding Children}">
                <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                                  Content="{Binding}"/>
            </HierarchicalDataTemplate>

            <HierarchicalDataTemplate DataType="{x:Type vm:PlcNodeViewModel}"
                                       ItemsSource="{Binding Children}">
                <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                                  Content="{Binding}"/>
            </HierarchicalDataTemplate>

            <DataTemplate DataType="{x:Type vm:TagNodeViewModel}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconGlyph}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource NodeLabelStyle}"
                               Visibility="{Binding IsEditing,
                                   Converter={StaticResource BoolToVisibilityInvertConverter}}"/>
                    <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource NodeEditBoxStyle}"
                             Width="120"
                             Visibility="{Binding IsEditing,
                                 Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Border CornerRadius="4" Padding="4,1" Margin="5,0,0,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BufType}" FontSize="9"
                                   Foreground="{DynamicResource Text2Brush}"/>
                    </Border>
                    <TextBlock Text="{Binding Address, StringFormat='@ {0}'}"
                               FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text3Brush}"/>
                </StackPanel>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>

        <ToolBar DockPanel.Dock="Top"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="0,0,0,1">

            <Button Command="{Binding AddGroupCommand}"
                    ToolTip="그룹 추가" Style="{DynamicResource GhostBtn}" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" FontSize="13"/>
                    <TextBlock Text=" 그룹" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding AddDeviceCommand}"
                    ToolTip="장비 추가 (그룹 선택 필요)"
                    Style="{DynamicResource GhostBtn}" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📟" FontSize="13"/>
                    <TextBlock Text=" 장비" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding AddPlcCommand}"
                    ToolTip="PLC 추가 (장비 선택 필요)"
                    Style="{DynamicResource GhostBtn}" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙️" FontSize="13"/>
                    <TextBlock Text=" PLC" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding AddTagCommand}"
                    ToolTip="태그 추가 (장비 또는 PLC 선택 필요)"
                    Style="{DynamicResource GhostBtn}" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏷️" FontSize="13"/>
                    <TextBlock Text=" 태그" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <Separator/>

            <Button Command="{Binding MoveUpCommand}"
                    ToolTip="위로 이동" Style="{DynamicResource GhostBtn}" Padding="6,3">
                <TextBlock Text="▲" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Button Command="{Binding MoveDownCommand}"
                    ToolTip="아래로 이동" Style="{DynamicResource GhostBtn}" Padding="6,3">
                <TextBlock Text="▼" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Separator/>

            <Button Command="{Binding DeleteNodeCommand}"
                    ToolTip="선택 노드 삭제" Style="{DynamicResource SecondaryBtn}" Padding="6,3"
                    Foreground="{DynamicResource RedBrush}"
                    BorderBrush="{DynamicResource RedBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" FontSize="13"/>
                    <TextBlock Text=" 삭제" FontSize="12" Foreground="{DynamicResource RedBrush}"/>
                </StackPanel>
            </Button>

            <Separator/>

            <Button Command="{Binding ExpandAllCommand}"
                    ToolTip="전체 펼치기" Style="{DynamicResource GhostBtn}" Padding="6,3">
                <TextBlock Text="⊞" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Button Command="{Binding CollapseAllCommand}"
                    ToolTip="전체 접기" Style="{DynamicResource GhostBtn}" Padding="6,3">
                <TextBlock Text="⊟" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Separator/>

            <Button Command="{Binding LoadSampleCommand}"
                    ToolTip="샘플 데이터 로드 (개발용)"
                    Style="{DynamicResource GhostBtn}" Padding="6,3">
                <TextBlock Text="↺ 샘플" FontSize="12" Foreground="{DynamicResource Text2Brush}"/>
            </Button>

        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom" Height="22"
                   Background="{DynamicResource SurfaceBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock FontSize="11" Foreground="{DynamicResource Text2Brush}">
                    <Run Text="전체:"/>
                    <Run Text="{Binding TotalNodeCount, Mode=OneWay}"/>
                    <Run Text="개"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock FontSize="11" Foreground="{DynamicResource Text2Brush}">
                    <Run Text="선택:"/>
                    <Run Text="{Binding SelectedNode.Name, Mode=OneWay, FallbackValue=없음}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <TreeView
            x:Name="DeviceTree"
            ItemsSource="{Binding RootNodes}"
            Background="{DynamicResource BgBrush}"
            BorderThickness="0"
            Style="{DynamicResource DeviceTreeView}"
            SelectedItemChanged="DeviceTree_SelectedItemChanged"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">

                    <!-- ① 일반 Setter (단순 값) -->
                    <Setter Property="IsExpanded"  Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected"  Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="Padding"      Value="2,3"/>
                    <Setter Property="MinHeight"    Value="26"/>
                    <Setter Property="Foreground"   Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Background"   Value="Transparent"/>

                    <!-- ② 복합 Setter (ContextMenu) -->
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                             RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="✏️ 이름 변경"
                                          Command="{Binding BeginEditCommand}"/>
                                <Separator/>
                                <MenuItem Header="📁 하위 그룹 추가"
                                          Command="{Binding DataContext.AddGroupCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <MenuItem Header="📟 장비 추가"
                                          Command="{Binding DataContext.AddDeviceCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <MenuItem Header="⚙️ PLC 추가"
                                          Command="{Binding DataContext.AddPlcCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <MenuItem Header="🏷️ 태그 추가"
                                          Command="{Binding DataContext.AddTagCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <Separator/>
                                <MenuItem Header="▲ 위로 이동"
                                          Command="{Binding DataContext.MoveUpCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <MenuItem Header="▼ 아래로 이동"
                                          Command="{Binding DataContext.MoveDownCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <Separator/>
                                <MenuItem Header="🗑 삭제"
                                          Command="{Binding DataContext.DeleteNodeCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>

                    <!-- ③ EventSetter -->
                    <EventSetter Event="MouseDoubleClick"
                                 Handler="TreeViewItem_MouseDoubleClick"/>
                    <EventSetter Event="KeyDown"
                                 Handler="TreeViewItem_KeyDown"/>

                    <!--
                    ★ v5 핵심 수정: Style.Triggers 는 반드시 Style 내 마지막에 위치
                       Setter / EventSetter (일반 내용) 뒤에
                       Style.Triggers (속성 요소) 가 와야 XLS0509 가 발생하지 않음.
                       순서: ① 일반 Setter → ② 복합 Setter → ③ EventSetter → ④ Style.Triggers
                    -->
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected"       Value="True"/>
                                <Condition Property="IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource Border2Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </MultiTrigger>
                    </Style.Triggers>

                </Style>
            </TreeView.ItemContainerStyle>

        </TreeView>

    </DockPanel>
</UserControl>
