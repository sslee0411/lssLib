<!--
 ══════════════════════════════════════════════════════════
  IIoT.DeviceManager · DeviceTreeView.xaml
  역할: 장비 트리 뷰 — Group/Device/PLC/Tag 계층 표시 + CRUD 툴바
  생성: 2025-05-22
 ══════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="IIoT.DeviceManager.Views.DeviceTree.DeviceTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:IIoT.DeviceManager.ViewModels.DeviceTree"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="280"
    d:DataContext="{d:DesignInstance vm:DeviceTreeViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>

        <!-- ── 노드 공통: 인라인 편집 트리거 ── -->
        <Style x:Key="NodeEditableTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <Style x:Key="NodeEditBoxStyle" TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,1,4,1"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>

        <!-- ── 배지 스타일 ── -->
        <Style x:Key="NodeBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── 노드 공통 헤더 DataTemplate ──
             각 타입별 HierarchicalDataTemplate 에서 공유 -->
        <DataTemplate x:Key="NodeHeaderTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 아이콘 -->
                <TextBlock Text="{Binding IconGlyph}"
                           FontSize="14"
                           VerticalAlignment="Center"/>
                <!-- 이름 (일반 모드) -->
                <TextBlock Text="{Binding Name}"
                           Style="{StaticResource NodeEditableTextStyle}"
                           Visibility="{Binding IsEditing,
                               Converter={StaticResource BoolToVisibilityInvertConverter}}"/>
                <!-- 이름 (편집 모드) -->
                <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource NodeEditBoxStyle}"
                         Width="130"
                         Visibility="{Binding IsEditing,
                             Converter={StaticResource BoolToVisibilityConverter}}"
                         x:Name="EditBox"/>
                <!-- 배지 -->
                <Border Style="{StaticResource NodeBadgeStyle}"
                        Background="{DynamicResource AccentBrush}"
                        Visibility="{Binding Badge,
                            Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding Badge}"
                               FontSize="10"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ═══ Group HierarchicalDataTemplate ═══ -->
        <HierarchicalDataTemplate
            DataType="{x:Type vm:GroupNodeViewModel}"
            ItemsSource="{Binding Children}">
            <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                              Content="{Binding}"/>
        </HierarchicalDataTemplate>

        <!-- ═══ Device HierarchicalDataTemplate ═══ -->
        <HierarchicalDataTemplate
            DataType="{x:Type vm:DeviceItemViewModel}"
            ItemsSource="{Binding Children}">
            <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                              Content="{Binding}"/>
        </HierarchicalDataTemplate>

        <!-- ═══ PLC HierarchicalDataTemplate ═══ -->
        <HierarchicalDataTemplate
            DataType="{x:Type vm:PlcNodeViewModel}"
            ItemsSource="{Binding Children}">
            <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                              Content="{Binding}"/>
        </HierarchicalDataTemplate>

        <!-- ═══ Tag DataTemplate (리프 노드) ═══ -->
        <DataTemplate DataType="{x:Type vm:TagNodeViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding IconGlyph}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}"
                           Style="{StaticResource NodeEditableTextStyle}"
                           Visibility="{Binding IsEditing,
                               Converter={StaticResource BoolToVisibilityInvertConverter}}"/>
                <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource NodeEditBoxStyle}"
                         Width="120"
                         Visibility="{Binding IsEditing,
                             Converter={StaticResource BoolToVisibilityConverter}}"/>
                <!-- BufType 배지 (회색) -->
                <Border CornerRadius="4" Padding="4,1" Margin="4,0,0,0"
                        Background="{DynamicResource BgTertiaryBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding BufType}"
                               FontSize="9"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <!-- Address -->
                <TextBlock Text="{Binding Address, StringFormat='@ {0}'}"
                           FontSize="10" Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <DockPanel>

        <!-- ── 상단 툴바 ── -->
        <ToolBar DockPanel.Dock="Top"
                 Background="{DynamicResource BgSecondaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="0,0,0,1">

            <!-- 그룹 추가 -->
            <Button Command="{Binding AddGroupCommand}"
                    ToolTip="그룹 추가 (선택 그룹 하위 또는 루트)"
                    Style="{DynamicResource ToolbarButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" FontSize="13"/>
                    <TextBlock Text=" 그룹" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>

            <!-- 장비 추가 (그룹 선택 시 활성) -->
            <Button Command="{Binding AddDeviceCommand}"
                    ToolTip="장비 추가 (그룹 선택 필요)"
                    Style="{DynamicResource ToolbarButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📟" FontSize="13"/>
                    <TextBlock Text=" 장비" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>

            <!-- PLC 추가 (장비 선택 시 활성) -->
            <Button Command="{Binding AddPlcCommand}"
                    ToolTip="PLC 추가 (장비 선택 필요)"
                    Style="{DynamicResource ToolbarButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙️" FontSize="13"/>
                    <TextBlock Text=" PLC" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>

            <!-- 태그 추가 (장비/PLC 선택 시 활성) -->
            <Button Command="{Binding AddTagCommand}"
                    ToolTip="태그 추가 (장비 또는 PLC 선택 필요)"
                    Style="{DynamicResource ToolbarButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏷️" FontSize="13"/>
                    <TextBlock Text=" 태그" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>

            <Separator/>

            <!-- 위로 -->
            <Button Command="{Binding MoveUpCommand}"
                    ToolTip="위로 이동"
                    Style="{DynamicResource ToolbarButtonStyle}">
                <TextBlock Text="▲" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>

            <!-- 아래로 -->
            <Button Command="{Binding MoveDownCommand}"
                    ToolTip="아래로 이동"
                    Style="{DynamicResource ToolbarButtonStyle}">
                <TextBlock Text="▼" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>

            <Separator/>

            <!-- 삭제 -->
            <Button Command="{Binding DeleteNodeCommand}"
                    ToolTip="선택 노드 삭제"
                    Style="{DynamicResource DangerButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" FontSize="13"/>
                    <TextBlock Text=" 삭제" FontSize="12"/>
                </StackPanel>
            </Button>

            <Separator/>

            <!-- 전체 펼치기 -->
            <Button Command="{Binding ExpandAllCommand}"
                    ToolTip="전체 펼치기"
                    Style="{DynamicResource ToolbarButtonStyle}">
                <TextBlock Text="⊞" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>

            <!-- 전체 접기 -->
            <Button Command="{Binding CollapseAllCommand}"
                    ToolTip="전체 접기"
                    Style="{DynamicResource ToolbarButtonStyle}">
                <TextBlock Text="⊟" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>

            <!-- 샘플 로드 (개발용) -->
            <Separator/>
            <Button Command="{Binding LoadSampleCommand}"
                    ToolTip="샘플 데이터 로드 (개발용)"
                    Style="{DynamicResource ToolbarButtonStyle}">
                <TextBlock Text="↺ 샘플" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>
        </ToolBar>

        <!-- ── 하단 상태바 ── -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource BgSecondaryBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0"
                   Height="22">
            <StatusBarItem>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="전체:"/>
                    <Run Text="{Binding TotalNodeCount, Mode=OneWay}"/>
                    <Run Text="개 노드"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="선택:"/>
                    <Run Text="{Binding SelectedNode.Name, Mode=OneWay, FallbackValue=없음}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- ── 트리뷰 본체 ── -->
        <TreeView
            x:Name="DeviceTree"
            ItemsSource="{Binding RootNodes}"
            Background="{DynamicResource BgPrimaryBrush}"
            BorderThickness="0"
            Style="{DynamicResource BaseTreeViewStyle}"
            SelectedItemChanged="DeviceTree_SelectedItemChanged"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem"
                       BasedOn="{StaticResource BaseTreeViewItemStyle}">
                    <Setter Property="IsExpanded"
                            Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected"
                            Value="{Binding IsSelected, Mode=TwoWay}"/>

                    <!-- 컨텍스트 메뉴 (각 노드에 동일 적용, CanExecute 로 항목 자동 비활성) -->
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="✏️ 이름 변경"
                                          Command="{Binding BeginEditCommand}"/>
                                <Separator/>
                                <MenuItem Header="📁 하위 그룹 추가"
                                          Command="{Binding DataContext.AddGroupCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <MenuItem Header="📟 장비 추가"
                                          Command="{Binding DataContext.AddDeviceCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <MenuItem Header="⚙️ PLC 추가"
                                          Command="{Binding DataContext.AddPlcCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <MenuItem Header="🏷️ 태그 추가"
                                          Command="{Binding DataContext.AddTagCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <Separator/>
                                <MenuItem Header="▲ 위로 이동"
                                          Command="{Binding DataContext.MoveUpCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <MenuItem Header="▼ 아래로 이동"
                                          Command="{Binding DataContext.MoveDownCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <Separator/>
                                <MenuItem Header="🗑 삭제"
                                          Command="{Binding DataContext.DeleteNodeCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>

                    <!-- 더블클릭 → 인라인 편집 시작 -->
                    <EventSetter Event="MouseDoubleClick"
                                 Handler="TreeViewItem_MouseDoubleClick"/>

                    <!-- 편집 중 키 처리 (Enter=확정, Escape=취소) -->
                    <EventSetter Event="KeyDown"
                                 Handler="TreeViewItem_KeyDown"/>
                </Style>
            </TreeView.ItemContainerStyle>

        </TreeView>

    </DockPanel>
</UserControl>
