<!--
 ══════════════════════════════════════════════════════════
  IIoT.DeviceManager · DeviceTreeView.xaml
  역할: 장비 트리뷰 — Group/Device/PLC/Tag/Sensor 계층 + CRUD 툴바
  생성: 2025-05-22
  수정: 2025-05-22 v1 — XDG0008 수정 (BasedOn StaticResource 제거)
  수정: 2025-05-22 v2 — DeviceTreeView 스타일 키 수정
  수정: 2025-05-23 v3 — vm: → conv:, vm:: → vm:
  수정: 2025-05-23 v4 — ResourceDictionary 구조 수정 (모든 리소스 내부로 이동)
  수정: 2025-05-23 v5 — XLS0509 수정: Style.Triggers 를 Style 내 마지막으로 이동
                         XLS0414 재확인: conv: 접두사 명시적 적용
  수정: 2025-05-23 v6 — 트리 구조 유연화 반영
        ToolTip / ContextMenu 텍스트를 새 동작에 맞게 수정
        · 장비 추가: 선택 없으면 루트에 추가, Device/Plc 하위에도 추가 가능
        · PLC 추가: 선택 없으면 루트에 추가, Device/Plc 하위에도 추가 가능
  수정: 2025-05-23 v7 — 같은 레벨(Sibling) 추가 버튼/메뉴 추가
        툴바: [하위 추가] 그룹 | 장비 | PLC | 태그  ──  [같은레벨] 그룹 | 장비 | PLC
        컨텍스트: 하위에 추가 / 같은 레벨에 추가 분리
  수정: 2025-05-23 v8 — Tag/Sensor 이중 레이어 구조 반영
        · SensorNodeViewModel HierarchicalDataTemplate 추가
        · 툴바: 태그 추가(Plc 선택 시) / 센서 추가(Device 선택 시) 분리
        · ContextMenu: 수집레이어/물리레이어 섹션 구분
        · 레이어 구분 레이블 추가 (수집뷰/물리뷰)
 ══════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="IIoT.DeviceManager.Views.DeviceTree.DeviceTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:IIoT.DeviceManager.ViewModels.DeviceTree"
    xmlns:conv="clr-namespace:IIoT.DeviceManager.Views.DeviceTree"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!--
                ★ 테마 파일(Theme.*.xaml) 은 여기서 로드하지 않음.
                  ThemeManager.Apply() 가 Application.Resources 에 런타임 주입.
                  여기서 하드코딩하면 테마 전환이 무시됨 (UserControl 로컬이 우선).
                  Styles 만 병합 — DynamicResource 는 Application.Resources 에서 탐색.
                -->
                <ResourceDictionary Source="pack://application:,,,/IIoT.UI.Themes;component/Styles/Styles.Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/IIoT.UI.Themes;component/Styles/Styles.TreeView.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter       x:Key="BoolToVisibilityConverter"/>
            <conv:BoolToVisibilityInvertConverter x:Key="BoolToVisibilityInvertConverter"/>
            <conv:NullToVisibilityConverter       x:Key="NullToVisibilityConverter"/>

            <!-- ── 노드 공통 스타일 ── -->
            <Style x:Key="NodeLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
            </Style>

            <Style x:Key="NodeEditBoxStyle" TargetType="TextBox">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,1,4,1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="3,1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccBrush}"/>
            </Style>

            <Style x:Key="NodeBadgeStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="5,1"/>
                <Setter Property="Margin" Value="5,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource AccBrush}"/>
            </Style>

            <!-- Sensor 배지 — GreenBrush (물리 레이어 강조) -->
            <Style x:Key="SensorBadgeStyle" TargetType="Border"
                   BasedOn="{StaticResource NodeBadgeStyle}">
                <Setter Property="Background" Value="{DynamicResource GreenBrush}"/>
            </Style>

            <!-- ── 공통 노드 헤더 (Group/Device/Plc 공유) ── -->
            <DataTemplate x:Key="NodeHeaderTemplate">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconGlyph}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource NodeLabelStyle}"
                               Visibility="{Binding IsEditing,
                                   Converter={StaticResource BoolToVisibilityInvertConverter}}"/>
                    <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource NodeEditBoxStyle}" Width="130"
                             Visibility="{Binding IsEditing,
                                 Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Border Style="{StaticResource NodeBadgeStyle}"
                            Visibility="{Binding Badge,
                                Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding Badge}" FontSize="10"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ═══ Group ═══ -->
            <HierarchicalDataTemplate DataType="{x:Type vm:GroupNodeViewModel}"
                                       ItemsSource="{Binding Children}">
                <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                                  Content="{Binding}"/>
            </HierarchicalDataTemplate>

            <!-- ═══ Device ═══ -->
            <HierarchicalDataTemplate DataType="{x:Type vm:DeviceItemViewModel}"
                                       ItemsSource="{Binding Children}">
                <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                                  Content="{Binding}"/>
            </HierarchicalDataTemplate>

            <!-- ═══ Plc ═══ -->
            <HierarchicalDataTemplate DataType="{x:Type vm:PlcNodeViewModel}"
                                       ItemsSource="{Binding Children}">
                <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                                  Content="{Binding}"/>
            </HierarchicalDataTemplate>

            <!-- ═══ Tag (수집 레이어 리프) ═══ -->
            <DataTemplate DataType="{x:Type vm:TagNodeViewModel}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconGlyph}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource NodeLabelStyle}"
                               Visibility="{Binding IsEditing,
                                   Converter={StaticResource BoolToVisibilityInvertConverter}}"/>
                    <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource NodeEditBoxStyle}" Width="110"
                             Visibility="{Binding IsEditing,
                                 Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <!-- BufType 배지 -->
                    <Border CornerRadius="4" Padding="4,1" Margin="5,0,0,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BufType}" FontSize="9"
                                   Foreground="{DynamicResource Text2Brush}"/>
                    </Border>
                    <!-- 주소 -->
                    <TextBlock Text="{Binding Address, StringFormat='@ {0}'}"
                               FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text3Brush}"/>
                    <!-- 수집 주체 고정 배지 (OwnerDeviceId 지정 시만 표시) -->
                    <Border CornerRadius="4" Padding="4,1" Margin="4,0,0,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource OrangeBrush}"
                            BorderThickness="1" VerticalAlignment="Center"
                            Visibility="{Binding OwnerDeviceId,
                                Converter={StaticResource NullToVisibilityConverter}}"
                            ToolTip="{Binding OwnerLabel}">
                        <TextBlock Text="🔒" FontSize="9"
                                   Foreground="{DynamicResource OrangeBrush}"/>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- ═══ Sensor (물리 레이어 — Tag 자식 허용) ═══
                 ★ HierarchicalDataTemplate 필수:
                   DataTemplate 사용 시 Children 이 트리에 표시되지 않음.
                   Sensor 하위에 Tag 를 추가해도 ItemsSource 가 없어 렌더링 생략됨.
            -->
            <HierarchicalDataTemplate DataType="{x:Type vm:SensorNodeViewModel}"
                                       ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconGlyph}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource NodeLabelStyle}"
                               Visibility="{Binding IsEditing,
                                   Converter={StaticResource BoolToVisibilityInvertConverter}}"/>
                    <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource NodeEditBoxStyle}" Width="110"
                             Visibility="{Binding IsEditing,
                                 Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <!-- 단위 배지 (GreenBrush) -->
                    <Border CornerRadius="4" Padding="4,1" Margin="5,0,0,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource GreenBrush}"
                            BorderThickness="1" VerticalAlignment="Center"
                            Visibility="{Binding Unit,
                                Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding Unit}" FontSize="9"
                                   Foreground="{DynamicResource GreenBrush}"/>
                    </Border>
                    <!-- TagRef 개수 배지 -->
                    <Border CornerRadius="4" Padding="4,1" Margin="3,0,0,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource AccBrush}"
                            BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock FontSize="9" Foreground="{DynamicResource AccBrush}">
                            <Run Text="T×"/>
                            <Run Text="{Binding TagRefs.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </HierarchicalDataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>

        <!-- ══════════════════════════════════════════════════
             상단 툴바
             ──────────────────────────────────────────────────
             [하위] 그룹 | 장비 | PLC
             [수집] 태그     ← Plc 선택 시만 활성
             [물리] 센서     ← Device 선택 시만 활성
             ─ Sep ─
             [동레벨] 그룹= | 장비= | PLC=
             ─ Sep ─ ▲ ▼ ─ Sep ─ 삭제 ─ Sep ─ ⊞ ⊟ ─ 샘플
        ══════════════════════════════════════════════════ -->
        <ToolBar DockPanel.Dock="Top"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="0,0,0,1">

            <!-- ── 하위 추가 레이블 ── -->
            <TextBlock Text="하위"
                       FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource Text3Brush}"
                       VerticalAlignment="Center" Margin="4,0,2,0"/>

            <Button Command="{Binding AddGroupCommand}"
                    ToolTip="하위 그룹 추가"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" FontSize="13"/>
                    <TextBlock Text=" 그룹" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding AddDeviceCommand}"
                    ToolTip="하위 장비 추가"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📟" FontSize="13"/>
                    <TextBlock Text=" 장비" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding AddPlcCommand}"
                    ToolTip="하위 PLC 추가 (수집 레이어)"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙️" FontSize="13"/>
                    <TextBlock Text=" PLC" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <Separator/>

            <!-- ── 수집 레이어 레이블 ── -->
            <TextBlock Text="수집"
                       FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource AccBrush}"
                       VerticalAlignment="Center" Margin="4,0,2,0"/>

            <!-- Tag: Plc 선택 시만 활성 -->
            <Button Command="{Binding AddTagCommand}"
                    ToolTip="태그 추가 [수집 레이어]&#x0a;· Plc 선택 → PLC 레지스터 태그&#x0a;· Device 선택 → 필드 장비 직접 태그 (HART/Profibus 등)"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="13"/>
                    <TextBlock Text=" 태그" FontSize="11" Foreground="{DynamicResource AccBrush}"/>
                </StackPanel>
            </Button>

            <Separator/>

            <!-- ── 물리 레이어 레이블 ── -->
            <TextBlock Text="물리"
                       FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource GreenBrush}"
                       VerticalAlignment="Center" Margin="4,0,2,0"/>

            <!-- Sensor: Device 선택 시만 활성 -->
            <Button Command="{Binding AddSensorCommand}"
                    ToolTip="센서 추가 [물리 레이어]&#x0a;실 물리 센서 표현 — Device 선택 시만 활성"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🌡️" FontSize="13"/>
                    <TextBlock Text=" 센서" FontSize="11" Foreground="{DynamicResource GreenBrush}"/>
                </StackPanel>
            </Button>

            <Separator/>

            <!-- ── 동레벨 추가 레이블 ── -->
            <TextBlock Text="동레벨"
                       FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource Acc2Brush}"
                       VerticalAlignment="Center" Margin="4,0,2,0"/>

            <Button Command="{Binding AddSiblingGroupCommand}"
                    ToolTip="같은 레벨에 그룹 추가"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" FontSize="13"/>
                    <TextBlock Text="=" FontSize="9" Foreground="{DynamicResource Acc2Brush}"
                               VerticalAlignment="Bottom" Margin="1,0,0,2"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding AddSiblingDeviceCommand}"
                    ToolTip="같은 레벨에 장비 추가"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📟" FontSize="13"/>
                    <TextBlock Text="=" FontSize="9" Foreground="{DynamicResource Acc2Brush}"
                               VerticalAlignment="Bottom" Margin="1,0,0,2"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding AddSiblingPlcCommand}"
                    ToolTip="같은 레벨에 PLC 추가"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙️" FontSize="13"/>
                    <TextBlock Text="=" FontSize="9" Foreground="{DynamicResource Acc2Brush}"
                               VerticalAlignment="Bottom" Margin="1,0,0,2"/>
                </StackPanel>
            </Button>

            <Separator/>

            <Button Command="{Binding MoveUpCommand}"
                    ToolTip="위로 이동" Style="{DynamicResource GhostBtn}" Padding="5,3">
                <TextBlock Text="▲" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Button Command="{Binding MoveDownCommand}"
                    ToolTip="아래로 이동" Style="{DynamicResource GhostBtn}" Padding="5,3">
                <TextBlock Text="▼" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Separator/>

            <Button Command="{Binding DeleteNodeCommand}"
                    ToolTip="선택 노드 삭제 (하위 전체 포함)"
                    Style="{DynamicResource SecondaryBtn}" Padding="5,3"
                    Foreground="{DynamicResource RedBrush}"
                    BorderBrush="{DynamicResource RedBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" FontSize="13"/>
                    <TextBlock Text=" 삭제" FontSize="11" Foreground="{DynamicResource RedBrush}"/>
                </StackPanel>
            </Button>

            <Separator/>

            <Button Command="{Binding ExpandAllCommand}"
                    ToolTip="전체 펼치기" Style="{DynamicResource GhostBtn}" Padding="5,3">
                <TextBlock Text="⊞" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Button Command="{Binding CollapseAllCommand}"
                    ToolTip="전체 접기" Style="{DynamicResource GhostBtn}" Padding="5,3">
                <TextBlock Text="⊟" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Separator/>

            <Button Command="{Binding LoadSampleCommand}"
                    ToolTip="샘플 데이터 로드 (이중 레이어 구조)"
                    Style="{DynamicResource GhostBtn}" Padding="5,3">
                <TextBlock Text="↺ 샘플" FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"/>
            </Button>

        </ToolBar>

        <!-- ── 하단 상태바 ── -->
        <StatusBar DockPanel.Dock="Bottom" Height="22"
                   Background="{DynamicResource SurfaceBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock FontSize="11" Foreground="{DynamicResource Text2Brush}">
                    <Run Text="전체:"/>
                    <Run Text="{Binding TotalNodeCount, Mode=OneWay}"/>
                    <Run Text="개"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock FontSize="11" Foreground="{DynamicResource Text2Brush}">
                    <Run Text="선택:"/>
                    <Run Text="{Binding SelectedNode.Name, Mode=OneWay, FallbackValue=없음}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- ── 트리뷰 본체 ── -->
        <TreeView
            x:Name="DeviceTree"
            ItemsSource="{Binding RootNodes}"
            Background="{DynamicResource BgBrush}"
            BorderThickness="0"
            Style="{DynamicResource DeviceTreeView}"
            SelectedItemChanged="DeviceTree_SelectedItemChanged"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">

                    <Setter Property="IsExpanded"  Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <!--
                    IsSelected: OneWayToSource 만 사용
                    TreeView → VM 방향만 허용. VM에서 TreeView로 역주입 시
                    부모 노드 IsSelected가 함께 활성화되는 버그 발생.
                    선택 동기화는 SelectedItemChanged 이벤트가 단독 담당.
                    -->
                    <Setter Property="IsSelected"  Value="{Binding IsSelected, Mode=OneWayToSource}"/>
                    <Setter Property="Padding"      Value="2,3"/>
                    <Setter Property="MinHeight"    Value="26"/>
                    <Setter Property="Foreground"   Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Background"   Value="Transparent"/>

                    <!-- Tag 패턴: TreeViewItem.Tag = DeviceTreeViewModel (ContextMenu 바인딩용) -->
                    <Setter Property="Tag" Value="{Binding DataContext, ElementName=DeviceTree}"/>

                    <!--
                    ★ ContextMenu 커맨드 바인딩 핵심 패턴 (v7 Fix)
                    ══════════════════════════════════════════════
                    문제: ContextMenu는 Visual Tree 밖 별도 Popup으로 생성됨
                         → RelativeSource AncestorType=TreeView 로 TreeView 탐색 불가 → null
                    해결: TreeViewItem.Tag 에 DeviceTreeViewModel을 바인딩 (ElementName 사용)
                         ContextMenu.PlacementTarget = TreeViewItem (WPF 자동 설정)
                         → PlacementTarget.Tag = DeviceTreeViewModel 항상 접근 가능
                    ──────────────────────────────────────────────
                    노드 자체 커맨드 (BeginEditCommand):
                      DataContext = PlacementTarget.DataContext = 해당 NodeViewModel
                      → {Binding BeginEditCommand} 그대로 사용
                    트리 전체 커맨드 (Add*/Delete/Move*):
                      → {Binding PlacementTarget.Tag.커맨드명,
                             RelativeSource={RelativeSource AncestorType=ContextMenu}}
                    ══════════════════════════════════════════════
                    컨텍스트 메뉴 구조:
                      ✏️ 이름 변경
                      ─────────────────────────────────────────
                      ↓ 하위에 추가
                        📁 하위 그룹 / 📟 하위 장비 / ⚙️ 하위 PLC
                        ─────────────────────────────────────────
                        [수집 레이어]
                        📋 태그 (Plc 하위에만)
                        [물리 레이어]
                        🌡️ 센서 (Device 하위에만)
                      ─────────────────────────────────────────
                      ↔ 같은 레벨에 추가
                        📁= / 📟= / ⚙️=
                      ─────────────────────────────────────────
                      ▲ 위로 이동 / ▼ 아래로 이동
                      ─────────────────────────────────────────
                      🗑 삭제
                    ══════════════════════════════════════════════
                    -->
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                             RelativeSource={RelativeSource Self}}">

                                <MenuItem Header="✏️  이름 변경"
                                          Command="{Binding BeginEditCommand}"/>

                                <Separator/>

                                <!-- 하위에 추가 -->
                                <MenuItem Header="↓  하위에 추가">
                                    <MenuItem Header="📁  하위 그룹"
                                              Command="{Binding PlacementTarget.Tag.AddGroupCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="📟  하위 장비"
                                              Command="{Binding PlacementTarget.Tag.AddDeviceCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="⚙️  하위 PLC"
                                              Command="{Binding PlacementTarget.Tag.AddPlcCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="── [수집 레이어] ──" IsEnabled="False"/>
                                    <MenuItem Header="📋  태그 (Plc/Device 선택 시 활성)"
                                              Command="{Binding PlacementTarget.Tag.AddTagCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="── [물리 레이어] ──" IsEnabled="False"/>
                                    <MenuItem Header="🌡️  센서 (Device 선택 시 활성)"
                                              Command="{Binding PlacementTarget.Tag.AddSensorCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </MenuItem>

                                <!-- 같은 레벨에 추가 -->
                                <MenuItem Header="↔  같은 레벨에 추가">
                                    <MenuItem Header="📁  같은 레벨 그룹"
                                              Command="{Binding PlacementTarget.Tag.AddSiblingGroupCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="📟  같은 레벨 장비"
                                              Command="{Binding PlacementTarget.Tag.AddSiblingDeviceCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="⚙️  같은 레벨 PLC"
                                              Command="{Binding PlacementTarget.Tag.AddSiblingPlcCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </MenuItem>

                                <Separator/>

                                <MenuItem Header="▲  위로 이동"
                                          Command="{Binding PlacementTarget.Tag.MoveUpCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="▼  아래로 이동"
                                          Command="{Binding PlacementTarget.Tag.MoveDownCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                <Separator/>

                                <MenuItem Header="🗑  삭제"
                                          Command="{Binding PlacementTarget.Tag.DeleteNodeCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                            </ContextMenu>
                        </Setter.Value>
                    </Setter>

                    <EventSetter Event="MouseDoubleClick"
                                 Handler="TreeViewItem_MouseDoubleClick"/>
                    <EventSetter Event="KeyDown"
                                 Handler="TreeViewItem_KeyDown"/>

                    <!-- ★ Style.Triggers — 항상 마지막 -->
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected"        Value="True"/>
                                <Condition Property="IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource Border2Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </MultiTrigger>
                    </Style.Triggers>

                </Style>
            </TreeView.ItemContainerStyle>

        </TreeView>

    </DockPanel>
</UserControl>
