<!--
 ══════════════════════════════════════════════════════════
  IIoT.DeviceManager · DeviceTreeView.xaml
  역할: 장비 트리 뷰 — Group/Device/PLC/Tag 계층 표시 + CRUD 툴바
  생성: 2025-05-22
  수정: 2025-05-22 v1 — XDG0008 수정
        ① BasedOn="{StaticResource BaseTreeViewItemStyle}" 제거
        ② 잘못된 리소스 키 전면 교체
  수정: 2025-05-22 v2 — 런타임 오류 수정
        ③ Style="{DynamicResource BaseTreeViewStyle}"
           → Style="{DynamicResource DeviceTreeView}"  (올바른 키)
 ══════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="IIoT.DeviceManager.Views.DeviceTree.DeviceTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:IIoT.DeviceManager.ViewModels.DeviceTree"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="280"
    d:DataContext="{d:DesignInstance vm:DeviceTreeViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>

        <!--
        ★ 올바른 리소스 키 (IIoT.UI.Themes README 기준)
        ════════════════════════════════════════════
        TextBrush     주 텍스트
        Text2Brush    보조 텍스트
        Text3Brush    흐린 텍스트
        AccBrush      주 액센트
        BgBrush       페이지 배경
        SurfaceBrush  패널/사이드바
        CardBrush     카드/컨텐츠 박스
        BorderBrush   구분선(연함)
        Border2Brush  구분선(강함)
        RedBrush      위험/오류
        GhostBtn      툴바 아이콘 버튼
        SecondaryBtn  보조 액션 버튼
        DeviceTreeView  TreeView 스타일 키 (Styles.TreeView.xaml 정의)
        ★ StaticResource 절대 금지 — DynamicResource 전용
        ════════════════════════════════════════════
        -->

        <!-- ── 노드 이름 텍스트 스타일 ── -->
        <Style x:Key="NodeLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <!-- ── 인라인 편집 TextBox 스타일 ── -->
        <Style x:Key="NodeEditBoxStyle" TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,1,4,1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccBrush}"/>
        </Style>

        <!-- ── 배지 Border 스타일 ── -->
        <Style x:Key="NodeBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource AccBrush}"/>
        </Style>

        <!-- ── 노드 공통 헤더 Template (Group · Device · PLC 공유) ── -->
        <DataTemplate x:Key="NodeHeaderTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 아이콘 -->
                <TextBlock Text="{Binding IconGlyph}"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <!-- 이름 — 일반 모드 -->
                <TextBlock Text="{Binding Name}"
                           Style="{StaticResource NodeLabelStyle}"
                           Visibility="{Binding IsEditing,
                               Converter={StaticResource BoolToVisibilityInvertConverter}}"/>

                <!-- 이름 — 편집 모드 -->
                <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource NodeEditBoxStyle}"
                         Width="130"
                         Visibility="{Binding IsEditing,
                             Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- 배지 (null 이면 숨김) -->
                <Border Style="{StaticResource NodeBadgeStyle}"
                        Visibility="{Binding Badge,
                            Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding Badge}"
                               FontSize="10"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>

            </StackPanel>
        </DataTemplate>

        <!-- ═══ Group ═══ -->
        <HierarchicalDataTemplate DataType="{x:Type vm:GroupNodeViewModel}"
                                   ItemsSource="{Binding Children}">
            <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                              Content="{Binding}"/>
        </HierarchicalDataTemplate>

        <!-- ═══ Device ═══ -->
        <HierarchicalDataTemplate DataType="{x:Type vm:DeviceItemViewModel}"
                                   ItemsSource="{Binding Children}">
            <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                              Content="{Binding}"/>
        </HierarchicalDataTemplate>

        <!-- ═══ PLC ═══ -->
        <HierarchicalDataTemplate DataType="{x:Type vm:PlcNodeViewModel}"
                                   ItemsSource="{Binding Children}">
            <ContentPresenter ContentTemplate="{StaticResource NodeHeaderTemplate}"
                              Content="{Binding}"/>
        </HierarchicalDataTemplate>

        <!-- ═══ Tag (리프 노드) ═══ -->
        <DataTemplate DataType="{x:Type vm:TagNodeViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="{Binding IconGlyph}"
                           FontSize="13"
                           VerticalAlignment="Center"/>

                <!-- 이름 — 일반 모드 -->
                <TextBlock Text="{Binding Name}"
                           Style="{StaticResource NodeLabelStyle}"
                           Visibility="{Binding IsEditing,
                               Converter={StaticResource BoolToVisibilityInvertConverter}}"/>

                <!-- 이름 — 편집 모드 -->
                <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource NodeEditBoxStyle}"
                         Width="120"
                         Visibility="{Binding IsEditing,
                             Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- BufType 배지 (회색) -->
                <Border CornerRadius="4"
                        Padding="4,1"
                        Margin="5,0,0,0"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding BufType}"
                               FontSize="9"
                               Foreground="{DynamicResource Text2Brush}"/>
                </Border>

                <!-- 주소 -->
                <TextBlock Text="{Binding Address, StringFormat='@ {0}'}"
                           FontSize="10"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Text3Brush}"/>

            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <DockPanel>

        <!-- ── 상단 툴바 ── -->
        <ToolBar DockPanel.Dock="Top"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="0,0,0,1">

            <!-- 그룹 추가 -->
            <Button Command="{Binding AddGroupCommand}"
                    ToolTip="그룹 추가"
                    Style="{DynamicResource GhostBtn}"
                    Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" FontSize="13"/>
                    <TextBlock Text=" 그룹" FontSize="12"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <!-- 장비 추가 -->
            <Button Command="{Binding AddDeviceCommand}"
                    ToolTip="장비 추가 (그룹 선택 필요)"
                    Style="{DynamicResource GhostBtn}"
                    Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📟" FontSize="13"/>
                    <TextBlock Text=" 장비" FontSize="12"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <!-- PLC 추가 -->
            <Button Command="{Binding AddPlcCommand}"
                    ToolTip="PLC 추가 (장비 선택 필요)"
                    Style="{DynamicResource GhostBtn}"
                    Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙️" FontSize="13"/>
                    <TextBlock Text=" PLC" FontSize="12"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <!-- 태그 추가 -->
            <Button Command="{Binding AddTagCommand}"
                    ToolTip="태그 추가 (장비 또는 PLC 선택 필요)"
                    Style="{DynamicResource GhostBtn}"
                    Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏷️" FontSize="13"/>
                    <TextBlock Text=" 태그" FontSize="12"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>

            <Separator/>

            <!-- 위로 이동 -->
            <Button Command="{Binding MoveUpCommand}"
                    ToolTip="위로 이동"
                    Style="{DynamicResource GhostBtn}"
                    Padding="6,3">
                <TextBlock Text="▲" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <!-- 아래로 이동 -->
            <Button Command="{Binding MoveDownCommand}"
                    ToolTip="아래로 이동"
                    Style="{DynamicResource GhostBtn}"
                    Padding="6,3">
                <TextBlock Text="▼" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Separator/>

            <!-- 삭제 — SecondaryBtn + RedBrush 오버라이드 -->
            <Button Command="{Binding DeleteNodeCommand}"
                    ToolTip="선택 노드 삭제"
                    Style="{DynamicResource SecondaryBtn}"
                    Padding="6,3"
                    Foreground="{DynamicResource RedBrush}"
                    BorderBrush="{DynamicResource RedBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" FontSize="13"/>
                    <TextBlock Text=" 삭제" FontSize="12"
                               Foreground="{DynamicResource RedBrush}"/>
                </StackPanel>
            </Button>

            <Separator/>

            <!-- 전체 펼치기 -->
            <Button Command="{Binding ExpandAllCommand}"
                    ToolTip="전체 펼치기"
                    Style="{DynamicResource GhostBtn}"
                    Padding="6,3">
                <TextBlock Text="⊞" FontSize="13"
                           Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <!-- 전체 접기 -->
            <Button Command="{Binding CollapseAllCommand}"
                    ToolTip="전체 접기"
                    Style="{DynamicResource GhostBtn}"
                    Padding="6,3">
                <TextBlock Text="⊟" FontSize="13"
                           Foreground="{DynamicResource TextBrush}"/>
            </Button>

            <Separator/>

            <!-- 샘플 로드 (개발용) -->
            <Button Command="{Binding LoadSampleCommand}"
                    ToolTip="샘플 데이터 로드 (개발용)"
                    Style="{DynamicResource GhostBtn}"
                    Padding="6,3">
                <TextBlock Text="↺ 샘플" FontSize="12"
                           Foreground="{DynamicResource Text2Brush}"/>
            </Button>

        </ToolBar>

        <!-- ── 하단 상태바 ── -->
        <StatusBar DockPanel.Dock="Bottom"
                   Height="22"
                   Background="{DynamicResource SurfaceBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock FontSize="11" Foreground="{DynamicResource Text2Brush}">
                    <Run Text="전체:"/>
                    <Run Text="{Binding TotalNodeCount, Mode=OneWay}"/>
                    <Run Text="개"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock FontSize="11" Foreground="{DynamicResource Text2Brush}">
                    <Run Text="선택:"/>
                    <Run Text="{Binding SelectedNode.Name, Mode=OneWay, FallbackValue=없음}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- ── 트리뷰 본체 ── -->
        <!-- ★ v2 수정: BaseTreeViewStyle → DeviceTreeView (Styles.TreeView.xaml 에 정의된 올바른 키) -->
        <TreeView
            x:Name="DeviceTree"
            ItemsSource="{Binding RootNodes}"
            Background="{DynamicResource BgBrush}"
            BorderThickness="0"
            Style="{DynamicResource DeviceTreeView}"
            SelectedItemChanged="DeviceTree_SelectedItemChanged"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <TreeView.ItemContainerStyle>
                <!--
                ★ XDG0008 수정 (v1):
                   BasedOn="{StaticResource BaseTreeViewItemStyle}" 제거
                   이유: 테마는 런타임에 ThemeManager.Apply()로 로드되므로
                         디자인타임에는 StaticResource로 찾을 수 없음
                   대신: 필요한 Setter를 직접 정의
                -->
                <Style TargetType="TreeViewItem">

                    <!-- IsExpanded / IsSelected 양방향 바인딩 -->
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>

                    <!-- 기본 스타일 직접 정의 -->
                    <Setter Property="Padding" Value="2,3"/>
                    <Setter Property="MinHeight" Value="26"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>

                    <!-- 선택 시 하이라이트 -->
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource Border2Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </MultiTrigger>
                    </Style.Triggers>

                    <!-- 컨텍스트 메뉴 -->
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="✏️ 이름 변경"
                                          Command="{Binding BeginEditCommand}"/>
                                <Separator/>
                                <MenuItem Header="📁 하위 그룹 추가"
                                          Command="{Binding DataContext.AddGroupCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <MenuItem Header="📟 장비 추가"
                                          Command="{Binding DataContext.AddDeviceCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <MenuItem Header="⚙️ PLC 추가"
                                          Command="{Binding DataContext.AddPlcCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <MenuItem Header="🏷️ 태그 추가"
                                          Command="{Binding DataContext.AddTagCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <Separator/>
                                <MenuItem Header="▲ 위로 이동"
                                          Command="{Binding DataContext.MoveUpCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <MenuItem Header="▼ 아래로 이동"
                                          Command="{Binding DataContext.MoveDownCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                <Separator/>
                                <MenuItem Header="🗑 삭제"
                                          Command="{Binding DataContext.DeleteNodeCommand,
                                              RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>

                    <!-- 더블클릭 → 인라인 편집 시작 -->
                    <EventSetter Event="MouseDoubleClick"
                                 Handler="TreeViewItem_MouseDoubleClick"/>

                    <!-- Enter = 확정 / Escape = 취소 -->
                    <EventSetter Event="KeyDown"
                                 Handler="TreeViewItem_KeyDown"/>

                </Style>
            </TreeView.ItemContainerStyle>

        </TreeView>

    </DockPanel>
</UserControl>
