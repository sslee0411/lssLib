<!--
 ══════════════════════════════════════════════════════════
  IIoT.DeviceManager · Views/Library/CommLibraryView.xaml
  역할: 통신 설정 라이브러리 편집 패널
  Phase 4-3
 ══════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="IIoT.DeviceManager.Views.Library.CommLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:conv="clr-namespace:IIoT.DeviceManager.Views.DeviceTree"
    mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter       x:Key="BoolToVisibilityConverter"/>
        <conv:BoolToVisibilityInvertConverter x:Key="BoolToVisibilityInvertConverter"/>
        <conv:NullToVisibilityConverter       x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>   <!-- DataGrid -->
            <RowDefinition Height="*"/>     <!-- 상세 편집 -->
            <RowDefinition Height="Auto"/>  <!-- 상태바 -->
        </Grid.RowDefinitions>

        <!-- ── 헤더 + 툴바 ── -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="통신 설정 라이브러리"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="프로토콜별 연결 설정 관리 (comm-library.json)"
                           FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Command="{Binding AddCommand}"
                        Style="{DynamicResource GhostBtn}"
                        Content="＋ 추가" Padding="12,5" FontSize="12" Margin="0,0,6,0"/>
                <Button Command="{Binding DeleteCommand}"
                        Style="{DynamicResource SecondaryBtn}"
                        Content="🗑 삭제" Padding="12,5" FontSize="12" Margin="0,0,6,0"
                        Foreground="{DynamicResource RedBrush}"/>
                <Button Command="{Binding TestConnectionCommand}"
                        Style="{DynamicResource SecondaryBtn}"
                        Content="🔌 연결 테스트" Padding="12,5" FontSize="12" Margin="0,0,6,0"/>
                <Button Command="{Binding SaveCommand}"
                        Style="{DynamicResource PrimaryBtn}"
                        Content="💾 저장" Padding="16,5" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- ── DataGrid (목록) ── -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  SelectionMode="Single" IsReadOnly="True"
                  Background="{DynamicResource SurfaceBrush}"
                  RowBackground="{DynamicResource BgBrush}"
                  AlternatingRowBackground="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  RowHeight="32" FontSize="12"
                  Foreground="{DynamicResource TextBrush}">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="이름"      Binding="{Binding Name}"          Width="150"/>
                <DataGridTextColumn Header="프로토콜"  Binding="{Binding ProtocolLabel}"  Width="100"/>
                <DataGridTextColumn Header="주소/포트" Binding="{Binding IpAddress}"      Width="130"/>
                <DataGridTextColumn Header="포트"      Binding="{Binding Port}"           Width="60"/>
                <DataGridTextColumn Header="COM"       Binding="{Binding PortName}"       Width="70"/>
                <DataGridTextColumn Header="Poll(ms)"  Binding="{Binding PollMs}"         Width="70"/>
                <DataGridTextColumn Header="설명"      Binding="{Binding Description}"    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── 선택 항목 상세 편집 ── -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Visibility="{Binding HasSelection,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedItem}">

                    <!-- 기본 정보 카드 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="기본 정보" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="이름" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource ModernTextBox}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="프로토콜" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.ProtocolList,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Protocol}"
                                              Style="{DynamicResource ModernComboBox}"
                                              Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="설명" FontSize="11" Foreground="{DynamicResource Text2Brush}" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- TCP/IP 카드 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="14" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTcp}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="TCP/IP 설정" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccBrush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="IP 주소" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource ModernTextBox}"
                                             FontFamily="{DynamicResource MonoFont}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="포트" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource ModernTextBox}"
                                             FontFamily="{DynamicResource MonoFont}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Slave ID" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <TextBox Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource ModernTextBox}"
                                             FontFamily="{DynamicResource MonoFont}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 시리얼 카드 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="14" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSerial}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="시리얼 설정" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccBrush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="COM 포트" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource ModernTextBox}"
                                             FontFamily="{DynamicResource MonoFont}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="보드레이트" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.BaudRateList,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding BaudRate}"
                                              Style="{DynamicResource ModernComboBox}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="패리티" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.ParityList,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Parity}"
                                              Style="{DynamicResource ModernComboBox}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="스톱비트" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.StopBitsList,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding StopBits}"
                                              Style="{DynamicResource ModernComboBox}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- OPC-UA 카드 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="14" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpcUa}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="OPC-UA 설정" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="엔드포인트 URL" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                            <TextBox Text="{Binding OpcEndpointUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}"
                                     FontFamily="{DynamicResource MonoFont}" Margin="0,4,0,8"/>
                            <TextBlock Text="보안 정책" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                            <TextBox Text="{Binding OpcSecurityPolicy, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 수집 공통 카드 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="수집 공통 설정" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="타임아웃 (ms)" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource ModernTextBox}"
                                             FontFamily="{DynamicResource MonoFont}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="재시도 횟수" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource ModernTextBox}"
                                             FontFamily="{DynamicResource MonoFont}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="폴링 주기 (ms)" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                    <TextBox Text="{Binding PollMs, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource ModernTextBox}"
                                             FontFamily="{DynamicResource MonoFont}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── 상태바 ── -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="8,4" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                <TextBlock Grid.Column="1" FontSize="11"
                           Foreground="{DynamicResource YellowBrush}" Margin="0,0,4,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Text" Value="● 미저장 변경사항"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
