<!--
 ══════════════════════════════════════════════════════════
  IIoT.DeviceManager · Views/Library/ScaleLibraryView.xaml
  역할: 스케일 라이브러리 편집 패널
  Phase 4-1
 ══════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="IIoT.DeviceManager.Views.Library.ScaleLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:conv="clr-namespace:IIoT.DeviceManager.Views.DeviceTree"
    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter       x:Key="BoolToVisibilityConverter"/>
        <conv:BoolToVisibilityInvertConverter x:Key="BoolToVisibilityInvertConverter"/>
        <conv:NullToVisibilityConverter       x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 헤더 + 툴바 -->
            <RowDefinition Height="*"/>     <!-- DataGrid -->
            <RowDefinition Height="Auto"/>  <!-- 미리보기 -->
            <RowDefinition Height="Auto"/>  <!-- 상태바 -->
        </Grid.RowDefinitions>

        <!-- ── 헤더 + 툴바 ── -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="스케일 라이브러리"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Raw → 공학 단위 선형 변환 설정 (scale-library.json)"
                           FontSize="11" Foreground="{DynamicResource Text3Brush}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Command="{Binding AddCommand}"
                        Style="{DynamicResource GhostBtn}"
                        Content="＋ 추가" Padding="12,5" FontSize="12" Margin="0,0,6,0"/>
                <Button Command="{Binding DeleteCommand}"
                        Style="{DynamicResource SecondaryBtn}"
                        Content="🗑 삭제" Padding="12,5" FontSize="12" Margin="0,0,6,0"
                        Foreground="{DynamicResource RedBrush}"/>
                <Button Command="{Binding SaveCommand}"
                        Style="{DynamicResource PrimaryBtn}"
                        Content="💾 저장" Padding="16,5" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- ── DataGrid ── -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  Background="{DynamicResource SurfaceBrush}"
                  RowBackground="{DynamicResource BgBrush}"
                  AlternatingRowBackground="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  RowHeight="32"
                  FontSize="12"
                  Foreground="{DynamicResource TextBrush}">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="이름" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="160" MinWidth="100"/>
                <DataGridTextColumn Header="Raw 최솟값" Binding="{Binding RawMin, UpdateSourceTrigger=PropertyChanged}"
                                    Width="90" ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                <DataGridTextColumn Header="Raw 최댓값" Binding="{Binding RawMax, UpdateSourceTrigger=PropertyChanged}"
                                    Width="90"/>
                <DataGridTextColumn Header="공학 최솟값" Binding="{Binding EngMin, UpdateSourceTrigger=PropertyChanged}"
                                    Width="90"/>
                <DataGridTextColumn Header="공학 최댓값" Binding="{Binding EngMax, UpdateSourceTrigger=PropertyChanged}"
                                    Width="90"/>
                <DataGridTextColumn Header="단위" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                    Width="70"/>
                <!-- 검증 상태 -->
                <DataGridTemplateColumn Header="상태" Width="*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ValidationMessage}"
                                       FontSize="11"
                                       Foreground="{DynamicResource YellowBrush}"
                                       VerticalAlignment="Center" Margin="6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── 미리보기 카드 ── -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource AccBrush}"
                BorderThickness="1" CornerRadius="6"
                Padding="14,10" Margin="0,10,0,0"
                Visibility="{Binding HasSelection,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="🔢 변환 미리보기  Raw ="
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text2Brush}" Margin="0,0,8,0"/>

                <Slider Grid.Column="1"
                        Minimum="{Binding SelectedItem.RawMin}"
                        Maximum="{Binding SelectedItem.RawMax}"
                        Value="{Binding PreviewRawValue}"
                        VerticalAlignment="Center"
                        TickFrequency="1" IsSnapToTickEnabled="False"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding PreviewRawValue, StringFormat='{}{0:F2}'}"
                           FontSize="12" FontFamily="{DynamicResource MonoFont}"
                           VerticalAlignment="Center" Margin="10,0"
                           Foreground="{DynamicResource TextBrush}" Width="60"/>

                <Border Grid.Column="3"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="4" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="→ " FontSize="13"
                                   Foreground="{DynamicResource AccBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PreviewEngValue}"
                                   FontSize="13" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource MonoFont}"
                                   Foreground="{DynamicResource GreenBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ── 상태바 ── -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="8,4" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                <TextBlock Grid.Column="1"
                           FontSize="11" Foreground="{DynamicResource YellowBrush}"
                           Margin="0,0,4,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Text" Value="● 미저장 변경사항"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
