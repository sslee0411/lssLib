<!--
 ══════════════════════════════════════════════════════════
  IIoT.DeviceManager · Views/Editors/PlcEditorView.xaml
  역할: PLC 노드 통신 설정 편집 패널
  Phase 3
 ══════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="IIoT.DeviceManager.Views.Editors.PlcEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="640">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 헤더 -->
            <RowDefinition Height="*"/>     <!-- 폼 -->
            <RowDefinition Height="Auto"/>  <!-- 버튼 -->
        </Grid.RowDefinitions>

        <!-- ── 헤더 ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding TargetLabel}"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="PLC 통신 설정 편집 — 수집 레이어"
                       FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ── 폼 ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 기본 정보 카드 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="기본 정보" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <TextBlock Text="이름" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}" Margin="0,4,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="슬롯 번호" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBox Text="{Binding SlotNo, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         FontFamily="{DynamicResource MonoFont}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unit ID (Slave ID)" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBox Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         FontFamily="{DynamicResource MonoFont}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 프로토콜 선택 카드 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource AccBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="프로토콜" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="통신 프로토콜" FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"/>
                        <ComboBox ItemsSource="{Binding ProtocolList}"
                                  SelectedItem="{Binding Protocol}"
                                  Style="{DynamicResource ModernComboBox}"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TCP/IP 설정 카드 (Modbus TCP / TcpIp 선택 시) -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTcp}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="TCP/IP 설정" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <TextBlock Text="IP 주소" FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"/>
                        <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}"
                                 FontFamily="{DynamicResource MonoFont}"
                                 Margin="0,4,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="포트" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         FontFamily="{DynamicResource MonoFont}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Slave ID" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBox Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         FontFamily="{DynamicResource MonoFont}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 시리얼 설정 카드 (Modbus RTU / ASCII / Serial 선택 시) -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSerial}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="시리얼 설정" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <TextBlock Text="COM 포트" FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"/>
                        <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}"
                                 FontFamily="{DynamicResource MonoFont}"
                                 Margin="0,4,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="보드레이트" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <ComboBox ItemsSource="{Binding BaudRateList}"
                                          SelectedItem="{Binding BaudRate}"
                                          Style="{DynamicResource ModernComboBox}"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="패리티" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <ComboBox ItemsSource="{Binding ParityList}"
                                          SelectedItem="{Binding Parity}"
                                          Style="{DynamicResource ModernComboBox}"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OPC-UA 설정 카드 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpcUa}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="OPC-UA 설정" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <TextBlock Text="엔드포인트 URL" FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"/>
                        <TextBox Text="{Binding OpcEndpointUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}"
                                 FontFamily="{DynamicResource MonoFont}"
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 수집 공통 설정 카드 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="수집 공통 설정" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="타임아웃 (ms)" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         FontFamily="{DynamicResource MonoFont}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="재시도 횟수" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         FontFamily="{DynamicResource MonoFont}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="폴링 주기 (ms)" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBox Text="{Binding PollMs, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         FontFamily="{DynamicResource MonoFont}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── 버튼 ── -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Command="{Binding ApplyCommand}"
                    Style="{DynamicResource PrimaryBtn}"
                    Content="✔  적용" Height="34"/>
            <Button Grid.Column="2"
                    Command="{Binding ResetCommand}"
                    Style="{DynamicResource SecondaryBtn}"
                    Content="↺  되돌리기" Height="34" Padding="14,0"/>
        </Grid>

    </Grid>
</UserControl>
