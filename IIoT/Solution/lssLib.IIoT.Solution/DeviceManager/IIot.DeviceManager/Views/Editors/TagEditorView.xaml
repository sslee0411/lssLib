<!--
 ══════════════════════════════════════════════════════════
  IIoT.DeviceManager · Views/Editors/TagEditorView.xaml
  역할: Tag 노드 속성 편집 패널
  Phase 3
 ══════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="IIoT.DeviceManager.Views.Editors.TagEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="600">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 헤더 ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding TargetLabel}"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccBrush}"/>
            <TextBlock Text="Tag 속성 편집 — 수집 레이어"
                       FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ── 폼 ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 주소 카드 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="수집 주소" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <TextBlock Text="이름" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}" Margin="0,4,0,10"/>

                        <TextBlock Text="레지스터 주소" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}"
                                 FontFamily="{DynamicResource MonoFont}"
                                 Margin="0,4,0,4"/>
                        <TextBlock Text="예: 40001 (Modbus)  MW100 (Siemens)  ns=2;i=3 (OPC-UA)"
                                   FontSize="10" Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <TextBlock Text="데이터 타입 (BufType)" FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"/>
                        <ComboBox ItemsSource="{Binding BufTypeList}"
                                  SelectedItem="{Binding BufType}"
                                  Style="{DynamicResource ModernComboBox}"
                                  FontFamily="{DynamicResource MonoFont}"
                                  Margin="0,4,0,4"/>
                        <TextBlock Text="{Binding BufTypeDescription}"
                                   FontSize="10" Foreground="{DynamicResource Text3Brush}"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="폴링 주기 (ms)" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBox Text="{Binding PollMs, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         FontFamily="{DynamicResource MonoFont}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DeadBand (원시값)" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBox Text="{Binding DeadBand, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}"
                                         FontFamily="{DynamicResource MonoFont}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 수집 주체 카드 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="수집 주체 (OwnerDevice)" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <!-- 모드 표시 배지 -->
                        <Border CornerRadius="4" Padding="8,4" Margin="0,0,0,10"
                                HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOwnerFixed}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource OrangeBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding OwnerModeText}" FontSize="11"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </Border>

                        <TextBlock Text="수집 주체 NodeId (비워두면 자동 탐색)" FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"/>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding OwnerDeviceId, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     Style="{DynamicResource ModernTextBox}"
                                     FontFamily="{DynamicResource MonoFont}"/>
                            <Button Grid.Column="2"
                                    Command="{Binding ClearOwnerCommand}"
                                    Style="{DynamicResource SecondaryBtn}"
                                    Content="초기화" Padding="10,0" Height="30"/>
                        </Grid>

                        <!-- 자동 탐색 결과 -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="4" Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="탐색 결과: " FontSize="11"
                                           Foreground="{DynamicResource Text3Brush}"/>
                                <TextBlock Text="{Binding ResolvedOwnerName}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource GreenBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── 버튼 ── -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Command="{Binding ApplyCommand}"
                    Style="{DynamicResource PrimaryBtn}"
                    Content="✔  적용" Height="34"/>
            <Button Grid.Column="2"
                    Command="{Binding ResetCommand}"
                    Style="{DynamicResource SecondaryBtn}"
                    Content="↺  되돌리기" Height="34" Padding="14,0"/>
        </Grid>
    </Grid>
</UserControl>
