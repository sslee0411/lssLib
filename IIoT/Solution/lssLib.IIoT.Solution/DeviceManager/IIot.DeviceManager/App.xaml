<Application x:Class="IIoT.DeviceManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ★ Phase 0 규칙: ResourceDictionary를 비워둠 -->
    <!-- ThemeManager.Apply()가 런타임에 테마 XAML을 주입하므로 여기에는 아무것도 선언하지 않음 -->
    <!-- StaticResource 절대 금지 — DynamicResource 전용 -->
    <!--
        ★ Fix: BoolToVisibilityConverter 등 컨버터는 App.xaml 에서 선언하지 않음.
               이유: WPF XAML 컴파일러가 App.xaml 처리 시점에
                    같은 프로젝트의 C# 타입(TreeConverters.cs)을 찾지 못해 XDG0008 발생.
               대신: 컨버터를 실제 사용하는 DeviceTreeView.xaml 의 UserControl.Resources 에
                    로컬로 선언 (conv: 접두사로 등록되어 있음 — 정상 동작).
    -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- ThemeManager.Apply()가 런타임에 MergedDictionaries 등을 활용하도록 비워둠 -->
        </ResourceDictionary>
    </Application.Resources>

</Application>
