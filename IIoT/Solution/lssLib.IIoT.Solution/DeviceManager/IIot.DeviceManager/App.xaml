<Application x:Class="IIoT.DeviceManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IIoT.DeviceManager.Views.DeviceTree">
                                    
    <!-- ★ Phase 0 규칙: ResourceDictionary를 비워둠 -->
    <!-- ThemeManager.Apply()가 런타임에 테마 XAML을 주입하므로 여기에는 아무것도 선언하지 않음 -->
    <!-- StaticResource 절대 금지 — DynamicResource 전용 -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- 컨버터 리소스는 반드시 ResourceDictionary 내부에 선언되어야 합니다 -->
            <conv:BoolToVisibilityConverter       x:Key="BoolToVisibilityConverter"/>
            <conv:BoolToVisibilityInvertConverter x:Key="BoolToVisibilityInvertConverter"/>
            <conv:NullToVisibilityConverter       x:Key="NullToVisibilityConverter"/>

            <!-- ThemeManager.Apply()가 런타임에 MergedDictionaries 등을 활용하도록 비워둠 -->
        </ResourceDictionary>
    </Application.Resources>

</Application>
