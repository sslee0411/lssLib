<!--  IIoT.DeviceManager · MainWindow.xaml                      -->
<!--  역할: 메인 레이아웃 — 헤더 + 사이드트리 + 상세 편집 영역  -->
<!--  Phase 0: 테마 통합 (DynamicResource 전용, ThemePickerButton) -->
<!-- ══════════════════════════════════════════════════════════ -->

<Window x:Class="IIoT.DeviceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        mc:Ignorable="d"
        Title="IIoT Device Manager"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <!-- ★ Phase 0: 모든 색상은 DynamicResource — 하드코딩 hex 절대 금지 -->

    <DockPanel LastChildFill="True">

        <!-- ── 헤더 ─────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Height="48"
                Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">

                <!-- 앱 아이콘 + 타이틀 -->
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="⚙"
                               FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Device Manager"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{DynamicResource FgBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="v0.3"
                               FontSize="11"
                               Foreground="{DynamicResource FgMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- ★ Phase 0 핵심: ThemePickerButton — 헤더 우측 배치 필수 -->
                <uc:ThemePickerButton DockPanel.Dock="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0"/>

                <!-- 헤더 우측 액션 버튼 영역 -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Content="저장"
                            Style="{DynamicResource PrimaryButton}"
                            Width="64" Height="30"
                            Margin="4,0"
                            ToolTip="device.xml 저장 (Ctrl+S)"
                            x:Name="BtnSave"/>
                    <Button Content="되돌리기"
                            Style="{DynamicResource SecondaryButton}"
                            Width="72" Height="30"
                            Margin="4,0"
                            x:Name="BtnRevert"/>
                </StackPanel>

                <!-- 상태 표시 (중앙) -->
                <TextBlock x:Name="TxtStatus"
                           Text="준비"
                           FontSize="12"
                           Foreground="{DynamicResource FgMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ── 상태바 ─────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Height="26"
                Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <TextBlock x:Name="TxtStatusBar"
                           Text="device.xml 경로: (미지정)"
                           FontSize="11"
                           Foreground="{DynamicResource FgMutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTagCount"
                           DockPanel.Dock="Right"
                           FontSize="11"
                           Foreground="{DynamicResource FgMutedBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Text="Tag 0개"/>
            </DockPanel>
        </Border>

        <!-- ── 본문 레이아웃 (Tree | Splitter | 편집 영역) ─── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 좌: 장비 트리 -->
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="480"/>
                <!-- 스플리터 -->
                <ColumnDefinition Width="4"/>
                <!-- 우: 상세 편집 -->
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- ── 좌측 장비 트리 패널 ─────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- 트리 헤더 툴바 -->
                    <Border DockPanel.Dock="Top"
                            Height="36"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel Margin="8,0">
                            <TextBlock Text="장비 트리"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource FgBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <Button Content="+"
                                        Style="{DynamicResource GhostButton}"
                                        Width="28" Height="28"
                                        ToolTip="그룹 추가"
                                        x:Name="BtnAddGroup"/>
                                <Button Content="−"
                                        Style="{DynamicResource GhostButton}"
                                        Width="28" Height="28"
                                        ToolTip="선택 항목 삭제"
                                        x:Name="BtnDelete"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 검색창 -->
                    <Border DockPanel.Dock="Top"
                            Padding="8,6">
                        <TextBox x:Name="TxtSearch"
                                 Style="{DynamicResource PropInput}"
                                 Height="28"
                                 FontSize="12"
                                 Tag="장비/Tag 검색..."/>
                    </Border>

                    <!-- TreeView 영역 (Phase 2에서 DeviceTreeView로 교체 예정) -->
                    <TreeView x:Name="DeviceTree"
                              Style="{DynamicResource IIoTTreeView}"
                              Background="Transparent"
                              BorderThickness="0"
                              Margin="4,0"/>
                </DockPanel>
            </Border>

            <!-- ── 스플리터 ───────────────────────────────── -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          Cursor="SizeWE"/>

            <!-- ── 우측 편집 영역 ─────────────────────────── -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BgBrush}">
                <Grid>
                    <!-- 탭 헤더 -->
                    <TabControl x:Name="EditTabs"
                                Style="{DynamicResource IIoTTabControl}"
                                Background="Transparent"
                                BorderThickness="0">

                        <!-- Phase 2에서 각 View로 교체 예정 -->
                        <TabItem Header="장비 정보">
                            <Border Padding="20">
                                <StackPanel>
                                    <TextBlock Text="장비 정보 편집"
                                               FontSize="16"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource FgBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Phase 2 — DeviceEditorView 구현 예정"
                                               FontSize="12"
                                               Foreground="{DynamicResource FgMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </TabItem>

                        <TabItem Header="Tag 편집">
                            <Border Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Tag 편집"
                                               FontSize="16"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource FgBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Phase 2 — TagEditorView 구현 예정"
                                               FontSize="12"
                                               Foreground="{DynamicResource FgMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </TabItem>

                        <TabItem Header="스케일">
                            <Border Padding="20">
                                <StackPanel>
                                    <TextBlock Text="스케일 설정"
                                               FontSize="16"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource FgBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Phase 3 — ScaleEditorView 구현 예정"
                                               FontSize="12"
                                               Foreground="{DynamicResource FgMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </TabItem>

                        <TabItem Header="알람">
                            <Border Padding="20">
                                <StackPanel>
                                    <TextBlock Text="알람 규칙"
                                               FontSize="16"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource FgBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Phase 3 — AlarmRuleView 구현 예정"
                                               FontSize="12"
                                               Foreground="{DynamicResource FgMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </TabItem>

                    </TabControl>
                </Grid>
            </Border>

        </Grid>
    </DockPanel>
</Window>
