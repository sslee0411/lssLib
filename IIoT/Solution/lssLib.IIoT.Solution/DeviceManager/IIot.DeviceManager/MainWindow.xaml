<!-- ══════════════════════════════════════════════════════════
     IIoT.DeviceManager · MainWindow.xaml
     역할: 메인 레이아웃 — 헤더 + 좌(장비트리) + 우(편집/라이브러리) + 상태바
     Phase 0 : 테마 통합 (DynamicResource 전용, ThemePickerButton)
     Phase 1 : Core 기반 구조
     Phase 2 : DeviceTreeView 좌측 패널 통합
     Phase 3 : 편집기 DataTemplate 매핑
     Phase 3F: XamlParseException 수정 — NullToVisibilityConverter Window.Resources 추가
     Phase 4 : 탭 전환 → 라이브러리 뷰 교체
     Phase 5 : DataContext = MainViewModel 교체
               상태바 — HasUnsavedChanges 바인딩 추가
               버전 v0.5-Phase5 으로 갱신
     ══════════════════════════════════════════════════════════ -->

<Window x:Class="IIoT.DeviceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        xmlns:tree="clr-namespace:IIoT.DeviceManager.Views.DeviceTree"
        xmlns:ed="clr-namespace:IIoT.DeviceManager.Views.Editors"
        xmlns:vm="clr-namespace:IIoT.DeviceManager.ViewModels.Editors"
        xmlns:conv="clr-namespace:IIoT.DeviceManager.Views.DeviceTree"
        mc:Ignorable="d"
        Title="IIoT Device Manager"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>

        <!--
        ★ Phase 3 Fix: NullToVisibilityConverter 를 Window 스코프에 선언
          DeviceTreeView.UserControl.Resources 에도 있지만
          MainWindow 스코프에서 편집기 ContentControl 이 참조하므로 반드시 중복 선언 필요
        -->
        <conv:NullToVisibilityConverter       x:Key="NullToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter       x:Key="BoolToVisibilityConverter"/>
        <conv:BoolToVisibilityInvertConverter x:Key="BoolToVisibilityInvertConverter"/>

        <!-- 편집기 DataTemplate 매핑 — ContentControl 이 자동으로 View 선택 -->
        <DataTemplate DataType="{x:Type vm:DeviceEditorViewModel}">
            <ed:DeviceEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlcEditorViewModel}">
            <ed:PlcEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagEditorViewModel}">
            <ed:TagEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SensorEditorViewModel}">
            <ed:SensorEditorView/>
        </DataTemplate>

    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ──────────────────────────────────────────────────────
             헤더 (48px)
             ────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Height="48"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <DockPanel Margin="12,0">

                <!-- 좌: 앱 타이틀 -->
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="⚙"
                               FontSize="18"
                               Foreground="{DynamicResource AccBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="IIoT Device Manager"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccBrush}"
                            CornerRadius="4" Padding="5,2"
                            Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.85">
                        <TextBlock Text="DEV" FontSize="9" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- 우: 저장 + 테마 -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{DynamicResource SecondaryBtn}"
                            Content="💾 저장"
                            Margin="0,0,8,0" Padding="10,4" FontSize="12"
                            Click="BtnSave_Click"
                            ToolTip="Ctrl+S — 설정 저장"/>
                    <uc:ThemePickerButton VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 중: 탭 메뉴 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <Button x:Name="BtnTabDevice"
                            Content="장비 관리"
                            Style="{DynamicResource GhostBtn}"
                            FontSize="13" Padding="14,6"
                            Click="BtnTab_Click" Tag="Device"/>

                    <Button x:Name="BtnTabScale"
                            Content="스케일 설정"
                            Style="{DynamicResource GhostBtn}"
                            FontSize="13" Padding="14,6" Margin="2,0,0,0"
                            Click="BtnTab_Click" Tag="Scale"/>

                    <Button x:Name="BtnTabAlarm"
                            Content="알람 규칙"
                            Style="{DynamicResource GhostBtn}"
                            FontSize="13" Padding="14,6" Margin="2,0,0,0"
                            Click="BtnTab_Click" Tag="Alarm"/>

                    <Button x:Name="BtnTabComm"
                            Content="통신 설정"
                            Style="{DynamicResource GhostBtn}"
                            FontSize="13" Padding="14,6" Margin="2,0,0,0"
                            Click="BtnTab_Click" Tag="Comm"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ──────────────────────────────────────────────────────
             상태바 (하단, 24px)
             Phase 5: HasUnsavedChanges 미저장 표시 추가
             ────────────────────────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom"
                   Height="24"
                   Background="{DynamicResource SurfaceBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0">

            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="선택:"
                               FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtSelectedNode"
                               Text="없음"
                               FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="노드:"
                               FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtNodeCount"
                               Text="0"
                               FontSize="11" FontFamily="{DynamicResource MonoFont}"
                               Foreground="{DynamicResource AccBrush}"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock x:Name="TxtStatus"
                           Text="준비"
                           FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
            </StatusBarItem>

            <!--
            ★ Phase 5 신규: 미저장 변경사항 표시
              DataContext = MainViewModel 이므로 HasUnsavedChanges 직접 바인딩
            -->
            <StatusBarItem>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource YellowBrush}"
                           Margin="8,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Text"       Value="● 미저장 변경사항"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="v0.5-Phase5"
                           FontSize="10" Foreground="{DynamicResource Text3Brush}"
                           Margin="0,0,8,0"/>
            </StatusBarItem>

        </StatusBar>

        <!-- ──────────────────────────────────────────────────────
             본문 — 좌(트리) + 구분선 + 우(편집 or 라이브러리)
             ────────────────────────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColTree"
                                  Width="280" MinWidth="200" MaxWidth="480"/>
                <ColumnDefinition x:Name="ColSplitter"
                                  Width="4"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- ── 좌: 장비 트리 ── -->
            <Border x:Name="DeviceTreePanel"
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">

                <!--
                ★ Phase 5: DataContext = MainViewModel
                  DeviceTree 프로퍼티로 DeviceTreeViewModel 에 바인딩
                -->
                <tree:DeviceTreeView x:Name="DeviceTreeViewPanel"
                                     DataContext="{Binding DeviceTree}"/>

            </Border>

            <!-- ── 구분선 ── -->
            <GridSplitter x:Name="GridSplitter1"
                          Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          Cursor="SizeWE"
                          ShowsPreview="True"/>

            <!-- ── 우: 편집 영역 / 라이브러리 영역 ── -->
            <Grid Grid.Column="2">

                <!-- 장비 관리 탭 편집 영역 -->
                <Grid x:Name="DeviceEditorGrid"
                      Background="{DynamicResource BgBrush}">

                    <!-- 선택 없을 때 플레이스홀더 -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Opacity="0.4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEditor}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="⚙" FontSize="48"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Text3Brush}"/>
                        <TextBlock Text="장비를 선택하면 편집기가 표시됩니다"
                                   FontSize="14" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Text2Brush}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>

                    <!--
                    ★ Phase 5: DataContext = MainViewModel
                      SelectedEditor 가 MainViewModel.SelectedEditor 에 직접 바인딩됨
                    -->
                    <ContentControl Content="{Binding SelectedEditor}"
                                    Visibility="{Binding SelectedEditor,
                                        Converter={StaticResource NullToVisibilityConverter}}"/>

                </Grid>

                <!-- 라이브러리 뷰 주입 ContentControl -->
                <ContentControl x:Name="LibraryArea"
                                Visibility="Collapsed"
                                Background="{DynamicResource BgBrush}"/>

            </Grid>

        </Grid>

    </DockPanel>
</Window>
