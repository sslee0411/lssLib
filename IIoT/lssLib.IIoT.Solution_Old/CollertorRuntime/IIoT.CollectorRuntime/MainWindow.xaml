<!-- ══════════════════════════════════════════════════════════
     IIoT.CollectorRuntime · Views/MainWindow.xaml
     역할: 수집 실시간 모니터링 메인 윈도우
     레이아웃:
       [헤더 56px] 제어버튼 | 상태배지 | 통계 | 테마버튼
       [본문 3열]  좌(필터/통계) | 중(실시간DataGrid) | 우(태그상세)
       [하단 180px] 실시간 로그
     WPF 규칙:
       · 모든 리소스 참조 → DynamicResource
       · TextBlock 혼합 콘텐츠 금지 → Run 또는 멀티 TextBlock
       · FaintBrush: AccFaintBrush / GreenFaintBrush / RedFaintBrush 만 사용
         (OrangeFaintBrush / YellowFaintBrush 미존재)
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.CollectorRuntime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        mc:Ignorable="d"
        Title="IIoT Collector Runtime — 실시간 모니터링"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <DockPanel LastChildFill="True">

        <!-- ══════════════════════════════════════════════
             헤더 (56px)
             ══════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Height="56"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0">

                <!-- 좌: 타이틀 -->
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <TextBlock Text="📡" FontSize="22"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="IIoT Collector Runtime"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding Engine.ConfigInfo}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Text3Brush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 우: 테마 버튼 -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <uc:ThemePickerButton VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 중: 제어 + 상태 + 통계 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- 수집 제어 버튼 3개 -->
                    <Button Command="{Binding StartCommand}"
                            Style="{DynamicResource PrimaryBtn}"
                            Content="▶ 시작" Padding="14,6"
                            FontSize="12" Margin="0,0,6,0"/>
                    <Button Command="{Binding StopCommand}"
                            Style="{DynamicResource SecondaryBtn}"
                            Content="■ 중지" Padding="14,6"
                            FontSize="12" Margin="0,0,6,0"/>
                    <Button Command="{Binding RestartCommand}"
                            Style="{DynamicResource SecondaryBtn}"
                            Content="↺ 재시작" Padding="14,6"
                            FontSize="12" Margin="0,0,24,0"/>

                    <!-- 상태 배지 -->
                    <Border CornerRadius="12" Padding="12,5"
                            Margin="0,0,20,0"
                            Background="{DynamicResource CardBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8"
                                     VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill"
                                                Value="{DynamicResource Text3Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Engine.IsRunning}"
                                                         Value="True">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource GreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Engine.StateText}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Text2Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Engine.IsRunning}"
                                                         Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource GreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- TPS 배지 -->
                    <Border CornerRadius="6" Padding="12,5"
                            Margin="0,0,8,0"
                            Background="{DynamicResource CardBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TPS "
                                       FontSize="10" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBlock Text="{Binding Engine.Tps, StringFormat='{}{0:F0}'}"
                                       FontSize="16" FontWeight="Bold"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource AccBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- GOOD / BAD / ALARM 배지 -->
                    <Border CornerRadius="6" Padding="12,5"
                            Margin="0,0,8,0"
                            Background="{DynamicResource CardBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅ "
                                       FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GoodCount}"
                                       FontSize="14" FontWeight="Bold"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource GreenBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="6" Padding="12,5"
                            Margin="0,0,8,0"
                            Background="{DynamicResource CardBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌ "
                                       FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BadCount}"
                                       FontSize="14" FontWeight="Bold"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource RedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="6" Padding="12,5"
                            Margin="0,0,8,0"
                            Background="{DynamicResource CardBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔 "
                                       FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AlarmCount}"
                                       FontSize="14" FontWeight="Bold"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource OrangeBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 업타임 -->
                    <Border CornerRadius="6" Padding="12,5"
                            Background="{DynamicResource CardBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱ "
                                       FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Uptime}"
                                       FontSize="13" FontWeight="Bold"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource Text2Brush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             하단 로그 패널 (180px)
             ══════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Height="180"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>

                <!-- 로그 헤더 -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,5">
                    <DockPanel>
                        <TextBlock Text="📋 수집 로그"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ClearLogCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Content="지우기"
                                Padding="8,2" FontSize="10"/>
                    </DockPanel>
                </Border>

                <!-- 로그 목록 -->
                <ListBox ItemsSource="{Binding LogRows}"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="{DynamicResource MonoFont}"
                         FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"        Value="2,1"/>
                            <Setter Property="Focusable"      Value="False"/>
                            <Setter Property="Background"     Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Time}"
                                           Width="88"
                                           Foreground="{DynamicResource Text3Brush}"/>
                                <Border Width="44" Margin="4,0"
                                        CornerRadius="2" Padding="3,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource CardBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}"
                                                             Value="ERROR">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource RedFaintBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}"
                                                             Value="WARN">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AccFaintBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Level}"
                                               FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource GreenBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}"
                                                                 Value="ERROR">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource RedBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}"
                                                                 Value="WARN">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource OrangeBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}"
                                                                 Value="DEBUG">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Text3Brush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Source}"
                                           Width="100"
                                           Foreground="{DynamicResource Text3Brush}"/>
                                <TextBlock Text="{Binding Msg}"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             본문 3열
             ══════════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="340" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────
                 좌 패널: 필터 + 통계
                 ───────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Text="🔍 필터 / 통계"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text2Brush}"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">

                            <!-- 검색 -->
                            <TextBlock Text="태그 검색"
                                       FontSize="10" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBox Text="{Binding SearchText,
                                             UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource PropInput}"
                                     Margin="0,0,0,10"/>

                            <!-- 체크박스 필터 -->
                            <CheckBox IsChecked="{Binding ShowBadOnly}"
                                      FontSize="11" Margin="0,0,0,6" Cursor="Hand"
                                      Foreground="{DynamicResource RedBrush}">
                                <TextBlock Text="BAD 태그만 표시"
                                           Foreground="{DynamicResource RedBrush}"
                                           FontSize="11"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ShowAlarmOnly}"
                                      FontSize="11" Margin="0,0,0,10" Cursor="Hand"
                                      Foreground="{DynamicResource OrangeBrush}">
                                <TextBlock Text="알람 태그만 표시"
                                           Foreground="{DynamicResource OrangeBrush}"
                                           FontSize="11"/>
                            </CheckBox>

                            <Button Command="{Binding ClearFilterCommand}"
                                    Style="{DynamicResource GhostBtn}"
                                    Content="필터 초기화"
                                    FontSize="11" HorizontalAlignment="Left"
                                    Padding="8,3" Margin="0,0,0,16"/>

                            <Border Height="1" Margin="0,0,0,12"
                                    Background="{DynamicResource BorderBrush}"/>

                            <!-- 수집 통계 -->
                            <TextBlock Text="수집 통계"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource Text3Brush}"
                                       Margin="0,0,0,8"/>

                            <!-- 통계 행 반복 패턴 -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="전체 태그"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LiveTags.Count}"
                                           FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="표시 태그"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FilteredCount}"
                                           FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}"
                                           Foreground="{DynamicResource AccBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GOOD"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GoodCount}"
                                           FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}"
                                           Foreground="{DynamicResource GreenBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="BAD"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BadCount}"
                                           FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}"
                                           Foreground="{DynamicResource RedBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="알람"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AlarmCount}"
                                           FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}"
                                           Foreground="{DynamicResource OrangeBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="총 폴링"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Engine.TotalPolled,
                                                  StringFormat='{}{0:N0}'}"
                                           FontSize="11"
                                           FontFamily="{DynamicResource MonoFont}"
                                           Foreground="{DynamicResource Text2Brush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="오류"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Engine.ErrorCount}"
                                           FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}"
                                           Foreground="{DynamicResource RedBrush}"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 분할선 1 -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch" Width="4"
                          Background="{DynamicResource BorderBrush}"
                          Cursor="SizeWE"/>

            <!-- ─────────────────────────────
                 중앙: 실시간 태그 DataGrid
                 ───────────────────────────── -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BgBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 실시간 태그 데이터"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource Text2Brush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Margin="10,0,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text3Brush}"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding LiveTags.Count, Mode=OneWay}"/>
                                <Run Text=" 개 표시"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding TagsView}"
                              SelectedItem="{Binding SelectedTag}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              Background="{DynamicResource BgBrush}"
                              RowBackground="{DynamicResource BgBrush}"
                              AlternatingRowBackground="{DynamicResource CardBrush}"
                              BorderThickness="0"
                              RowHeight="34" FontSize="12"
                              Foreground="{DynamicResource TextBrush}"
                              EnableRowVirtualization="True">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"
                                        Value="{DynamicResource SurfaceBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Text2Brush}"/>
                                <Setter Property="FontSize"        Value="11"/>
                                <Setter Property="FontWeight"      Value="SemiBold"/>
                                <Setter Property="Padding"         Value="10,6"/>
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Quality}"
                                                 Value="Bad">
                                        <Setter Property="Background"
                                                Value="{DynamicResource RedFaintBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasAlarm}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource AccFaintBrush}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource GreenFaintBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <!-- 품질 상태 점 -->
                            <DataGridTemplateColumn Header="" Width="30" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource Text3Brush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding QualityColorKey}"
                                                                     Value="Good">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource GreenBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding QualityColorKey}"
                                                                     Value="Bad">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource RedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding QualityColorKey}"
                                                                     Value="Uncertain">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource YellowBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 장비명 -->
                            <DataGridTextColumn Header="장비"
                                Binding="{Binding DeviceName}" Width="120"/>

                            <!-- 태그명 -->
                            <DataGridTextColumn Header="태그 이름"
                                Binding="{Binding TagName}" Width="180"/>

                            <!-- 주소 -->
                            <DataGridTemplateColumn Header="주소" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Address}"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Text2Brush}"
                                                   VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 현재값 -->
                            <DataGridTemplateColumn Header="현재 값" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ValueText}"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="13" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource GreenBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding QualityColorKey}"
                                                                     Value="Bad">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource RedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding QualityColorKey}"
                                                                     Value="Uncertain">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource YellowBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding QualityColorKey}"
                                                                     Value="None">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource Text3Brush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 알람 레벨 배지 -->
                            <DataGridTemplateColumn Header="알람" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="5,2"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAlarm}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource OrangeBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AlarmLevel}"
                                                                     Value="HH">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource RedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding AlarmLevel}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 상태 텍스트 -->
                            <DataGridTemplateColumn Header="상태" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource GreenBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding QualityColorKey}"
                                                                     Value="Bad">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource RedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding QualityColorKey}"
                                                                     Value="Uncertain">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource YellowBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding QualityColorKey}"
                                                                     Value="None">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource Text3Brush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 갱신 경과 -->
                            <DataGridTemplateColumn Header="갱신" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ElapsedText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Text3Brush}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 분할선 2 -->
            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Stretch" Width="4"
                          Background="{DynamicResource BorderBrush}"
                          Cursor="SizeWE"/>

            <!-- ─────────────────────────────
                 우 패널: 태그 상세
                 ───────────────────────────── -->
            <Border Grid.Column="4"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Text="📈 태그 상세"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text2Brush}"/>
                    </Border>

                    <!-- 미선택 안내 -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Opacity="0.4" Margin="0,0,0,60">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedTag}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="📊" FontSize="40"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Text3Brush}"/>
                        <TextBlock Text="태그를 선택하세요"
                                   FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Text2Brush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- 태그 상세 내용 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedTag}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel Margin="14" DataContext="{Binding SelectedTag}">

                            <!-- 태그명 -->
                            <TextBlock Text="{Binding TagName}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DeviceName}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text3Brush}"
                                       Margin="0,2,0,12"/>

                            <!-- 현재값 대형 표시 -->
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource Border2Brush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="16,12" Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="현재 값"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text3Brush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ValueText}"
                                               FontSize="30" FontWeight="Bold"
                                               FontFamily="{DynamicResource MonoFont}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource GreenBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding QualityColorKey}"
                                                                 Value="Bad">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource RedBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding QualityColorKey}"
                                                                 Value="None">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Text3Brush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource GreenBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding QualityColorKey}"
                                                                 Value="Bad">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource RedBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding QualityColorKey}"
                                                                 Value="None">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Text3Brush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 태그 속성 -->
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="태그 정보"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource Text3Brush}"
                                               Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="주소"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Text3Brush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Address}"
                                                   FontSize="11"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="단위"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Text3Brush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Unit,
                                                          FallbackValue='-'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="갱신"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Text3Brush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ElapsedText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Text2Brush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="업데이트"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Text3Brush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UpdateCount,
                                                          StringFormat='{}{0:N0}회'}"
                                                   FontSize="11"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   Foreground="{DynamicResource AccBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 세션 통계 Min/Max -->
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="세션 통계"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource Text3Brush}"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="최솟값"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Text3Brush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding MinValue,
                                                              StringFormat='{}{0:F3}'}"
                                                       FontSize="15" FontWeight="Bold"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       Foreground="{DynamicResource AccBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="최댓값"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Text3Brush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding MaxValue,
                                                              StringFormat='{}{0:F3}'}"
                                                       FontSize="15" FontWeight="Bold"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       Foreground="{DynamicResource OrangeBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 최근 이력 -->
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="최근 수집 이력 (최대 10건)"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource Text3Brush}"
                                               Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding TrendHistory}"
                                                  VirtualizingPanel.IsVirtualizing="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Text="{Binding Time,
                                                               StringFormat='HH:mm:ss.fff'}"
                                                        FontSize="10"
                                                        FontFamily="{DynamicResource MonoFont}"
                                                        Foreground="{DynamicResource Text3Brush}"/>
                                                    <TextBlock Grid.Column="1"
                                                        Text="{Binding Value,
                                                               StringFormat='{}{0:F3}'}"
                                                        FontSize="11" FontWeight="Bold"
                                                        FontFamily="{DynamicResource MonoFont}"
                                                        Foreground="{DynamicResource GreenBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
