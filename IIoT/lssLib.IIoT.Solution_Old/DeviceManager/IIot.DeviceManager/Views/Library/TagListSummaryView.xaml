<!--
 ══════════════════════════════════════════════════════════
  IIoT.DeviceManager · Views/Library/TagListSummaryView.xaml
  역할: PLC 선택 시 하위 태그 목록 요약 표시
        태그 항목 클릭 → 트리에서 해당 태그 선택
  Phase 5R: 신규
 ══════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="IIoT.DeviceManager.Views.Library.TagListSummaryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:conv="clr-namespace:IIoT.DeviceManager.Views.DeviceTree"
    mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter       x:Key="NullToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter       x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📋 태그 목록"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <Border Background="{DynamicResource AccBrush}"
                        CornerRadius="8" Padding="8,2"
                        Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Count}"
                               FontSize="11" FontWeight="Bold"
                               Foreground="White"/>
                </Border>
            </StackPanel>
            <TextBlock Text="이 PLC 하위에 등록된 수집 태그 목록입니다."
                       FontSize="11" Foreground="{DynamicResource Text3Brush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 태그 목록 DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Tags}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  Background="{DynamicResource SurfaceBrush}"
                  RowBackground="{DynamicResource BgBrush}"
                  AlternatingRowBackground="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  RowHeight="32" FontSize="12"
                  Foreground="{DynamicResource TextBrush}">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"   Value="{DynamicResource SurfaceBrush}"/>
                    <Setter Property="Foreground"   Value="{DynamicResource Text2Brush}"/>
                    <Setter Property="FontSize"     Value="11"/>
                    <Setter Property="FontWeight"   Value="SemiBold"/>
                    <Setter Property="Padding"      Value="8,6"/>
                    <Setter Property="BorderBrush"  Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <!-- 이름 -->
                <DataGridTextColumn Header="태그 이름"
                    Binding="{Binding Name}" Width="140"/>

                <!-- 주소 -->
                <DataGridTemplateColumn Header="주소" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Address}"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource GreenBrush}"
                                       VerticalAlignment="Center" Margin="6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 데이터 타입 -->
                <DataGridTemplateColumn Header="데이터 타입" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding BufType}"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccBrush}"
                                       VerticalAlignment="Center" Margin="6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 폴링 주기 -->
                <DataGridTextColumn Header="Poll (ms)"
                    Binding="{Binding PollMs}" Width="80"/>

                <!-- 수집 주체 -->
                <DataGridTemplateColumn Header="수집 주체" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OwnerLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text2Brush}"
                                       VerticalAlignment="Center" Margin="6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

        </DataGrid>

        <!-- 태그 없을 때 안내 -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Opacity="0.5">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Text3Brush}"/>
            <TextBlock Text="등록된 태그가 없습니다"
                       FontSize="14" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Text2Brush}" Margin="0,8,0,0"/>
            <TextBlock Text="트리에서 태그 추가 버튼을 클릭하거나&#x0a;이 PLC 노드를 우클릭하여 태그를 추가하세요"
                       FontSize="11" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Text3Brush}"
                       TextAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

    </Grid>
</UserControl>
