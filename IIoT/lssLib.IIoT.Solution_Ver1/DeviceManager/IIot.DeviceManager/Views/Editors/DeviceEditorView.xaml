<!--
 ══════════════════════════════════════════════════════════
  IIoT.DeviceManager · Views/Editors/DeviceEditorView.xaml
  역할: 장비(Device) 노드 속성 편집 패널
  Phase 3
 ══════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="IIoT.DeviceManager.Views.Editors.DeviceEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="600">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 헤더 -->
            <RowDefinition Height="*"/>     <!-- 폼 -->
            <RowDefinition Height="Auto"/>  <!-- 버튼 -->
        </Grid.RowDefinitions>

        <!-- ── 헤더 ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding TargetLabel}"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="장비 속성 편집"
                       FontSize="11" Foreground="{DynamicResource Text3Brush}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ── 폼 ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 기본 정보 카드 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="기본 정보" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <TextBlock Text="이름" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}" Margin="0,4,0,10"/>

                        <TextBlock Text="제조사" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                        <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}" Margin="0,4,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="모델" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="시리얼 번호" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                <TextBox Text="{Binding SerialNo, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ModernTextBox}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="온라인 상태" FontSize="11"
                                       Foreground="{DynamicResource Text2Brush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox IsChecked="{Binding IsOnline}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 통신 설정 카드 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="통신 설정" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <TextBlock Text="CommConfig 참조 ID" FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"/>
                        <ComboBox ItemsSource="{Binding AvailableCommConfigs}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  SelectedValue="{Binding CommConfigId}"
                                  Style="{DynamicResource ModernComboBox}"
                                  Margin="0,4,0,6"/>

                        <TextBlock FontSize="10" Foreground="{DynamicResource Text3Brush}">
                            <Run Text="선택됨:"/>
                            <Run Text="{Binding CommConfigName, FallbackValue='(없음)'}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 위치 카드 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="위치 정보" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <TextBlock Text="Location 참조 ID" FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"/>
                        <ComboBox ItemsSource="{Binding AvailableLocations}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  SelectedValue="{Binding LocationId}"
                                  Style="{DynamicResource ModernComboBox}"
                                  Margin="0,4,0,6"/>

                        <TextBlock FontSize="10" Foreground="{DynamicResource Text3Brush}">
                            <Run Text="선택됨:"/>
                            <Run Text="{Binding LocationName, FallbackValue='(없음)'}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── 버튼 ── -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Command="{Binding ApplyCommand}"
                    Style="{DynamicResource PrimaryBtn}"
                    Content="✔  적용" Height="34"/>
            <Button Grid.Column="2"
                    Command="{Binding ResetCommand}"
                    Style="{DynamicResource SecondaryBtn}"
                    Content="↺  되돌리기" Height="34" Padding="14,0"/>
        </Grid>

    </Grid>
</UserControl>
