<!-- ══════════════════════════════════════════════════════════
     IIoT.UI.Themes · Controls/ThemeSelectorPanel.xaml
     역할: 7가지 테마를 카드 형태로 표시/즉시 전환하는 UserControl
     수정: 2025-05-16 v1.3
       FIX — xmlns 에서 ;assembly= 제거
             같은 프로젝트 내 타입은 assembly 한정자 없이 사용해야 함
             ;assembly= 를 붙이면 XAML 컴파일러가 이미 컴파일된
             외부 어셈블리를 찾으려 하여 XDG0008 오류 발생
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.UI.Themes.Controls.ThemeSelectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:IIoT.UI.Themes"
             xmlns:conv="clr-namespace:IIoT.UI.Themes.Controls"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.Resources>

        <!-- 컨버터 인스턴스 (ThemeConverters.cs 에 정의 — 독립 파일) -->
        <conv:HexToColorConverter       x:Key="HexToColorConverter"/>
        <conv:ThemePreviewBgConverter   x:Key="ThemePreviewBgConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 테마 카드 기본 스타일 -->
        <Style x:Key="ThemeCard" TargetType="Button">
            <Setter Property="Width"           Value="148"/>
            <Setter Property="Height"          Value="88"/>
            <Setter Property="Margin"          Value="6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Padding"         Value="0"/>
            <!-- 시스템 기본 FocusVisualStyle 제거 — 직접 구현 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Radius}">
                                <ContentPresenter/>
                            </Border>
                            <!--
                                키보드 포커스 표시 오버레이:
                                IsKeyboardFocused=True 일 때 AccBrush 테두리 + 반투명 배경
                            -->
                            <Border x:Name="focusHighlight"
                                    BorderBrush="{DynamicResource AccBrush}"
                                    BorderThickness="3"
                                    CornerRadius="{DynamicResource Radius}"
                                    Background="{DynamicResource AccFaintBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <!-- 키보드 포커스 — 뚜렷한 테두리+오버레이 표시 -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focusHighlight" Property="Opacity" Value="1"/>
                            </Trigger>
                            <!-- Enter/Space 눌렀을 때 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="focusHighlight" Property="Opacity" Value="0"/>
                                <Setter TargetName="root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 테마 카드 DataTemplate -->
        <DataTemplate DataType="{x:Type themes:ThemeItemViewModel}">
            <Button Command="{Binding DataContext.SelectThemeCommand,
                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <!-- IsSelected: 두꺼운 AccBrush 테두리 + 반투명 배경으로 선택 상태 강조 -->
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ThemeCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource AccBrush}"/>
                                <Setter Property="Background"
                                        Value="{DynamicResource AccFaintBrush}"/>
                                <Setter Property="BorderThickness" Value="3"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 색상 프리뷰 -->
                    <Border Grid.Row="0" CornerRadius="4,4,0,0" ClipToBounds="True">
                        <Grid>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <SolidColorBrush>
                                        <SolidColorBrush.Color>
                                            <MultiBinding Converter="{StaticResource ThemePreviewBgConverter}">
                                                <Binding Path="IsDark"/>
                                            </MultiBinding>
                                        </SolidColorBrush.Color>
                                    </SolidColorBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Ellipse Width="36" Height="36"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Bottom"
                                     Margin="8,0,0,8">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding AccentHex,
                                        Converter={StaticResource HexToColorConverter}}"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,6,6,0"
                                    Width="18" Height="18"
                                    CornerRadius="9"
                                    Visibility="{Binding IsSelected,
                                        Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding AccentHex,
                                        Converter={StaticResource HexToColorConverter}}"/>
                                </Border.Background>
                                <TextBlock Text="✓" FontSize="10" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="6,6,0,0" Padding="4,1"
                                    CornerRadius="3" Background="#33000000">
                                <TextBlock Text="{Binding ModeLabel}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 이름 / 설명 -->
                    <StackPanel Grid.Row="1"
                                Background="{DynamicResource CardBrush}">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="7,5,7,0"/>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="9"
                                   Foreground="{DynamicResource Text3Brush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="7,2,7,5"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <TextBlock Text="테마 설정"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding CurrentThemeDisplay}"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Content="◀" ToolTip="이전 테마 (Ctrl+Shift+T)"
                            Style="{DynamicResource ToolbarBtn}"
                            Command="{Binding PrevThemeCommand}"
                            Padding="6,4" Margin="0,0,3,0"/>
                    <Button Content="▶" ToolTip="다음 테마 (Ctrl+T)"
                            Style="{DynamicResource ToolbarBtn}"
                            Command="{Binding NextThemeCommand}"
                            Padding="6,4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Themes}" Margin="6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
