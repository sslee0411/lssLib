<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
      ★ Fix: UseWPF=true 제거 → net8.0 순수 라이브러리
         Studio·Collector·Manager·Analytics 모두 참조 가능
    -->
		<OutputType>Library</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>IIoT.Shared</AssemblyName>
		<RootNamespace>IIoT.Shared</RootNamespace>
		<Description>IIoT SCADA 시스템 공유 모델·인터페이스·ConfigBundle</Description>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<!-- LiveTagValue ObservableObject 기반 -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup>
		<!--
      ★ Fix: lssLib.Messaging 추가 (EventMessage 상속 — TagValueUpdatedEvent 등)
         경로는 실제 솔루션 위치에 맞게 조정
    -->
		<ProjectReference Include="..\..\..\Base\BCL\Message\lssLib.Messaging\lssLib.Messaging.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Models\" />
	</ItemGroup>

</Project>