<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · MainWindow.xaml
     Fix: x:Class "IIot.Studio" → "IIoT.Studio" (대소문자 수정)
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        mc:Ignorable="d"
        Title="IIoT Studio — 설정 관리"
        Width="1400" Height="860"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <DockPanel LastChildFill="True">

        <!-- ══════════════════════════════════════════════
             헤더 (56px)
             ══════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Height="56"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0">

                <!-- 좌: 타이틀 -->
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <TextBlock Text="⚙️" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="IIoT Studio"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="설정·수집흐름·라이브러리 통합 관리"
                                   FontSize="10" Foreground="{DynamicResource Text3Brush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 우: 테마 + 저장 -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SaveAllCommand}"
                            Style="{DynamicResource PrimaryBtn}"
                            Content="💾 저장" Padding="12,5" FontSize="12"
                            Margin="0,0,8,0"/>
                    <Button Command="{Binding LoadAllCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Content="↺ 새로고침" Padding="10,5" FontSize="11"
                            Margin="0,0,8,0"/>
                    <uc:ThemePickerButton VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 중: 저장 상태 -->
                <TextBlock Text="{Binding SaveStatus}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"/>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             하단 상태바
             ══════════════════════════════════════════════ -->
        <StatusBar DockPanel.Dock="Bottom" Height="24"
                   Background="{DynamicResource SurfaceBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding SaveStatus}"
                           FontSize="10" Foreground="{DynamicResource Text2Brush}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="● 미저장"
                           FontSize="10" Foreground="{DynamicResource YellowBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- ══════════════════════════════════════════════
             본문 — 탭 (장비·수집흐름·스케일·알람·통신)
             ══════════════════════════════════════════════ -->
        <TabControl SelectedIndex="{Binding ActiveTabIndex}"
                    Background="{DynamicResource BgBrush}"
                    BorderThickness="0">

            <!-- 탭 ① 장비 관리 -->
            <TabItem Header="🖥️ 장비 관리">
                <!-- DeviceTree 좌 + 편집기 우 — ContentControl로 이식 예정 -->
                <TextBlock Text="장비 관리 탭 (DeviceTree + Editor)"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text3Brush}" FontSize="13"/>
            </TabItem>

            <!-- 탭 ② 수집 흐름 -->
            <TabItem Header="🔗 수집 흐름">
                <TextBlock Text="수집 흐름 탭 (NodeRed Canvas)"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text3Brush}" FontSize="13"/>
            </TabItem>

            <!-- 탭 ③ 스케일 관리 -->
            <TabItem Header="📐 스케일">
                <TextBlock Text="스케일 라이브러리 탭"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text3Brush}" FontSize="13"/>
            </TabItem>

            <!-- 탭 ④ 알람 규칙 -->
            <TabItem Header="🔔 알람 규칙">
                <TextBlock Text="알람 규칙 탭"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text3Brush}" FontSize="13"/>
            </TabItem>

            <!-- 탭 ⑤ 통신 설정 -->
            <TabItem Header="📡 통신 설정">
                <TextBlock Text="통신 설정 탭"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text3Brush}" FontSize="13"/>
            </TabItem>

        </TabControl>

    </DockPanel>
</Window>
