<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · MainWindow.xaml
     Fix:
       ① x:Class "IIot.Studio" → "IIoT.Studio"
       ② xmlns: vTree/vCanvas/vLib 추가 (View 참조용)
       ③ BoolToVisibility 키 통일 (App.xaml 등록 키와 일치)
       ④ SaveAllCommand → 탭 전환과 저장 커맨드 바인딩 정리
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        xmlns:vTree="clr-namespace:IIoT.Studio.Views.DeviceTree"
        xmlns:vCanvas="clr-namespace:IIoT.Studio.Views.Canvas"
        xmlns:vLib="clr-namespace:IIoT.Studio.Views.Library"
        mc:Ignorable="d"
        Title="IIoT Studio — 설정"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <DockPanel LastChildFill="True">

        <!-- ══════════════════════════════════════════════
             헤더 (56px)
             ══════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Height="56"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0">

                <!-- 우: 테마 버튼 + 저장 -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="{DynamicResource YellowBrush}"
                            CornerRadius="3" Padding="8,3" Margin="0,0,12,0"
                            Visibility="{Binding HasUnsavedChanges,
                                Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="● 미저장"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BgBrush}"/>
                    </Border>
                    <Button Style="{DynamicResource PrimaryBtn}"
                            Command="{Binding SaveAllCommand}"
                            Content="💾 전체 저장"
                            Padding="14,0" Margin="0,0,12,0"/>
                    <uc:ThemePickerButton/>
                </StackPanel>

                <!-- 좌: 타이틀 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="22"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource AccBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="IIoT Studio"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding SaveStatus}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Text3Brush}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             탭 바 (40px)
             ══════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Height="40"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,0">

                <Button Style="{DynamicResource GhostBtn}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="0"
                        Height="40" Padding="16,0" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏭" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="장비 관리" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Button>

                <Button Style="{DynamicResource GhostBtn}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="1"
                        Height="40" Padding="16,0" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔀" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="수집 흐름" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Button>

                <Button Style="{DynamicResource GhostBtn}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="2"
                        Height="40" Padding="16,0" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📐" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="스케일" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Button>

                <Button Style="{DynamicResource GhostBtn}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="3"
                        Height="40" Padding="16,0" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔔" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="알람 규칙" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Button>

                <Button Style="{DynamicResource GhostBtn}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="4"
                        Height="40" Padding="16,0" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔌" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="통신 설정" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             탭 본문
             ══════════════════════════════════════════════ -->
        <Grid>

            <!-- ① 장비 관리 탭 -->
            <vTree:DeviceTreeView
                DataContext="{Binding DeviceTree}"
                Visibility="{Binding IsDeviceTab,
                    Converter={StaticResource BoolToVisibility}}"/>

            <!-- ② 수집 흐름 탭 -->
            <vCanvas:CanvasView
                DataContext="{Binding Canvas}"
                Visibility="{Binding IsCanvasTab,
                    Converter={StaticResource BoolToVisibility}}"/>

            <!-- ③ 스케일 탭 -->
            <vLib:ScaleLibraryView
                DataContext="{Binding ScaleLibrary}"
                Visibility="{Binding IsScaleTab,
                    Converter={StaticResource BoolToVisibility}}"/>

            <!-- ④ 알람 탭 -->
            <vLib:AlarmLibraryView
                DataContext="{Binding AlarmLibrary}"
                Visibility="{Binding IsAlarmTab,
                    Converter={StaticResource BoolToVisibility}}"/>

            <!-- ⑤ 통신 탭 -->
            <vLib:CommLibraryView
                DataContext="{Binding CommLibrary}"
                Visibility="{Binding IsCommTab,
                    Converter={StaticResource BoolToVisibility}}"/>

        </Grid>
    </DockPanel>
</Window>
