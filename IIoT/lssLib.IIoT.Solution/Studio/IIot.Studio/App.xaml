<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · App.xaml
     Fix:
       ① x:Class "IIot.Studio.App" → "IIoT.Studio.App" (대소문자)
       ② StartupUri 제거 (OnStartup 수동 처리와 중복 금지)
       ③ BoolToVisibilityConverter 전역 등록
          (Views에서 {StaticResource BoolToVisibility} 사용)
     생성: 2026-06-14
     ══════════════════════════════════════════════════════════ -->
<Application x:Class="IIoT.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes">
    <!--
        ★ Fix ①: x:Class "IIot" → "IIoT"
        ★ Fix ②: StartupUri 제거 (App.xaml.cs OnStartup에서 MainWindow 직접 생성)
    -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- ★ Fix ③: BoolToVisibilityConverter 전역 등록
                 Views에서 {StaticResource BoolToVisibility} 로 참조 -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
