<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · App.xaml
     Fix XamlParseException 'BoolToVisibility' not found:
       원인: Application.Resources 직접 등록 → ThemeManager가
             MergedDictionaries에 테마 추가 시 WPF 리소스 조회 순서 충돌
       해결: MergedDictionaries 구조로 Converter 딕셔너리 분리
             ThemeManager는 IsOurDictionary() 필터로만 제거하므로
             Converter 딕셔너리는 안전하게 유지됨
     ══════════════════════════════════════════════════════════ -->
<Application x:Class="IIoT.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ★ Converter 전용 딕셔너리 — 테마 전환과 독립적으로 유지 -->
                <ResourceDictionary>
                    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
