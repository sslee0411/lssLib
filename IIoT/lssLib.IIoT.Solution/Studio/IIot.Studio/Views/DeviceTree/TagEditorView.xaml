<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/TagEditorView.xaml
     역할: Tag 노드 편집기
           주소·데이터타입·폴링주기·스케일/알람 라이브러리 연결
           DeviceTreeView 우측 패널 — IsTagSelected 시 표시
     생성: 2026-06-14
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.TagEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="680">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- 헤더 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius}"
                    Padding="16,12" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏷" FontSize="18" Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tag 편집"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text3Brush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── 기본 정보 ── -->
            <TextBlock Text="기본 정보"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccBrush}"
                       Margin="0,0,0,8"/>

            <!-- 이름 / Tag ID -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tag 이름"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,4"/>
                    <TextBox Style="{DynamicResource PropInput}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Tag="예: 실린더 온도"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tag ID"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,4"/>
                    <TextBox Style="{DynamicResource PropInput}"
                             Text="{Binding TagId, UpdateSourceTrigger=PropertyChanged}"
                             Tag="자동 생성"/>
                </StackPanel>
            </Grid>

            <!-- ── PLC 주소 설정 ── -->
            <Border Height="1" Background="{DynamicResource BorderBrush}"
                    Margin="0,4,0,12"/>
            <TextBlock Text="PLC 주소 설정"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccBrush}"
                       Margin="0,0,0,8"/>

            <!-- 레지스터 주소 / 데이터타입 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="레지스터 주소"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,4"/>
                    <TextBox Style="{DynamicResource PropInput}"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             Tag="예: 40001"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="데이터 타입"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,4"/>
                    <ComboBox Style="{DynamicResource PropCombo}"
                              SelectedValue="{Binding DataType}"
                              ItemsSource="{Binding DataTypeOptions}"/>
                </StackPanel>
            </Grid>

            <!-- 폴링 주기 / 단위 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="폴링 주기 (ms)"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,4"/>
                    <TextBox Style="{DynamicResource PropInput}"
                             Text="{Binding PollMs, UpdateSourceTrigger=PropertyChanged}"
                             Tag="PLC 기본값 사용"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="단위"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,4"/>
                    <TextBox Style="{DynamicResource PropInput}"
                             Text="{Binding RawUnit, UpdateSourceTrigger=PropertyChanged}"
                             Tag="예: raw, count"/>
                </StackPanel>
            </Grid>

            <!-- ── 스케일 연결 ── -->
            <Border Height="1" Background="{DynamicResource BorderBrush}"
                    Margin="0,4,0,12"/>
            <TextBlock Text="스케일 라이브러리 연결"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccBrush}"
                       Margin="0,0,0,8"/>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="스케일 규칙"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,4"/>
                <ComboBox Style="{DynamicResource PropCombo}"
                          SelectedValue="{Binding ScaleConfigId}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          ItemsSource="{Binding AvailableScales}"/>
                <TextBlock Text="스케일 탭에서 규칙 추가 후 여기서 선택하세요"
                           FontSize="10"
                           Foreground="{DynamicResource Text3Brush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 스케일 미리보기 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSm}"
                    Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding HasScalePreview,
                        Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="변환 미리보기: "
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"/>
                    <TextBlock Text="{Binding ScalePreviewText}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource GreenBrush}"
                               FontFamily="{DynamicResource MonoFont}"/>
                </StackPanel>
            </Border>

            <!-- ── 알람 연결 ── -->
            <Border Height="1" Background="{DynamicResource BorderBrush}"
                    Margin="0,4,0,12"/>
            <TextBlock Text="알람 라이브러리 연결"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccBrush}"
                       Margin="0,0,0,8"/>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="알람 규칙"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,4"/>
                <ComboBox Style="{DynamicResource PropCombo}"
                          SelectedValue="{Binding AlarmConfigId}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          ItemsSource="{Binding AvailableAlarms}"/>
                <TextBlock Text="알람 탭에서 규칙 추가 후 여기서 선택하세요"
                           FontSize="10"
                           Foreground="{DynamicResource Text3Brush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 저장 -->
            <Button Style="{DynamicResource PrimaryBtn}"
                    Command="{Binding SaveCommand}"
                    Content="저장"
                    HorizontalAlignment="Right"
                    Padding="24,8"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
