<UserControl x:Class="IIoT.Studio.Views.DeviceTree.GroupEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- 헤더 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius}"
                    Padding="16,12" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" FontSize="18" Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="그룹 편집"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text3Brush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 이름 -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="그룹 이름"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,4"/>
                <TextBox Style="{DynamicResource PropInput}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Tag="예: 라인1, 공장A"/>
            </StackPanel>

            <!-- 설명 -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="설명"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,4"/>
                <TextBox Style="{DynamicResource PropInput}"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Tag="선택 사항"
                         Height="72"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- 저장 -->
            <Button Style="{DynamicResource PrimaryBtn}"
                    Command="{Binding SaveCommand}"
                    Content="저장"
                    HorizontalAlignment="Right"
                    Padding="24,8"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
