<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/PlcEditorView.xaml
     역할: PLC 노드 편집기
           이름·통신 라이브러리 연결·폴링 주기
           DeviceTreeView 우측 패널 — IsPlcSelected 시 표시
     생성: 2026-06-14
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.PlcEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="500">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- 헤더 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius}"
                    Padding="16,12" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔧" FontSize="18" Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PLC 편집"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text3Brush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 이름 -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="PLC 이름"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,4"/>
                <TextBox Style="{DynamicResource PropInput}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Tag="예: PLC-01"/>
            </StackPanel>

            <!-- 통신 라이브러리 연결 -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="통신 라이브러리"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,4"/>
                <ComboBox Style="{DynamicResource PropCombo}"
                          SelectedValue="{Binding CommLibraryId}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          ItemsSource="{Binding AvailableCommLibraries}"/>
                <TextBlock Text="통신 라이브러리 탭에서 먼저 설정을 추가하세요"
                           FontSize="10"
                           Foreground="{DynamicResource Text3Brush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 폴링 주기 -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="기본 폴링 주기 (ms)"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,4"/>
                <TextBox Style="{DynamicResource PropInput}"
                         Text="{Binding DefaultPollMs, UpdateSourceTrigger=PropertyChanged}"
                         Tag="1000"/>
                <TextBlock Text="개별 Tag에서 폴링 주기를 별도로 설정할 수 있습니다"
                           FontSize="10"
                           Foreground="{DynamicResource Text3Brush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 활성화 토글 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSm}"
                    Padding="12,10" Margin="0,0,0,20">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right"
                              IsChecked="{Binding IsEnabled}"
                              VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="수집 활성화"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="비활성화 시 이 PLC의 모든 Tag 수집이 중단됩니다"
                                   FontSize="10"
                                   Foreground="{DynamicResource Text3Brush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 저장 -->
            <Button Style="{DynamicResource PrimaryBtn}"
                    Command="{Binding SaveCommand}"
                    Content="저장"
                    HorizontalAlignment="Right"
                    Padding="24,8"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
