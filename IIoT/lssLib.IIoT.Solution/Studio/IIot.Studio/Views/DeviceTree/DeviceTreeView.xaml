<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/DeviceTreeView.xaml
     Fix XamlParseException 'BoolToVisibility':
       UserControl.Resources에 Converter 직접 등록
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.DeviceTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
             xmlns:vm="clr-namespace:IIoT.Studio.ViewModels.DeviceTree"
             xmlns:local="clr-namespace:IIoT.Studio.Views.DeviceTree"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             d:DataContext="{d:DesignInstance Type=vm:DeviceTreeViewModel}">

    <!-- ★ Fix: UserControl 자체 Resources에 Converter 등록 -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌: 장비 트리 패널 -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{DynamicResource GhostBtn}"
                                    Command="{Binding AddGroupCommand}"
                                    ToolTip="그룹 추가" Padding="6,2" Margin="2,0">
                                <TextBlock Text="＋그룹" FontSize="11"
                                           Foreground="{DynamicResource AccBrush}"/>
                            </Button>
                            <Button Style="{DynamicResource GhostBtn}"
                                    Command="{Binding AddDeviceCommand}"
                                    ToolTip="장비 추가" Padding="6,2" Margin="2,0">
                                <TextBlock Text="＋장비" FontSize="11"
                                           Foreground="{DynamicResource GreenBrush}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏭" FontSize="13"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="장비 구조"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Padding="8,6"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBox Style="{DynamicResource PropInput}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="🔍 검색..." FontSize="11"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TreeView Style="{DynamicResource DeviceTreeView}"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="TreeView_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem"
                                   BasedOn="{StaticResource DeviceTreeItem}"/>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                    <TextBlock Text="{Binding IconGlyph}"
                                               FontSize="13" Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Badge}"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text3Brush}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      Cursor="SizeWE"/>

        <!-- 우: 동적 편집기 패널 -->
        <Grid Grid.Column="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsNoneSelected,
                            Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="🏭" FontSize="48"
                           HorizontalAlignment="Center" Opacity="0.3"/>
                <TextBlock Text="트리에서 노드를 선택하세요"
                           FontSize="13"
                           Foreground="{DynamicResource Text3Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>

            <local:GroupEditorView
                DataContext="{Binding GroupEditor}"
                Visibility="{Binding IsGroupSelected,
                    Converter={StaticResource BoolToVisibility}}"/>

            <local:DeviceEditorView
                DataContext="{Binding DeviceEditor}"
                Visibility="{Binding IsDeviceSelected,
                    Converter={StaticResource BoolToVisibility}}"/>

            <local:PlcEditorView
                DataContext="{Binding PlcEditor}"
                Visibility="{Binding IsPlcSelected,
                    Converter={StaticResource BoolToVisibility}}"/>

            <local:TagEditorView
                DataContext="{Binding TagEditor}"
                Visibility="{Binding IsTagSelected,
                    Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</UserControl>
