<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/DeviceTreeView.xaml
     Fix:
       ① xmlns:local 추가 (GroupEditorView 등 같은 네임스페이스 참조)
       ② BoolToVisibility 키 → App.xaml 등록 키와 통일
       ③ ContentControl DataTemplate 방식 → ContentControl + Visibility 방식으로 변경
          (DataTemplate 내부에서 local: 사용 시 일부 WPF 버전 컴파일 이슈 회피)
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.DeviceTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:IIoT.Studio.ViewModels.DeviceTree"
             xmlns:local="clr-namespace:IIoT.Studio.Views.DeviceTree"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             d:DataContext="{d:DesignInstance Type=vm:DeviceTreeViewModel}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             좌: 장비 트리 패널
             ══════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- 헤더 -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <Button Style="{DynamicResource GhostBtn}"
                                    Command="{Binding AddGroupCommand}"
                                    ToolTip="그룹 추가"
                                    Padding="6,2" Margin="2,0">
                                <TextBlock Text="＋그룹" FontSize="11"
                                           Foreground="{DynamicResource AccBrush}"/>
                            </Button>
                            <Button Style="{DynamicResource GhostBtn}"
                                    Command="{Binding AddDeviceCommand}"
                                    ToolTip="장비 추가"
                                    Padding="6,2" Margin="2,0">
                                <TextBlock Text="＋장비" FontSize="11"
                                           Foreground="{DynamicResource GreenBrush}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏭" FontSize="13"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="장비 구조"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 검색 -->
                <Border DockPanel.Dock="Top"
                        Padding="8,6"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBox Style="{DynamicResource PropInput}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="🔍 검색..." FontSize="11"/>
                </Border>

                <!-- 트리 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TreeView Style="{DynamicResource DeviceTreeView}"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="TreeView_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem"
                                   BasedOn="{StaticResource DeviceTreeItem}"/>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                    <TextBlock Text="{Binding IconGlyph}"
                                               FontSize="13" Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Badge}"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text3Brush}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- 스플리터 -->
        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      Cursor="SizeWE"/>

        <!-- ══════════════════════════════════════════════
             우: 동적 편집기 패널 (RightPanelMode)
             ★ ContentControl + Visibility 방식 사용
               (DataTemplate 내 local: xmlns 컴파일 이슈 회피)
             ══════════════════════════════════════════════ -->
        <Grid Grid.Column="2">

            <!-- 미선택 상태 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsNoneSelected,
                            Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="🏭" FontSize="48"
                           HorizontalAlignment="Center" Opacity="0.3"/>
                <TextBlock Text="트리에서 노드를 선택하세요"
                           FontSize="13"
                           Foreground="{DynamicResource Text3Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>

            <!-- 그룹 편집기 -->
            <local:GroupEditorView
                DataContext="{Binding GroupEditor}"
                Visibility="{Binding IsGroupSelected,
                    Converter={StaticResource BoolToVisibility}}"/>

            <!-- 장비 편집기 -->
            <local:DeviceEditorView
                DataContext="{Binding DeviceEditor}"
                Visibility="{Binding IsDeviceSelected,
                    Converter={StaticResource BoolToVisibility}}"/>

            <!-- PLC 편집기 -->
            <local:PlcEditorView
                DataContext="{Binding PlcEditor}"
                Visibility="{Binding IsPlcSelected,
                    Converter={StaticResource BoolToVisibility}}"/>

            <!-- Tag 편집기 -->
            <local:TagEditorView
                DataContext="{Binding TagEditor}"
                Visibility="{Binding IsTagSelected,
                    Converter={StaticResource BoolToVisibility}}"/>

        </Grid>

    </Grid>
</UserControl>
