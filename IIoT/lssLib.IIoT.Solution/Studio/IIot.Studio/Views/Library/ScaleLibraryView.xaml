<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/Library/ScaleLibraryView.xaml
     역할: 스케일 라이브러리 관리 화면
     Fix MC3015: UserControl.Resources를 UserControl 직계 자식으로 배치
                 (Border 내부 Grid 앞에 삽입된 이전 오류 수정)
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.Library.ScaleLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
             xmlns:vm="clr-namespace:IIoT.Studio.ViewModels.Library"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             d:DataContext="{d:DesignInstance Type=vm:ScaleLibraryViewModel}">

    <!-- ★ 핵심: UserControl.Resources는 반드시 UserControl의 직계 속성 요소여야 함
              Grid/Border 등 자식 요소 안에 있으면 MC3015 오류 발생 -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="220"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ 좌: 목록 패널 ══════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- 헤더 -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{DynamicResource PrimaryBtn}"
                                Command="{Binding AddScaleCommand}"
                                Content="＋ 추가" Padding="10,4"/>
                        <TextBlock Text="📐 스케일 라이브러리"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- 목록 -->
                <ListBox ItemsSource="{Binding Scales}"
                         SelectedItem="{Binding SelectedScale}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding RangeText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Text3Brush}"
                                                       FontFamily="{DynamicResource MonoFont}"/>
                                            <Border Background="{DynamicResource AccFaintBrush}"
                                                    CornerRadius="2" Padding="4,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Unit}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource AccBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{DynamicResource GhostBtn}"
                                            Command="{Binding DataContext.DeleteScaleCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="✕" Padding="6,2"
                                            Foreground="{DynamicResource RedBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- 스플리터 -->
        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      Cursor="SizeWE"/>

        <!-- ══════════════ 우: 편집 패널 ══════════════ -->
        <!-- MC3089 방지: ScrollViewer 단일 자식 → Grid로 래핑 -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Grid>

                <!-- 미선택 상태 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsNoneSelected,
                                Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="📐" FontSize="48"
                               HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="스케일 규칙을 선택하세요"
                               FontSize="13"
                               Foreground="{DynamicResource Text3Brush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- 편집 폼 -->
                <StackPanel Margin="24"
                            Visibility="{Binding IsScaleSelected,
                                Converter={StaticResource BoolToVisibility}}">

                    <!-- 헤더 카드 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius}"
                            Padding="16,12" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📐" FontSize="16" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding SelectedScale.Name}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 이름 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="규칙 이름"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                        <TextBox Style="{DynamicResource PropInput}"
                                 Text="{Binding SelectedScale.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="예: 압력 센서 0~10bar"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,16"/>

                    <!-- Raw 범위 -->
                    <TextBlock Text="Raw 값 범위 (PLC 레지스터)"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccBrush}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Raw 최솟값"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource PropInput}" Tag="0"
                                     Text="{Binding SelectedScale.RawMin, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Raw 최댓값"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource PropInput}" Tag="4095"
                                     Text="{Binding SelectedScale.RawMax, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 공학단위 범위 -->
                    <TextBlock Text="공학단위 범위 (변환 후)"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccBrush}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="공학단위 최솟값"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource PropInput}" Tag="0.0"
                                     Text="{Binding SelectedScale.EngMin, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="공학단위 최댓값"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource PropInput}" Tag="100.0"
                                     Text="{Binding SelectedScale.EngMax, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 단위 / 소수점 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="단위"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource PropInput}"
                                     Tag="예: bar, °C, mm/s"
                                     Text="{Binding SelectedScale.Unit, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="소수점 자리"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource PropCombo}"
                                      SelectedValue="{Binding SelectedScale.DecimalPlaces}"
                                      ItemsSource="{Binding DecimalPlaceOptions}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 변환식 미리보기 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="12,10" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="변환식"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedScale.RangeText}"
                                       FontSize="12"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource GreenBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 저장 -->
                    <Button Style="{DynamicResource PrimaryBtn}"
                            Command="{Binding SaveScaleCommand}"
                            Content="저장"
                            HorizontalAlignment="Right"
                            Padding="24,8"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>
</UserControl>
