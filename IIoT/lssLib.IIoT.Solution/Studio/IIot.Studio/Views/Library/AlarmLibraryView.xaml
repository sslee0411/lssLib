<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/Library/AlarmLibraryView.xaml
     역할: 알람 규칙 라이브러리 관리 화면
     Fix: MC3089 — ScrollViewer 단일 자식 규칙 준수
          미선택+편집폼 두 패널을 Grid로 묶어서 ScrollViewer에 전달
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.Library.AlarmLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:IIoT.Studio.ViewModels.Library"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             d:DataContext="{d:DesignInstance Type=vm:AlarmLibraryViewModel}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="240"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ 좌: 목록 패널 ══════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{DynamicResource PrimaryBtn}"
                                Command="{Binding AddAlarmCommand}"
                                Content="＋ 추가" Padding="10,4"/>
                        <TextBlock Text="🔔 알람 라이브러리"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <ListBox ItemsSource="{Binding AlarmRules}"
                         SelectedItem="{Binding SelectedRule}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Background="{DynamicResource RedBrush}"
                                                    CornerRadius="2" Padding="4,1" Margin="0,0,3,0">
                                                <TextBlock Text="{Binding HiHiText}"
                                                           FontSize="9" Foreground="White"/>
                                            </Border>
                                            <Border Background="{DynamicResource OrangeBrush}"
                                                    CornerRadius="2" Padding="4,1" Margin="0,0,3,0">
                                                <TextBlock Text="{Binding HiText}"
                                                           FontSize="9" Foreground="White"/>
                                            </Border>
                                            <Border Background="{DynamicResource AccBrush}"
                                                    CornerRadius="2" Padding="4,1" Margin="0,0,3,0">
                                                <TextBlock Text="{Binding LoText}"
                                                           FontSize="9" Foreground="White"/>
                                            </Border>
                                            <Border Background="{DynamicResource Acc2Brush}"
                                                    CornerRadius="2" Padding="4,1">
                                                <TextBlock Text="{Binding LoLoText}"
                                                           FontSize="9" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{DynamicResource GhostBtn}"
                                            Command="{Binding DataContext.DeleteAlarmCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="✕" Padding="6,2"
                                            Foreground="{DynamicResource RedBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- 스플리터 -->
        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      Cursor="SizeWE"/>

        <!-- ══════════════ 우: 편집 패널 ══════════════ -->
        <!-- ★ Fix MC3089: ScrollViewer 단일 자식 → Grid로 래핑 -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Grid>

                <!-- 미선택 상태 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsNoneSelected,
                                Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="🔔" FontSize="48"
                               HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="알람 규칙을 선택하세요"
                               FontSize="13"
                               Foreground="{DynamicResource Text3Brush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- 편집 폼 -->
                <StackPanel Margin="24"
                            Visibility="{Binding IsRuleSelected,
                                Converter={StaticResource BoolToVisibility}}">

                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius}"
                            Padding="16,12" Margin="0,0,0,16">
                        <TextBlock FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding SelectedRule.Name}"/>
                    </Border>

                    <!-- 이름 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="규칙 이름"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text2Brush}"
                                   Margin="0,0,0,4"/>
                        <TextBox Style="{DynamicResource PropInput}"
                                 Text="{Binding SelectedRule.Name,
                                     UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush}"
                            Margin="0,4,0,16"/>

                    <!-- HH 상상한 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource RedBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border Background="{DynamicResource RedBrush}"
                                        CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="HH" FontSize="11"
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="상상한" FontSize="10"
                                           Foreground="{DynamicResource Text3Brush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Style="{DynamicResource PropInput}"
                                     Tag="임계값"
                                     Text="{Binding SelectedRule.HiHi,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="→"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBox Grid.Column="3" Style="{DynamicResource PropInput}"
                                     Tag="메시지"
                                     Text="{Binding SelectedRule.HiHiMsg,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <!-- H 상한 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource OrangeBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border Background="{DynamicResource OrangeBrush}"
                                        CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="H" FontSize="11"
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="상한" FontSize="10"
                                           Foreground="{DynamicResource Text3Brush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Style="{DynamicResource PropInput}"
                                     Tag="임계값"
                                     Text="{Binding SelectedRule.Hi,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="→"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBox Grid.Column="3" Style="{DynamicResource PropInput}"
                                     Tag="메시지"
                                     Text="{Binding SelectedRule.HiMsg,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <!-- L 하한 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource AccBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border Background="{DynamicResource AccBrush}"
                                        CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="L" FontSize="11"
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="하한" FontSize="10"
                                           Foreground="{DynamicResource Text3Brush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Style="{DynamicResource PropInput}"
                                     Tag="임계값"
                                     Text="{Binding SelectedRule.Lo,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="→"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBox Grid.Column="3" Style="{DynamicResource PropInput}"
                                     Tag="메시지"
                                     Text="{Binding SelectedRule.LoMsg,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <!-- LL 하하한 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource Acc2Brush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="12,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border Background="{DynamicResource Acc2Brush}"
                                        CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="LL" FontSize="11"
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="하하한" FontSize="10"
                                           Foreground="{DynamicResource Text3Brush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Style="{DynamicResource PropInput}"
                                     Tag="임계값"
                                     Text="{Binding SelectedRule.LoLo,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="→"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBox Grid.Column="3" Style="{DynamicResource PropInput}"
                                     Tag="메시지"
                                     Text="{Binding SelectedRule.LoLoMsg,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <Button Style="{DynamicResource PrimaryBtn}"
                            Command="{Binding SaveAlarmCommand}"
                            Content="저장"
                            HorizontalAlignment="Right"
                            Padding="24,8"/>
                </StackPanel>

            </Grid>
        </ScrollViewer>

    </Grid>
</UserControl>
