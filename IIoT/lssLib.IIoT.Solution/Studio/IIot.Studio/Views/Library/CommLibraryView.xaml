<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/Library/CommLibraryView.xaml
     역할: 통신 라이브러리 관리 화면
     Fix MC3089: ScrollViewer 단일 자식 → Grid 래핑
     Fix BoolToVisibility: UserControl.Resources에 Converter 등록
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.Library.CommLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
             xmlns:vm="clr-namespace:IIoT.Studio.ViewModels.Library"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             d:DataContext="{d:DesignInstance Type=vm:CommLibraryViewModel}">

    <!-- ★ Fix: UserControl.Resources — Grid 이전, UserControl 직계 자식으로 배치 -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="240"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ 좌: 목록 패널 ══════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{DynamicResource PrimaryBtn}"
                                Command="{Binding AddCommCommand}"
                                Content="＋ 추가" Padding="10,4"/>
                        <TextBlock Text="🔌 통신 라이브러리"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <ListBox ItemsSource="{Binding CommConfigs}"
                         SelectedItem="{Binding SelectedConfig}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Background="{DynamicResource AccFaintBrush}"
                                                    CornerRadius="2" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Protocol}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource AccBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding HostPortText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Text3Brush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{DynamicResource GhostBtn}"
                                            Command="{Binding DataContext.DeleteCommCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="✕" Padding="6,2"
                                            Foreground="{DynamicResource RedBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      Cursor="SizeWE"/>

        <!-- ══════════════ 우: 편집 패널 ══════════════ -->
        <!-- MC3089 Fix: ScrollViewer 단일 자식 → Grid 래핑 -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Grid>

                <!-- 미선택 상태 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsNoneSelected,
                                Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="🔌" FontSize="48"
                               HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="통신 설정을 선택하세요"
                               FontSize="13"
                               Foreground="{DynamicResource Text3Brush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- 편집 폼 -->
                <StackPanel Margin="24"
                            Visibility="{Binding IsConfigSelected,
                                Converter={StaticResource BoolToVisibility}}">

                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius}"
                            Padding="16,12" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔌" FontSize="16" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding SelectedConfig.Name}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="설정 이름"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                        <TextBox Style="{DynamicResource PropInput}"
                                 Text="{Binding SelectedConfig.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="프로토콜"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                        <ComboBox Style="{DynamicResource PropCombo}"
                                  SelectedValue="{Binding SelectedConfig.Protocol}"
                                  ItemsSource="{Binding ProtocolOptions}"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,16"/>

                    <!-- Modbus TCP -->
                    <StackPanel Visibility="{Binding IsModbusTcp,
                                    Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Modbus TCP 설정"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccBrush}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="IP 주소" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                                <TextBox Style="{DynamicResource PropInput}" Tag="예: 192.168.1.10"
                                         Text="{Binding SelectedConfig.Host, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="포트" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                                <TextBox Style="{DynamicResource PropInput}" Tag="502"
                                         Text="{Binding SelectedConfig.Port, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Unit ID" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                                <TextBox Style="{DynamicResource PropInput}" Tag="1"
                                         Text="{Binding SelectedConfig.UnitId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="타임아웃 (ms)" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                                <TextBox Style="{DynamicResource PropInput}" Tag="3000"
                                         Text="{Binding SelectedConfig.TimeoutMs, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Serial -->
                    <StackPanel Visibility="{Binding IsSerial,
                                    Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Serial 설정"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccBrush}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="포트 이름" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                                <TextBox Style="{DynamicResource PropInput}" Tag="COM1"
                                         Text="{Binding SelectedConfig.PortName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="보드레이트" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                                <ComboBox Style="{DynamicResource PropCombo}"
                                          SelectedValue="{Binding SelectedConfig.BaudRate}"
                                          ItemsSource="{Binding BaudRateOptions}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- MQTT -->
                    <StackPanel Visibility="{Binding IsMqtt,
                                    Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="MQTT 설정"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccBrush}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="브로커 주소" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                                <TextBox Style="{DynamicResource PropInput}" Tag="예: broker.hivemq.com"
                                         Text="{Binding SelectedConfig.Host, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="포트" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                                <TextBox Style="{DynamicResource PropInput}" Tag="1883"
                                         Text="{Binding SelectedConfig.Port, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="클라이언트 ID" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource PropInput}" Tag="iiot-collector-01"
                                     Text="{Binding SelectedConfig.ClientId, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 재시도 공통 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="12,10" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="재시도 설정"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="재시도 횟수" FontSize="10"
                                               Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,3"/>
                                    <TextBox Style="{DynamicResource PropInput}" Tag="3"
                                             Text="{Binding SelectedConfig.RetryCount, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="재시도 간격 (ms)" FontSize="10"
                                               Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,3"/>
                                    <TextBox Style="{DynamicResource PropInput}" Tag="1000"
                                             Text="{Binding SelectedConfig.RetryIntervalMs, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Style="{DynamicResource PrimaryBtn}"
                            Command="{Binding SaveCommCommand}"
                            Content="저장"
                            HorizontalAlignment="Right"
                            Padding="24,8"/>

                </StackPanel>

            </Grid>
        </ScrollViewer>

    </Grid>
</UserControl>
