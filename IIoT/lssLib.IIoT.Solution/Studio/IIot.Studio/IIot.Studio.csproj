<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AssemblyName>IIoT.Studio</AssemblyName>
		<RootNamespace>IIoT.Studio</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\..\Base\BCL\Config\lssLib.Config\lssLib.Config.csproj" />
		<ProjectReference Include="..\..\..\..\Base\BCL\log\lssLib.Log\lssLib.Log.csproj" />
		<ProjectReference Include="..\..\..\..\Base\BCL\Message\lssLib.Messaging\lssLib.Messaging.csproj" />
		<ProjectReference Include="..\..\..\..\Base\BCL\Utils\lssLib.Utils\lssLib.Utils.csproj" />
		<ProjectReference Include="..\..\Shared\IIoT.Shared.csproj" />
		<ProjectReference Include="..\..\UI\IIoT.UI.Controls\Iiot.Controls.csproj" />
		<ProjectReference Include="..\..\UI\Themes\IIoT.UI.Themes\IIoT.UI.Themes.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- EmbeddedResource prefix: "IIoT.Studio.Config." -->
		<EmbeddedResource Include="Config\*.json.sample" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Core\Canvas\" />
		<Folder Include="Core\Config\" />
		<Folder Include="Core\DataModel\" />
		<Folder Include="ViewModels\Canvas\" />
		<Folder Include="ViewModels\DeviceTree\" />
		<Folder Include="ViewModels\Editors\" />
		<Folder Include="ViewModels\Library\" />
		<Folder Include="Views\Canvas\" />
		<!-- ★ Fix ①: DeviceTree 폴더 추가 -->
		<Folder Include="Views\DeviceTree\" />
		<Folder Include="Views\Editors\" />
		<!-- ★ Fix ②: Library 폴더 추가 -->
		<Folder Include="Views\Library\" />
	</ItemGroup>

</Project>
