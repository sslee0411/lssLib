<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/DeviceTreeView.xaml
     역할: 장비 트리 뷰 — 좌(280px) 트리 + 우(*) 선택 정보 패널
     S-01: 초기 구현 (우측 편집기는 S-02~S-05에서 추가)
     규칙:
       ① UserControl.Resources 는 <UserControl> 직계 자식 위치 필수
          (Grid·Border 안에 넣으면 MC3015 오류)
       ② DynamicResource 필수 (StaticResource → 테마 전환 불가)
       ③ TreeView SelectedItemChanged → 코드비하인드에서 vm.SelectNode() 호출
     생성: 2026-06-15
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.DeviceTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:IIoT.Studio.Models">

    <!-- ★ UserControl.Resources: Grid/Border 밖, UserControl 직계 자식 위치 필수 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 좌: 트리 패널 (280px 고정) -->
            <ColumnDefinition Width="280" />
            <!-- 구분선 -->
            <ColumnDefinition Width="1" />
            <!-- 우: 선택 정보 패널 -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════
             § 좌측 트리 패널 (280px)
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="0"
              Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <!-- 툴바 (버튼) -->
                <RowDefinition Height="44" />
                <!-- 트리 본문 -->
                <RowDefinition Height="*" />
                <!-- 상태 메시지 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 툴바: 드롭다운 버튼 3종 + Tag 단독 + 삭제 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="6,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- ＋그룹 드롭다운 -->
                    <Grid Margin="0,0,4,0">
                        <Button Style="{DynamicResource SecondaryBtn}"
                                Padding="8,4" FontSize="11"
                                Content="＋그룹 ▾"
                                Click="GroupMenuBtn_Click" />
                        <Popup x:Name="GroupPopup"
                               PlacementTarget="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Grid}}"
                               Placement="Bottom"
                               StaysOpen="False">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4">
                                <StackPanel>
                                    <Button Content="  형제로 추가"
                                            Command="{Binding DataContext.AddGroupSiblingCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{DynamicResource GhostBtn}"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,6" FontSize="12"
                                            Click="PopupItem_Click" />
                                    <Button Content="  하위로 추가"
                                            Command="{Binding DataContext.AddGroupChildCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{DynamicResource GhostBtn}"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,6" FontSize="12"
                                            Click="PopupItem_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- ＋장비 드롭다운 -->
                    <Grid Margin="0,0,4,0">
                        <Button Style="{DynamicResource SecondaryBtn}"
                                Padding="8,4" FontSize="11"
                                Content="＋장비 ▾"
                                Click="DeviceMenuBtn_Click" />
                        <Popup x:Name="DevicePopup"
                               PlacementTarget="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Grid}}"
                               Placement="Bottom"
                               StaysOpen="False">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4">
                                <StackPanel>
                                    <Button Content="  형제로 추가"
                                            Command="{Binding DataContext.AddDeviceSiblingCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{DynamicResource GhostBtn}"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,6" FontSize="12"
                                            Click="PopupItem_Click" />
                                    <Button Content="  하위로 추가"
                                            Command="{Binding DataContext.AddDeviceChildCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{DynamicResource GhostBtn}"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,6" FontSize="12"
                                            Click="PopupItem_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- ＋PLC 드롭다운 -->
                    <Grid Margin="0,0,4,0">
                        <Button Style="{DynamicResource SecondaryBtn}"
                                Padding="8,4" FontSize="11"
                                Content="＋PLC ▾"
                                Click="PlcMenuBtn_Click" />
                        <Popup x:Name="PlcPopup"
                               PlacementTarget="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Grid}}"
                               Placement="Bottom"
                               StaysOpen="False">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4">
                                <StackPanel>
                                    <Button Content="  형제로 추가"
                                            Command="{Binding DataContext.AddPlcSiblingCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{DynamicResource GhostBtn}"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,6" FontSize="12"
                                            Click="PopupItem_Click" />
                                    <Button Content="  하위로 추가"
                                            Command="{Binding DataContext.AddPlcChildCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{DynamicResource GhostBtn}"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,6" FontSize="12"
                                            Click="PopupItem_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- ＋Tag 단독 버튼 (하위 전용) -->
                    <Button Content="＋Tag"
                            Command="{Binding AddTagCommand}"
                            Style="{DynamicResource SecondaryBtn}"
                            Padding="8,4"
                            Margin="0,0,8,0"
                            FontSize="11"
                            ToolTip="PLC 또는 장비 선택 후 하위에 Tag 추가" />

                    <!-- 구분선 -->
                    <Border Width="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,6,8,6" />

                    <!-- 삭제 -->
                    <Button Content="🗑"
                            Command="{Binding DeleteSelectedCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4"
                            FontSize="13"
                            ToolTip="선택 노드 삭제" />

                </StackPanel>
            </Border>

            <!-- 트리 뷰 -->
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding RootNodes}"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderThickness="0"
                      SelectedItemChanged="TreeView_SelectedItemChanged">

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type model:AbstractTreeNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal"
                                    Margin="2,3">
                            <!-- 아이콘 -->
                            <TextBlock Text="{Binding IconGlyph}"
                                       FontSize="14"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <!-- 이름 -->
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>

                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <!-- ★ Trigger Setter 도 DynamicResource 필수 -->
                        <Setter Property="Foreground"
                                Value="{DynamicResource TextBrush}" />
                        <Setter Property="IsExpanded"
                                Value="True" />
                        <Setter Property="Padding"
                                Value="2,1" />
                    </Style>
                </TreeView.ItemContainerStyle>

            </TreeView>
            <!-- 상태 메시지 (Tag 추가 실패 등 안내) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="8,4"
                    Visibility="{Binding IsStatusVisible,
                                 Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource YellowBrush}"
                           TextWrapping="Wrap" />
            </Border>

        </Grid>

        <!-- 세로 구분선 -->
        <Border Grid.Column="1"
                Background="{DynamicResource BorderBrush}" />

        <!-- ══════════════════════════════════════════════════
             § 우측 선택 정보 패널
             S-01: 미선택 안내 + 노드 타입 표시
             S-02~05: 각 편집기 View 로 교체 예정
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="2"
              Background="{DynamicResource BgBrush}">

            <!-- 미선택 안내 -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsNoneSelected,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="🌲"
                           FontSize="48"
                           HorizontalAlignment="Center" />
                <TextBlock Text="트리에서 노드를 선택하세요"
                           FontSize="15"
                           Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
                <TextBlock Text="좌측 버튼으로 그룹·장비·PLC·Tag를 추가할 수 있습니다."
                           FontSize="12"
                           Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- 선택된 노드 정보 (S-02~05에서 편집기로 교체) -->
            <Border Padding="24"
                    Visibility="{Binding IsNoneSelected,
                                 Converter={StaticResource BoolToVisibility}}">
                <!-- IsNoneSelected 반전 처리:
                     S-02 이후 IsGroupSelected/IsDeviceSelected 등 각각 분기 -->
            </Border>

            <!-- 그룹 선택 시 임시 표시 -->
            <StackPanel Margin="24"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsGroupSelected,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="📁  그룹"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccBrush}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding GroupEditor.Name}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="S-02 에서 그룹 편집기가 추가됩니다."
                           FontSize="12"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,12,0,0" />
            </StackPanel>

            <!-- 장비 선택 시 임시 표시 -->
            <StackPanel Margin="24"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsDeviceSelected,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="🏭  장비"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccBrush}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding DeviceEditor.Name}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="S-03 에서 장비 편집기가 추가됩니다."
                           FontSize="12"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,12,0,0" />
            </StackPanel>

            <!-- PLC 선택 시 임시 표시 -->
            <StackPanel Margin="24"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsPlcSelected,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="🔧  PLC"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccBrush}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding PlcEditor.Name}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="S-04 에서 PLC 편집기가 추가됩니다."
                           FontSize="12"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,12,0,0" />
            </StackPanel>

            <!-- Tag 선택 시 임시 표시 -->
            <StackPanel Margin="24"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsTagSelected,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="🏷  Tag"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccBrush}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding TagEditor.Name}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="S-05 에서 Tag 편집기가 추가됩니다."
                           FontSize="12"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,12,0,0" />
            </StackPanel>

        </Grid>

    </Grid>
</UserControl>
