<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · MainWindow.xaml
     역할: 메인 창 — Base-0: 테마 적용된 빈 창
     규칙:
       ① 모든 색상·스타일은 DynamicResource 참조
          (StaticResource → 테마 전환 시 색상 고정 → 런타임 전환 불가)
       ② ThemePickerButton: xmlns:uc assembly=IIoT.UI.Themes 로 참조
     생성: 2026-06-15
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        Title="IIoT Studio — 설정"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Grid>

        <!-- 헤더 영역 (임시 — Base-1 에서 레이아웃 분리) -->
        <DockPanel>

            <!-- 헤더 바 -->
            <Border DockPanel.Dock="Top"
                    Height="56"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0">

                    <!-- 우측: 테마 선택 버튼 -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- ★ ThemePickerButton: assembly= 선언 필수 (cross-project) -->
                        <uc:ThemePickerButton />
                    </StackPanel>

                    <!-- 좌측: 타이틀 -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="IIoT"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccBrush}" />
                        <TextBlock Text=" Studio"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- 본문: 안내 텍스트 (Base-1 에서 레이아웃 교체 예정) -->
            <Grid Background="{DynamicResource BgBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="⚙️"
                               FontSize="56"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="IIoT Studio"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,6" />
                    <TextBlock Text="Base-0 완료 — 테마가 적용된 빈 창입니다."
                               FontSize="13"
                               Foreground="{DynamicResource Text2Brush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="우측 상단 🎨 버튼으로 7가지 테마를 전환할 수 있습니다."
                               FontSize="13"
                               Foreground="{DynamicResource Text2Brush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

        </DockPanel>

    </Grid>

</Window>
