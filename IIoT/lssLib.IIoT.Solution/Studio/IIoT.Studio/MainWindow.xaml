<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · MainWindow.xaml
     역할: 메인 창
     Base-1: 헤더(56px) + 탭바(40px) + 본문 3단 레이아웃
     규칙:
       ① 모든 색상·스타일은 DynamicResource (StaticResource 금지)
       ② ThemePickerButton: xmlns:uc assembly=IIoT.UI.Themes
       ③ 탭 전환 기능은 Base-2에서 추가 (현재는 버튼만 배치)
     생성: 2026-06-15
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        Title="IIoT Studio — 설정"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <DockPanel LastChildFill="True">

        <!-- ══════════════════════════════════════════════════
             § 헤더 (56px)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">

                <!-- 우측: 테마 버튼 -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <uc:ThemePickerButton />
                </StackPanel>

                <!-- 좌측: 타이틀 + 저장 상태 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="IIoT"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccBrush}" />
                    <TextBlock Text=" Studio"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />

                    <!-- 저장 상태 배지 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8,2"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SaveStatus}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}" />
                    </Border>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 탭바 (40px)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Height="40"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Stretch"
                        Margin="8,0,0,0">

                <!-- 탭 버튼 5개 (Base-2에서 Command 연결) -->
                <Button Content="🖥  장비 관리"
                        Style="{DynamicResource GhostBtn}"
                        Height="40"
                        Padding="16,0" />

                <Button Content="🔀  수집 흐름"
                        Style="{DynamicResource GhostBtn}"
                        Height="40"
                        Padding="16,0" />

                <Button Content="📐  스케일"
                        Style="{DynamicResource GhostBtn}"
                        Height="40"
                        Padding="16,0" />

                <Button Content="🔔  알람 규칙"
                        Style="{DynamicResource GhostBtn}"
                        Height="40"
                        Padding="16,0" />

                <Button Content="🔌  통신 설정"
                        Style="{DynamicResource GhostBtn}"
                        Height="40"
                        Padding="16,0" />

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 본문 (나머지 영역)
             Base-1: 안내 텍스트 — Base-2에서 탭 패널로 교체
             ══════════════════════════════════════════════════ -->
        <Grid Background="{DynamicResource BgBrush}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="⚙️"
                           FontSize="48"
                           HorizontalAlignment="Center" />
                <TextBlock Text="탭을 선택하세요"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,6" />
                <TextBlock Text="Base-2 에서 탭 전환 기능이 추가됩니다."
                           FontSize="13"
                           Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

    </DockPanel>

</Window>
