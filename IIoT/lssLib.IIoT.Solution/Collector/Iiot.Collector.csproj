		<ProjectReference Include="..\..\..\Base\BCL\Message\lssLib.Messaging\lssLib.Messaging.csproj" />
		<ProjectReference Include="..\..\..\Base\BCL\Utils\lssLib.Utils\lssLib.Utils.csproj" />
		<!-- ★ Fix: Modbus TCP/RTU 드라이버 구현용 -->
