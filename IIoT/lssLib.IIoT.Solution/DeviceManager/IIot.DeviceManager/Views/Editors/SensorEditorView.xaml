<!--
 ══════════════════════════════════════════════════════════
  IIoT.DeviceManager · Views/Editors/SensorEditorView.xaml
  역할: Sensor 노드 속성 편집 패널
  Phase 3
 ══════════════════════════════════════════════════════════
-->
<UserControl
    x:Class="IIoT.DeviceManager.Views.Editors.SensorEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="700">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 헤더 ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding TargetLabel}"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource GreenBrush}"/>
            <TextBlock Text="Sensor 속성 편집 — 물리 레이어"
                       FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ── 폼 ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 물리 속성 카드 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="물리 속성" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <TextBlock Text="이름" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}" Margin="0,4,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="공학 단위" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <ComboBox ItemsSource="{Binding UnitSuggestions}"
                                          Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Style="{DynamicResource ModernComboBox}"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="센서 종류" FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <ComboBox ItemsSource="{Binding SensorTypeList}"
                                          SelectedItem="{Binding SensorType}"
                                          Style="{DynamicResource ModernComboBox}"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="설명" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBox}"
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TagRef 카드 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource GreenBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tag 참조 (TagRef)" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource GreenBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Command="{Binding AddTagRefCommand}"
                                    Style="{DynamicResource GhostBtn}"
                                    Content="+ 추가" Padding="8,2" FontSize="11"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TagRefs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="8,6"
                                            Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11"
                                                     ToolTip="역할 (primary / high / low / a / b 등)"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding TagId, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11"
                                                     FontFamily="{DynamicResource MonoFont}"
                                                     ToolTip="참조 Tag ID"/>
                                            <Button Grid.Column="4"
                                                    Command="{Binding DataContext.RemoveTagRefCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="✕" FontSize="10"
                                                    Width="28" Height="28"
                                                    Foreground="{DynamicResource RedBrush}"
                                                    Style="{DynamicResource GhostBtn}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 복합 계산식 -->
                        <TextBlock Text="복합 계산식 (Formula)" FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged,
                                     TargetNullValue=''}"
                                 Style="{DynamicResource ModernTextBox}"
                                 FontFamily="{DynamicResource MonoFont}"
                                 ToolTip="단일 TagRef이면 비워두세요. 예: high - low"/>
                        <TextBlock Text="비워두면 TagRef[0] 값을 그대로 사용"
                                   FontSize="10" Foreground="{DynamicResource Text3Brush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 알람 카드 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="알람 임계값 (공학 단위 기준)" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- HH -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="HH 상한" FontSize="11"
                                       Foreground="{DynamicResource RedBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding AlarmHH, UpdateSourceTrigger=PropertyChanged,
                                         TargetNullValue=''}"
                                     Style="{DynamicResource ModernTextBox}"
                                     FontFamily="{DynamicResource MonoFont}"/>

                            <!-- H -->
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="H 상한" FontSize="11"
                                       Foreground="{DynamicResource OrangeBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="4"
                                     Text="{Binding AlarmH, UpdateSourceTrigger=PropertyChanged,
                                         TargetNullValue=''}"
                                     Style="{DynamicResource ModernTextBox}"
                                     FontFamily="{DynamicResource MonoFont}"/>

                            <!-- L -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="L 하한" FontSize="11"
                                       Foreground="{DynamicResource AccBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding AlarmL, UpdateSourceTrigger=PropertyChanged,
                                         TargetNullValue=''}"
                                     Style="{DynamicResource ModernTextBox}"
                                     FontFamily="{DynamicResource MonoFont}"/>

                            <!-- LL -->
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="LL 하한" FontSize="11"
                                       Foreground="{DynamicResource Acc2Brush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="4"
                                     Text="{Binding AlarmLL, UpdateSourceTrigger=PropertyChanged,
                                         TargetNullValue=''}"
                                     Style="{DynamicResource ModernTextBox}"
                                     FontFamily="{DynamicResource MonoFont}"/>

                            <!-- DeadBand -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="데드밴드" FontSize="11"
                                       Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding AlarmDeadBand, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBox}"
                                     FontFamily="{DynamicResource MonoFont}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── 버튼 ── -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Command="{Binding ApplyCommand}"
                    Style="{DynamicResource PrimaryBtn}"
                    Content="✔  적용" Height="34"/>
            <Button Grid.Column="2"
                    Command="{Binding ResetCommand}"
                    Style="{DynamicResource SecondaryBtn}"
                    Content="↺  되돌리기" Height="34" Padding="14,0"/>
        </Grid>
    </Grid>
</UserControl>
