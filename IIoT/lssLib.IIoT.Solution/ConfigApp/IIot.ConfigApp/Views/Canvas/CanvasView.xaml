<!-- ══════════════════════════════════════════════════════════
     IIoT.ConfigApp · Views/Canvas/CanvasView.xaml
     역할: NodeRed 스타일 수집 흐름 캔버스 편집기
     구성:
       좌(200px) — 노드 팔레트 (카테고리별 드래그 소스)
       우(*)     — 편집 캔버스 (WPF Canvas + ScaleTransform)
       하단 툴바 — 줌/자동배치/저장/샘플
     WPF 규칙:
       · DynamicResource 필수
       · TextBlock 혼합 콘텐츠 금지
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.ConfigApp.Views.Canvas.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:IIoT.ConfigApp.ViewModels.Canvas"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="160"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             좌: 노드 팔레트
             ══════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- 팔레트 헤더 -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,8">
                    <TextBlock Text="📦 노드 팔레트"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource Text2Brush}"/>
                </Border>

                <!-- 팔레트 항목 목록 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Palette}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgBrush}"
                                                Padding="10,4">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource Text3Brush}"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PaletteItem}">
                                <!-- 팔레트 항목 — 클릭하면 캔버스에 노드 추가 -->
                                <Button Command="{Binding DataContext.AddNodeCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding NodeType}"
                                        Margin="6,2" Padding="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource GhostBtn}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </Button.Style>
                                    <Border Margin="0" Padding="8,6" CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource BorderBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- 노드 색상 바 -->
                                            <Border Width="4" CornerRadius="2"
                                                    Margin="0,0,8,0">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Color,
                                                        Converter={x:Null}}"/>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="{Binding Icon}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- 구분선 -->
        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      Cursor="SizeWE"/>

        <!-- ══════════════════════════════════════════════
             우: 편집 캔버스 영역
             ══════════════════════════════════════════════ -->
        <DockPanel Grid.Column="2">

            <!-- 하단 툴바 -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="10,5">
                <DockPanel>

                    <!-- 상태 텍스트 -->
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding StatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <!-- 변경 표시 -->
                    <TextBlock DockPanel.Dock="Left"
                               Text="● 미저장"
                               FontSize="11"
                               Foreground="{DynamicResource YellowBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 툴바 버튼 우측 정렬 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding Nodes.Count, StringFormat='노드: {0}개'}"
                                   FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text3Brush}"
                                   FontFamily="{DynamicResource MonoFont}"
                                   Margin="0,0,12,0"/>
                        <Button Command="{Binding LoadSampleFlowCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Content="↺ 샘플" Padding="8,3" FontSize="11"
                                Margin="0,0,6,0"/>
                        <Button Command="{Binding AutoLayoutCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Content="⊞ 자동배치" Padding="8,3" FontSize="11"
                                Margin="0,0,6,0"/>
                        <Separator Style="{x:Null}" Width="1"
                                   Background="{DynamicResource BorderBrush}"
                                   Margin="4,2"/>
                        <Button Command="{Binding ZoomOutCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Content="🔍-" Padding="6,3" FontSize="12"
                                Margin="4,0,2,0"/>
                        <TextBlock Text="{Binding Scale, StringFormat='{}{0:P0}'}"
                                   FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text2Brush}"
                                   FontFamily="{DynamicResource MonoFont}"
                                   Width="42" TextAlignment="Center"/>
                        <Button Command="{Binding ZoomInCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Content="🔍+" Padding="6,3" FontSize="12"
                                Margin="2,0,4,0"/>
                        <Button Command="{Binding ResetViewCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Content="↺" Padding="6,3" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 캔버스 본체 — 격자 배경 + 노드/연결선 -->
            <Border Background="{DynamicResource BgBrush}"
                    ClipToBounds="True"
                    x:Name="CanvasBorder">
                <Grid>

                    <!-- 격자 배경 -->
                    <Rectangle Fill="{DynamicResource GridDotBrush}" Opacity="0.6"/>

                    <!-- 메인 캔버스 (ScaleTransform 적용) -->
                    <Canvas x:Name="MainCanvas"
                            ClipToBounds="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform   ScaleX="{Binding Scale}"
                                                  ScaleY="{Binding Scale}"/>
                                <TranslateTransform X="{Binding OffsetX}"
                                                    Y="{Binding OffsetY}"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>

                        <!-- 연결선 레이어 (노드 아래) -->
                        <ItemsControl x:Name="ConnectionsControl"
                                      ItemsSource="{Binding Connections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 연결선: 코드비하인드에서 Path로 그림 -->
                                    <Canvas Tag="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 노드 레이어 -->
                        <ItemsControl x:Name="NodesControl"
                                      ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left"
                                            Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top"
                                            Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 노드 카드 -->
                                    <Border Width="{Binding Width}"
                                            Height="{Binding Height}"
                                            CornerRadius="{DynamicResource RadiusSm}"
                                            BorderThickness="1"
                                            Cursor="SizeAll">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource CardBrush}"/>
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource Border2Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource AccBrush}"/>
                                                        <Setter Property="BorderThickness"
                                                                Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="22"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- 노드 헤더 (카테고리 컬러 배경) -->
                                            <Border Grid.Row="0"
                                                    CornerRadius="3,3,0,0"
                                                    Background="{DynamicResource AccBrush}"
                                                    Padding="6,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding NodeType}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 노드 본체 -->
                                            <StackPanel Grid.Row="1"
                                                        VerticalAlignment="Center"
                                                        Margin="6,2">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- 실행 상태 표시 -->
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource Text3Brush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource GreenBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </Canvas>
                </Grid>
            </Border>

        </DockPanel>
    </Grid>
</UserControl>
