<!-- ══════════════════════════════════════════════════════════
     IIoT.Collector · App.xaml
     역할: 애플리케이션 리소스 선언 (BoolToVisibilityConverter 전역 등록)
     규칙:
       ① StartupUri 없음 — App.xaml.cs OnStartup 에서 창 직접 생성
          (StartupUri + Show() 동시 사용 → 이중 창 버그)
       ② BoolToVisibilityConverter 는 MergedDictionaries 안에 등록
          (최상위 ResourceDictionary 직접 등록 시 테마 전환 때 소멸)
     생성: 2026-06-29
     ══════════════════════════════════════════════════════════ -->
<Application x:Class="IIoT.Collector.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  ★ BoolToVisibilityConverter 전역 등록
                     각 View 에서 {StaticResource BoolToVisibility} 로 참조
                     MergedDictionaries 안에 있어야 테마 전환 후에도 유지됨
                -->
                <ResourceDictionary>
                    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
