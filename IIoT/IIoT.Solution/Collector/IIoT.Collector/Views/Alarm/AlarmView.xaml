<!-- ══════════════════════════════════════════════════════════
     IIoT.Collector · Views/Alarm/AlarmView.xaml
     역할: 알람 탭 — 활성 알람 목록 + 이력 표시
     Col-Base-1: 레이아웃 뼈대
     C-06: AlarmViewModel 실데이터 바인딩, ACK 기능 연결
     C-EX-05: 알람 억제(Shelving) 버튼 추가
     생성: 2026-06-29 / 수정: 2026-07-06
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Collector.Views.Alarm.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"   />  <!-- 활성 알람 -->
            <RowDefinition Height="4"   />  <!-- GridSplitter -->
            <RowDefinition Height="200" />  <!-- 알람 이력 -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════
             § 상단 — 활성 알람 목록
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*"  />
            </Grid.RowDefinitions>

            <!-- 헤더 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="🔔"
                                   FontSize="14"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="활성 알람"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />

                        <!-- 활성 알람 수 배지 -->
                        <Border Background="#C0392B"
                                CornerRadius="10"
                                Padding="8,2"
                                Margin="8,0,0,0">
                            <TextBlock Text="{Binding ActiveCount}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="White" />
                        </Border>

                        <!-- ACK 된 알람 수 배지 -->
                        <Border Background="#6C757D"
                                CornerRadius="10"
                                Padding="8,2"
                                Margin="4,0,0,0">
                            <TextBlock Text="{Binding AckedCount, StringFormat='ACK {0}'}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="White" />
                        </Border>
                    </StackPanel>

                    <!-- 전체 ACK 버튼 -->
                    <Button DockPanel.Dock="Right"
                            Content="✔ 전체 ACK"
                            Command="{Binding AckAllCommand}"
                            Style="{DynamicResource GhostBtn}"
                            FontSize="11"
                            Padding="10,4"
                            VerticalAlignment="Center" />

                    <!-- ★ C-EX-05 신규: 1시간 알람 억제 -->
                    <Button DockPanel.Dock="Right"
                            Content="🔕 1시간 억제"
                            Command="{Binding ShelveAlarmCommand}"
                            CommandParameter="{Binding SelectedAlarm}"
                            Style="{DynamicResource GhostBtn}"
                            FontSize="11"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center" />

                    <!-- 선택 ACK 버튼 -->
                    <Button DockPanel.Dock="Right"
                            Content="✔ ACK"
                            Command="{Binding AckAlarmCommand}"
                            CommandParameter="{Binding SelectedAlarm}"
                            Style="{DynamicResource GhostBtn}"
                            FontSize="11"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- 활성 알람 DataGrid -->
            <DataGrid Grid.Row="1"
                      Style="{DynamicResource IIoTGrid}"
                      ItemsSource="{Binding ActiveAlarms}"
                      SelectedItem="{Binding SelectedAlarm}"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="레벨"   Width="60"
                                        Binding="{Binding LevelText}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource GridStatusGood}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LevelText}" Value="HH">
                                        <Setter Property="Foreground" Value="#E05050" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LevelText}" Value="H">
                                        <Setter Property="Foreground" Value="#EF9F27" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LevelText}" Value="L">
                                        <Setter Property="Foreground" Value="#4C9FD4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LevelText}" Value="LL">
                                        <Setter Property="Foreground" Value="#AA66FF" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="상태"   Width="70"
                                        Binding="{Binding StatusText}" />
                    <DataGridTextColumn Header="Tag"   Width="150"
                                        Binding="{Binding TagName}" />
                    <DataGridTextColumn Header="메시지" Width="*"
                                        Binding="{Binding Message}" />
                    <DataGridTextColumn Header="현재값"   Width="90"
                                        Binding="{Binding CurrentEngValue, StringFormat='F2'}"
                                        ElementStyle="{DynamicResource IIoTGridCellMono}" />
                    <DataGridTextColumn Header="발생시각" Width="80"
                                        Binding="{Binding OccurredAtText}" />
                    <DataGridTextColumn Header="갱신시각" Width="80"
                                        Binding="{Binding UpdatedAtText}" />
                </DataGrid.Columns>

                <!-- 행 스타일: 발생=빨강 배경, ACK=회색 -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow"
                           BasedOn="{StaticResource IIoTGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                <Setter Property="Background" Value="#2A1414" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Acked">
                                <Setter Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>

        <!-- GridSplitter (상하 분할) -->
        <GridSplitter Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS" />

        <!-- ══════════════════════════════════════════════════
             § 하단 — 알람 이력
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*"  />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="16,0">
                <TextBlock Text="알람 이력"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center" />
            </Border>

            <!-- 이력 DataGrid -->
            <DataGrid Grid.Row="1"
                      Style="{DynamicResource IIoTGrid}"
                      ItemsSource="{Binding AlarmHistory}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="레벨"   Width="60"
                                        Binding="{Binding LevelText}" />
                    <DataGridTextColumn Header="상태"   Width="70"
                                        Binding="{Binding StatusText}" />
                    <DataGridTextColumn Header="Tag"   Width="150"
                                        Binding="{Binding TagName}" />
                    <DataGridTextColumn Header="메시지" Width="*"
                                        Binding="{Binding Message}" />
                    <DataGridTextColumn Header="발생시각" Width="80"
                                        Binding="{Binding OccurredAtText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid>
</UserControl>
