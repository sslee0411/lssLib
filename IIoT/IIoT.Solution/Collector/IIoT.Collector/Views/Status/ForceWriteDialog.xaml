<!-- ══════════════════════════════════════════════════════════
     IIoT.Collector · Views/Status/ForceWriteDialog.xaml
     역할: Tag 강제값 쓰기(Force Write) 입력 모달 다이얼로그
           StatusView 의 "강제쓰기" 버튼 클릭 시 표시
     C-15: 신규
     C-EX-02: API Key 입력란 추가 (Security.ForceWriteApiKey 설정 시에만 필요)
     생성: 2026-07-06 / 수정: 2026-07-06
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Collector.Views.Status.ForceWriteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag 강제값 쓰기"
        Width="380" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="TxtTagName"
                   FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="0,0,0,4" />

        <TextBlock Grid.Row="1"
                   x:Name="TxtTagInfo"
                   FontSize="11"
                   Foreground="{DynamicResource Text2Brush}"
                   Margin="0,0,0,16" />

        <TextBlock Grid.Row="2"
                   Text="쓸 값 (Raw 값 기준)"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text2Brush}"
                   Margin="0,0,0,6" />

        <TextBox Grid.Row="3"
                 x:Name="TxtValue"
                 Style="{DynamicResource PropInput}"
                 Margin="0,0,0,12" />

        <!-- ★ C-EX-02 신규: API Key 입력 (settings.json Security.ForceWriteApiKey
             가 설정된 경우에만 필요 — 비어있으면 그냥 빈 값으로 전달해도 통과됨) -->
        <TextBlock Grid.Row="4"
                   Text="API Key (설정된 경우에만 입력)"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text2Brush}"
                   Margin="0,0,0,6" />

        <PasswordBox Grid.Row="5"
                     x:Name="PwdApiKey"
                     Background="{DynamicResource CardBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     Padding="8,6"
                     Margin="0,0,0,8" />

        <TextBlock Grid.Row="6"
                   x:Name="TxtWarning"
                   FontSize="11"
                   Foreground="{DynamicResource RedBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top" />

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="취소"
                    Width="70"
                    Margin="0,0,8,0"
                    Style="{DynamicResource GhostBtn}"
                    Click="CancelButton_Click" />
            <Button Content="쓰기"
                    Width="70"
                    Style="{DynamicResource SecondaryBtn}"
                    Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</Window>
