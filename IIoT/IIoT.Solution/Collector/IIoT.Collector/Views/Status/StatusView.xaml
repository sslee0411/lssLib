<!-- ══════════════════════════════════════════════════════════
     IIoT.Collector · Views/Status/StatusView.xaml
     역할: 수집 현황 탭 — 실시간 Tag 값 표시 영역
     Col-Base-1: 레이아웃 뼈대
     C-04: StatusViewModel 바인딩 — 통계 카드 + Tag DataGrid 실데이터 연결
     생성: 2026-06-29 / 수정: 2026-06-29
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Collector.Views.Status.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="360" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════
             § 좌측 — 수집 통계 패널 (240px)
             ══════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Height="40"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0">
                    <TextBlock Text="수집 통계"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <!-- 전체 현황 카드 — C-04: 실데이터 바인딩 -->
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="전체 현황"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="총 Tag"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text2Brush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding TotalTagCount}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Right" />

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="정상 (Good)"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text2Brush}"
                                               Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding GoodCount}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#3FB950"
                                               HorizontalAlignment="Right"
                                               Margin="0,6,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="오류/미수신"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text2Brush}"
                                               Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding BadCount}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#E05050"
                                               HorizontalAlignment="Right"
                                               Margin="0,6,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 드라이버 상태 카드 — C-04: 연결 PLC 수 바인딩 -->
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="드라이버"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="연결됨"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text2Brush}" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ConnectedPlcCount}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#3FB950" />
                                        <TextBlock Text=" / " FontSize="12"
                                                   Foreground="{DynamicResource Text2Brush}" />
                                        <TextBlock Text="{Binding TotalPlcCount}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      Cursor="SizeWE"
                      ShowsPreview="False" />

        <!-- ══════════════════════════════════════════════════
             § 우측 — Tag 목록 (C-04: 실시간 DataGrid)
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="2"
              Background="{DynamicResource BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                <DockPanel>
                    <TextBlock Text="수집 태그 목록"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding TotalTagCount, StringFormat='총 {0}개'}"
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Tag DataGrid -->
            <DataGrid Grid.Row="1"
                      x:Name="TagGrid"
                      ItemsSource="{Binding LiveTags}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="28"
                      Background="{DynamicResource SurfaceBrush}"
                      Foreground="{DynamicResource TextBrush}"
                      BorderThickness="0"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PLC"   Width="140" Binding="{Binding PlcName}" />
                    <DataGridTextColumn Header="Tag"   Width="160" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="값"     Width="100" Binding="{Binding DisplayValue}" />
                    <DataGridTextColumn Header="단위"   Width="70"  Binding="{Binding Unit}" />
                    <DataGridTextColumn Header="품질"   Width="90"  Binding="{Binding Quality}" />
                    <DataGridTextColumn Header="갱신시각" Width="110" Binding="{Binding UpdatedAtText}" />
                </DataGrid.Columns>

                <!-- 행 스타일: 품질별 색상 -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Quality}" Value="Bad">
                                <Setter Property="Background" Value="#2A1414" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Quality}" Value="Timeout">
                                <Setter Property="Background" Value="#2A2014" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Quality}" Value="Disconnected">
                                <Setter Property="Background" Value="#1A1A1A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

        </Grid>
    </Grid>
</UserControl>
