<!-- ══════════════════════════════════════════════════════════
     IIoT.Collector · Views/Status/StatusView.xaml
     역할: 수집 현황 탭 — 실시간 Tag 값 표시 영역
     Col-Base-1: 레이아웃 뼈대 (좌: 수집 통계 패널 / 우: Tag 목록)
     C-01~   : device.json 로드 후 Tag 목록 표시 예정
     C-04~   : LiveTag DataGrid 실시간 갱신 예정
     생성: 2026-06-29
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Collector.Views.Status.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="360" />
            <ColumnDefinition Width="4" />   <!-- GridSplitter -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════
             § 좌측 — 수집 통계 패널 (240px)
             ══════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- 헤더 -->
                    <RowDefinition Height="*"    />  <!-- 통계 카드 목록 -->
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <Border Grid.Row="0"
                        Height="40"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0">
                    <TextBlock Text="수집 통계"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                </Border>

                <!-- 통계 카드 영역 (C-03 FlowEngine 연결 후 채워짐) -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <!-- 전체 현황 카드 -->
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="전체 현황"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="총 Tag"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text2Brush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="—"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Right" />

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="수집 중"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text2Brush}"
                                               Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="—"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#3FB950"
                                               HorizontalAlignment="Right"
                                               Margin="0,6,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="오류"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text2Brush}"
                                               Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="—"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#E05050"
                                               HorizontalAlignment="Right"
                                               Margin="0,6,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 드라이버 상태 카드 -->
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="드라이버"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="C-01 이후 표시됩니다"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 수집 속도 카드 -->
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="수집 속도"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="폴링 주기"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text2Brush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="— ms"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      Cursor="SizeWE"
                      ShowsPreview="False" />

        <!-- ══════════════════════════════════════════════════
             § 우측 — Tag 목록 영역
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="2"
              Background="{DynamicResource BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />  <!-- 툴바 -->
                <RowDefinition Height="*"  />  <!-- Tag DataGrid -->
            </Grid.RowDefinitions>

            <!-- 툴바 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                <DockPanel>
                    <TextBlock Text="수집 태그 목록"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />

                    <!-- 우측: 검색 (C-04 연결 예정) -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="🔍"
                                   FontSize="13"
                                   Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBox Width="180"
                                 FontSize="11"
                                 IsEnabled="False"
                                 Background="{DynamicResource CardBrush}"
                                 Foreground="{DynamicResource Text2Brush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 ToolTip="C-04 에서 활성화됩니다"
                                 Text="C-04에서 활성화" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tag DataGrid 자리 — C-04 LiveTagView 로 교체 예정 -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="📋"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               Opacity="0.3" />
                    <TextBlock Text="device.json 로드 후 Tag 목록이 표시됩니다"
                               FontSize="13"
                               Foreground="{DynamicResource Text2Brush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="C-01 단계에서 구현됩니다"
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Opacity="0.6" />
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
