<!-- ══════════════════════════════════════════════════════════
     IIoT.Collector · Views/Device/DeviceTreeView.xaml
     역할: [장비] 탭 — DeviceInstance 트리(PLC → Tag) 조회 화면
           검색어로 Device/Tag 이름 필터링, 알람/품질 상태 색상 표시
           통신상태·주소/DataType·가상Tag수식·전역(압축/필터 등)설정 표시
     C-EX-01-6: 신규
     업데이트: 2026-07-06 (통신상태/주소·DataType/수식/전역설정 표시 추가)
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Collector.Views.Device.DeviceTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IIoT.Collector.ViewModels"
             Background="{DynamicResource BgBrush}">

    <UserControl.Resources>
        <!-- ★ SKILL.md 규칙: UserControl.Resources 는 <UserControl> 직계 자식이어야 함 -->
        <!-- HasAlarm/HasExpression(bool) → Visibility 변환용 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 검색 + 요약 -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding SummaryText}"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Width="260"
                         VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ★ 신규: 전역(공통) 설정 요약 — 압축/필터/강제쓰기/알림/가상Tag 활성 여부 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0">
            <TextBlock Text="{Binding GlobalSettingsText}"
                       FontSize="10"
                       Foreground="{DynamicResource Text3Brush}"
                       VerticalAlignment="Center" />
        </Border>

        <!-- 트리 -->
        <!-- ★ 버그 근본 수정 (2026-07-06): 자체 SystemColors 오버라이드 대신
             IIoT.UI.Themes 에 이미 존재하는 DeviceTreeView/DeviceTreeItem 스타일을
             재사용한다. 이 스타일은 완전한 커스텀 ControlTemplate 이라 SystemColors
             를 아예 참조하지 않으므로, 포커스 이동 시 흰색이 노출되는 문제 자체가
             구조적으로 발생하지 않는다 (Styles.TreeView.xaml Phase 5 에서 이미
             DynamicResource 전환까지 완료된 검증된 스타일).
             IsExpanded=True 도 DeviceTreeItem 자체에 기본 포함되어 있어
             별도 Setter 불필요. -->
        <TreeView Grid.Row="2"
                  Style="{DynamicResource DeviceTreeView}"
                  ItemsSource="{Binding Devices}"
                  ItemContainerStyle="{DynamicResource DeviceTreeItem}">

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:DeviceTreeNodeViewModel}"
                                           ItemsSource="{Binding Tags}">
                    <!-- Device(PLC) 헤더 행 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding StatusIcon}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" />

                        <!-- ★ 신규: 통신 상태 라벨 -->
                        <Border Background="{DynamicResource CardBrush}"
                                CornerRadius="3"
                                Padding="6,1"
                                Margin="8,0,0,0">
                            <TextBlock Text="{Binding ConnectionStatusText}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding StatusColor}" />
                        </Border>

                        <TextBlock Text="{Binding SubTitle}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TagTreeNodeViewModel}">
                            <!-- ★ 요청사항: 상위 노드(아이콘+이름) 위치에 맞춰 들여쓰기 -->
                            <Grid Margin="24,3,0,3" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 이름 -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" />

                                <!-- ★ 요청사항: 이름과 값 사이 — 비활성/품질이상 상태 배지 -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource CardBrush}"
                                        CornerRadius="3"
                                        Padding="6,1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasStatusIssue,
                                                     Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding StatusBadgeText}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding StatusBadgeColor}" />
                                </Border>

                                <!-- 값 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="값 " FontSize="11"
                                               Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Text="{Binding ValueText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccBrush}" />
                                </StackPanel>

                                <!-- 스케일 -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <TextBlock Text="스케일 " FontSize="11"
                                               Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Text="{Binding ScaleText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Text2Brush}" />
                                </StackPanel>

                                <!-- 스케일 뒤로 알람/알림/주소를 이어서 한 줄에 표시 -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <TextBlock Text="알람 " FontSize="11"
                                               Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Text="{Binding AlarmText}" FontSize="11"
                                               Foreground="{DynamicResource Text2Brush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                    <TextBlock Text="알림 " FontSize="11"
                                               Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Text="{Binding NotifyText}" FontSize="11"
                                               Foreground="{DynamicResource Text2Brush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="6" Orientation="Horizontal">
                                    <TextBlock Text="주소 " FontSize="11"
                                               Foreground="{DynamicResource Text3Brush}" />
                                    <TextBlock Text="{Binding AddressText}" FontSize="11"
                                               Foreground="{DynamicResource Text2Brush}" />
                                </StackPanel>

                                <!-- 나머지(활성알람배지 · 가상배지 · 가상Tag수식) — 맨 끝 -->
                                <StackPanel Grid.Column="7" Orientation="Horizontal">
                                    <Border Background="#552A1414"
                                            CornerRadius="3"
                                            Padding="6,1"
                                            Margin="0,0,10,0"
                                            Visibility="{Binding HasAlarm,
                                                         Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding AlarmBadge}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="#FF6B6B" />
                                    </Border>

                                    <TextBlock Text="{Binding ExtraBadge}" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#D4A72C"
                                               Margin="0,0,10,0" />

                                    <TextBlock Text="{Binding ExpressionText}" FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource AccBrush}"
                                               Visibility="{Binding HasExpression,
                                                            Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
