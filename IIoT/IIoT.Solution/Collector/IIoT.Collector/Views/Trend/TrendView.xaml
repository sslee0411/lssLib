<!-- ══════════════════════════════════════════════════════════
     IIoT.Collector · Views/Trend/TrendView.xaml
     역할: 수집 이력 조회 탭 — Tag 선택 + 기간 설정 + LiveCharts2 LineChart
     C-13: 신규
     생성: 2026-07-01
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Collector.Views.Trend.TrendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{DynamicResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />   <!-- 툴바 -->
            <RowDefinition Height="*"  />   <!-- 차트 -->
            <RowDefinition Height="28" />   <!-- 상태바 -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════
             § 툴바 — Tag 선택 + 기간 + 조회 버튼
             ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">

                <!-- Tag 선택 -->
                <TextBlock Text="Tag"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox Style="{DynamicResource PropCombo}"
                          Width="200"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableTags}"
                          SelectedItem="{Binding SelectedTag}"
                          Margin="0,0,16,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PlcId}"
                                           FontSize="10"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding TagName}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 기간 프리셋 -->
                <TextBlock Text="기간"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox Style="{DynamicResource PropCombo}"
                          Width="130"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding RangePresets}"
                          SelectedItem="{Binding SelectedRange}"
                          Margin="0,0,12,0" />

                <!-- 사용자 지정 기간 (조건부 표시) -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCustomRange}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <DatePicker SelectedDate="{Binding FromDate}"
                                Width="110"
                                FontSize="11"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center" />
                    <TextBox Style="{DynamicResource PropInput}"
                             Text="{Binding FromTime, StringFormat='hh\\:mm'}"
                             Width="55"
                             FontSize="11"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <TextBlock Text="~"
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding ToDate}"
                                Width="110"
                                FontSize="11"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center" />
                    <TextBox Style="{DynamicResource PropInput}"
                             Text="{Binding ToTime, StringFormat='hh\\:mm'}"
                             Width="55"
                             FontSize="11"
                             VerticalAlignment="Center" />
                </StackPanel>

                <!-- 조회 버튼 -->
                <Button Content="🔍 조회"
                        Command="{Binding QueryCommand}"
                        Style="{DynamicResource PrimaryBtn}"
                        FontSize="11"
                        Padding="14,5"
                        VerticalAlignment="Center" />

                <!-- 로딩 표시 -->
                <TextBlock Text="⏳ 조회 중..."
                           FontSize="11"
                           Foreground="{DynamicResource AccBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Visibility="{Binding IsLoading,
                                        Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 차트 영역 — LiveCharts2 LineChart
             ══════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                Margin="0">

            <!-- 데이터 없을 때 안내 -->
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.35">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Series.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="📈"
                               FontSize="56"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Tag 와 기간을 선택 후 조회하세요"
                               FontSize="14"
                               Foreground="{DynamicResource Text2Brush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>

                <!-- LiveCharts2 LineChart -->
                <lvc:CartesianChart Series="{Binding Series}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    LegendPosition="Top"
                                    Background="Transparent"
                                    Margin="8">
                    <lvc:CartesianChart.Style>
                        <Style TargetType="lvc:CartesianChart">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Series.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </lvc:CartesianChart.Style>
                </lvc:CartesianChart>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 상태바
             ══════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11"
                       Foreground="{DynamicResource Text2Brush}"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
