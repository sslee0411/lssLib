<!-- ══════════════════════════════════════════════════════════
     IIoT.Collector · MainWindow.xaml
     역할: 메인 창
     Col-Base-0: 헤더(56px) + 탭바(40px) + 하단 로그 패널 + 본문 임시 블록
     Col-Base-1: 본문 임시 블록 → 실제 View 교체
                 xmlns:vStatus / xmlns:vAlarm 추가
                 StatusView / AlarmView / 수집흐름 임시 패널 연결
     생성: 2026-06-29
     규칙:
       ① DynamicResource 필수 (StaticResource → 테마 전환 시 깨짐)
       ② BoolToVisibility: Window.Resources 직접 등록
       ③ xmlns:uc assembly="IIoT.UI.Themes" (크로스-프로젝트 xmlns)
       ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Collector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        xmlns:local="clr-namespace:IIoT.Collector.Views.Log"
        xmlns:vStatus="clr-namespace:IIoT.Collector.Views.Status"
        xmlns:vAlarm="clr-namespace:IIoT.Collector.Views.Alarm"
        Title="IIoT Collector — 수집"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <!--
          ★ BoolToVisibilityConverter Window.Resources 직접 등록
             (App.xaml MergedDictionaries 에도 등록되어 있지만
              Window 단위 명시적 등록으로 이중 안전망 확보)
        -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ══════════════════════════════════════════════════
             § 헤더 (56px) — 타이틀 + ThemePickerButton
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">

                <!-- 좌: 타이틀 + 부제 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="⚙"
                               FontSize="20"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="IIoT Collector"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="수집 런타임"
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>

                <!-- 우: ThemePickerButton -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <uc:ThemePickerButton />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 탭바 (40px)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Height="40"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Stretch"
                        Margin="8,0,0,0">

                <Button Content="📊  수집 현황"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="0"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />

                <Button Content="🔔  알람"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="1"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />

                <Button Content="🔀  수집 흐름"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="2"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />

                <!-- 로그 패널 토글 버튼 (탭 전환이 아닌 하단 패널 토글) -->
                <Button Content="📋  로그"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="3"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 하단 상태바 (26px)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Height="26"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <TextBlock Text="● 준비됨"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right"
                           Text="IIoT.Collector v0.1"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 하단 로그 패널 (토글)
             DockPanel.Dock="Bottom" 순서:
               상태바보다 먼저 선언 → 상태바 위에 위치
             LogPanelVisible=false → Collapsed (기본 숨김)
             LogPanelVisible=true  → Visible   (로그 버튼 클릭 시)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Height="180"
                Visibility="{Binding LogPanelVisible,
                             Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GridSplitter Grid.Row="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS" />

                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <local:LogPanelView />
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 본문 — 탭별 View
             Col-Base-1: 실제 View 연결 완료
             ══════════════════════════════════════════════════ -->
        <Grid Background="{DynamicResource BgBrush}">

            <!-- 수집 현황 탭 (0) — StatusView -->
            <Grid Visibility="{Binding IsStatusTab,
                               Converter={StaticResource BoolToVisibility}}">
                <vStatus:StatusView />
            </Grid>

            <!-- 알람 탭 (1) — AlarmView -->
            <Grid Visibility="{Binding IsAlarmTab,
                               Converter={StaticResource BoolToVisibility}}">
                <vAlarm:AlarmView />
            </Grid>

            <!-- 수집 흐름 탭 (2) — C-09 구현 예정 -->
            <Border Background="{DynamicResource BgBrush}"
                    Visibility="{Binding IsFlowTab,
                                 Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="🔀"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Opacity="0.3" />
                    <TextBlock Text="수집 흐름 시각화"
                               FontSize="20"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="C-09 단계에서 구현됩니다"
                               FontSize="13"
                               Foreground="{DynamicResource Text2Brush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Opacity="0.6" />
                </StackPanel>
            </Border>

        </Grid>

    </DockPanel>
</Window>
