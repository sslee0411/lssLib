<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/Canvas/CanvasView.xaml
     역할: NodeRed 스타일 수집 흐름 캔버스
     S-11: 초기 구현
     S-12: 포트 점(●) UI 추가
           드래그 연결선 미리보기 레이어 추가
           포트는 노드 카드 좌(입력)/우(출력) 중앙에 표시
     생성: 2026-06-17
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.Canvas.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:canvas="clr-namespace:IIoT.Studio.Core.Canvas"
             Background="{DynamicResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <canvas:HexColorConverter    x:Key="HexColor"/>

        <!-- ── 노드 카드 템플릿 ──────────────────────────────── -->
        <DataTemplate x:Key="NodeCardTemplate">
            <Grid>
                <!-- 입력 포트 (좌측) — 노드에 InputPorts 있을 때만 -->
                <ItemsControl ItemsSource="{Binding InputPorts}"
                              IsHitTestVisible="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 입력 포트 원: 노드 좌측 중앙 -->
                            <Ellipse x:Name="InPort"
                                     Width="14" Height="14"
                                     Fill="{DynamicResource SurfaceBrush}"
                                     Stroke="{DynamicResource AccBrush}"
                                     StrokeThickness="2"
                                     Cursor="Cross"
                                     Tag="{Binding}"
                                     Canvas.Left="-7"
                                     Canvas.Top="23">
                                <Ellipse.ToolTip>
                                    <TextBlock Text="{Binding Label}"/>
                                </Ellipse.ToolTip>
                            </Ellipse>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 노드 카드 본체 -->
                <Border Width="160" MinHeight="60"
                        Background="{DynamicResource CardBrush}"
                        BorderThickness="2"
                        CornerRadius="6"
                        Cursor="SizeAll"
                        Margin="0,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource AccBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="6,0,0,6">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding CategoryColor,
                                    Converter={StaticResource HexColor}}"/>
                            </Border.Background>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="8,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding IconGlyph}"
                                           FontSize="13" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Label}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding NodeType}"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text2Brush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 출력 포트 (우측) -->
                <ItemsControl ItemsSource="{Binding OutputPorts}"
                              IsHitTestVisible="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 출력 포트 원: 노드 우측 중앙 -->
                            <Ellipse x:Name="OutPort"
                                     Width="14" Height="14"
                                     Fill="{DynamicResource AccBrush}"
                                     Stroke="{DynamicResource SurfaceBrush}"
                                     StrokeThickness="2"
                                     Cursor="Cross"
                                     Tag="{Binding}"
                                     Canvas.Left="153"
                                     Canvas.Top="23">
                                <Ellipse.ToolTip>
                                    <TextBlock Text="{Binding Label}"/>
                                </Ellipse.ToolTip>
                            </Ellipse>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </DataTemplate>

        <!-- ── 팔레트 버튼 템플릿 ────────────────────────────── -->
        <DataTemplate x:Key="PaletteItemTemplate">
            <Button Command="{Binding DataContext.AddNodeCommand,
                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding NodeType}"
                    Style="{DynamicResource ToolbarBtn}"
                    HorizontalContentAlignment="Left"
                    Margin="0,0,0,4" Padding="10,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}"
                               FontSize="14" Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════
             § 좌측 팔레트
             ══════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12,10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="노드 팔레트"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PaletteItems}"
                              ItemTemplate="{StaticResource PaletteItemTemplate}"
                              Margin="8"/>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

        <!-- ══════════════════════════════════════════
             § 우측 캔버스
             ══════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- 툴바 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="8,0"
                            VerticalAlignment="Center">
                    <Button Content="🔍＋" Command="{Binding ZoomInCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4" Margin="0,0,2,0"/>
                    <Button Content="🔍－" Command="{Binding ZoomOutCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4" Margin="0,0,2,0"/>
                    <Button Content="⟳ 초기화" Command="{Binding ZoomResetCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ScalePercent}"
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="🗑 선택 삭제"
                            Command="{Binding DeleteSelectedCommand}"
                            Style="{DynamicResource DangerBtn}"
                            Padding="8,4"
                            Visibility="{Binding HasSelection,
                                Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- 캔버스 영역 -->
            <Border x:Name="CanvasBorder"
                    Grid.Row="1"
                    Background="#0D1117"
                    ClipToBounds="True">

                <Canvas x:Name="RootCanvas">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ScaleXY"
                                            ScaleX="{Binding Scale}"
                                            ScaleY="{Binding Scale}"/>
                            <TranslateTransform x:Name="PanXY"
                                                X="{Binding OffsetX}"
                                                Y="{Binding OffsetY}"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- 레이어 1: 확정 연결선 -->
                    <ItemsControl x:Name="ConnectionsLayer"
                                  ItemsSource="{Binding Connections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Path Data="{Binding PathData}"
                                      Stroke="{DynamicResource AccBrush}"
                                      StrokeThickness="2.5"
                                      Fill="Transparent"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 레이어 2: 드래그 중 미리보기 연결선 (★ S-12) -->
                    <Path x:Name="DragPreviewPath"
                          Data="{Binding DragConnectionPath}"
                          Stroke="{DynamicResource AccBrush}"
                          StrokeThickness="2"
                          StrokeDashArray="6 3"
                          Fill="Transparent"
                          Opacity="0.7"
                          Visibility="{Binding IsDraggingConnection,
                              Converter={StaticResource BoolToVisibility}}"/>

                    <!-- 레이어 3: 노드 카드 -->
                    <ItemsControl x:Name="NodesLayer"
                                  ItemsSource="{Binding Nodes}"
                                  ItemTemplate="{StaticResource NodeCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                </Canvas>
            </Border>

            <!-- 상태바 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <TextBlock FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text2Brush}">
                    <Run Text="노드: "/>
                    <Run Text="{Binding Nodes.Count, Mode=OneWay}"/>
                    <Run Text="  |  연결선: "/>
                    <Run Text="{Binding Connections.Count, Mode=OneWay}"/>
                    <Run Text="  |  출력포트(●) 드래그 → 입력포트(○) 에 연결  |  휠: 줌  |  Space+드래그: 패닝"/>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</UserControl>
