<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/Canvas/CanvasView.xaml
     S-11: 초기 구현
     S-12: 포트 UI + 드래그 미리보기
     S-12B: 팔레트 [장비] 섹션 추가
            PortsLayer (Layer4) 추가 — 절대좌표 포트 (HitTest 완전 해결)
            노드 카드 DataTemplate 에서 포트 제거 (PortsLayer 이관)
     S-20 (N포트 노드): NodeCardTemplate MinHeight를 CardHeight 바인딩으로 동적화 +
            Splitter(분배기)/CompositeCalc(복합계산) 우측 오버레이 포트 편집 패널 추가
     생성: 2026-06-17 / 수정: 2026-07-20
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.Canvas.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:canvas="clr-namespace:IIoT.Studio.Core.Canvas"
             Background="{DynamicResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <canvas:HexColorConverter     x:Key="HexColor"/>

        <!-- ── 노드 카드 템플릿 (포트 없음 — PortsLayer에서 별도 배치) ── -->
        <DataTemplate x:Key="NodeCardTemplate">
            <Border Width="160" MinHeight="{Binding CardHeight}"
                    Background="{DynamicResource CardBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Cursor="SizeAll">

                <!-- ★ S-13B: DeviceNode 우클릭 컨텍스트 메뉴 -->
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📋 템플릿 적용..."
                                  Click="OnContextMenuApplyTemplate"/>
                        <Separator/>
                        <MenuItem Header="🗑 삭제"
                                  Command="{Binding DataContext.DeleteSelectedCommand,
                                      Source={x:Reference Name=RootCanvas}}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource BorderBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource AccBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측 색상 바 -->
                    <Border Grid.Column="0" CornerRadius="6,0,0,6">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding CategoryColor,
                                Converter={StaticResource HexColor}}"/>
                        </Border.Background>
                    </Border>

                    <!-- 노드 본문 -->
                    <StackPanel Grid.Column="1" Margin="8,6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{Binding IconGlyph}"
                                       FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Label}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NodeType}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Text2Brush}"/>

                        <!-- DeviceCanvasNode 전용: Tag 미리보기 -->
                        <ItemsControl ItemsSource="{Binding PreviewTags}"
                                      Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type canvas:TagInfo}">
                                    <TextBlock FontSize="10"
                                               Foreground="{DynamicResource Text2Brush}">
                                        <Run Text="{Binding Name}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Address}"
                                             Foreground="{DynamicResource AccBrush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ExtraTagsText}"
                                   FontSize="10" FontStyle="Italic"
                                   Foreground="{DynamicResource Text2Brush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── 처리 노드 팔레트 버튼 템플릿 ───────────────────── -->
        <DataTemplate x:Key="ProcessItemTemplate">
            <Button Command="{Binding DataContext.AddNodeCommand,
                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding NodeType}"
                    Style="{DynamicResource ToolbarBtn}"
                    HorizontalContentAlignment="Left"
                    Margin="0,0,0,3" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}" FontSize="13"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}" FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- ── 장비 팔레트 버튼 템플릿 (★ S-12B) ─────────────── -->
        <DataTemplate x:Key="DeviceItemTemplate">
            <Button Command="{Binding DataContext.AddDeviceNodeCommand,
                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Style="{DynamicResource ToolbarBtn}"
                    HorizontalContentAlignment="Left"
                    Margin="0,0,0,3" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="13" Margin="0,0,6,0"
                               VerticalAlignment="Center">
                        <TextBlock.Text>
                            <Binding Path="DeviceType">
                                <Binding.Converter>
                                    <canvas:DeviceTypeIconConverter/>
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Text>
                    </TextBlock>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource Text2Brush}">
                            <Run Text="{Binding DeviceType}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding Tags.Count, Mode=OneWay}"/>
                            <Run Text=" Tags"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════
             § 좌측 팔레트
             ══════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 타이틀 -->
                <RowDefinition Height="*"/>     <!-- 스크롤 목록 -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12,10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="노드 팔레트"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,6">

                    <!-- ★ S-12B: 장비 섹션 -->
                    <TextBlock Text="▸ 장비"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccBrush}"
                               Margin="2,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding DevicePaletteItems}"
                                  ItemTemplate="{StaticResource DeviceItemTemplate}"/>

                    <!-- 장비 없을 때 안내 -->
                    <TextBlock Text="장비 관리 탭에서 PLC/장비를 추가하세요."
                               FontSize="10" FontStyle="Italic"
                               Foreground="{DynamicResource Text2Brush}"
                               TextWrapping="Wrap" Margin="4,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding DevicePaletteItems.Count, Mode=OneWay}"
                                        Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 구분선 -->
                    <Border Height="1" Margin="0,8,0,8"
                            Background="{DynamicResource BorderBrush}"/>

                    <!-- 처리 노드 섹션 -->
                    <TextBlock Text="▸ 처리 노드"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="2,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding ProcessItems}"
                                  ItemTemplate="{StaticResource ProcessItemTemplate}"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

        <!-- ══════════════════════════════════════════
             § 우측 캔버스
             ══════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- 툴바 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="8,0"
                            VerticalAlignment="Center">
                    <Button Content="🔍＋" Command="{Binding ZoomInCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4" Margin="0,0,2,0"/>
                    <Button Content="🔍－" Command="{Binding ZoomOutCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4" Margin="0,0,2,0"/>
                    <Button Content="⟳ 초기화" Command="{Binding ZoomResetCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ScalePercent}"
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="🗑 선택 삭제"
                            Command="{Binding DeleteSelectedCommand}"
                            Style="{DynamicResource DangerBtn}"
                            Padding="8,4"
                            Visibility="{Binding HasSelection,
                                Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- 캔버스 영역 -->
            <Border x:Name="CanvasBorder"
                    Grid.Row="1"
                    Background="#0D1117"
                    ClipToBounds="True">

                <Canvas x:Name="RootCanvas">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ScaleXY"
                                            ScaleX="{Binding Scale}"
                                            ScaleY="{Binding Scale}"/>
                            <TranslateTransform x:Name="PanXY"
                                                X="{Binding OffsetX}"
                                                Y="{Binding OffsetY}"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- Layer 1: 확정 연결선 -->
                    <ItemsControl x:Name="ConnectionsLayer"
                                  ItemsSource="{Binding Connections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Path Data="{Binding PathData}"
                                      Stroke="{DynamicResource AccBrush}"
                                      StrokeThickness="2.5"
                                      Fill="Transparent"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Layer 2: 드래그 미리보기 -->
                    <Path x:Name="DragPreviewPath"
                          Data="{Binding DragConnectionPath}"
                          Stroke="{DynamicResource AccBrush}"
                          StrokeThickness="2"
                          StrokeDashArray="6 3"
                          Fill="Transparent"
                          Opacity="0.7"
                          Visibility="{Binding IsDraggingConnection,
                              Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Layer 3: 노드 카드 (포트 없음) -->
                    <ItemsControl x:Name="NodesLayer"
                                  ItemsSource="{Binding Nodes}"
                                  ItemTemplate="{StaticResource NodeCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                    <!-- Layer 4: 포트 Ellipse 절대좌표 (★ S-12B HitTest 해결) -->
                    <!-- 코드비하인드에서 노드 이동 시마다 위치 갱신 -->
                    <Canvas x:Name="PortsLayer"
                            IsHitTestVisible="True"/>

                </Canvas>
            </Border>

            <!-- ★ S-20: 분배기(Splitter) 출력 포트 편집 패널 (선택 시에만 표시) -->
            <Border Grid.Row="1"
                    Width="220"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,10,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="10"
                    Visibility="{Binding IsSplitterSelected,
                        Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="🔱 분배기 출력 포트"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding SelectedNode.OutputPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource PropInput}"
                                             FontSize="11" Padding="4,3"/>
                                    <Button Grid.Column="1" Content="✕"
                                            Style="{DynamicResource GhostBtn}"
                                            Padding="6,2" FontSize="10" Margin="4,0,0,0"
                                            Command="{Binding DataContext.RemoveSelectedNodeOutputPortCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ 출력 추가"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4" FontSize="11" Margin="0,4,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding AddSelectedNodeOutputPortCommand}"/>
                </StackPanel>
            </Border>

            <!-- ★ S-20: 복합계산(CompositeCalc) 입력 포트 + NCalc 식 편집 패널 -->
            <Border Grid.Row="1"
                    Width="240"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,10,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="10"
                    Visibility="{Binding IsCompositeCalcSelected,
                        Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="🧮 복합계산 입력 포트"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding SelectedNode.InputPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource PropInput}"
                                             FontSize="11" Padding="4,3"/>
                                    <Button Grid.Column="1" Content="✕"
                                            Style="{DynamicResource GhostBtn}"
                                            Padding="6,2" FontSize="10" Margin="4,0,0,0"
                                            Command="{Binding DataContext.RemoveSelectedNodeInputPortCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ 입력 추가"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4" FontSize="11" Margin="0,4,0,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding AddSelectedNodeInputPortCommand}"/>
                    <TextBlock Text="NCalc 식 — 입력 포트는 [라벨] 로 참조. 예: [압력1] - [압력2]"
                               FontSize="10"
                               Foreground="{DynamicResource Text2Brush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SelectedNode.Expression, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             FontFamily="Consolas" FontSize="11"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="50"/>
                </StackPanel>
            </Border>

            <!-- 상태바 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <TextBlock FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text2Brush}">
                    <Run Text="노드: "/>
                    <Run Text="{Binding Nodes.Count, Mode=OneWay}"/>
                    <Run Text="  연결선: "/>
                    <Run Text="{Binding Connections.Count, Mode=OneWay}"/>
                    <Run Text="  |  출력포트(●) 드래그 → 입력포트(○)  |  휠: 줌  |  Space+드래그: 패닝"/>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</UserControl>
