<Window x:Class="IIoT.Studio.Views.SaveMemoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="저장 — 변경 메모"
        Width="480" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,12">

            <!-- 입력 섹션 -->
            <TextBlock Text="변경 메모 (선택 사항)"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,6" />
            <TextBlock Text="이번 저장에서 변경한 내용을 간략히 기록하세요."
                       FontSize="10"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,8" />
            <TextBox x:Name="TxtMemo"
                     Style="{DynamicResource PropInput}"
                     Height="72"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Margin="0,0,0,24" />

            <!-- 이전 저장 이력 -->
            <TextBlock Text="최근 저장 이력"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,8" />

            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,7"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SavedAt}"
                                           FontSize="10"
                                           Foreground="{DynamicResource Text2Brush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Memo}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>

        </StackPanel>

        <!-- 구분선 -->
        <Border Grid.Row="1"
                Background="{DynamicResource BorderBrush}" />

        <!-- 버튼 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,12,24,16">
            <Button Content="취소"
                    Style="{DynamicResource GhostBtn}"
                    Padding="16,7" Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancel" />
            <Button Content="💾 저장"
                    Style="{DynamicResource ToolbarBtn}"
                    Padding="16,7"
                    IsDefault="True"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
