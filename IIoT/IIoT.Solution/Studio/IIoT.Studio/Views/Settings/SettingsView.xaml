<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/Settings/SettingsView.xaml
     역할: [환경설정] 탭 — studio-settings.json 편집 (로그 / 편집기 히스토리)
           device.json/collect.json 관련 항목은 대상 아님(각자 탭에서 편집됨)
     C-SET-01 후속 (Studio)
     설정화면 통일(2026-07-20): Collector 와 동일한 DockPanel 골격(상단 경고
           배너 + 좌측 220px 섹션 네비 + 우측 스크롤 폼 + 하단 고정 저장/
           다시불러오기 바)으로 전면 교체 — 기존 "중앙 카드 나열" 레이아웃에서
           변경. 경고 배너 색상도 하드코딩 헥스 대신 YellowFaintBrush/
           YellowBrush 테마 리소스로 교체.
     생성: 2026-07-20
     규칙:
       ① DataContext 는 MainWindow.xaml 에서 DataContext="{Binding Settings}" 로
          직접 주입 (Studio 의 기존 DeviceTree/Canvas 등과 동일한 서브 VM 패턴 —
          Collector/Manager 의 ContentControl+코드비하인드 주입 패턴과 다름)
       ② PropCombo/PropInput/DarkCheckBox 테마 스타일 필수
       ③ 좌측 섹션 네비게이션은 GhostBtn+SwitchSectionCommand(string) 패턴
          (Collector 환경설정 탭과 동일)
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:log="clr-namespace:lssLib.Log;assembly=lssLib.Log"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- LogLevel enum 값 목록 (PropCombo ItemsSource 용) -->
        <ObjectDataProvider x:Key="LogLevelValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="log:LogLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ══════════════════════════════════════════════════
             § 상단 — 재시작 필요 안내 배너 (항상 표시)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource YellowFaintBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <TextBlock Text="⚠ 이 화면의 설정은 모두 Studio 시작 시 1회만 적용됩니다 — 저장 후 재시작이 필요합니다."
                       FontSize="11"
                       Foreground="{DynamicResource YellowBrush}" />
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 하단 — 저장/다시불러오기 + 상태 메시지
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Height="44"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="↻ 다시 불러오기"
                            Command="{Binding ReloadCommand}"
                            Style="{DynamicResource SecondaryBtn}"
                            Margin="0,0,8,0" />
                    <Button Content="💾 저장"
                            Command="{Binding SaveCommand}"
                            Style="{DynamicResource PrimaryBtn}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 좌측 — 섹션 네비게이션 (220px)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Left"
                Width="220"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="0,8">
                <Button Content="📄  로그 (Log)"     Command="{Binding SwitchSectionCommand}" CommandParameter="0" Style="{DynamicResource GhostBtn}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Padding="16,8" />
                <Button Content="✏  편집기 (Editor)" Command="{Binding SwitchSectionCommand}" CommandParameter="1" Style="{DynamicResource GhostBtn}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Padding="16,8" />
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 우측 — 섹션 본문
             ══════════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="24,16">
            <Grid MaxWidth="640" HorizontalAlignment="Left">

                <!-- ── 0. 로그 ─────────────────────────────── -->
                <StackPanel Visibility="{Binding IsLogSection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="로그 (Log)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="파일 로그 최소 레벨" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{DynamicResource PropCombo}"
                                  ItemsSource="{Binding Source={StaticResource LogLevelValues}}"
                                  SelectedItem="{Binding Settings.Log.MinimumLevel}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="로그 패널/콘솔 최소 레벨" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{DynamicResource PropCombo}"
                                  ItemsSource="{Binding Source={StaticResource LogLevelValues}}"
                                  SelectedItem="{Binding Settings.Log.MinimumConsoleLevel}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="로그 파일 보존 일수" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Log.ValidDays}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="로그 패널 최대 표시 건수" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Log.MaxDisplayCount}"/>
                    </Grid>
                </StackPanel>

                <!-- ── 1. 편집기 ───────────────────────────── -->
                <StackPanel Visibility="{Binding IsEditorSection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="편집기 (Editor)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="실행취소(Ctrl+Z) 최대 단계 수" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Editor.UndoHistoryMaxSize}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="저장 이력 최대 보관 개수" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Editor.SaveHistoryMaxCount}"/>
                    </Grid>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
