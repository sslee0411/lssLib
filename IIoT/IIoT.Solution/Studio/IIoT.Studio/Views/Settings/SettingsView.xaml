<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/Settings/SettingsView.xaml
     역할: [환경설정] 탭 — studio-settings.json 편집 (로그 / 편집기 히스토리)
           device.json/collect.json 관련 항목은 대상 아님(각자 탭에서 편집됨)
     C-SET-01 후속 (Studio)
     생성: 2026-07-20
     규칙:
       ① DataContext 는 MainWindow.xaml 에서 DataContext="{Binding Settings}" 로
          직접 주입 (Studio 의 기존 DeviceTree/Canvas 등과 동일한 서브 VM 패턴 —
          Collector/Manager 의 ContentControl+코드비하인드 주입 패턴과 다름)
       ② PropCombo/PropInput/DarkCheckBox 테마 스타일 필수
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:log="clr-namespace:lssLib.Log;assembly=lssLib.Log"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="16,12"/>
        </Style>

        <!-- LogLevel enum 값 목록 (PropCombo ItemsSource 용) -->
        <ObjectDataProvider x:Key="LogLevelValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="log:LogLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="24">
            <Grid MaxWidth="560" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 재시작 안내 -->
                    <RowDefinition Height="Auto" /> <!-- 로그 카드 -->
                    <RowDefinition Height="Auto" /> <!-- 편집기 카드 -->
                    <RowDefinition Height="Auto" /> <!-- 저장/새로고침 + 상태 -->
                </Grid.RowDefinitions>

                <!-- § 재시작 필요 안내 -->
                <Border Grid.Row="0" Background="#2A2410" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <TextBlock Text="⚠ 이 화면의 설정은 모두 Studio 시작 시 1회만 적용됩니다 — 저장 후 재시작이 필요합니다."
                               FontSize="11" Foreground="#E0A030" TextWrapping="Wrap" />
                </Border>

                <!-- § 로그 -->
                <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="로그 (Log)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="파일 로그 최소 레벨" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{DynamicResource PropCombo}"
                                      ItemsSource="{Binding Source={StaticResource LogLevelValues}}"
                                      SelectedItem="{Binding Settings.Log.MinimumLevel}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="로그 패널/콘솔 최소 레벨" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{DynamicResource PropCombo}"
                                      ItemsSource="{Binding Source={StaticResource LogLevelValues}}"
                                      SelectedItem="{Binding Settings.Log.MinimumConsoleLevel}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="로그 파일 보존 일수" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Log.ValidDays}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="로그 패널 최대 표시 건수" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Log.MaxDisplayCount}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- § 편집기 -->
                <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="편집기 (Editor)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="실행취소(Ctrl+Z) 최대 단계 수" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Editor.UndoHistoryMaxSize}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="저장 이력 최대 보관 개수" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Editor.SaveHistoryMaxCount}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- § 저장/새로고침 + 상태 -->
                <StackPanel Grid.Row="3">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="💾 저장" Command="{Binding SaveCommand}"
                                Style="{DynamicResource PrimaryBtn}" Margin="0,0,8,0"/>
                        <Button Content="↻ 다시 불러오기" Command="{Binding ReloadCommand}"
                                Style="{DynamicResource SecondaryBtn}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
