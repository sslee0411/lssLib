<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/Protocol/ProtocolLibraryView.xaml
     역할: 프로토콜 라이브러리 화면
           좌(280px) 프로토콜 목록 + 우(*) 선택 프로토콜 편집기
           (기본정보 → 프레임 설정 → 읽기블록 N개 → 쓰기블록 N개,
            각 블록 선택 시 그 아래 필드 N개 편집 — Scale/Alarm/Comm
            라이브러리와 동일한 좌측목록+우측편집 골격 재사용)
     S-프로토콜01: 신규
     생성: 2026-07-20
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.Protocol.ProtocolLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:IIoT.Studio.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════
             § 좌측 프로토콜 목록
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="0"
              Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="＋ 추가"
                            Command="{Binding AddEntryCommand}"
                            Style="{DynamicResource SecondaryBtn}"
                            Padding="10,4" Margin="0,0,4,0" FontSize="11" />
                    <Button Content="🗑"
                            Command="{Binding DeleteEntryCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4" Margin="0,0,4,0" FontSize="13"
                            ToolTip="선택 항목 삭제" />
                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,6,4,6" />
                    <Button Content="↑" Command="{Binding MoveUpCommand}"
                            Style="{DynamicResource GhostBtn}" Padding="8,4" FontSize="13" />
                    <Button Content="↓" Command="{Binding MoveDownCommand}"
                            Style="{DynamicResource GhostBtn}" Padding="8,4" FontSize="13" />
                </StackPanel>
            </Border>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry}"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:ProtocolEntry}">
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding PreviewSummary}"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text2Brush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

        <!-- ══════════════════════════════════════════════════
             § 우측 편집기
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="2" Background="{DynamicResource BgBrush}">

            <!-- 미선택 안내 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📡" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="프로토콜을 선택하거나 추가하세요"
                           FontSize="15"
                           Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="28,24,28,24">

                    <!-- 헤더 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="📡" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="프로토콜 편집" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,24" />

                    <!-- ── 기본정보 (DataContext = SelectedEntry) ── -->
                    <StackPanel DataContext="{Binding SelectedEntry}">
                        <TextBlock Text="이름" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource PropInput}" Margin="0,0,0,16" />

                        <TextBlock Text="설명" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource PropInput}"
                                 Height="52" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Margin="0,0,0,20" />

                        <!-- ── 프레임 설정 ── -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding UseFraming}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="커스텀 바이너리 프레임 사용(STX/LEN/CRC) — 표준 드라이버(Modbus 등)만 쓰면 체크 해제"
                                       FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Visibility="{Binding UseFraming, Converter={StaticResource BoolToVisibility}}"
                              Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="STX (16진)" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding StxHex, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CRC 방식" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
                                <ComboBox SelectedValue="{Binding CrcType}"
                                          SelectedValuePath="Content"
                                          Style="{DynamicResource PropCombo}">
                                    <ComboBoxItem Content="None" />
                                    <ComboBoxItem Content="Crc16Modbus" />
                                    <ComboBoxItem Content="Xor" />
                                    <ComboBoxItem Content="Sum" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <CheckBox IsChecked="{Binding HasLengthField}"
                                          Content="LEN 필드 포함"
                                          Foreground="{DynamicResource TextBrush}"
                                          Padding="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ── 읽기 블록 N개 ── -->
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,16" />
                    <TextBlock Text="읽기 블록" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />
                    <Grid Height="220" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 블록 목록 -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button Content="＋ 블록" Command="{Binding AddReadBlockCommand}"
                                        Style="{DynamicResource GhostBtn}" FontSize="10" Padding="6,3" Margin="0,0,4,0" />
                                <Button Content="🗑" Command="{Binding DeleteReadBlockCommand}"
                                        Style="{DynamicResource GhostBtn}" FontSize="10" Padding="6,3" />
                            </StackPanel>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding SelectedEntry.ReadBlocks}"
                                     SelectedItem="{Binding SelectedReadBlock}"
                                     Background="{DynamicResource CardBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:ProtocolBlock}">
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{Binding PreviewSummary}" FontSize="9"
                                                       Foreground="{DynamicResource Text2Brush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

                        <!-- 선택 블록 편집 -->
                        <Grid Grid.Column="2" Visibility="{Binding HasReadBlockSelection, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedReadBlock}" Margin="12,0,0,0">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource PropInput}" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource PropInput}" ToolTip="시작 주소" />
                                        <TextBox Grid.Column="2" Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource PropInput}" ToolTip="블록 길이" />
                                        <TextBox Grid.Column="4" Text="{Binding CmdCode, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource PropInput}" FontFamily="Consolas"
                                                 ToolTip="CMD(16진, 커스텀 프레임 전용)" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="＋ 필드"
                                                Command="{Binding DataContext.AddReadFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{DynamicResource GhostBtn}" FontSize="10" Padding="6,3" Margin="0,0,4,0" />
                                        <Button Content="🗑 필드"
                                                Command="{Binding DataContext.DeleteReadFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{DynamicResource GhostBtn}" FontSize="10" Padding="6,3" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Fields}"
                                             SelectedItem="{Binding DataContext.SelectedReadField, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Height="112"
                                             Background="{DynamicResource CardBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type model:ProtocolField}">
                                                <StackPanel Margin="2,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="60" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{DynamicResource PropInput}" FontSize="10" Margin="0,0,4,0" />
                                                        <TextBox Grid.Column="1" Text="{Binding ByteOffset, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{DynamicResource PropInput}" FontSize="10" ToolTip="바이트 오프셋" Margin="0,0,4,0" />
                                                        <ComboBox Grid.Column="2" SelectedValue="{Binding BufType}"
                                                                  SelectedValuePath="Content" Style="{DynamicResource PropCombo}" FontSize="10">
                                                            <ComboBoxItem Content="FloatLE" /><ComboBoxItem Content="FloatBE" />
                                                            <ComboBoxItem Content="Int16" /><ComboBoxItem Content="UInt16" />
                                                            <ComboBoxItem Content="Int32" /><ComboBoxItem Content="UInt32" />
                                                            <ComboBoxItem Content="Bool" /><ComboBoxItem Content="Byte" />
                                                        </ComboBox>
                                                    </Grid>
                                                    <!-- ★ S-프로토콜01 Step B 후속: 필드 스케일 라이브러리 연결 -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <ComboBox Width="110" FontSize="9"
                                                                  SelectedValue="{Binding ScaleEntryId}"
                                                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                                                  Style="{DynamicResource PropCombo}"
                                                                  ItemsSource="{Binding DataContext.ScaleLibrary.Entries,
                                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  ToolTip="스케일 라이브러리 연결(선택 시 Raw→공학단위 변환 적용, 미선택 시 Raw 그대로)" />
                                                        <Button Content="✕" FontSize="9" Padding="4,1" Margin="4,0,0,0"
                                                                Style="{DynamicResource GhostBtn}"
                                                                ToolTip="스케일 연결 해제"
                                                                Command="{Binding DataContext.ClearFieldScaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ── 쓰기 블록 N개 (읽기 블록과 동일 구조) ── -->
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16" />
                    <TextBlock Text="쓰기 블록" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />
                    <Grid Height="220" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button Content="＋ 블록" Command="{Binding AddWriteBlockCommand}"
                                        Style="{DynamicResource GhostBtn}" FontSize="10" Padding="6,3" Margin="0,0,4,0" />
                                <Button Content="🗑" Command="{Binding DeleteWriteBlockCommand}"
                                        Style="{DynamicResource GhostBtn}" FontSize="10" Padding="6,3" />
                            </StackPanel>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding SelectedEntry.WriteBlocks}"
                                     SelectedItem="{Binding SelectedWriteBlock}"
                                     Background="{DynamicResource CardBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:ProtocolBlock}">
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{Binding PreviewSummary}" FontSize="9"
                                                       Foreground="{DynamicResource Text2Brush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

                        <Grid Grid.Column="2" Visibility="{Binding HasWriteBlockSelection, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedWriteBlock}" Margin="12,0,0,0">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource PropInput}" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource PropInput}" ToolTip="시작 주소" />
                                        <TextBox Grid.Column="2" Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource PropInput}" ToolTip="블록 길이" />
                                        <TextBox Grid.Column="4" Text="{Binding CmdCode, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource PropInput}" FontFamily="Consolas"
                                                 ToolTip="CMD(16진, 커스텀 프레임 전용)" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="＋ 필드"
                                                Command="{Binding DataContext.AddWriteFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{DynamicResource GhostBtn}" FontSize="10" Padding="6,3" Margin="0,0,4,0" />
                                        <Button Content="🗑 필드"
                                                Command="{Binding DataContext.DeleteWriteFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{DynamicResource GhostBtn}" FontSize="10" Padding="6,3" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Fields}"
                                             SelectedItem="{Binding DataContext.SelectedWriteField, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Height="112"
                                             Background="{DynamicResource CardBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type model:ProtocolField}">
                                                <StackPanel Margin="2,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="60" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{DynamicResource PropInput}" FontSize="10" Margin="0,0,4,0" />
                                                        <TextBox Grid.Column="1" Text="{Binding ByteOffset, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{DynamicResource PropInput}" FontSize="10" ToolTip="바이트 오프셋" Margin="0,0,4,0" />
                                                        <ComboBox Grid.Column="2" SelectedValue="{Binding BufType}"
                                                                  SelectedValuePath="Content" Style="{DynamicResource PropCombo}" FontSize="10">
                                                            <ComboBoxItem Content="FloatLE" /><ComboBoxItem Content="FloatBE" />
                                                            <ComboBoxItem Content="Int16" /><ComboBoxItem Content="UInt16" />
                                                            <ComboBoxItem Content="Int32" /><ComboBoxItem Content="UInt32" />
                                                            <ComboBoxItem Content="Bool" /><ComboBoxItem Content="Byte" />
                                                        </ComboBox>
                                                    </Grid>
                                                    <!-- ★ S-프로토콜01 Step B 후속: 필드 스케일 라이브러리 연결 -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <ComboBox Width="110" FontSize="9"
                                                                  SelectedValue="{Binding ScaleEntryId}"
                                                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                                                  Style="{DynamicResource PropCombo}"
                                                                  ItemsSource="{Binding DataContext.ScaleLibrary.Entries,
                                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  ToolTip="스케일 라이브러리 연결(선택 시 Raw→공학단위 변환 적용, 미선택 시 Raw 그대로)" />
                                                        <Button Content="✕" FontSize="9" Padding="4,1" Margin="4,0,0,0"
                                                                Style="{DynamicResource GhostBtn}"
                                                                ToolTip="스케일 연결 해제"
                                                                Command="{Binding DataContext.ClearFieldScaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- 안내 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ " Foreground="{DynamicResource AccBrush}" FontSize="12" />
                            <TextBlock Text="이 화면에서 정의한 프로토콜은 device.json 에 저장됩니다. PLC/장비 편집기에서 이 프로토콜을 연결하면 됩니다. 표준 주소범위 블록(CmdCode 비움)은 기존 드라이버(Modbus/미쓰비시)가, 커스텀 프레임 블록(CmdCode 있음)은 raw-frame 드라이버가 실행합니다. 필드에 스케일 라이브러리를 연결하면 Raw 값이 공학단위로 변환되어 발행됩니다(미연결 시 Raw 그대로)."
                                       FontSize="11" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
