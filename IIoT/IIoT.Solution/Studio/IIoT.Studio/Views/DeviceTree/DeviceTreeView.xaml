<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/DeviceTreeView.xaml
     역할: 장비 트리 뷰 — 좌(280px) 트리 + 우(*) 선택 정보 패널
     S-01: 초기 구현
     S-14: 툴바 "📋 템플릿" 버튼 + TagTemplateManagerView 전환
     S-14 fix4:
       [이슈1] ＋Tag 버튼: Popup 없이 AddTagCommand 직접 실행 (누를 때마다 추가)
       [이슈2] TagTemplateManagerView Visibility 바인딩을
               ElementName=RootPanel 로 UserControl DataContext에 고정
               → 코드비하인드에서 DataContext를 TagTemplateVm으로 교체해도
                 Visibility 소스는 변하지 않음
     규칙:
       ① UserControl.Resources → <UserControl> 직계 자식 필수
       ② DynamicResource 필수
       ③ TreeView SelectedItemChanged → 코드비하인드 vm.SelectNode() 호출
     생성: 2026-06-15 / 수정: 2026-06-19
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.DeviceTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:IIoT.Studio.Models"
             xmlns:local="clr-namespace:IIoT.Studio.Views.DeviceTree"
             x:Name="RootPanel">

    <!-- ★ UserControl.Resources: Grid/Border 밖, UserControl 직계 자식 필수 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════
             § 좌측 트리 패널 (280px)
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="0"
              Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── 툴바 ──────────────────────────────────────
                 DockPanel: 우측 고정(템플릿) + 좌측(그룹·장비·PLC·Tag·삭제)
            ─────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="4,5">
                <DockPanel>

                    <!-- ★ 우측 고정: 📋 템플릿 -->
                    <Button DockPanel.Dock="Right"
                            Content="📋 템플릿"
                            Command="{Binding ShowTemplateCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Foreground="{DynamicResource AccBrush}"
                            Padding="8,4" FontSize="11"
                            ToolTip="태그 템플릿 목록 관리 (BufSchema 기반 일괄 생성)" />

                    <!-- 우측 구분선 -->
                    <Border DockPanel.Dock="Right"
                            Width="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="4,5" />

                    <!-- 좌측: 그룹·장비·PLC·Tag·삭제 -->
                    <StackPanel Orientation="Horizontal">

                        <!-- ══ 그룹 드롭다운 ══ -->
                        <Grid Margin="0,0,2,0">
                            <Button x:Name="GroupMenuBtn"
                                    Content="＋그룹"
                                    Style="{DynamicResource GhostBtn}"
                                    Padding="7,4" FontSize="11"
                                    Click="GroupMenuBtn_Click" />
                            <Popup x:Name="GroupPopup"
                                   PlacementTarget="{Binding ElementName=GroupMenuBtn}"
                                   Placement="Bottom" StaysOpen="False">
                                <Border Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4">
                                    <StackPanel>
                                        <Button Content="같은 레벨에 추가"
                                                Command="{Binding AddGroupSiblingCommand}"
                                                Style="{DynamicResource GhostBtn}"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6" FontSize="12"
                                                Click="PopupItem_Click" />
                                        <Button Content="하위에 추가"
                                                Command="{Binding AddGroupChildCommand}"
                                                Style="{DynamicResource GhostBtn}"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6" FontSize="12"
                                                Click="PopupItem_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- ══ 장비 드롭다운 ══ -->
                        <Grid Margin="0,0,2,0">
                            <Button x:Name="DeviceMenuBtn"
                                    Content="＋장비"
                                    Style="{DynamicResource GhostBtn}"
                                    Padding="7,4" FontSize="11"
                                    Click="DeviceMenuBtn_Click" />
                            <Popup x:Name="DevicePopup"
                                   PlacementTarget="{Binding ElementName=DeviceMenuBtn}"
                                   Placement="Bottom" StaysOpen="False">
                                <Border Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4">
                                    <StackPanel>
                                        <Button Content="같은 레벨에 추가"
                                                Command="{Binding AddDeviceSiblingCommand}"
                                                Style="{DynamicResource GhostBtn}"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6" FontSize="12"
                                                Click="PopupItem_Click" />
                                        <Button Content="하위에 추가"
                                                Command="{Binding AddDeviceChildCommand}"
                                                Style="{DynamicResource GhostBtn}"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6" FontSize="12"
                                                Click="PopupItem_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- ══ PLC 드롭다운 ══ -->
                        <Grid Margin="0,0,2,0">
                            <Button x:Name="PlcMenuBtn"
                                    Content="＋PLC"
                                    Style="{DynamicResource GhostBtn}"
                                    Padding="7,4" FontSize="11"
                                    Click="PlcMenuBtn_Click" />
                            <Popup x:Name="PlcPopup"
                                   PlacementTarget="{Binding ElementName=PlcMenuBtn}"
                                   Placement="Bottom" StaysOpen="False">
                                <Border Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4">
                                    <StackPanel>
                                        <Button Content="같은 레벨에 추가"
                                                Command="{Binding AddPlcSiblingCommand}"
                                                Style="{DynamicResource GhostBtn}"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6" FontSize="12"
                                                Click="PopupItem_Click" />
                                        <Button Content="하위에 추가"
                                                Command="{Binding AddPlcChildCommand}"
                                                Style="{DynamicResource GhostBtn}"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6" FontSize="12"
                                                Click="PopupItem_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- ＋Tag: Popup 없이 직접 AddTagCommand 실행 -->
                        <Button Content="＋Tag"
                                Command="{Binding AddTagCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Padding="7,4" Margin="0,0,2,0" FontSize="11"
                                ToolTip="PLC 또는 장비 선택 후 하위에 Tag 추가" />

                        <!-- 구분선 -->
                        <Border Width="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="4,6" />

                        <!-- 삭제 -->
                        <Button Content="🗑"
                                Command="{Binding DeleteSelectedCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Padding="8,4" FontSize="13"
                                ToolTip="선택 노드 삭제" />

                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 트리 뷰 -->
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding RootNodes}"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderThickness="0"
                      SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type model:AbstractTreeNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="2,3">
                            <TextBlock Text="{Binding IconGlyph}"
                                       FontSize="14" Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="IsExpanded" Value="True" />
                        <Setter Property="Padding"    Value="2,1" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <!-- 상태 메시지 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="8,4"
                    Visibility="{Binding IsStatusVisible,
                                 Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource YellowBrush}"
                           TextWrapping="Wrap" />
            </Border>

        </Grid>

        <!-- 세로 구분선 -->
        <Border Grid.Column="1"
                Background="{DynamicResource BorderBrush}" />

        <!-- ══════════════════════════════════════════════════
             § 우측 편집기 패널 — Grid 레이어 방식
             우선순위: IsTemplateMode(최상) > 노드편집기 > 미선택안내
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="2"
              Background="{DynamicResource BgBrush}">

            <!-- 1) 미선택 안내 -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsNoneSelected,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="🌲" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="트리에서 노드를 선택하세요"
                           FontSize="15"
                           Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
                <TextBlock Text="좌측 버튼으로 그룹·장비·PLC·Tag를 추가할 수 있습니다."
                           FontSize="12"
                           Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- 2) 노드 편집기 (타입별 DataTemplate) -->
            <ContentControl Content="{Binding ActiveEditor}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type model:GroupTreeNode}">
                        <local:GroupEditorView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type model:DeviceTreeNode}">
                        <local:DeviceEditorView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type model:PlcTreeNode}">
                        <local:PlcEditorView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type model:TagTreeNode}">
                        <local:TagEditorView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!-- ★ 이슈2 fix: TagTemplateManagerView
                 [문제] 코드비하인드에서 TemplateManagerView.DataContext = vm.TagTemplateVm
                        으로 교체하면, Visibility="{Binding IsTemplateMode}" 의 소스도
                        TagTemplateVm 으로 바뀌어 IsTemplateMode를 찾지 못함 → 항상 Visible

                 [해결] ElementName=RootPanel (UserControl x:Name) 을 통해
                        Visibility 바인딩 소스를 UserControl.DataContext 로 고정
                        → DataContext.IsTemplateMode = DeviceTreeViewModel.IsTemplateMode
                        코드비하인드의 DataContext 교체가 Visibility에 영향 없음 -->
            <local:TagTemplateManagerView
                x:Name="TemplateManagerView"
                Background="{DynamicResource BgBrush}"
                Visibility="{Binding DataContext.IsTemplateMode,
                             ElementName=RootPanel,
                             Converter={StaticResource BoolToVisibility}}" />

        </Grid>

    </Grid>
</UserControl>
