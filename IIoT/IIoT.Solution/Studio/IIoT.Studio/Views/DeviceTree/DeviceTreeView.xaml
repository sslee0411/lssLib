<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/DeviceTreeView.xaml
     역할: 장비 트리 뷰 — 좌(280px) 트리 + 우(*) 선택 정보 패널
     S-01: 초기 구현
     S-14: 툴바 "📋 템플릿" 버튼 + TagTemplateManagerView 전환
     S-14 fix4: ＋Tag 직접 실행 / ElementName=RootPanel Visibility 고정
     S-17A: MoveUpCommand / MoveDownCommand 추가
     S-17A fix: ▲▼ 버튼을 DockPanel 우측 고정으로 이동
                (좌측 StackPanel 에 넣으면 280px 툴바에서 잘려 보이지 않음)
                📋 템플릿 ← [구분선] ← ▼ ← ▲  순서로 우측 고정
     규칙:
       ① UserControl.Resources → <UserControl> 직계 자식 필수
       ② DynamicResource 필수
       ③ TreeView SelectedItemChanged → 코드비하인드 vm.SelectNode() 호출
     생성: 2026-06-15 / 수정: 2026-06-20
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.DeviceTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:IIoT.Studio.Models"
             xmlns:local="clr-namespace:IIoT.Studio.Views.DeviceTree"
             x:Name="RootPanel">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════
             § 좌측 트리 패널 (280px)
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="0"
              Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── 툴바 (2행) ─────────────────────────────────
                 1행: ＋그룹 ＋장비 ＋PLC ＋Tag
                 2행: 🗑 삭제 | ↑ ↓ | 📋 템플릿
                 → 280px 내에 모든 버튼이 표시됨
            ─────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1행: 추가 버튼 4개 -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="4,3,4,3">

                        <!-- ══ 그룹 드롭다운 ══ -->
                        <Grid Margin="0,0,2,0">
                            <Button x:Name="GroupMenuBtn"
                                    Content="＋그룹"
                                    Style="{DynamicResource GhostBtn}"
                                    Padding="7,4" FontSize="11"
                                    Click="GroupMenuBtn_Click" />
                            <Popup x:Name="GroupPopup"
                                   PlacementTarget="{Binding ElementName=GroupMenuBtn}"
                                   Placement="Bottom" StaysOpen="False">
                                <Border Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4">
                                    <StackPanel>
                                        <Button Content="같은 레벨에 추가"
                                                Command="{Binding AddGroupSiblingCommand}"
                                                Style="{DynamicResource GhostBtn}"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6" FontSize="12"
                                                Click="PopupItem_Click" />
                                        <Button Content="하위에 추가"
                                                Command="{Binding AddGroupChildCommand}"
                                                Style="{DynamicResource GhostBtn}"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6" FontSize="12"
                                                Click="PopupItem_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- ══ 장비 드롭다운 ══ -->
                        <Grid Margin="0,0,2,0">
                            <Button x:Name="DeviceMenuBtn"
                                    Content="＋장비"
                                    Style="{DynamicResource GhostBtn}"
                                    Padding="7,4" FontSize="11"
                                    Click="DeviceMenuBtn_Click" />
                            <Popup x:Name="DevicePopup"
                                   PlacementTarget="{Binding ElementName=DeviceMenuBtn}"
                                   Placement="Bottom" StaysOpen="False">
                                <Border Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4">
                                    <StackPanel>
                                        <Button Content="같은 레벨에 추가"
                                                Command="{Binding AddDeviceSiblingCommand}"
                                                Style="{DynamicResource GhostBtn}"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6" FontSize="12"
                                                Click="PopupItem_Click" />
                                        <Button Content="하위에 추가"
                                                Command="{Binding AddDeviceChildCommand}"
                                                Style="{DynamicResource GhostBtn}"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6" FontSize="12"
                                                Click="PopupItem_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- ══ PLC 드롭다운 ══ -->
                        <Grid Margin="0,0,2,0">
                            <Button x:Name="PlcMenuBtn"
                                    Content="＋PLC"
                                    Style="{DynamicResource GhostBtn}"
                                    Padding="7,4" FontSize="11"
                                    Click="PlcMenuBtn_Click" />
                            <Popup x:Name="PlcPopup"
                                   PlacementTarget="{Binding ElementName=PlcMenuBtn}"
                                   Placement="Bottom" StaysOpen="False">
                                <Border Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4">
                                    <StackPanel>
                                        <Button Content="같은 레벨에 추가"
                                                Command="{Binding AddPlcSiblingCommand}"
                                                Style="{DynamicResource GhostBtn}"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6" FontSize="12"
                                                Click="PopupItem_Click" />
                                        <Button Content="하위에 추가"
                                                Command="{Binding AddPlcChildCommand}"
                                                Style="{DynamicResource GhostBtn}"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6" FontSize="12"
                                                Click="PopupItem_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- ＋Tag -->
                        <Button Content="＋Tag"
                                Command="{Binding AddTagCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Padding="7,4" FontSize="11"
                                ToolTip="PLC 또는 장비 선택 후 하위에 Tag 추가" />

                    </StackPanel>

                    <!-- 2행: 삭제 | ↑ ↓ | 📋 템플릿 -->
                    <DockPanel Grid.Row="1"
                               Margin="4,2,4,2"
                               LastChildFill="False">

                        <!-- 우측: 📋 템플릿 -->
                        <Button DockPanel.Dock="Right"
                                Content="📋 템플릿"
                                Command="{Binding ShowTemplateCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Foreground="{DynamicResource AccBrush}"
                                Padding="7,3" FontSize="11"
                                ToolTip="태그 템플릿 목록 관리" />

                        <!-- 구분선 -->
                        <Border DockPanel.Dock="Right"
                                Width="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="3,4" />

                        <!-- ↓ 아래로 -->
                        <Button DockPanel.Dock="Right"
                                Content="↓"
                                Command="{Binding MoveDownCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Padding="8,3" FontSize="13"
                                ToolTip="선택 노드 아래로 이동" />

                        <!-- ↑ 위로 -->
                        <Button DockPanel.Dock="Right"
                                Content="↑"
                                Command="{Binding MoveUpCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Padding="8,3" FontSize="13"
                                ToolTip="선택 노드 위로 이동" />

                        <!-- 구분선 -->
                        <Border DockPanel.Dock="Right"
                                Width="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="3,4" />

                        <!-- 🗑 삭제 (좌측) -->
                        <Button DockPanel.Dock="Left"
                                Content="🗑 삭제"
                                Command="{Binding DeleteSelectedCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Padding="7,3" FontSize="11"
                                ToolTip="선택 노드 삭제" />

                    </DockPanel>
                </Grid>
            </Border>

            <!-- 트리 뷰 -->
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding RootNodes}"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderThickness="0"
                      SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type model:AbstractTreeNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="2,2">

                            <!-- 아이콘 -->
                            <TextBlock Text="{Binding IconGlyph}"
                                       FontSize="13" Margin="0,0,5,0"
                                       VerticalAlignment="Center" />

                            <!-- ★ S-17B: 이름 표시 (일반 모드) — IsEditing=false 시 표시 -->
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"
                                       MouseLeftButtonDown="OnNodeLabelMouseDown">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- ★ S-17B: 이름 편집 (편집 모드) — IsEditing=true 시 표시 -->
                            <TextBox Text="{Binding EditBuffer,
                                            UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12"
                                     MinWidth="80"
                                     VerticalAlignment="Center"
                                     KeyDown="OnRenameKeyDown"
                                     LostFocus="OnRenameLostFocus">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Padding" Value="2,1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="IsExpanded" Value="True" />
                        <Setter Property="Padding"    Value="2,1" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <!-- 상태 메시지 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="8,4"
                    Visibility="{Binding IsStatusVisible,
                                 Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource YellowBrush}"
                           TextWrapping="Wrap" />
            </Border>

        </Grid>

        <!-- 세로 구분선 -->
        <Border Grid.Column="1"
                Background="{DynamicResource BorderBrush}" />

        <!-- ══════════════════════════════════════════════════
             § 우측 편집기 패널
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="2"
              Background="{DynamicResource BgBrush}">

            <!-- 1) 미선택 안내 -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsNoneSelected,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="🌲" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="트리에서 노드를 선택하세요"
                           FontSize="15"
                           Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
                <TextBlock Text="좌측 버튼으로 그룹·장비·PLC·Tag를 추가할 수 있습니다."
                           FontSize="12"
                           Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- 2) 노드 편집기 -->
            <ContentControl Content="{Binding ActiveEditor}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type model:GroupTreeNode}">
                        <local:GroupEditorView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type model:DeviceTreeNode}">
                        <local:DeviceEditorView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type model:PlcTreeNode}">
                        <local:PlcEditorView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type model:TagTreeNode}">
                        <local:TagEditorView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!-- 3) 태그 템플릿 관리 뷰 -->
            <local:TagTemplateManagerView
                x:Name="TemplateManagerView"
                Background="{DynamicResource BgBrush}"
                Visibility="{Binding DataContext.IsTemplateMode,
                             ElementName=RootPanel,
                             Converter={StaticResource BoolToVisibility}}" />

        </Grid>
    </Grid>
</UserControl>
