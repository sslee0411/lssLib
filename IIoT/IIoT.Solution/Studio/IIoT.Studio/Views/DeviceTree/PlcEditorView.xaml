<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/PlcEditorView.xaml
     역할: PLC 노드 편집기
           통신방식(CommType) 선택에 따라 입력 폼 동적 전환
     S-04: 초기 구현
     S-14: 하단에 [📋 태그 템플릿 적용] 버튼 추가
     규칙:
       ① CommType 콤보박스 → IsModbusTcp/IsSerial/IsMqtt 가시성 전환
       ② 모든 색상 DynamicResource
       ③ DataContext = PlcTreeNode
     생성: 2026-06-15
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.PlcEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:model="clr-namespace:IIoT.Studio.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ObjectDataProvider x:Key="PlcCommTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:NodeCommType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">

            <!-- 헤더 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="🔧" FontSize="22"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="PLC 편집"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 구분선 -->
            <Border Height="1"
                    Background="{DynamicResource BorderBrush}"
                    Margin="0,0,0,24" />

            <!-- PLC 이름 -->
            <TextBlock Text="PLC 이름"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,20" />

            <!-- 통신 방식 -->
            <TextBlock Text="통신 방식"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <ComboBox SelectedValue="{Binding CommType}"
                      ItemsSource="{Binding Source={StaticResource PlcCommTypeValues}}"
                      Style="{DynamicResource PropCombo}"
                      Margin="0,0,0,20" />

            <!-- ── Modbus TCP 전용 필드 ── -->
            <StackPanel Visibility="{Binding IsModbusTcp,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="IP 주소"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />
                <TextBlock Text="포트"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />
            </StackPanel>

            <!-- ── Serial 전용 필드 ── -->
            <StackPanel Visibility="{Binding IsSerial,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="COM 포트"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />
                <TextBlock Text="보드레이트"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />
            </StackPanel>

            <!-- ── MQTT 전용 필드 ── -->
            <StackPanel Visibility="{Binding IsMqtt,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="브로커 주소"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />
                <TextBlock Text="포트"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />
            </StackPanel>

            <!-- ── OPC-UA 전용 필드 ── -->
            <StackPanel Visibility="{Binding IsOpcUa,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="엔드포인트 URL"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />
            </StackPanel>

            <!-- 폴링 주기 (공통) -->
            <TextBlock Text="폴링 주기 (ms)"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding PollMs, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,20" />

            <!-- 설명 -->
            <TextBlock Text="설명"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Height="72"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Margin="0,0,0,24" />

            <!-- 안내 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,10"
                    Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ "
                               Foreground="{DynamicResource AccBrush}"
                               FontSize="12" />
                    <TextBlock Text="저장 기능은 S-10 단계에서 추가됩니다. 현재 입력값은 메모리에 바로 반영됩니다."
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════
                 ★ S-14: 태그 템플릿 일괄 적용
                 ══════════════════════════════════════════════ -->
            <Border Height="1"
                    Background="{DynamicResource BorderBrush}"
                    Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="태그 템플릿 일괄 적용"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="BufSchema 기반 Tag를 시작주소 하나로 자동 생성합니다."
                               FontSize="10"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="📋  템플릿 적용"
                        Style="{DynamicResource ToolbarBtn}"
                        Padding="12,7"
                        Click="OnApplyTemplate"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
