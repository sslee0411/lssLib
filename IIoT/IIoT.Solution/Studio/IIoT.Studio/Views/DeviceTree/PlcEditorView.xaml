<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/PlcEditorView.xaml
     역할: PLC 노드 편집기
           통신방식(CommType) 선택에 따라 입력 폼 동적 전환
     S-04: 초기 구현
     S-14: [📋 태그 템플릿 적용] 버튼 헤더 상단 고정으로 변경
           (기존: 스크롤 맨 아래 → 항상 보이도록 개선)
     규칙:
       ① CommType 콤보박스 → IsModbusTcp/IsSerial/IsMqtt 가시성 전환
       ② 모든 색상 DynamicResource
       ③ DataContext = PlcTreeNode
     생성: 2026-06-15 / 수정: 2026-06-19
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.PlcEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:model="clr-namespace:IIoT.Studio.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ObjectDataProvider x:Key="PlcCommTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:NodeCommType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <!-- ★ S-21A B-1: PlcVendor 목록 -->
        <ObjectDataProvider x:Key="PlcVendorValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:PlcVendor" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <!-- ★ S-14: Grid 레이아웃으로 변경
         Row 0: 헤더 + 📋 템플릿 버튼 (항상 고정 표시)
         Row 1: 구분선
         Row 2: 폼 영역 (ScrollViewer — 스크롤 가능)
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 헤더 (항상 보임) ──────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="28,16,20,16">
            <DockPanel>
                <!-- 우측: 버튼 그룹 -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- ★ S-21B: 일괄 주소 부여 버튼 -->
                    <Button Content="🔢 일괄 주소"
                            Style="{DynamicResource GhostBtn}"
                            Padding="10,7"
                            Margin="0,0,6,0"
                            Click="OnBulkAddress"
                            ToolTip="하위 Tag에 시작주소부터 순서대로 주소를 부여합니다." />

                    <!-- 📋 템플릿 적용 버튼 -->
                    <Button Content="📋 템플릿 적용"
                            Style="{DynamicResource ToolbarBtn}"
                            Padding="12,7"
                            Click="OnApplyTemplate"
                            ToolTip="저장된 태그 템플릿을 이 PLC에 일괄 적용합니다." />
                </StackPanel>

                <!-- 좌측: 아이콘 + 타이틀 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="🔧" FontSize="22"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PLC 편집"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccBrush}" />
                        <TextBlock Text="📋 템플릿 적용으로 Tag를 일괄 생성할 수 있습니다."
                                   FontSize="10"
                                   Foreground="{DynamicResource Text2Brush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 구분선 -->
        <Border Grid.Row="1"
                Background="{DynamicResource BorderBrush}" />

        <!-- ── 폼 영역 (스크롤 가능) ──────────────────────────── -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,24">

                <!-- PLC 이름 -->
                <TextBlock Text="PLC 이름"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />

                <!-- ★ S-21A B-1: PLC 제조사 (하위 Tag 주소 형식 결정) -->
                <TextBlock Text="PLC 제조사"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox SelectedValue="{Binding PlcVendor}"
                          ItemsSource="{Binding Source={StaticResource PlcVendorValues}}"
                          Style="{DynamicResource PropCombo}"
                          Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12"
                                       Foreground="{DynamicResource TextBrush}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="하위 Tag 편집기에서 레지스터 종류 목록이 이 설정에 따라 필터링됩니다."
                           FontSize="10"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="2,0,0,20" />

                <!-- ★ S-28: 통신 라이브러리 참조 -->
                <TextBlock Text="통신 라이브러리 참조"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="CommEntryCombo"
                          Style="{DynamicResource PropCombo}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding CommEntryId}"
                          SelectionChanged="OnCommEntryChanged"
                          Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextBrush}">
                                <Run Text="{Binding Name}" />
                                <Run Text=" — " Foreground="{DynamicResource Text2Brush}" />
                                <Run Text="{Binding Host}" Foreground="{DynamicResource Text2Brush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="참조 해제"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,3" FontSize="11"
                            Click="OnCommEntryDetach" />
                    <TextBlock FontSize="10"
                               Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"
                                        Value="직접 입력 모드 — 아래 설정을 직접 입력하세요" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommReferenced}"
                                                 Value="True">
                                        <Setter Property="Text"
                                                Value="라이브러리 참조 중 — 직접 입력 비활성" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 통신 방식 (직접 입력 비활성 여부: IsDirectInput) -->
                <TextBlock Text="통신 방식"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox SelectedValue="{Binding CommType}"
                          ItemsSource="{Binding Source={StaticResource PlcCommTypeValues}}"
                          IsEnabled="{Binding IsDirectInput}"
                          Style="{DynamicResource PropCombo}"
                          Margin="0,0,0,20" />

                <!-- ── Modbus TCP 전용 필드 ── -->
                <StackPanel Visibility="{Binding IsModbusTcp,
                                         Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="IP 주소"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,20" />
                    <TextBlock Text="포트"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,20" />
                </StackPanel>

                <!-- ── Serial 전용 필드 ── -->
                <StackPanel Visibility="{Binding IsSerial,
                                         Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="COM 포트"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,20" />
                    <TextBlock Text="보드레이트"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,20" />
                </StackPanel>

                <!-- ── MQTT 전용 필드 ── -->
                <StackPanel Visibility="{Binding IsMqtt,
                                         Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="브로커 주소"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,20" />
                    <TextBlock Text="포트"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,20" />
                </StackPanel>

                <!-- ── OPC-UA 전용 필드 ── -->
                <StackPanel Visibility="{Binding IsOpcUa,
                                         Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="엔드포인트 URL"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,20" />
                </StackPanel>

                <!-- 폴링 주기 (공통) -->
                <TextBlock Text="폴링 주기 (ms)"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding PollMs, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />

                <!-- 설명 -->
                <TextBlock Text="설명"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Height="72"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Margin="0,0,0,24" />

                <!-- 안내 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ "
                                   Foreground="{DynamicResource AccBrush}"
                                   FontSize="12" />
                        <TextBlock Text="현재 입력값은 메모리에 바로 반영됩니다."
                                   FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
