<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/PlcEditorView.xaml
     역할: PLC 노드 편집기
           통신방식(CommType) 선택에 따라 입력 폼 동적 전환
     S-04: 초기 구현
     규칙:
       ① CommType 콤보박스 → IsModbusTcp/IsSerial/IsMqtt 가시성 전환
       ② 모든 색상 DynamicResource
       ③ DataContext = PlcTreeNode
       ④ CommType 전환용 IsXxx 프로퍼티는 PlcTreeNode 에 추가
     생성: 2026-06-15
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.PlcEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">

            <!-- 헤더 -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,20">
                <TextBlock Text="🔧"
                           FontSize="22"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBlock Text="PLC 편집"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 구분선 -->
            <Border Height="1"
                    Background="{DynamicResource BorderBrush}"
                    Margin="0,0,0,24" />

            <!-- PLC 이름 -->
            <TextBlock Text="PLC 이름"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,20" />

            <!-- 통신 방식 -->
            <TextBlock Text="통신 방식"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <ComboBox SelectedValue="{Binding CommType}"
                      Style="{DynamicResource PropCombo}"
                      Margin="0,0,0,20">
                <ComboBoxItem Content="Modbus TCP" />
                <ComboBoxItem Content="Serial" />
                <ComboBoxItem Content="MQTT" />
                <ComboBoxItem Content="OPC-UA" />
            </ComboBox>

            <!-- ── Modbus TCP 전용 필드 ── -->
            <StackPanel Visibility="{Binding IsModbusTcp,
                                     Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="IP 주소"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />

                <TextBlock Text="포트"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />

            </StackPanel>

            <!-- ── Serial 전용 필드 ── -->
            <StackPanel Visibility="{Binding IsSerial,
                                     Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="COM 포트"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />

                <TextBlock Text="보드레이트"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox SelectedValue="{Binding Port}"
                          Style="{DynamicResource PropCombo}"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="9600" />
                    <ComboBoxItem Content="19200" />
                    <ComboBoxItem Content="38400" />
                    <ComboBoxItem Content="57600" />
                    <ComboBoxItem Content="115200" />
                </ComboBox>

            </StackPanel>

            <!-- ── MQTT 전용 필드 ── -->
            <StackPanel Visibility="{Binding IsMqtt,
                                     Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="브로커 주소"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />

                <TextBlock Text="포트"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />

            </StackPanel>

            <!-- ── OPC-UA 전용 필드 ── -->
            <StackPanel Visibility="{Binding IsOpcUa,
                                     Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="엔드포인트 URL"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />

            </StackPanel>

            <!-- 폴링 주기 (공통) -->
            <TextBlock Text="폴링 주기 (ms)"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding PollMs, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,20" />

            <!-- 설명 -->
            <TextBlock Text="설명"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Height="72"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Margin="0,0,0,24" />

            <!-- 안내 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ "
                               Foreground="{DynamicResource AccBrush}"
                               FontSize="12" />
                    <TextBlock Text="저장 기능은 S-10 단계에서 추가됩니다. 현재 입력값은 메모리에 바로 반영됩니다."
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
