<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/PlcEditorView.xaml
     역할: PLC 노드 편집기
     S-04: 초기 구현
     S-14: 헤더 상단 고정
     S-21A B-1: PlcVendor ComboBox
     S-28: 통신 라이브러리 참조 ComboBox
     Studio-P03: 드라이버 선택 ComboBox + 동적 파라미터 폼 영역 추가
     S-프로토콜01: 프로토콜 라이브러리 참조 ComboBox 추가
     생성: 2026-06-15 / 수정: 2026-07-20
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.PlcEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:model="clr-namespace:IIoT.Studio.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ObjectDataProvider x:Key="PlcCommTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:NodeCommType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="PlcVendorValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:PlcVendor" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 헤더 ──────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="28,16,20,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="🔢 일괄 주소"
                            Style="{DynamicResource GhostBtn}"
                            Padding="10,7" Margin="0,0,6,0"
                            Click="OnBulkAddress"
                            ToolTip="하위 Tag에 시작주소부터 순서대로 주소를 부여합니다." />
                    <Button Content="📋 템플릿 적용"
                            Style="{DynamicResource GhostBtn}"
                            Padding="10,7"
                            Click="OnApplyTemplate"
                            ToolTip="선택한 태그 템플릿을 이 PLC에 적용합니다." />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="PLC 편집기"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding Name}"
                               FontSize="10"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

        <!-- ── 폼 영역 ──────────────────────────────────────── -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,24">

                <!-- PLC 이름 -->
                <TextBlock Text="PLC 이름"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />

                <!-- PLC 제조사 -->
                <TextBlock Text="PLC 제조사"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox SelectedValue="{Binding PlcVendor}"
                          ItemsSource="{Binding Source={StaticResource PlcVendorValues}}"
                          Style="{DynamicResource PropCombo}"
                          Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12"
                                       Foreground="{DynamicResource TextBrush}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="하위 Tag 편집기에서 레지스터 종류 목록이 이 설정에 따라 필터링됩니다."
                           FontSize="10"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,2,0,20" />

                <!-- ★ Studio-P03: 드라이버 선택 ──────────────── -->
                <TextBlock Text="드라이버"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="DriverCombo"
                          Style="{DynamicResource PropCombo}"
                          SelectionChanged="OnDriverSelectionChanged"
                          Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12"
                                       Foreground="{DynamicResource TextBrush}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Plugins/ 폴더의 드라이버 dll이 자동 표시됩니다."
                           FontSize="10"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,2,0,16" />

                <!-- ★ Studio-P03: 동적 파라미터 폼 영역 ─────────
                     코드비하인드 _RenderParameterForm() 이 이 패널에
                     ParameterDefinition 스키마를 읽어 컨트롤을 동적 생성 -->
                <Border x:Name="ParamBorder"
                        Visibility="Collapsed"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,12"
                        Margin="0,0,0,20">
                    <StackPanel x:Name="ParamPanel" />
                </Border>

                <!-- 폴링 주기 -->
                <TextBlock Text="폴링 주기 (ms)"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding PollMs, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,20" />

                <!-- 통신 방식 (레거시) -->
                <TextBlock Text="통신 방식 (레거시)"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox SelectedValue="{Binding CommType}"
                          ItemsSource="{Binding Source={StaticResource PlcCommTypeValues}}"
                          Style="{DynamicResource PropCombo}"
                          Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12"
                                       Foreground="{DynamicResource TextBrush}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="드라이버 플러그인 선택 시 이 항목은 무시됩니다."
                           FontSize="10"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,2,0,16" />

                <!-- Modbus TCP -->
                <StackPanel Visibility="{Binding IsModbusTcp, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="IP 주소"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,16" />
                    <TextBlock Text="포트"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,16" />
                </StackPanel>

                <!-- Serial -->
                <StackPanel Visibility="{Binding IsSerial, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="COM 포트"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,16" />
                </StackPanel>

                <!-- 통신 라이브러리 참조 (S-28) -->
                <TextBlock Text="통신 라이브러리 참조"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="CommEntryCombo"
                          Style="{DynamicResource PropCombo}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding CommEntryId}"
                          SelectionChanged="OnCommEntryChanged"
                          Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextBrush}">
                                <Run Text="{Binding Name}" />
                                <Run Text=" — " Foreground="{DynamicResource Text2Brush}" />
                                <Run Text="{Binding Host}" Foreground="{DynamicResource Text2Brush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                    <Button Content="참조 해제"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,3" FontSize="11"
                            Click="OnCommEntryDetach" />
                </StackPanel>

                <!-- 프로토콜 라이브러리 참조 (S-프로토콜01) -->
                <TextBlock Text="프로토콜 라이브러리 참조"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="ProtocolEntryCombo"
                          Style="{DynamicResource PropCombo}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding ProtocolEntryId}"
                          Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextBrush}">
                                <Run Text="{Binding Name}" />
                                <Run Text=" — " Foreground="{DynamicResource Text2Brush}" />
                                <Run Text="{Binding PreviewSummary}" Foreground="{DynamicResource Text2Brush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                    <Button Content="참조 해제"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,3" FontSize="11"
                            Click="OnProtocolEntryDetach" />
                </StackPanel>

                <!-- 설명 -->
                <TextBlock Text="설명"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         TextWrapping="Wrap" MinHeight="60"
                         AcceptsReturn="True"
                         Margin="0,0,0,20" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
