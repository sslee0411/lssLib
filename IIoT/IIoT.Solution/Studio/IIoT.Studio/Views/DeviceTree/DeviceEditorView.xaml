<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/DeviceEditorView.xaml
     역할: 장비 노드 편집기
     S-03 rev2: 통신 설정 섹션
     Studio-P03b: 드라이버 선택 + 파라미터 폼 + CommEntryId 추가
                  (PLC 노드와 동일 수준 — 단독 통신 장비 지원)
     생성: 2026-06-15 / 수정: 2026-06-27
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.DeviceEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:model="clr-namespace:IIoT.Studio.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ObjectDataProvider x:Key="CommTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:NodeCommType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 헤더 ──────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="28,16,20,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="📋 템플릿 적용"
                            Style="{DynamicResource GhostBtn}"
                            Padding="10,7"
                            Click="OnApplyTemplate"
                            ToolTip="선택한 태그 템플릿을 이 장비에 적용합니다." />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="장비 편집기"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding Name}"
                               FontSize="10"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

        <!-- ── 폼 영역 ──────────────────────────────────────── -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,24">

                <!-- 기본 정보 섹션 -->
                <TextBlock Text="장비 이름"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,16" />

                <TextBlock Text="제조사"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,16" />

                <TextBlock Text="모델"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,16" />

                <TextBlock Text="위치"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,16" />

                <!-- 구분선: 통신 설정 -->
                <Border Height="1" Background="{DynamicResource BorderBrush}"
                        Margin="0,8,0,16" />
                <TextBlock Text="통신 설정"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,16" />

                <!-- ★ Studio-P03b: 드라이버 선택 -->
                <TextBlock Text="드라이버"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="DriverCombo"
                          Style="{DynamicResource PropCombo}"
                          SelectionChanged="OnDriverSelectionChanged"
                          Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12"
                                       Foreground="{DynamicResource TextBrush}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="단독 통신 장비(IoT 게이트웨이 등)에 드라이버를 연결합니다."
                           FontSize="10"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,2,0,16" />

                <!-- ★ Studio-P03b: 동적 파라미터 폼 -->
                <Border x:Name="ParamBorder"
                        Visibility="Collapsed"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16,12" Margin="0,0,0,20">
                    <StackPanel x:Name="ParamPanel" />
                </Border>

                <!-- 폴링 주기 -->
                <TextBlock Text="폴링 주기 (ms)"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding PollMs, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,16" />

                <!-- 통신 방식 (레거시) -->
                <TextBlock Text="통신 방식 (레거시)"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox SelectedValue="{Binding CommType}"
                          ItemsSource="{Binding Source={StaticResource CommTypeValues}}"
                          Style="{DynamicResource PropCombo}"
                          Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12"
                                       Foreground="{DynamicResource TextBrush}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="드라이버 플러그인 선택 시 이 항목은 무시됩니다."
                           FontSize="10"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,2,0,16" />

                <!-- Modbus TCP -->
                <StackPanel Visibility="{Binding IsModbusTcp,
                                         Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="IP 주소" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}" Margin="0,0,0,16" />
                    <TextBlock Text="포트" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}" Margin="0,0,0,16" />
                </StackPanel>

                <!-- Serial -->
                <StackPanel Visibility="{Binding IsSerial,
                                         Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="COM 포트" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}" Margin="0,0,0,16" />
                </StackPanel>

                <!-- MQTT -->
                <StackPanel Visibility="{Binding IsMqtt,
                                         Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="브로커 주소" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}" Margin="0,0,0,16" />
                    <TextBlock Text="포트" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}" Margin="0,0,0,16" />
                </StackPanel>

                <!-- ★ Studio-P03b: 통신 라이브러리 참조 -->
                <TextBlock Text="통신 라이브러리 참조"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="CommEntryCombo"
                          Style="{DynamicResource PropCombo}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding CommEntryId}"
                          SelectionChanged="OnCommEntryChanged"
                          Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextBrush}">
                                <Run Text="{Binding Name}" />
                                <Run Text=" — " Foreground="{DynamicResource Text2Brush}" />
                                <Run Text="{Binding Host}" Foreground="{DynamicResource Text2Brush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                    <Button Content="참조 해제"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,3" FontSize="11"
                            Click="OnCommEntryDetach" />
                </StackPanel>

                <!-- 설명 -->
                <TextBlock Text="설명"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         TextWrapping="Wrap" MinHeight="60"
                         AcceptsReturn="True"
                         Margin="0,0,0,20" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
