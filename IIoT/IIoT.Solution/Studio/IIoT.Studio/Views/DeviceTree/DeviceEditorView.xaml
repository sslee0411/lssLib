<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/DeviceEditorView.xaml
     역할: 장비 노드 편집기
           기본 정보 + 통신 설정 (A안 — 장비도 통신 가능)
     S-03 rev2: 통신 설정 섹션 추가
     생성: 2026-06-15
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.DeviceEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:model="clr-namespace:IIoT.Studio.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- ★ NodeCommType Enum 값 목록 → ItemsSource -->
        <ObjectDataProvider x:Key="CommTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:NodeCommType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">

            <!-- 헤더 -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,20">
                <TextBlock Text="🏭"
                           FontSize="22"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBlock Text="장비 편집"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 구분선 -->
            <Border Height="1"
                    Background="{DynamicResource BorderBrush}"
                    Margin="0,0,0,24" />

            <!-- ━━━ 기본 정보 ━━━ -->
            <TextBlock Text="기본 정보"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,14" />

            <!-- 장비 이름 -->
            <TextBlock Text="장비 이름"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,16" />

            <!-- 모델명 -->
            <TextBlock Text="모델명"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,16" />

            <!-- 제조사 -->
            <TextBlock Text="제조사"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,16" />

            <!-- 설치 위치 -->
            <TextBlock Text="설치 위치"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,16" />

            <!-- 설명 -->
            <TextBlock Text="설명"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Height="72"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Margin="0,0,0,28" />

            <!-- ━━━ 통신 설정 ━━━ -->
            <Border Height="1"
                    Background="{DynamicResource BorderBrush}"
                    Margin="0,0,0,20" />

            <TextBlock Text="통신 설정"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,14" />

            <!-- 통신 방식 -->
            <TextBlock Text="통신 방식"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <ComboBox SelectedValue="{Binding CommType}"
                      ItemsSource="{Binding Source={StaticResource CommTypeValues}}"
                      Style="{DynamicResource PropCombo}"
                      Margin="0,0,0,16" />

            <!-- ── 통신 방식별 동적 폼 ── -->

            <!-- Modbus TCP -->
            <StackPanel Visibility="{Binding IsModbusTcp,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="IP 주소"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,16" />
                <TextBlock Text="포트"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,16" />
            </StackPanel>

            <!-- Serial -->
            <StackPanel Visibility="{Binding IsSerial,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="COM 포트"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,16" />
                <TextBlock Text="보드레이트"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <ComboBox SelectedValue="{Binding Port}"
                          Style="{DynamicResource PropCombo}"
                          Margin="0,0,0,16">
                    <ComboBoxItem Content="9600" />
                    <ComboBoxItem Content="19200" />
                    <ComboBoxItem Content="38400" />
                    <ComboBoxItem Content="57600" />
                    <ComboBoxItem Content="115200" />
                </ComboBox>
            </StackPanel>

            <!-- MQTT -->
            <StackPanel Visibility="{Binding IsMqtt,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="브로커 주소"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,16" />
                <TextBlock Text="포트"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,16" />
            </StackPanel>

            <!-- OPC-UA -->
            <StackPanel Visibility="{Binding IsOpcUa,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="엔드포인트 URL"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,16" />
            </StackPanel>

            <!-- 폴링 주기 (통신 설정된 경우만 표시) -->
            <StackPanel Visibility="{Binding IsCommEnabled,
                                     Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="폴링 주기 (ms)"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding PollMs, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,24" />
            </StackPanel>

            <!-- 통신 없음 안내 -->
            <TextBlock Text="통신 방식을 선택하면 연결 설정 항목이 표시됩니다."
                       FontSize="11"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,24"
                       Visibility="{Binding IsCommEnabled,
                                    Converter={StaticResource BoolToVisibility}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCommEnabled}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 안내 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ "
                               Foreground="{DynamicResource AccBrush}"
                               FontSize="12" />
                    <TextBlock Text="저장 기능은 S-10 단계에서 추가됩니다. 현재 입력값은 메모리에 바로 반영됩니다."
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
