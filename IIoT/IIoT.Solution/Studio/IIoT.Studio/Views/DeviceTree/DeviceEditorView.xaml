<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/DeviceEditorView.xaml
     역할: 장비 노드 편집기 — 이름·모델명·제조사·설치위치 입력
     S-03: 초기 구현
     규칙:
       ① 모든 색상 DynamicResource (테마 전환 지원)
       ② DataContext = DeviceTreeNode (DeviceTreeViewModel.DeviceEditor)
       ③ 저장 기능은 S-10에서 추가
     생성: 2026-06-15
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.DeviceEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">

            <!-- 헤더 -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,20">
                <TextBlock Text="🏭"
                           FontSize="22"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBlock Text="장비 편집"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 구분선 -->
            <Border Height="1"
                    Background="{DynamicResource BorderBrush}"
                    Margin="0,0,0,24" />

            <!-- 장비 이름 -->
            <TextBlock Text="장비 이름"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,20" />

            <!-- 모델명 -->
            <TextBlock Text="모델명"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,20" />

            <!-- 제조사 -->
            <TextBlock Text="제조사"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,20" />

            <!-- 설치 위치 -->
            <TextBlock Text="설치 위치"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,20" />

            <!-- 설명 -->
            <TextBlock Text="설명"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Margin="0,0,0,24" />

            <!-- 안내 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ "
                               Foreground="{DynamicResource AccBrush}"
                               FontSize="12" />
                    <TextBlock Text="저장 기능은 S-10 단계에서 추가됩니다. 현재 입력값은 메모리에 바로 반영됩니다."
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
