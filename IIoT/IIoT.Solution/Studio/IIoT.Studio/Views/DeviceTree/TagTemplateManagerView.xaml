<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/TagTemplateManagerView.xaml
     역할: 태그 템플릿 목록 관리 + 항목 편집
     S-14: 초기 구현 (장비 관리 탭 우측 패널 전환)
     생성: 2026-06-18
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.TagTemplateManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════
             § 좌측: 템플릿 목록
             ══════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 툴바 -->
            <Border Grid.Row="0"
                    Padding="8,6"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="＋ 추가"
                            Command="{Binding AddCommand}"
                            Style="{DynamicResource ToolbarBtn}"
                            Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="🗑"
                            Command="{Binding DeleteCommand}"
                            Style="{DynamicResource DangerBtn}"
                            Padding="8,4"/>
                </StackPanel>
            </Border>

            <!-- 목록 -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Templates}"
                     SelectedItem="{Binding Selected}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,3">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock FontSize="10"
                                       Foreground="{DynamicResource Text2Brush}">
                                <Run Text="{Binding Items.Count, Mode=OneWay}"/>
                                <Run Text=" 항목 / "/>
                                <Run Text="{Binding TotalBytes, Mode=OneWay}"/>
                                <Run Text=" bytes"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 구분선 -->
        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

        <!-- ══════════════════════════════════
             § 우측: 템플릿 편집
             ══════════════════════════════════ -->
        <Grid Grid.Column="2">

            <!-- 미선택 안내 -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsNoneSelected,
                            Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="📋" FontSize="48"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="템플릿을 선택하거나 추가하세요."
                           FontSize="13"
                           Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>

            <!-- 편집 패널 -->
            <ScrollViewer Visibility="{Binding IsSelected,
                              Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">

                    <!-- 이름 -->
                    <TextBlock Text="템플릿 이름"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Selected.Name,
                                 UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,16"/>

                    <!-- 설명 -->
                    <TextBlock Text="설명"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Selected.Description,
                                 UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,24"/>

                    <!-- 항목 헤더 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="항목 목록"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="＋ 항목 추가"
                                Command="{Binding AddItemCommand}"
                                Style="{DynamicResource GhostBtn}"
                                Padding="8,4"/>
                    </Grid>

                    <!-- 컬럼 헤더 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="4,4,0,0"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Offset"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"/>
                            <TextBlock Grid.Column="1" Text="BufType"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"/>
                            <TextBlock Grid.Column="2" Text="이름"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"/>
                            <TextBlock Grid.Column="3" Text="단위"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"/>
                        </Grid>
                    </Border>

                    <!-- 항목 목록 -->
                    <ItemsControl ItemsSource="{Binding Selected.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1,0,1,1"
                                        Padding="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Offset -->
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding ByteOffset,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource PropInput}"
                                                 FontSize="11" Padding="4,2"
                                                 Margin="0,0,4,0"/>
                                        <!-- BufType -->
                                        <ComboBox Grid.Column="1"
                                                  SelectedValue="{Binding BufType}"
                                                  Style="{DynamicResource PropCombo}"
                                                  FontSize="11"
                                                  Margin="0,0,4,0">
                                            <ComboBoxItem Content="UInt16"/>
                                            <ComboBoxItem Content="Int16"/>
                                            <ComboBoxItem Content="UInt32LE"/>
                                            <ComboBoxItem Content="Int32LE"/>
                                            <ComboBoxItem Content="FloatLE"/>
                                            <ComboBoxItem Content="FloatBE"/>
                                            <ComboBoxItem Content="DoubleLE"/>
                                            <ComboBoxItem Content="Bool"/>
                                        </ComboBox>
                                        <!-- 이름 -->
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Name,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource PropInput}"
                                                 FontSize="11" Padding="4,2"
                                                 Margin="0,0,4,0"/>
                                        <!-- 단위 -->
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding Unit,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{DynamicResource PropInput}"
                                                 FontSize="11" Padding="4,2"
                                                 Margin="0,0,4,0"/>
                                        <!-- 삭제 -->
                                        <Button Grid.Column="4"
                                                Content="✕"
                                                Command="{Binding DataContext.DeleteItemCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource DangerBtn}"
                                                Padding="4,2" FontSize="10"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 저장 버튼 -->
                    <Button Content="💾 저장"
                            Command="{Binding SaveCommand}"
                            Style="{DynamicResource ToolbarBtn}"
                            HorizontalAlignment="Right"
                            Padding="16,7" Margin="0,16,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
