<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/TagEditorView.xaml
     역할: Tag 노드 편집기
           레지스터 주소·데이터타입·단위·설명 입력
     S-05: 초기 구현
     규칙:
       ① 모든 색상 DynamicResource
       ② DataContext = TagTreeNode (DeviceTreeViewModel.TagEditor)
       ③ 저장 기능은 S-10에서 추가
     생성: 2026-06-15
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.TagEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">

            <!-- 헤더 -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,20">
                <TextBlock Text="🏷"
                           FontSize="22"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBlock Text="Tag 편집"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 구분선 -->
            <Border Height="1"
                    Background="{DynamicResource BorderBrush}"
                    Margin="0,0,0,24" />

            <!-- Tag 이름 -->
            <TextBlock Text="Tag 이름"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,20" />

            <!-- 레지스터 주소 -->
            <TextBlock Text="레지스터 주소"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,4" />
            <TextBlock Text="예) Modbus: 40001  /  OPC-UA: ns=2;s=Temperature"
                       FontSize="10"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="2,0,0,20" />

            <!-- 데이터 타입 -->
            <TextBlock Text="데이터 타입"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <ComboBox SelectedValue="{Binding DataType}"
                      Style="{DynamicResource PropCombo}"
                      Margin="0,0,0,20">
                <ComboBoxItem Content="Float" />
                <ComboBoxItem Content="Double" />
                <ComboBoxItem Content="Int16" />
                <ComboBoxItem Content="Int32" />
                <ComboBoxItem Content="UInt16" />
                <ComboBoxItem Content="UInt32" />
                <ComboBoxItem Content="Bool" />
                <ComboBoxItem Content="String" />
                <ComboBoxItem Content="Byte" />
            </ComboBox>

            <!-- 단위 -->
            <TextBlock Text="단위"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Margin="0,0,0,4" />
            <TextBlock Text="예) bar / °C / rpm / mm"
                       FontSize="10"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="2,0,0,20" />

            <!-- 설명 -->
            <TextBlock Text="설명"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Height="72"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Margin="0,0,0,24" />

            <!-- 안내 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ "
                               Foreground="{DynamicResource AccBrush}"
                               FontSize="12" />
                    <TextBlock Text="저장 기능은 S-10 단계에서 추가됩니다. 스케일·알람 연결은 S-09에서 추가됩니다."
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
