<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/TagEditorView.xaml
     역할: Tag 노드 편집기
           수집 설정 + 스케일·알람 라이브러리 연결
     S-09: 라이브러리 연결 추가
     규칙:
       ① DataContext = TagTreeNode
       ② 라이브러리 목록: RelativeSource → DeviceTreeView.DataContext
          (DeviceTreeViewModel.ScaleLibrary / AlarmLibrary)
     생성: 2026-06-15
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.DeviceTree.TagEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:IIoT.Studio.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">

            <!-- 헤더 -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,20">
                <TextBlock Text="🏷" FontSize="22"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="Tag 편집" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderBrush}"
                    Margin="0,0,0,24" />

            <!-- ━━━ 수집 설정 ━━━ -->
            <TextBlock Text="수집 설정" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" />

            <TextBlock Text="Tag 이름" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}" Margin="0,0,0,16" />

            <TextBlock Text="레지스터 주소" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}" Margin="0,0,0,4" />
            <TextBlock Text="예) Modbus: 40001  /  OPC-UA: ns=2;s=Temperature"
                       FontSize="10" Foreground="{DynamicResource Text2Brush}"
                       Margin="2,0,0,16" />

            <TextBlock Text="데이터 타입" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
            <ComboBox SelectedValue="{Binding DataType}"
                      Style="{DynamicResource PropCombo}" Margin="0,0,0,16">
                <ComboBoxItem Content="Float" />
                <ComboBoxItem Content="Double" />
                <ComboBoxItem Content="Int16" />
                <ComboBoxItem Content="Int32" />
                <ComboBoxItem Content="UInt16" />
                <ComboBoxItem Content="UInt32" />
                <ComboBoxItem Content="Bool" />
                <ComboBoxItem Content="String" />
                <ComboBoxItem Content="Byte" />
            </ComboBox>

            <TextBlock Text="단위" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
            <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}" Margin="0,0,0,4" />
            <TextBlock Text="예) bar / °C / rpm / mm"
                       FontSize="10" Foreground="{DynamicResource Text2Brush}"
                       Margin="2,0,0,16" />

            <TextBlock Text="설명" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource PropInput}"
                     Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" Margin="0,0,0,28" />

            <!-- ━━━ 라이브러리 연결 ━━━ -->
            <Border Height="1" Background="{DynamicResource BorderBrush}"
                    Margin="0,0,0,20" />
            <TextBlock Text="라이브러리 연결" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" />

            <!-- 스케일 연결 -->
            <TextBlock Text="스케일 라이브러리" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- ★ ItemsSource: RelativeSource → DeviceTreeView DataContext
                       DeviceTreeViewModel.ScaleLibrary.Entries -->
                <ComboBox Grid.Column="0"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding ScaleEntryId}"
                          Style="{DynamicResource PropCombo}"
                          ItemsSource="{Binding DataContext.ScaleLibrary.Entries,
                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:ScaleEntry}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding PreviewFormula}" FontSize="10"
                                           Foreground="{DynamicResource Text2Brush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="✕"
                        Style="{DynamicResource GhostBtn}"
                        Padding="8,6" FontSize="12"
                        ToolTip="스케일 연결 해제"
                        Command="{Binding DataContext.ClearScaleCommand,
                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Grid>

            <!-- 스케일 연결 상태 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource AccBrush}"
                    BorderThickness="1" CornerRadius="3"
                    Padding="8,4" Margin="0,0,0,20"
                    Visibility="{Binding HasScale, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="✔ 스케일 연결됨" FontSize="11"
                           Foreground="{DynamicResource AccBrush}" />
            </Border>
            <TextBlock Text="스케일 미연결 — Raw 값이 그대로 수집됩니다."
                       FontSize="11" Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,20">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasScale}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 알람 연결 -->
            <TextBlock Text="알람 라이브러리" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding AlarmEntryId}"
                          Style="{DynamicResource PropCombo}"
                          ItemsSource="{Binding DataContext.AlarmLibrary.Entries,
                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:AlarmEntry}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding ActiveLevelsPreview}" FontSize="10"
                                           Foreground="{DynamicResource Text2Brush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="✕"
                        Style="{DynamicResource GhostBtn}"
                        Padding="8,6" FontSize="12"
                        ToolTip="알람 연결 해제"
                        Command="{Binding DataContext.ClearAlarmCommand,
                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Grid>

            <!-- 알람 연결 상태 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="#FF4444" BorderThickness="1"
                    CornerRadius="3" Padding="8,4" Margin="0,0,0,20"
                    Visibility="{Binding HasAlarm, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="✔ 알람 연결됨" FontSize="11" Foreground="#FF4444" />
            </Border>
            <TextBlock Text="알람 미연결 — 이상 감지가 비활성화됩니다."
                       FontSize="11" Foreground="{DynamicResource Text2Brush}"
                       Margin="0,0,0,24">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAlarm}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 안내 -->
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ " Foreground="{DynamicResource AccBrush}" FontSize="12" />
                    <TextBlock Text="저장 기능은 S-10 단계에서 추가됩니다. 스케일·알람 탭에서 항목을 먼저 추가하세요."
                               FontSize="11" Foreground="{DynamicResource Text2Brush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
