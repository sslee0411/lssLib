<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/ApplyTemplateDialog.xaml
     역할: 태그 템플릿 선택 + Modbus 시작주소 입력 다이얼로그
     S-13B: 초기 구현
     S-14 fix: 레이아웃 개선
     dialog fix:
       [1] ResizeMode="CanResize" → 사용자가 창 크기 조절 가능
           SizeToContent="Height" → 콘텐츠 높이에 맞게 자동 조정
       [2] 루트를 Grid로 변경: 콘텐츠 ScrollViewer + 버튼 하단 고정
       [3] ComboBox → ItemTemplate 직접 지정
           (PropCombo 스타일의 ContentPresenter가 DisplayMemberPath 무시 → 자료형 표시)
       [4] 미리보기 항목 목록 MaxHeight + ScrollViewer → 다수 항목 스크롤 가능
     생성: 2026-06-18 / 수정: 2026-06-19
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Studio.Views.DeviceTree.ApplyTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="태그 템플릿 적용"
        Width="480"
        MinHeight="300"
        MaxHeight="700"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <!-- ★ Grid 레이아웃: 콘텐츠(*) + 구분선(Auto) + 버튼(Auto) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 콘텐츠 영역 (스크롤 가능) ──────────────────────── -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,12">

                <!-- 안내 -->
                <TextBlock Text="적용할 템플릿과 시작 레지스터 주소를 선택하세요."
                           FontSize="12"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,16"/>

                <!-- 템플릿 선택 레이블 -->
                <TextBlock Text="템플릿"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,4"/>

                <!-- ★ [이슈2 fix] ComboBox — ItemTemplate 직접 지정
                     PropCombo 스타일의 ContentPresenter는 DisplayMemberPath를
                     선택된 항목 표시 시 무시하는 경우가 있음
                     → ItemTemplate + SelectedItemTemplate으로 이름 명시 표시 -->
                <ComboBox ItemsSource="{Binding Templates}"
                          SelectedItem="{Binding SelectedTemplate}"
                          Style="{DynamicResource PropCombo}"
                          Margin="0,0,0,12">
                    <!-- 드롭다운 항목 표시 -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextBrush}"
                                       Padding="2,1"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 템플릿 미리보기 (항목 선택 시만 표시) -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="10,8" Margin="0,0,0,16"
                        Visibility="{Binding HasSelectedTemplate,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>

                        <!-- 설명 (있을 때만) -->
                        <TextBlock Text="{Binding SelectedTemplate.Description}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding HasDescription,
                                       Converter={StaticResource BoolToVisibility}}"/>

                        <!-- 컬럼 헤더 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Offset"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"/>
                            <TextBlock Grid.Column="1" Text="자료형"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"/>
                            <TextBlock Grid.Column="2" Text="이름"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"/>
                            <TextBlock Grid.Column="3" Text="단위"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"/>
                        </Grid>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,0,0,4"/>

                        <!-- ★ [이슈1 fix] 항목 목록 — MaxHeight + ScrollViewer
                             태그가 많아도 스크롤로 확인 가능, 창 크기를 과도하게 늘리지 않음 -->
                        <ScrollViewer MaxHeight="200"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SelectedTemplate.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ByteOffset, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Text2Brush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding BufType, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccBrush}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Name, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Unit, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Text2Brush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 총 요약 -->
                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,6,0,4"/>
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource Text2Brush}">
                            <Run Text="총 "/>
                            <Run Text="{Binding SelectedTemplate.Items.Count, Mode=OneWay}"
                                 Foreground="{DynamicResource AccBrush}"/>
                            <Run Text="개 Tag  /  "/>
                            <Run Text="{Binding SelectedTemplate.TotalBytes, Mode=OneWay}"
                                 Foreground="{DynamicResource AccBrush}"/>
                            <Run Text=" bytes"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 시작 주소 입력 -->
                <TextBlock Text="Modbus 시작 레지스터 주소"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource PropInput}"
                         Margin="0,0,0,4"/>
                <TextBlock FontSize="10"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,4">
                    <Run Text="첫 번째 Tag 주소: "/>
                    <Run Text="{Binding PreviewFirstAddress, Mode=OneWay}"
                         Foreground="{DynamicResource AccBrush}"/>
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <!-- ── 구분선 ───────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Height="1"
                Background="{DynamicResource BorderBrush}"/>

        <!-- ── 버튼 영역 (항상 하단 고정) ──────────────────────── -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,12,24,16">
            <Button Content="취소"
                    Style="{DynamicResource GhostBtn}"
                    Padding="16,7" Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancel"/>
            <Button Content="✔ 적용"
                    Style="{DynamicResource ToolbarBtn}"
                    Padding="16,7"
                    IsDefault="True"
                    IsEnabled="{Binding CanApply}"
                    Click="OnApply"/>
        </StackPanel>

    </Grid>
</Window>
