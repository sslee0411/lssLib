<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/DeviceTree/ApplyTemplateDialog.xaml
     역할: 태그 템플릿 선택 + Modbus 시작주소 입력 다이얼로그
     S-13B: Views/Canvas/ → Views/DeviceTree/ 로 이동
     생성: 2026-06-18
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Studio.Views.DeviceTree.ApplyTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="태그 템플릿 적용"
        Width="420" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <StackPanel Margin="24">

        <!-- 안내 -->
        <TextBlock Text="적용할 템플릿과 시작 레지스터 주소를 선택하세요."
                   FontSize="12"
                   Foreground="{DynamicResource Text2Brush}"
                   Margin="0,0,0,16"/>

        <!-- 템플릿 선택 -->
        <TextBlock Text="템플릿"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="0,0,0,4"/>
        <ComboBox ItemsSource="{Binding Templates}"
                  SelectedItem="{Binding SelectedTemplate}"
                  DisplayMemberPath="Name"
                  Style="{DynamicResource PropCombo}"
                  Margin="0,0,0,12"/>

        <!-- 템플릿 미리보기 -->
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,12"
                Visibility="{Binding HasSelectedTemplate,
                    Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding SelectedTemplate.Description}"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding SelectedTemplate.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextBrush}">
                                <Run Text="  "/>
                                <Run Text="{Binding Name}"/>
                                <Run Text="  offset:"/>
                                <Run Text="{Binding ByteOffset, Mode=OneWay}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding BufType, Mode=OneWay}"
                                     Foreground="{DynamicResource AccBrush}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding Unit, Mode=OneWay}"
                                     Foreground="{DynamicResource Text2Brush}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 시작 주소 입력 -->
        <TextBlock Text="Modbus 시작 레지스터 주소"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="0,0,0,4"/>
        <TextBox Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}"
                 Style="{DynamicResource PropInput}"
                 Margin="0,0,0,4"/>
        <TextBlock FontSize="10"
                   Foreground="{DynamicResource Text2Brush}">
            <Run Text="첫 번째 Tag 주소: "/>
            <Run Text="{Binding PreviewFirstAddress, Mode=OneWay}"
                 Foreground="{DynamicResource AccBrush}"/>
        </TextBlock>

        <!-- 버튼 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="취소"
                    Style="{DynamicResource GhostBtn}"
                    Padding="16,7" Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancel"/>
            <Button Content="적용"
                    Style="{DynamicResource ToolbarBtn}"
                    Padding="16,7"
                    IsDefault="True"
                    IsEnabled="{Binding CanApply}"
                    Click="OnApply"/>
        </StackPanel>

    </StackPanel>
</Window>
