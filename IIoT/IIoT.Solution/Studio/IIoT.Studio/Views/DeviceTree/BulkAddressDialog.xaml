<Window x:Class="IIoT.Studio.Views.DeviceTree.BulkAddressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag 일괄 주소 부여"
        Width="500" Height="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 콘텐츠 -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,12">

                <!-- 안내 -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource AccBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="12,8" Margin="0,0,0,20">
                    <TextBlock x:Name="TxtInfo"
                               FontSize="11"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- 시작 주소 -->
                <TextBlock Text="시작 주소" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="TxtStartAddress"
                         Style="{DynamicResource PropInput}"
                         FontSize="13"
                         Margin="0,0,0,4"
                         TextChanged="OnStartAddressChanged" />
                <TextBlock x:Name="TxtStartHint"
                           FontSize="10"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="2,0,0,16" />

                <!-- 간격 -->
                <TextBlock Text="주소 간격 (step)" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,4" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtStep"
                             Grid.Column="0"
                             Style="{DynamicResource PropInput}"
                             FontSize="13"
                             TextChanged="OnStepChanged" />
                    <Button Grid.Column="1"
                            Content="기본값"
                            Style="{DynamicResource GhostBtn}"
                            Padding="10,6" Margin="8,0,0,0"
                            Click="OnResetStep" />
                </Grid>
                <TextBlock x:Name="TxtStepHint"
                           FontSize="10"
                           Foreground="{DynamicResource Text2Brush}"
                           Margin="2,0,0,20" />

                <!-- 미리보기 -->
                <TextBlock Text="적용 미리보기" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,8" />

                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="0">

                    <!-- 컬럼 헤더 -->
                    <StackPanel>
                        <Grid Background="{DynamicResource SurfaceBrush}"
                              Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tag 이름"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"
                                       Margin="12,6,0,6" />
                            <TextBlock Grid.Column="1" Text="적용될 주소"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"
                                       Margin="0,6,12,6" />
                        </Grid>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}" />

                        <!-- 미리보기 목록 -->
                        <ScrollViewer MaxHeight="200"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PreviewList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TagName}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Margin="12,5,0,5" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Address}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccBrush}"
                                                       Margin="0,5,12,5" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 구분선 -->
        <Border Grid.Row="1"
                Background="{DynamicResource BorderBrush}" />

        <!-- 버튼 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,12,24,16">
            <Button Content="취소"
                    Style="{DynamicResource GhostBtn}"
                    Padding="16,7" Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancel" />
            <Button x:Name="BtnApply"
                    Content="✔ 적용"
                    Style="{DynamicResource ToolbarBtn}"
                    Padding="16,7"
                    IsDefault="True"
                    Click="OnApply" />
        </StackPanel>
    </Grid>
</Window>
