<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/Log/LogPanelView.xaml
     역할: 하단 로그 패널 뷰어 (Studio 전용)
           LogManager.Instance.LogAdded 이벤트 구독 → ListView 표시
           (lssLib.Log 의 LogViewerControl 은 demo 프로젝트 전용이므로
            Studio 에서 직접 참조 불가 → 이 컨트롤로 대체)
     Studio-P04: 신규
     생성: 2026-06-27
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.Log.LogPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 레벨별 배경색 -->
        <SolidColorBrush x:Key="DebugFg"  Color="#888888" />
        <SolidColorBrush x:Key="InfoFg"   Color="#B0C4DE" />
        <SolidColorBrush x:Key="WarnFg"   Color="#EF9F27" />
        <SolidColorBrush x:Key="ErrorFg"  Color="#E05050" />
        <SolidColorBrush x:Key="FatalFg"  Color="#FF4444" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />  <!-- 툴바 -->
            <RowDefinition Height="*"  />  <!-- 로그 목록 -->
        </Grid.RowDefinitions>

        <!-- ── 툴바 ────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,0">
            <DockPanel>
                <!-- 우측: 지우기 버튼 -->
                <Button DockPanel.Dock="Right"
                        Content="🗑 지우기"
                        Style="{DynamicResource GhostBtn}"
                        FontSize="11" Padding="8,2"
                        Click="OnClear" />

                <!-- 레벨 필터 -->
                <TextBlock Text="레벨:"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox x:Name="LevelFilter"
                          FontSize="11"
                          Width="80"
                          VerticalAlignment="Center"
                          SelectionChanged="OnFilterChanged"
                          Margin="0,0,12,0">
                    <ComboBoxItem Content="ALL"   IsSelected="True" />
                    <ComboBoxItem Content="DEBUG" />
                    <ComboBoxItem Content="INFO"  />
                    <ComboBoxItem Content="WARN"  />
                    <ComboBoxItem Content="ERROR" />
                    <ComboBoxItem Content="FATAL" />
                </ComboBox>

                <!-- Source 필터 -->
                <TextBlock Text="Source:"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBox x:Name="SourceFilter"
                         FontSize="11"
                         Width="120"
                         VerticalAlignment="Center"
                         TextChanged="OnFilterChanged"
                         Background="{DynamicResource CardBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" />

                <!-- 로그 표제 -->
                <TextBlock Text="📋 로그"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ── 로그 목록 ────────────────────────────────────── -->
        <ListView x:Name="LogList"
                  Grid.Row="1"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderThickness="0"
                  FontSize="11"
                  FontFamily="Consolas, Courier New">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="시각"   Width="80"
                                    DisplayMemberBinding="{Binding TimeText}" />
                    <GridViewColumn Header="레벨"   Width="56"
                                    DisplayMemberBinding="{Binding LevelText}" />
                    <GridViewColumn Header="Source" Width="120"
                                    DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn Header="내용"   Width="800"
                                    DisplayMemberBinding="{Binding Message}" />
                </GridView>
            </ListView.View>

            <!-- 행 스타일: 레벨별 색상 -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource Text2Brush}" />
                    <Setter Property="Padding" Value="2,1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LevelText}" Value="WARN">
                            <Setter Property="Foreground"
                                    Value="{StaticResource WarnFg}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LevelText}" Value="ERROR">
                            <Setter Property="Foreground"
                                    Value="{StaticResource ErrorFg}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LevelText}" Value="FATAL">
                            <Setter Property="Foreground"
                                    Value="{StaticResource FatalFg}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LevelText}" Value="DEBUG">
                            <Setter Property="Foreground"
                                    Value="{StaticResource DebugFg}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
