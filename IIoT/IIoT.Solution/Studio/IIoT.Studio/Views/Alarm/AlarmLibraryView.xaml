<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/Alarm/AlarmLibraryView.xaml
     역할: 알람 라이브러리 화면
           좌(280px) 목록 + 우(*) HH/H/L/LL 편집기
     S-07: 초기 구현
     생성: 2026-06-15
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.Alarm.AlarmLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:IIoT.Studio.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════
             § 좌측 목록
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="0"
              Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 툴바 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="6,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="＋ 추가"
                            Command="{Binding AddEntryCommand}"
                            Style="{DynamicResource SecondaryBtn}"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            FontSize="11" />

                    <Button Content="🗑"
                            Command="{Binding DeleteEntryCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4"
                            Margin="0,0,4,0"
                            FontSize="13"
                            ToolTip="선택 항목 삭제" />

                    <Border Width="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="4,6,4,6" />

                    <Button Content="↑"
                            Command="{Binding MoveUpCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4"
                            FontSize="13" />

                    <Button Content="↓"
                            Command="{Binding MoveDownCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4"
                            FontSize="13" />

                </StackPanel>
            </Border>

            <!-- 알람 목록 -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry}"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:AlarmEntry}">
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding ActiveLevelsPreview}"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text2Brush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- 구분선 -->
        <Border Grid.Column="1"
                Background="{DynamicResource BorderBrush}" />

        <!-- ══════════════════════════════════════════════════
             § 우측 편집기
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="2"
              Background="{DynamicResource BgBrush}">

            <!-- 미선택 안내 -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="🔔"
                           FontSize="48"
                           HorizontalAlignment="Center" />
                <TextBlock Text="알람 항목을 선택하거나 추가하세요"
                           FontSize="15"
                           Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>

            <!-- 편집기 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection,
                                       Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="28,24,28,24"
                            DataContext="{Binding SelectedEntry}">

                    <!-- 헤더 -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,20">
                        <TextBlock Text="🔔"
                                   FontSize="22"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="알람 편집"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Height="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,0,0,24" />

                    <!-- 이름 -->
                    <TextBlock Text="이름"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,24" />

                    <!-- ── HH (상상한) ── -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="#CC3333"
                            BorderThickness="0,0,0,2"
                            CornerRadius="4"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 헤더 행 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding HhEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="HH  상상한"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#FF4444"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="임계값"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding HhValue, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}"
                                         IsEnabled="{Binding HhEnabled}" />
                            </Grid>
                            <!-- 메시지 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="메시지"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding HhMessage, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}"
                                         IsEnabled="{Binding HhEnabled}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── H (상한) ── -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="#FF8C00"
                            BorderThickness="0,0,0,2"
                            CornerRadius="4"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding HEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="H  상한"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#FF8C00"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="임계값"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding HValue, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}"
                                         IsEnabled="{Binding HEnabled}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="메시지"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding HMessage, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}"
                                         IsEnabled="{Binding HEnabled}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── L (하한) ── -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="#4488FF"
                            BorderThickness="0,0,0,2"
                            CornerRadius="4"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding LEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="L  하한"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#4488FF"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="임계값"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding LValue, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}"
                                         IsEnabled="{Binding LEnabled}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="메시지"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding LMessage, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}"
                                         IsEnabled="{Binding LEnabled}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── LL (하하한) ── -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="#8844CC"
                            BorderThickness="0,0,0,2"
                            CornerRadius="4"
                            Padding="12,10"
                            Margin="0,0,0,24">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding LlEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="LL  하하한"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#AA66FF"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="임계값"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding LlValue, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}"
                                         IsEnabled="{Binding LlEnabled}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="메시지"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text2Brush}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding LlMessage, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}"
                                         IsEnabled="{Binding LlEnabled}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 딜레이 설정 -->
                    <TextBlock Text="딜레이 설정"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="알람 딜레이 (ms)"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource PropInput}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="복귀 딜레이 (ms)"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding RecoveryDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource PropInput}" />
                        </StackPanel>
                    </Grid>

                    <!-- 설명 -->
                    <TextBlock Text="설명"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Height="72"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,24" />

                    <!-- 안내 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ "
                                       Foreground="{DynamicResource AccBrush}"
                                       FontSize="12" />
                            <TextBlock Text="저장 기능은 S-10 단계에서 추가됩니다. Tag 연결은 S-09에서 추가됩니다."
                                       FontSize="11"
                                       Foreground="{DynamicResource Text2Brush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
