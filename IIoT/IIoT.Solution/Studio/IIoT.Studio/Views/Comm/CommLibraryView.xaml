<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · Views/Comm/CommLibraryView.xaml
     역할: 통신 라이브러리 화면
           좌(280px) 목록 + 우(*) 통신방식별 동적 편집기
     S-08: 초기 구현
     생성: 2026-06-15
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Studio.Views.Comm.CommLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:IIoT.Studio.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════
             § 좌측 목록
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="0"
              Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 툴바 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="6,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="＋ 추가"
                            Command="{Binding AddEntryCommand}"
                            Style="{DynamicResource SecondaryBtn}"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            FontSize="11" />

                    <Button Content="🗑"
                            Command="{Binding DeleteEntryCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4"
                            Margin="0,0,4,0"
                            FontSize="13"
                            ToolTip="선택 항목 삭제" />

                    <Border Width="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="4,6,4,6" />

                    <Button Content="↑"
                            Command="{Binding MoveUpCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4"
                            FontSize="13" />

                    <Button Content="↓"
                            Command="{Binding MoveDownCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Padding="8,4"
                            FontSize="13" />

                </StackPanel>
            </Border>

            <!-- 통신 목록 -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry}"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:CommEntry}">
                        <StackPanel Margin="4,6">
                            <!-- 이름 + 방식 배지 -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <Border Background="{DynamicResource AccBrush}"
                                        CornerRadius="3"
                                        Padding="5,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CommTypeLabel}"
                                               FontSize="9"
                                               Foreground="White" />
                                </Border>
                            </StackPanel>
                            <!-- 연결 정보 미리보기 -->
                            <TextBlock Text="{Binding PreviewSummary}"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text2Brush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- 구분선 -->
        <Border Grid.Column="1"
                Background="{DynamicResource BorderBrush}" />

        <!-- ══════════════════════════════════════════════════
             § 우측 편집기
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="2"
              Background="{DynamicResource BgBrush}">

            <!-- 미선택 안내 -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="🔌"
                           FontSize="48"
                           HorizontalAlignment="Center" />
                <TextBlock Text="통신 항목을 선택하거나 추가하세요"
                           FontSize="15"
                           Foreground="{DynamicResource Text2Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>

            <!-- 편집기 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection,
                                       Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="28,24,28,24"
                            DataContext="{Binding SelectedEntry}">

                    <!-- 헤더 -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,20">
                        <TextBlock Text="🔌"
                                   FontSize="22"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="통신 편집"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Height="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,0,0,24" />

                    <!-- 이름 -->
                    <TextBlock Text="이름"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Margin="0,0,0,20" />

                    <!-- 통신 방식 선택 -->
                    <TextBlock Text="통신 방식"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,24">
                        <RadioButton Content="Modbus TCP"
                                     IsChecked="{Binding IsModbusTcp}"
                                     Foreground="{DynamicResource TextBrush}"
                                     Margin="0,0,16,0" />
                        <RadioButton Content="Serial"
                                     IsChecked="{Binding IsSerial}"
                                     Foreground="{DynamicResource TextBrush}"
                                     Margin="0,0,16,0" />
                        <RadioButton Content="MQTT"
                                     IsChecked="{Binding IsMqtt}"
                                     Foreground="{DynamicResource TextBrush}"
                                     Margin="0,0,16,0" />
                        <RadioButton Content="OPC-UA"
                                     IsChecked="{Binding IsOpcUa}"
                                     Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>

                    <!-- ── Modbus TCP ── -->
                    <StackPanel Visibility="{Binding IsModbusTcp,
                                             Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="— Modbus TCP 설정 ——————————"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccBrush}"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="IP 주소"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text2Brush}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource PropInput}"
                                 Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="포트"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="슬레이브 ID"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>

                    <!-- ── Serial ── -->
                    <StackPanel Visibility="{Binding IsSerial,
                                             Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="— Serial 설정 ——————————"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccBrush}"
                                   Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="COM 포트"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding ComPort, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="보드레이트"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <ComboBox SelectedValue="{Binding BaudRate}"
                                          SelectedValuePath="Content"
                                          Style="{DynamicResource PropCombo}">
                                    <ComboBoxItem Content="9600" />
                                    <ComboBoxItem Content="19200" />
                                    <ComboBoxItem Content="38400" />
                                    <ComboBoxItem Content="57600" />
                                    <ComboBoxItem Content="115200" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="패리티"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <ComboBox SelectedValue="{Binding Parity}"
                                          SelectedValuePath="Content"
                                          Style="{DynamicResource PropCombo}">
                                    <ComboBoxItem Content="None" />
                                    <ComboBoxItem Content="Odd" />
                                    <ComboBoxItem Content="Even" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="데이터 비트"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <ComboBox SelectedValue="{Binding DataBits}"
                                          SelectedValuePath="Content"
                                          Style="{DynamicResource PropCombo}">
                                    <ComboBoxItem Content="7" />
                                    <ComboBoxItem Content="8" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="스톱 비트"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <ComboBox SelectedValue="{Binding StopBits}"
                                          SelectedValuePath="Content"
                                          Style="{DynamicResource PropCombo}">
                                    <ComboBoxItem Content="One" />
                                    <ComboBoxItem Content="Two" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                    </StackPanel>

                    <!-- ── MQTT ── -->
                    <StackPanel Visibility="{Binding IsMqtt,
                                             Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="— MQTT 설정 ——————————"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccBrush}"
                                   Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="브로커 주소"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding BrokerHost, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="포트"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding BrokerPort, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="토픽"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text2Brush}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource PropInput}"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="클라이언트 ID"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text2Brush}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource PropInput}"
                                 Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="사용자명"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding MqttUser, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="비밀번호"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <PasswordBox Tag="{Binding MqttPassword}"
                                             Padding="8,6"
                                             Background="{DynamicResource CardBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             BorderThickness="1" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="TLS/SSL 사용"
                                  IsChecked="{Binding UseTls}"
                                  Foreground="{DynamicResource TextBrush}"
                                  Margin="0,0,0,14" />

                    </StackPanel>

                    <!-- ── OPC-UA ── -->
                    <StackPanel Visibility="{Binding IsOpcUa,
                                             Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="— OPC-UA 설정 ——————————"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccBrush}"
                                   Margin="0,0,0,14" />

                        <TextBlock Text="엔드포인트 URL"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text2Brush}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource PropInput}"
                                 Margin="0,0,0,4" />
                        <TextBlock Text="예) opc.tcp://192.168.0.1:4840"
                                   FontSize="10"
                                   Foreground="{DynamicResource Text2Brush}"
                                   Margin="2,0,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="사용자명"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <TextBox Text="{Binding OpcUser, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PropInput}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="비밀번호"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}"
                                           Margin="0,0,0,6" />
                                <PasswordBox Tag="{Binding OpcPassword}"
                                             Padding="8,6"
                                             Background="{DynamicResource CardBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             BorderThickness="1" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>

                    <!-- ── 공통 설정 ── -->
                    <Border Height="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,8,0,20" />

                    <TextBlock Text="공통 설정"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="폴링 주기 (ms)"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding PollMs, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource PropInput}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="타임아웃 (ms)"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource PropInput}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="재연결 간격 (ms)"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding RetryIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource PropInput}" />
                        </StackPanel>
                    </Grid>

                    <!-- 설명 -->
                    <TextBlock Text="설명"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PropInput}"
                             Height="72"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,24" />

                    <!-- 안내 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ "
                                       Foreground="{DynamicResource AccBrush}"
                                       FontSize="12" />
                            <TextBlock Text="저장 기능은 S-10 단계에서 추가됩니다. 장비·PLC 연결은 S-09에서 추가됩니다."
                                       FontSize="11"
                                       Foreground="{DynamicResource Text2Brush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
