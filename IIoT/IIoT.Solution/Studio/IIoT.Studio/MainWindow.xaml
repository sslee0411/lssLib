<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · MainWindow.xaml
     역할: 메인 창
     S-11:  탭1 임시 색상 블록 → CanvasView 교체
     S-15B: 헤더 "● 미저장" 황색 배지 추가
     S-19A: Window.InputBindings Ctrl+S → SaveCommand 추가
     S-19B: DockPanel.Dock="Bottom" 하단 상태바 추가
            선택 노드 경로 / PLC수 / Tag수 / 마지막 저장 시각
     Studio-P04: 탭바 "📋 로그" 버튼 추가
                 DockPanel.Dock="Bottom" 로그 패널 (GridSplitter + LogViewerControl)
     생성: 2026-06-15 / 수정: 2026-06-27
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        xmlns:vTree="clr-namespace:IIoT.Studio.Views.DeviceTree"
        xmlns:vScale="clr-namespace:IIoT.Studio.Views.Scale"
        xmlns:vAlarm="clr-namespace:IIoT.Studio.Views.Alarm"
        xmlns:vComm="clr-namespace:IIoT.Studio.Views.Comm"
        xmlns:vCanvas="clr-namespace:IIoT.Studio.Views.Canvas"
        xmlns:local="clr-namespace:IIoT.Studio.Views.Log"
        Title="IIoT Studio — 설정"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <!-- ★ S-19A: Ctrl+S / S-20A: Ctrl+C/V / S-29: Ctrl+Z/Y -->
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control"
                    Command="{Binding SaveCommand}" />
        <KeyBinding Key="C" Modifiers="Control"
                    Command="{Binding DeviceTree.CopyNodeCommand}" />
        <KeyBinding Key="V" Modifiers="Control"
                    Command="{Binding DeviceTree.PasteNodeCommand}" />
        <!-- ★ S-29: 실행취소 / 다시실행 -->
        <KeyBinding Key="Z" Modifiers="Control"
                    Command="{Binding DeviceTree.UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control"
                    Command="{Binding DeviceTree.RedoCommand}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True">

        <!-- ══════════════════════════════════════════════════
             § 헤더 (56px)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">

                <!-- 우측: 파일 버튼 + CSV + 저장 버튼 + 테마 버튼 -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">

                    <!-- ★ S-18: 📂 열기 -->
                    <Button Content="📂 열기"
                            Command="{Binding OpenConfigCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Foreground="{DynamicResource Text2Brush}"
                            Padding="10,6" Margin="0,0,4,0"
                            ToolTip="device.json 설정 파일 열기" />

                    <!-- ★ S-18: 💾 저장 드롭다운 -->
                    <Grid Margin="0,0,8,0">
                        <Button x:Name="SaveMenuBtn"
                                Content="💾 저장▾"
                                Style="{DynamicResource GhostBtn}"
                                Foreground="{DynamicResource Text2Brush}"
                                Padding="10,6"
                                Click="SaveMenuBtn_Click"
                                ToolTip="저장 옵션" />
                        <Popup x:Name="SavePopup"
                               PlacementTarget="{Binding ElementName=SaveMenuBtn}"
                               Placement="Bottom"
                               StaysOpen="False">
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="4">
                                <StackPanel MinWidth="160">
                                    <Button Content="💾 저장 (Ctrl+S)"
                                            Command="{Binding SaveCommand}"
                                            Style="{DynamicResource GhostBtn}"
                                            HorizontalContentAlignment="Left"
                                            Padding="10,7" FontSize="12"
                                            Click="SavePopupItem_Click" />
                                    <!-- ★ S-27: 메모 입력 후 저장 -->
                                    <Button Content="📝 메모 저장"
                                            Command="{Binding SaveWithMemoCommand}"
                                            Style="{DynamicResource GhostBtn}"
                                            HorizontalContentAlignment="Left"
                                            Padding="10,7" FontSize="12"
                                            Click="SavePopupItem_Click" />
                                    <Button Content="📁 다른 이름으로 저장"
                                            Command="{Binding SaveAsCommand}"
                                            Style="{DynamicResource GhostBtn}"
                                            HorizontalContentAlignment="Left"
                                            Padding="10,7" FontSize="12"
                                            Click="SavePopupItem_Click" />
                                    <Border Height="1"
                                            Background="{DynamicResource BorderBrush}"
                                            Margin="4,2" />
                                    <Button Content="📤 Tag CSV 내보내기"
                                            Command="{Binding ExportTagsCsvCommand}"
                                            Style="{DynamicResource GhostBtn}"
                                            HorizontalContentAlignment="Left"
                                            Padding="10,7" FontSize="12"
                                            Click="SavePopupItem_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- S-20B: 📥 CSV 가져오기 -->
                    <Button Content="📥 CSV"
                            Command="{Binding ImportTagsCsvCommand}"
                            Style="{DynamicResource GhostBtn}"
                            Foreground="{DynamicResource Text2Brush}"
                            Padding="10,6"
                            Margin="0,0,8,0"
                            ToolTip="Tag 목록 CSV 파일 가져오기" />

                    <Button Content="💾  전체 저장"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsSaveEnabled}"
                            Style="{DynamicResource GhostBtn}"
                            Foreground="{DynamicResource AccBrush}"
                            FontWeight="SemiBold"
                            Padding="14,6"
                            Margin="0,0,8,0" />
                    <uc:ThemePickerButton />
                </StackPanel>

                <!-- 좌측: 타이틀 + 저장 상태 배지 + 미저장 배지 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="IIoT"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccBrush}" />
                    <TextBlock Text=" Studio"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />

                    <!-- 저장 상태 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3"
                            Padding="8,2" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SaveStatus}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}" />
                    </Border>

                    <!-- ★ S-15B: 미저장 배지 -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource YellowBrush}"
                            BorderThickness="1" CornerRadius="3"
                            Padding="8,2" Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasUnsavedChanges,
                                         Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="● 미저장"
                                   FontSize="11"
                                   Foreground="{DynamicResource YellowBrush}" />
                    </Border>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 상태바 (26px)   DockPanel.Dock="Bottom"
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Height="26"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <DockPanel>

                <!-- Tag 수 -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Tag "
                               FontSize="10"
                               Foreground="{DynamicResource Text2Brush}" />
                    <TextBlock Text="{Binding TotalTagCount}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccBrush}" />
                    <TextBlock Text="개"
                               FontSize="10"
                               Foreground="{DynamicResource Text2Brush}" />
                </StackPanel>

                <!-- 구분선 -->
                <Border DockPanel.Dock="Right"
                        Width="1" Margin="12,4"
                        Background="{DynamicResource BorderBrush}" />

                <!-- PLC 수 -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="PLC "
                               FontSize="10"
                               Foreground="{DynamicResource Text2Brush}" />
                    <TextBlock Text="{Binding TotalPlcCount}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccBrush}" />
                    <TextBlock Text="개"
                               FontSize="10"
                               Foreground="{DynamicResource Text2Brush}" />
                </StackPanel>

                <!-- 구분선 -->
                <Border DockPanel.Dock="Right"
                        Width="1" Margin="12,4"
                        Background="{DynamicResource BorderBrush}" />

                <!-- 좌측: 선택 노드 경로 -->
                <TextBlock Text="{Binding StatusBarPath}"
                           FontSize="10"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 탭바 (40px)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Height="40"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Stretch"
                        Margin="8,0,0,0">
                <Button Content="🖥  장비 관리"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="0"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />
                <Button Content="🔀  수집 흐름"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="1"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />
                <Button Content="📐  스케일"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="2"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />
                <Button Content="🔔  알람 규칙"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="3"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />
                <Button Content="🔌  통신 설정"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="4"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />

                <!-- ★ Studio-P04: 로그 패널 토글 버튼 -->
                <Button Content="📋  로그"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="5"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />
            </StackPanel>
        </Border>

        <!-- ★ Studio-P04: 하단 로그 패널
             DockPanel.Dock="Bottom" → 상태바 위, 본문 Grid 아래에 위치
             LogPanelVisible=false → Collapsed (기본 숨김)
             LogPanelVisible=true  → Visible   (로그 버튼 클릭 시 토글)
             GridSplitter: 위쪽 드래그로 높이 조절 가능 -->
        <Border DockPanel.Dock="Bottom"
                Height="200"
                Visibility="{Binding LogPanelVisible,
                             Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4" />   <!-- GridSplitter 핸들 -->
                    <RowDefinition Height="*" />   <!-- LogViewerControl -->
                </Grid.RowDefinitions>

                <!-- 크기 조절 핸들 (위아래 드래그) -->
                <GridSplitter Grid.Row="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS" />

                <!-- ★ Studio-P04: 로그 뷰어 인라인 구현
                     LogManager.Instance.LogAdded 이벤트 → LogPanelView.xaml.cs 에서 구독
                     (log 프로젝트의 LogViewerControl 은 데모 전용 — Studio에서 직접 참조 불가)
                     대신 Views/Log/LogPanelView.xaml UserControl 을 사용 -->
                <local:LogPanelView Grid.Row="1"
                                    x:Name="LogPanel" />
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 본문
             ══════════════════════════════════════════════════ -->
        <Grid>
            <Grid Visibility="{Binding IsDeviceTab,
                               Converter={StaticResource BoolToVisibility}}">
                <vTree:DeviceTreeView DataContext="{Binding DeviceTree}" />
            </Grid>
            <Grid Visibility="{Binding IsCanvasTab,
                               Converter={StaticResource BoolToVisibility}}">
                <vCanvas:CanvasView DataContext="{Binding Canvas}" />
            </Grid>
            <Grid Visibility="{Binding IsScaleTab,
                               Converter={StaticResource BoolToVisibility}}">
                <vScale:ScaleLibraryView DataContext="{Binding ScaleLibrary}" />
            </Grid>
            <Grid Visibility="{Binding IsAlarmTab,
                               Converter={StaticResource BoolToVisibility}}">
                <vAlarm:AlarmLibraryView DataContext="{Binding AlarmLibrary}" />
            </Grid>
            <Grid Visibility="{Binding IsCommTab,
                               Converter={StaticResource BoolToVisibility}}">
                <vComm:CommLibraryView DataContext="{Binding CommLibrary}" />
            </Grid>
        </Grid>

    </DockPanel>
</Window>
