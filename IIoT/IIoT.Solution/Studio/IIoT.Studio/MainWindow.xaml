<!-- ══════════════════════════════════════════════════════════
     IIoT.Studio · MainWindow.xaml
     역할: 메인 창
     S-11: 탭1 임시 색상 블록 → CanvasView 교체
           xmlns:vCanvas 추가
     생성: 2026-06-15
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        xmlns:vTree="clr-namespace:IIoT.Studio.Views.DeviceTree"
        xmlns:vScale="clr-namespace:IIoT.Studio.Views.Scale"
        xmlns:vAlarm="clr-namespace:IIoT.Studio.Views.Alarm"
        xmlns:vComm="clr-namespace:IIoT.Studio.Views.Comm"
        xmlns:vCanvas="clr-namespace:IIoT.Studio.Views.Canvas"
        Title="IIoT Studio — 설정"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ══════════════════════════════════════════════════
             § 헤더 (56px)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">

                <!-- 우측: 저장 버튼 + 테마 버튼 -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">

                    <Button Content="💾  전체 저장"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsSaveEnabled}"
                            Style="{DynamicResource GhostBtn}"
                            Foreground="{DynamicResource AccBrush}"
                            FontWeight="SemiBold"
                            Padding="14,6"
                            Margin="0,0,8,0" />

                    <uc:ThemePickerButton />
                </StackPanel>

                <!-- 좌측: 타이틀 + 저장 상태 배지 -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="IIoT"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccBrush}" />
                    <TextBlock Text=" Studio"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3"
                            Padding="8,2" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SaveStatus}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}" />
                    </Border>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 탭바 (40px)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Height="40"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Stretch"
                        Margin="8,0,0,0">

                <Button Content="🖥  장비 관리"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="0"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />

                <Button Content="🔀  수집 흐름"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="1"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />

                <Button Content="📐  스케일"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="2"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />

                <Button Content="🔔  알람 규칙"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="3"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />

                <Button Content="🔌  통신 설정"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="4"
                        Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0" />

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 본문
             ══════════════════════════════════════════════════ -->
        <Grid>

            <!-- 탭 0: 장비 관리 -->
            <Grid Visibility="{Binding IsDeviceTab,
                               Converter={StaticResource BoolToVisibility}}">
                <vTree:DeviceTreeView DataContext="{Binding DeviceTree}" />
            </Grid>

            <!-- 탭 1: 수집 흐름 — ★ S-11: CanvasView 교체 -->
            <Grid Visibility="{Binding IsCanvasTab,
                               Converter={StaticResource BoolToVisibility}}">
                <vCanvas:CanvasView DataContext="{Binding Canvas}" />
            </Grid>

            <!-- 탭 2: 스케일 라이브러리 -->
            <Grid Visibility="{Binding IsScaleTab,
                               Converter={StaticResource BoolToVisibility}}">
                <vScale:ScaleLibraryView DataContext="{Binding ScaleLibrary}" />
            </Grid>

            <!-- 탭 3: 알람 라이브러리 -->
            <Grid Visibility="{Binding IsAlarmTab,
                               Converter={StaticResource BoolToVisibility}}">
                <vAlarm:AlarmLibraryView DataContext="{Binding AlarmLibrary}" />
            </Grid>

            <!-- 탭 4: 통신 라이브러리 -->
            <Grid Visibility="{Binding IsCommTab,
                               Converter={StaticResource BoolToVisibility}}">
                <vComm:CommLibraryView DataContext="{Binding CommLibrary}" />
            </Grid>

        </Grid>

    </DockPanel>

</Window>
