<!-- ══════════════════════════════════════════════════════════
     IIoT.HMI · App.xaml
     역할: 애플리케이션 리소스 선언
           ① BoolToVisibilityConverter 전역 등록
           ② HM-02: ConnectionStatusColorConverter 전역 등록
              — 모든 View 가 재선언 없이 {StaticResource} 로 공용 사용
     HM-Base-0: 신규
     HM-02: ConnColor 컨버터 추가 (Collector 관리 탭 연결상태 표시)
     규칙:
       ① StartupUri 없음 — App.xaml.cs OnStartup 에서 창 직접 생성
          (StartupUri + Show() 동시 사용 → 이중 창 버그)
       ② 컨버터는 MergedDictionaries 안에 등록
          (최상위 ResourceDictionary 직접 등록 시 테마 전환 때 소멸)
     생성: 2026-07-16
     ══════════════════════════════════════════════════════════ -->
<Application x:Class="IIoT.HMI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
             xmlns:hconv="clr-namespace:IIoT.HMI.Core.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <!-- ★ BoolToVisibilityConverter 전역 등록 -->
                    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

                    <!-- ★ HM-02: Collector 연결상태 색상 컨버터 (Monitor MN-02B 이식) -->
                    <hconv:ConnectionStatusColorConverter x:Key="ConnColor"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
