<!-- ══════════════════════════════════════════════════════════
     IIoT.HMI · Views/Log/LogPanelView.xaml
     역할: [로그] 탭 — 실시간 로그 뷰어
           LogManager.Instance.LogAdded 이벤트 구독 → ListView 표시
           (lssLib.Log 의 LogViewerControl 은 demo 프로젝트 전용이므로
            직접 참조 불가 → Studio/Collector/Monitor 와 동일한 LogPanelView 패턴 포팅)
     HM-15: 신규
     생성: 2026-07-19
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.HMI.Views.Log.LogPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 레벨별 전경색 -->
        <SolidColorBrush x:Key="DebugFg"  Color="#888888" />
        <SolidColorBrush x:Key="InfoFg"   Color="#B0C4DE" />
        <SolidColorBrush x:Key="WarnFg"   Color="#EF9F27" />
        <SolidColorBrush x:Key="ErrorFg"  Color="#E05050" />
        <SolidColorBrush x:Key="FatalFg"  Color="#FF4444" />

        <!-- GridViewColumnHeader 테마 스타일 (DataGrid 전용 IIoTGridHeader 와 동일 색상 체계) -->
        <Style x:Key="LogGridHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background"      Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground"      Value="{DynamicResource Text3Brush}" />
            <Setter Property="FontWeight"      Value="Bold" />
            <Setter Property="FontSize"        Value="11" />
            <Setter Property="Padding"         Value="8,4" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor"          Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />  <!-- 툴바 -->
            <RowDefinition Height="*"  />  <!-- 로그 목록 -->
        </Grid.RowDefinitions>

        <!-- ── 툴바 ────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,0">
            <DockPanel>

                <!-- 우측: 지우기 버튼 -->
                <Button DockPanel.Dock="Right"
                        Content="🗑 지우기"
                        Style="{DynamicResource GhostBtn}"
                        FontSize="11" Padding="8,2"
                        Click="OnClear" />

                <!-- 레벨 필터 -->
                <TextBlock Text="레벨:"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox x:Name="LevelFilter"
                          Style="{DynamicResource PropCombo}"
                          FontSize="11"
                          Width="80"
                          Padding="6,2"
                          VerticalAlignment="Center"
                          SelectionChanged="OnFilterChanged"
                          Margin="0,0,12,0">
                    <ComboBoxItem Content="ALL"   IsSelected="True" />
                    <ComboBoxItem Content="DEBUG" />
                    <ComboBoxItem Content="INFO"  />
                    <ComboBoxItem Content="WARN"  />
                    <ComboBoxItem Content="ERROR" />
                    <ComboBoxItem Content="FATAL" />
                </ComboBox>

                <!-- Source 필터 -->
                <TextBlock Text="Source:"
                           FontSize="11"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBox x:Name="SourceFilter"
                         Style="{DynamicResource PropInput}"
                         FontSize="11"
                         Width="120"
                         Padding="6,2"
                         VerticalAlignment="Center"
                         TextChanged="OnFilterChanged" />

                <TextBlock Text="📋 HMI 로그"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </DockPanel>
        </Border>

        <!-- ── 로그 목록 ────────────────────────────────────── -->
        <ListView x:Name="LogList"
                  Grid.Row="1"
                  Background="{DynamicResource SurfaceBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  BorderThickness="0"
                  FontSize="11"
                  FontFamily="Consolas, Courier New">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource LogGridHeader}">
                    <GridViewColumn Header="시각"   Width="80"
                                    DisplayMemberBinding="{Binding TimeText}" />
                    <GridViewColumn Header="레벨"   Width="56"
                                    DisplayMemberBinding="{Binding LevelText}" />
                    <GridViewColumn Header="Source" Width="160"
                                    DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn Header="내용"   Width="900"
                                    DisplayMemberBinding="{Binding Message}" />
                </GridView>
            </ListView.View>

            <!-- 행 스타일: 레벨별 색상 -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
                    <Setter Property="Padding" Value="2,1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LevelText}" Value="WARN">
                            <Setter Property="Foreground" Value="{StaticResource WarnFg}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LevelText}" Value="ERROR">
                            <Setter Property="Foreground" Value="{StaticResource ErrorFg}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LevelText}" Value="FATAL">
                            <Setter Property="Foreground" Value="{StaticResource FatalFg}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LevelText}" Value="DEBUG">
                            <Setter Property="Foreground" Value="{StaticResource DebugFg}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
