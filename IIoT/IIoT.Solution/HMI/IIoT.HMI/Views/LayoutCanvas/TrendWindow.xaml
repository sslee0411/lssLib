<!-- ══════════════════════════════════════════════════════════
     IIoT.HMI · Views/LayoutCanvas/TrendWindow.xaml
     역할: 레이아웃 편집 탭에서 Tag 바인딩된 카드를 우클릭하면 뜨는
           실시간 트렌드 창 (OxyPlot 라인차트, 롤링 윈도우 300포인트)
           (Monitor Views/Chart/ChartView.xaml 의 OxyPlot 사용 방식 이식 —
            여기서는 Collector/PLC/Tag 선택기 없이 우클릭된 노드 1개로 고정)
     ★ 범위: 실시간 값만 표시(창을 연 시점부터 누적) — 과거(창 열기 이전) 이력은
       조회하지 않는다. Collector 의 시계열 저장소(ITimeSeriesStore)는 현재
       조회(읽기) API가 없어(HM-17 조사 결과) 과거 이력 조회는 범위 밖으로
       확정(사용자 확인, 2026-07-19).
     HM-17: 신규
     생성: 2026-07-19
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.HMI.Views.LayoutCanvas.TrendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="실시간 트렌드"
        Width="520" Height="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="TxtHeader"
                   FontSize="13"
                   Foreground="{DynamicResource Text2Brush}"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12">
            <oxy:PlotView Model="{Binding PlotModel}"
                          Background="Transparent"/>
        </Border>
    </Grid>
</Window>
