<!-- ══════════════════════════════════════════════════════════
     IIoT.HMI · Views/Settings/SettingsView.xaml
     역할: [환경설정] 탭 — hmi.json 의 Web(자체 SignalR Hub)/ForceWriteSecurity
           (화면 잠금 기본값)/Log(로그 레벨·보존일수·최대표시건수) 3개 섹션 편집
           (Collectors 는 이미 [Collector 관리] 탭에서 편집 가능하므로 대상 아님)
     C-SET-01 후속 (HMI): Monitor 환경설정 탭과 동일 설계 원칙 — 항목 수가
           많지 않아 좌측 네비게이션 없이 섹션 카드 3개로 구성.
     생성: 2026-07-20
     규칙:
       ① DynamicResource 필수 (버튼: 테마 정식 스타일)
       ② UserControl.Resources 는 UserControl 직계 자식
       ③ Grid 는 Padding 불가 → Border.Padding 사용 (MC3072)
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.HMI.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:log="clr-namespace:lssLib.Log;assembly=lssLib.Log"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="16,12"/>
        </Style>

        <!-- LogLevel enum 값 목록 (PropCombo ItemsSource 용) -->
        <ObjectDataProvider x:Key="LogLevelValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="log:LogLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="24">
            <Grid MaxWidth="560" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 재시작 안내 -->
                    <RowDefinition Height="Auto" /> <!-- 웹 Hub 카드 -->
                    <RowDefinition Height="Auto" /> <!-- 화면 잠금 카드 -->
                    <RowDefinition Height="Auto" /> <!-- 로그 카드 -->
                    <RowDefinition Height="Auto" /> <!-- 저장/새로고침 + 상태 -->
                </Grid.RowDefinitions>

                <!-- § 재시작 필요 안내 -->
                <Border Grid.Row="0" Background="#2A2410" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <TextBlock Text="⚠ 웹 Hub/로그 설정은 HMI 시작 시 1회만 적용됩니다 — 저장 후 재시작이 필요합니다. 화면 잠금 기본값은 다음 시작부터 반영됩니다."
                               FontSize="11" Foreground="#E0A030" TextWrapping="Wrap" />
                </Border>

                <!-- § 웹 Hub -->
                <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="웹 브라우저 연동 (Web Hub)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="HMI 가 자체적으로 구동하는 SignalR Hub 설정입니다. 활성화하면 브라우저에서 이 포트로 접속해 레이아웃/알람을 보고 ACK·ForceWrite 를 실행할 수 있습니다. Collector(7878)·Monitor(7879) 와 겹치지 않도록 주의하세요(기본 7880)."
                                   FontSize="11" Foreground="{DynamicResource Text3Brush}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <CheckBox Content="자체 웹 Hub 활성화" Style="{DynamicResource DarkCheckBox}"
                                  IsChecked="{Binding Settings.Web.Enabled}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="웹 Hub 포트"
                                       FontSize="11" Foreground="{DynamicResource Text2Brush}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{DynamicResource PropInput}"
                                     Text="{Binding Settings.Web.Port}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- § 화면 잠금 -->
                <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="화면 잠금 (ForceWrite Security)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="[레이아웃 편집] 탭의 화면 잠금 모드는 툴바 🔒 버튼으로 세션 중 언제든 토글할 수 있습니다. 여기서는 HMI 시작 시 기본 상태만 설정합니다(운영자 실수 방지를 위해 기본값은 잠김)."
                                   FontSize="11" Foreground="{DynamicResource Text3Brush}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <CheckBox Content="시작 시 화면 잠금(강제쓰기 차단)" Style="{DynamicResource DarkCheckBox}"
                                  IsChecked="{Binding Settings.ForceWriteSecurity.DefaultLocked}" />
                    </StackPanel>
                </Border>

                <!-- § 로그 -->
                <Border Grid.Row="3" Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="로그 (Log)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="파일 로그 최소 레벨" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{DynamicResource PropCombo}"
                                      ItemsSource="{Binding Source={StaticResource LogLevelValues}}"
                                      SelectedItem="{Binding Settings.Log.MinimumLevel}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="로그 패널/콘솔 최소 레벨" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{DynamicResource PropCombo}"
                                      ItemsSource="{Binding Source={StaticResource LogLevelValues}}"
                                      SelectedItem="{Binding Settings.Log.MinimumConsoleLevel}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="로그 파일 보존 일수" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Log.ValidDays}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="로그 패널 최대 표시 건수" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Log.MaxDisplayCount}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- § 저장/새로고침 + 상태 -->
                <StackPanel Grid.Row="4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="💾 저장" Command="{Binding SaveCommand}"
                                Style="{DynamicResource PrimaryBtn}" Margin="0,0,8,0" />
                        <Button Content="↻ 다시 불러오기" Command="{Binding ReloadCommand}"
                                Style="{DynamicResource SecondaryBtn}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
