<!-- ══════════════════════════════════════════════════════════
     IIoT.HMI · Views/Settings/SettingsView.xaml
     역할: [환경설정] 탭 — hmi.json 의 Web(자체 SignalR Hub)/ForceWriteSecurity
           (화면 잠금 기본값)/Log(로그 레벨·보존일수·최대표시건수) 3개 섹션 편집
           (Collectors 는 이미 [Collector 관리] 탭에서 편집 가능하므로 대상 아님)
     C-SET-01 후속 (HMI): Monitor 환경설정 탭과 동일 설계 원칙.
     설정화면 통일(2026-07-20): Collector 와 동일한 DockPanel 골격(상단 경고
           배너 + 좌측 220px 섹션 네비 + 우측 스크롤 폼 + 하단 고정 저장/
           다시불러오기 바)으로 전면 교체 — 기존 "중앙 카드 나열" 레이아웃에서
           변경. 경고 배너 색상도 하드코딩 헥스 대신 YellowFaintBrush/
           YellowBrush 테마 리소스로 교체.
     생성: 2026-07-20
     규칙 (Collector 와 동일):
       ① DynamicResource 필수 (버튼: 테마 정식 스타일)
       ② 좌측 섹션 네비게이션은 GhostBtn+SwitchSectionCommand(string) 패턴
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.HMI.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:log="clr-namespace:lssLib.Log;assembly=lssLib.Log"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- LogLevel enum 값 목록 (PropCombo ItemsSource 용) -->
        <ObjectDataProvider x:Key="LogLevelValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="log:LogLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ══════════════════════════════════════════════════
             § 상단 — 재시작 필요 안내 배너 (항상 표시)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource YellowFaintBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <TextBlock Text="⚠ 웹 Hub/로그 설정은 HMI 시작 시 1회만 적용됩니다 — 저장 후 재시작이 필요합니다. 화면 잠금 기본값은 다음 시작부터 반영됩니다."
                       FontSize="11"
                       Foreground="{DynamicResource YellowBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 하단 — 저장/다시불러오기 + 상태 메시지
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Height="44"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="↻ 다시 불러오기"
                            Command="{Binding ReloadCommand}"
                            Style="{DynamicResource SecondaryBtn}"
                            Margin="0,0,8,0" />
                    <Button Content="💾 저장"
                            Command="{Binding SaveCommand}"
                            Style="{DynamicResource PrimaryBtn}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 좌측 — 섹션 네비게이션 (220px)
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Left"
                Width="220"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="0,8">
                <Button Content="🌐  웹 Hub (Web)"          Command="{Binding SwitchSectionCommand}" CommandParameter="0" Style="{DynamicResource GhostBtn}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Padding="16,8" />
                <Button Content="🔒  화면 잠금 (Security)"   Command="{Binding SwitchSectionCommand}" CommandParameter="1" Style="{DynamicResource GhostBtn}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Padding="16,8" />
                <Button Content="📄  로그 (Log)"             Command="{Binding SwitchSectionCommand}" CommandParameter="2" Style="{DynamicResource GhostBtn}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Padding="16,8" />
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 우측 — 섹션 본문
             ══════════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="24,16">
            <Grid MaxWidth="640" HorizontalAlignment="Left">

                <!-- ── 0. 웹 Hub ────────────────────────────── -->
                <StackPanel Visibility="{Binding IsWebSection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="웹 브라우저 연동 (Web Hub)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="HMI 가 자체적으로 구동하는 SignalR Hub 설정입니다. 활성화하면 브라우저에서 이 포트로 접속해 레이아웃/알람을 보고 ACK·ForceWrite 를 실행할 수 있습니다. Collector(7878)·Monitor(7879) 와 겹치지 않도록 주의하세요(기본 7880)."
                               FontSize="10" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <CheckBox Content="자체 웹 Hub 활성화" Style="{DynamicResource DarkCheckBox}"
                              IsChecked="{Binding Settings.Web.Enabled}" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="웹 Hub 포트" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Web.Port}" />
                    </Grid>
                </StackPanel>

                <!-- ── 1. 화면 잠금 ─────────────────────────── -->
                <StackPanel Visibility="{Binding IsSecuritySection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="화면 잠금 (ForceWrite Security)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="[레이아웃 편집] 탭의 화면 잠금 모드는 툴바 🔒 버튼으로 세션 중 언제든 토글할 수 있습니다. 여기서는 HMI 시작 시 기본 상태만 설정합니다(운영자 실수 방지를 위해 기본값은 잠김)."
                               FontSize="10" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <CheckBox Content="시작 시 화면 잠금(강제쓰기 차단)" Style="{DynamicResource DarkCheckBox}"
                              IsChecked="{Binding Settings.ForceWriteSecurity.DefaultLocked}" />
                </StackPanel>

                <!-- ── 2. 로그 ──────────────────────────────── -->
                <StackPanel Visibility="{Binding IsLogSection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="로그 (Log)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="파일 로그 최소 레벨" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{DynamicResource PropCombo}"
                                  ItemsSource="{Binding Source={StaticResource LogLevelValues}}"
                                  SelectedItem="{Binding Settings.Log.MinimumLevel}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="로그 패널/콘솔 최소 레벨" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{DynamicResource PropCombo}"
                                  ItemsSource="{Binding Source={StaticResource LogLevelValues}}"
                                  SelectedItem="{Binding Settings.Log.MinimumConsoleLevel}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="로그 파일 보존 일수" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Log.ValidDays}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="로그 패널 최대 표시 건수" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{DynamicResource PropInput}" Text="{Binding Settings.Log.MaxDisplayCount}"/>
                    </Grid>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
