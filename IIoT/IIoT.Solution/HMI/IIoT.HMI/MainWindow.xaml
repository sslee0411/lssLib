<!-- ══════════════════════════════════════════════════════════
     IIoT.HMI · MainWindow.xaml
     역할: 메인 창
     HM-Base-0: 빈 창 + 테마 (헤더 56px: 타이틀 + ThemePickerButton)
     HM-Base-1: 탭바(40px) + 본문 레이아웃 뼈대 추가
     HM-Base-2: 탭 전환 5개 — [현황판][레이아웃 편집][Collector 관리][알람][로그]
                (Manager MG-04 DataTrigger 필(pill) 스타일 패턴 재사용)
     HM-02: [Collector 관리] 탭 실제 화면 연결 (ContentControl + 코드 주입)
     HM-03: [레이아웃 편집] 탭 실제 화면 연결 (캔버스 기반 구조만 — 아이콘 종류는 HM-04 이후)
            남은 2개 탭(현황판/알람)은 아직 placeholder (이후 Step에서 실제 View로 교체)
     HM-13(정리, 사용자 확인): HM-03~12 가 전부 [레이아웃 편집] 탭에 구현되어
            (카드 배치·실시간 값·Z순서·다중 화면·알람 배지·ForceWrite) 이미 사실상
            생산현황판 역할을 하고 있었음 — 별도로 비워둔 "현황판" placeholder 탭은
            중복이라 판단해 제거. 탭 4개로 재정렬: [레이아웃 편집][Collector 관리]
            [알람][로그] (인덱스 0~3, 스타일 키도 TabBtn0~3 로 재번호). [알람]/[로그]
            탭은 여전히 placeholder — 착수 시점 미정(사용자 요청 시 별도 Step으로 진행).
     HM-14: [알람] 탭 placeholder → 실제 화면(AlarmView, ContentControl 주입)으로
            교체 — Collector 통합 실시간 알람 그리드(필터+검색+ACK, Monitor MN-03/
            MN-EX-06 이식). [로그] 탭은 여전히 placeholder.
     HM-15: [로그] 탭 placeholder → 실제 화면(LogPanelView, ContentControl 주입)으로
            교체 — LogManager.Instance.LogAdded 구독 실시간 로그 뷰어(레벨/Source
            필터+지우기, Studio/Collector/Monitor 와 동일한 LogPanelView 패턴 이식).
            이로써 4개 탭 전부 placeholder 없이 실제 화면으로 채워짐.
     C-SET-01 후속 (HMI): [⚙ 환경설정] 탭 추가 (인덱스 4, TabBtn4) — hmi.json 의
            Web/ForceWriteSecurity/Log 편집(SettingsView, ContentControl 주입).
     생성: 2026-07-16
     규칙:
       ① DynamicResource 필수 (StaticResource → 테마 전환 시 깨짐)
       ② BoolToVisibility: App.xaml 전역 등록 사용
       ③ xmlns:uc assembly="IIoT.UI.Themes" (크로스-프로젝트 xmlns)
       ④ DI 필요 View → ContentControl + 코드 주입 패턴
       ⑤ 탭 버튼 CommandParameter 는 string → ViewModel int.TryParse 처리
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.HMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        Title="IIoT HMI — 생산현황판"
        Width="1400" Height="860"
        MinWidth="1100" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <!-- ★ 규칙: BoolToVisibility 는 App.xaml 전역 등록에만 의존하지 않고
             Window.Resources 에도 직접 등록 (오류 빠른 참조표 "XamlParseException
             BoolToVisibility" 항목 — Manager MainWindow.xaml 과 동일한 방어적 패턴) -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ★ HM-Base-2: 탭 버튼 필(pill) 스타일 — 선택 여부는 각 버튼의 DataTrigger 로 처리 -->
        <Style x:Key="TabBtnBase" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="4,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ★ HM-13(정리): 탭 0 (레이아웃 편집 — 사실상 현황판 겸용) 선택 시 강조 -->
        <Style x:Key="TabBtn0" TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLayoutTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 탭 1 (Collector 관리) 선택 시 강조 -->
        <Style x:Key="TabBtn1" TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCollectorTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 탭 2 (알람) 선택 시 강조 -->
        <Style x:Key="TabBtn2" TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlarmTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 탭 3 (로그) 선택 시 강조 -->
        <Style x:Key="TabBtn3" TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLogTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 탭 4 (환경설정) 선택 시 강조 — ★ C-SET-01 후속 -->
        <Style x:Key="TabBtn4" TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- § 헤더 (56px) -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="IIoT.HMI"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  생산현황판"
                               FontSize="12"
                               Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 테마 선택 버튼 (우측) -->
                <uc:ThemePickerButton DockPanel.Dock="Right"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- § HM-Base-2: 탭바 (40px) — ★ HM-13(정리): 4탭으로 재정렬(현황판 제거) -->
        <Border DockPanel.Dock="Top"
                Height="40"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="12,0">
                <Button Content="🗂 현황판(레이아웃 편집)"
                        Style="{StaticResource TabBtn0}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="0"/>
                <Button Content="🔌 Collector 관리"
                        Style="{StaticResource TabBtn1}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="1"/>
                <Button Content="🔔 알람"
                        Style="{StaticResource TabBtn2}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="2"/>
                <Button Content="📋 로그"
                        Style="{StaticResource TabBtn3}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="3"/>
                <Button Content="⚙ 환경설정"
                        Style="{StaticResource TabBtn4}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="4"/>
            </StackPanel>
        </Border>

        <!-- § 하단 상태바 (24px) -->
        <Border DockPanel.Dock="Bottom"
                Height="24"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11"
                       Foreground="{DynamicResource Text3Brush}"
                       VerticalAlignment="Center"
                       Margin="16,0"/>
        </Border>

        <!-- § 본문 — 탭별 콘텐츠 (Visibility 토글: 숨김 탭도 콘텐츠 유지)
             ★ HM-13(정리): 별도 "현황판" Grid placeholder 제거 — 레이아웃 편집
             탭(LayoutCanvasHost)이 이미 생산현황판 역할을 겸함. -->
        <Grid>
            <!-- 탭 0: 현황판 겸 레이아웃 편집 — ✅ HM-03~12 실제 화면 -->
            <ContentControl x:Name="LayoutCanvasHost"
                            Visibility="{Binding IsLayoutTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- 탭 1: Collector 관리 — ✅ HM-02 실제 화면 -->
            <ContentControl x:Name="CollectorManageHost"
                            Visibility="{Binding IsCollectorTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- 탭 2: 알람 — ✅ HM-14 실제 화면 (Collector 통합 실시간 알람 그리드,
                 카드별 알람 배지/팝업/ACK 는 이미 [레이아웃 편집] 탭에 HM-08 로 구현됨) -->
            <ContentControl x:Name="AlarmHost"
                            Visibility="{Binding IsAlarmTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- 탭 3: 로그 — ✅ HM-15 실제 화면 (LogManager.Instance.LogAdded 구독 실시간 뷰어) -->
            <ContentControl x:Name="LogHost"
                            Visibility="{Binding IsLogTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- 탭 4: 환경설정 — ✅ C-SET-01 후속 실제 화면 (Web/ForceWriteSecurity/Log) -->
            <ContentControl x:Name="SettingsHost"
                            Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

    </DockPanel>

</Window>
