<!-- ══════════════════════════════════════════════════════════
     IIoT.Monitor · MainWindow.xaml
     역할: 메인 창
     MN-Base-0/1: 헤더(56px) + 탭바(40px) + 본문
     MN-01/MN-02: CollectorManageHost / TagStatusHost 추가
     MN-02B: UI 디자인 개선(B 스타일) + [대시보드] 탭(D 스타일) 신규
     변경(2026-07-08): [로그]를 콘텐츠 탭에서 Studio/Collector와 동일한
             "하단 고정 패널 토글" 방식으로 전환 (GridSplitter로 높이 조절 가능).
             콘텐츠 탭 5개로 재편성: 0=태그현황,1=알람,2=Collector관리,
             3=대시보드,4=차트. 탭바 맨 끝 "📋 로그" 버튼은 CommandParameter="L"
             로 패널만 토글(탭 전환 없음).
     MN-EX-04: 헤더에 연결상태 요약 배지 추가 — 어느 탭에 있든 항상 표시
     생성: 2026-07-07 / 수정: 2026-07-08 (로그 하단 패널화 + MN-EX-04)
     규칙:
       ① DynamicResource 필수 (StaticResource → 테마 전환 시 깨짐)
       ② BoolToVisibility: Window.Resources 직접 등록
       ③ xmlns:uc assembly="IIoT.UI.Themes" (크로스-프로젝트 xmlns)
       ④ DI 필요 View → ContentControl + 코드 주입 패턴
       ⑤ 탭 버튼 CommandParameter는 string → ViewModel int.TryParse 처리
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        Title="IIoT Monitor — 모니터링"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 탭바 버튼 — 선택 시 필(pill) 배경 + 강조 텍스트
             Background/Foreground 는 각 Button 인스턴스에서 ConverterParameter(탭 인덱스)로 바인딩 -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="4,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- § 헤더 (56px) -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="IIoT.Monitor"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  실시간 모니터링"
                               FontSize="12"
                               Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <uc:ThemePickerButton DockPanel.Dock="Right"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>

                <!-- ★ MN-EX-04: 연결상태 요약 배지 — 어느 탭에 있든 항상 표시 -->
                <Border DockPanel.Dock="Right"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="12,5"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource RedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectedCollectorCount}" Value="0">
                                            <Setter Property="Fill" Value="{DynamicResource RedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}">
                            <Run Text="Collector "/>
                            <Run Text="{Binding ConnectedCollectorCount, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TotalCollectorCount, Mode=OneWay}"/>
                            <Run Text=" 연결됨"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- § 탭바 (48px) -->
        <Border DockPanel.Dock="Top"
                Height="48"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📊 태그현황" Style="{StaticResource TabBtn}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="0"
                            Background="{Binding ActiveTabIndex, Converter={StaticResource TabBg}, ConverterParameter=0}"
                            Foreground="{Binding ActiveTabIndex, Converter={StaticResource TabFg}, ConverterParameter=0}"/>
                    <Button Content="🔔 알람" Style="{StaticResource TabBtn}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="1"
                            Background="{Binding ActiveTabIndex, Converter={StaticResource TabBg}, ConverterParameter=1}"
                            Foreground="{Binding ActiveTabIndex, Converter={StaticResource TabFg}, ConverterParameter=1}"/>
                    <Button Content="🔌 Collector 관리" Style="{StaticResource TabBtn}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="2"
                            Background="{Binding ActiveTabIndex, Converter={StaticResource TabBg}, ConverterParameter=2}"
                            Foreground="{Binding ActiveTabIndex, Converter={StaticResource TabFg}, ConverterParameter=2}"/>
                    <Button Content="🗂 대시보드" Style="{StaticResource TabBtn}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="3"
                            Background="{Binding ActiveTabIndex, Converter={StaticResource TabBg}, ConverterParameter=3}"
                            Foreground="{Binding ActiveTabIndex, Converter={StaticResource TabFg}, ConverterParameter=3}"/>
                    <Button Content="📈 차트" Style="{StaticResource TabBtn}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="4"
                            Background="{Binding ActiveTabIndex, Converter={StaticResource TabBg}, ConverterParameter=4}"
                            Foreground="{Binding ActiveTabIndex, Converter={StaticResource TabFg}, ConverterParameter=4}"/>
                </StackPanel>

                <!-- ★ 로그 패널 토글 버튼 — Studio/Collector와 동일하게 GhostBtn 스타일 사용
                     (탭 전환이 아닌 하단 패널 토글, 우측 배치) -->
                <Button DockPanel.Dock="Right"
                        Content="📋  로그" Style="{DynamicResource GhostBtn}"
                        Height="40" Padding="16,0"
                        Command="{Binding SwitchTabCommand}" CommandParameter="L"/>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             § 하단 로그 패널 (토글) — DockPanel.Dock="Bottom"
             본문 Grid(LastChildFill) 보다 먼저 선언되어야 본문 위/로그 아래 배치됨
             GridSplitter 로 위쪽 드래그하여 높이 조절 가능
             ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Height="220"
                Visibility="{Binding LogPanelVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GridSplitter Grid.Row="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS"/>

                <ContentControl x:Name="LogHost" Grid.Row="1"/>
            </Grid>
        </Border>

        <!-- § 본문 (마지막 자식 — 나머지 공간 채움) -->
        <Grid Background="{DynamicResource BgBrush}">
            <!-- [태그현황] 탭 전용 View 호스트 -->
            <ContentControl x:Name="TagStatusHost"
                            Visibility="{Binding IsTagTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- [알람] 탭 전용 View 호스트 -->
            <ContentControl x:Name="AlarmHost"
                            Visibility="{Binding IsAlarmTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- [Collector 관리] 탭 전용 View 호스트 -->
            <ContentControl x:Name="CollectorManageHost"
                            Visibility="{Binding IsCollectorTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- [대시보드] 탭 전용 View 호스트 -->
            <ContentControl x:Name="DashboardHost"
                            Visibility="{Binding IsDashboardTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- [차트] 탭 전용 View 호스트 -->
            <ContentControl x:Name="ChartHost"
                            Visibility="{Binding IsChartTab, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

    </DockPanel>
</Window>
