<!-- ══════════════════════════════════════════════════════════
     IIoT.Monitor · MainWindow.xaml
     역할: 메인 창
     MN-Base-0/1: 헤더(56px) + 탭바(40px) + 본문
     MN-01/MN-02: CollectorManageHost / TagStatusHost 추가
     MN-02B: UI 디자인 개선(B 스타일: 카드·필 배지) + [대시보드] 탭(D 스타일) 신규
             - 탭바: 선택된 탭에 필(pill) 배경(AccFaintBrush) + 강조색 텍스트
               (TabBg/TabFg 컨버터, App.xaml 전역 등록 — 7개 테마 전부 대응)
             - DashboardHost 추가 (탭 인덱스 4)
     생성: 2026-07-07 / 수정: 2026-07-07 (MN-02B)
     규칙:
       ① DynamicResource 필수 (StaticResource → 테마 전환 시 깨짐)
       ② BoolToVisibility: Window.Resources 직접 등록
       ③ xmlns:uc assembly="IIoT.UI.Themes" (크로스-프로젝트 xmlns)
       ④ DI 필요 View → ContentControl + 코드 주입 패턴
       ⑤ 탭 버튼 CommandParameter는 string → ViewModel int.TryParse 처리
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        Title="IIoT Monitor — 모니터링"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- ★ MN-02B: 탭바 버튼 — 선택 시 필(pill) 배경 + 강조 텍스트
             Background/Foreground 는 각 Button 인스턴스에서 ConverterParameter(탭 인덱스)로 바인딩 -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="4,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- § 헤더 (56px) -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="IIoT.Monitor"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  실시간 모니터링"
                               FontSize="12"
                               Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <uc:ThemePickerButton DockPanel.Dock="Right"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- § 탭바 (48px) -->
        <Border DockPanel.Dock="Top"
                Height="48"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="📊 태그현황" Style="{StaticResource TabBtn}"
                        Command="{Binding SwitchTabCommand}" CommandParameter="0"
                        Background="{Binding ActiveTabIndex, Converter={StaticResource TabBg}, ConverterParameter=0}"
                        Foreground="{Binding ActiveTabIndex, Converter={StaticResource TabFg}, ConverterParameter=0}"/>
                <Button Content="🔔 알람" Style="{StaticResource TabBtn}"
                        Command="{Binding SwitchTabCommand}" CommandParameter="1"
                        Background="{Binding ActiveTabIndex, Converter={StaticResource TabBg}, ConverterParameter=1}"
                        Foreground="{Binding ActiveTabIndex, Converter={StaticResource TabFg}, ConverterParameter=1}"/>
                <Button Content="🔌 Collector 관리" Style="{StaticResource TabBtn}"
                        Command="{Binding SwitchTabCommand}" CommandParameter="2"
                        Background="{Binding ActiveTabIndex, Converter={StaticResource TabBg}, ConverterParameter=2}"
                        Foreground="{Binding ActiveTabIndex, Converter={StaticResource TabFg}, ConverterParameter=2}"/>
                <Button Content="📜 로그" Style="{StaticResource TabBtn}"
                        Command="{Binding SwitchTabCommand}" CommandParameter="3"
                        Background="{Binding ActiveTabIndex, Converter={StaticResource TabBg}, ConverterParameter=3}"
                        Foreground="{Binding ActiveTabIndex, Converter={StaticResource TabFg}, ConverterParameter=3}"/>
                <Button Content="🗂 대시보드" Style="{StaticResource TabBtn}"
                        Command="{Binding SwitchTabCommand}" CommandParameter="4"
                        Background="{Binding ActiveTabIndex, Converter={StaticResource TabBg}, ConverterParameter=4}"
                        Foreground="{Binding ActiveTabIndex, Converter={StaticResource TabFg}, ConverterParameter=4}"/>
                <Button Content="📈 차트" Style="{StaticResource TabBtn}"
                        Command="{Binding SwitchTabCommand}" CommandParameter="5"
                        Background="{Binding ActiveTabIndex, Converter={StaticResource TabBg}, ConverterParameter=5}"
                        Foreground="{Binding ActiveTabIndex, Converter={StaticResource TabFg}, ConverterParameter=5}"/>
            </StackPanel>
        </Border>

        <!-- § 본문 -->
        <Grid Background="{DynamicResource BgBrush}">
            <!-- 임시 안내 문구 (알람/로그 탭) -->
            <TextBlock Text="{Binding TabPlaceholderText}"
                       Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}"
                       FontSize="14"
                       Foreground="{DynamicResource Text2Brush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- [태그현황] 탭 전용 View 호스트 -->
            <ContentControl x:Name="TagStatusHost"
                            Visibility="{Binding IsTagTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- ★ MN-03: [알람] 탭 전용 View 호스트 -->
            <ContentControl x:Name="AlarmHost"
                            Visibility="{Binding IsAlarmTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- [Collector 관리] 탭 전용 View 호스트 -->
            <ContentControl x:Name="CollectorManageHost"
                            Visibility="{Binding IsCollectorTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- ★ MN-02B: [대시보드] 탭 전용 View 호스트 -->
            <ContentControl x:Name="DashboardHost"
                            Visibility="{Binding IsDashboardTab, Converter={StaticResource BoolToVisibility}}"/>

            <!-- ★ MN-06: [차트] 탭 전용 View 호스트 -->
            <ContentControl x:Name="ChartHost"
                            Visibility="{Binding IsChartTab, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

    </DockPanel>
</Window>
