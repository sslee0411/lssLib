<!-- ══════════════════════════════════════════════════════════
     IIoT.Monitor · Views/CollectorManage/CollectorManageView.xaml
     역할: [Collector 관리] 탭 화면
           등록된 Collector 목록(DataGrid) + 추가/삭제/저장 툴바
     MN-01: 신규
     MN-02B: UI 디자인 개선(B 스타일) — DataGrid를 둥근 카드(Border)로 감싸고,
             연결상태 컬럼을 색상 점(Ellipse) + 텍스트 조합으로 교체
             (ConnColor 컨버터, App.xaml 전역 등록 — 7개 테마 전부 대응)
     FIX: DataGrid에 Style="{DynamicResource IIoTGrid}" 미적용으로 테마가
          반영되지 않던 문제 수정 — Collector StatusView.xaml과 동일하게
          Style="{DynamicResource IIoTGrid}" + RowStyle BasedOn="{StaticResource
          IIoTGridRow}" 패턴 적용 (개별 Background/Foreground 수동 지정 제거)
     FIX(2026-07-07): DataGrid IsReadOnly="False" 명시 누락으로 ID/Host/Port
          등 모든 컬럼이 편집 불가였던 문제 수정. IIoTGrid 스타일 기본값이
          IsReadOnly="True"(읽기전용 현황판 그리드 기준)이며, DataGrid.IsReadOnly는
          컬럼별 IsReadOnly보다 항상 우선하므로 이 화면(입력 화면)에서는
          반드시 명시적으로 덮어써야 함. "CollectorID 입력이 안 되던" 문제의 근본 원인.
     FIX(2026-07-08): 선택 삭제/저장 버튼이 Style 없이 개별 속성만 사용해
          IsEnabled=False(초기 미선택 상태) 시각 처리가 없어 테마가 깨져
          보이던 문제 수정 — DangerBtn/SecondaryBtn 정식 테마 스타일 적용.
     생성: 2026-07-07 / 수정: 2026-07-08 (버튼 테마 수정)
     규칙:
       ① UserControl.Resources 는 <UserControl> 직계 자식만 허용
       ② DynamicResource 필수 (테마 전환 대응)
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Monitor.Views.CollectorManage.CollectorManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- ConnColor 는 App.xaml 에서 전역 등록됨 -->
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ 툴바 ══ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="＋ Collector 추가"
                    Command="{Binding AddCollectorCommand}"
                    Style="{DynamicResource PrimaryBtn}"
                    Padding="14,7" Margin="0,0,8,0"/>
            <Button Content="🗑 선택 삭제"
                    Command="{Binding RemoveCollectorCommand}"
                    Style="{DynamicResource DangerBtn}"
                    Padding="14,7" Margin="0,0,8,0"/>
            <Button Content="💾 저장"
                    Command="{Binding SaveCommand}"
                    Style="{DynamicResource SecondaryBtn}"
                    Padding="14,7"/>
        </StackPanel>

        <!-- ══ Collector 목록 — 둥근 카드로 감싸기 ══ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="1">
            <DataGrid ItemsSource="{Binding Collectors}"
                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                      Style="{DynamicResource IIoTGrid}"
                      IsReadOnly="False"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0">
                <!-- ★ FIX: IIoTGrid 스타일 기본값(IsReadOnly=True, 읽기전용 현황판 그리드 기준)을
                     이 화면(입력 화면)에서는 명시적으로 덮어써야 함. DataGrid.IsReadOnly는
                     컬럼별 IsReadOnly보다 항상 우선하므로, 이 속성이 없으면 컬럼에
                     IsReadOnly="False"를 아무리 넣어도 편집이 절대 불가능함
                     (증상: ID/Host/Port 입력이 전혀 안 되던 문제의 근본 원인). -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource IIoTGridRow}"/>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID (비워두면 최초 연결 시 자동 설정됨)"
                                        Binding="{Binding Id}" Width="220" IsReadOnly="False"/>
                    <DataGridTextColumn Header="이름"
                                        Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="Host"
                                        Binding="{Binding Host}" Width="150"/>
                    <DataGridTextColumn Header="Port"
                                        Binding="{Binding Port}" Width="80"/>
                    <DataGridCheckBoxColumn Header="활성"
                                            Binding="{Binding Enabled}" Width="60"/>

                    <!-- ★ MN-02B: 연결상태 — 색상 점 + 텍스트 (ConnColor 컨버터) -->
                    <DataGridTemplateColumn Header="연결상태" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                             Fill="{Binding StatusText, Converter={StaticResource ConnColor}}"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{Binding StatusText, Converter={StaticResource ConnColor}}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Hub URL"
                                        Binding="{Binding HubUrl}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ 하단 상태바 ══ -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   Margin="0,10,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource Text2Brush}"/>
    </Grid>
</UserControl>
