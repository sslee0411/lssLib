<!-- ══════════════════════════════════════════════════════════
     IIoT.Monitor · Views/Chart/ChartView.xaml
     역할: [차트] 탭 화면 — Collector/PLC/Tag 필터 + OxyPlot 실시간 라인차트
     MN-06: 신규
     생성: 2026-07-08
     규칙: 전부 DynamicResource — 7개 기본 테마 어디서나 동일하게 동작
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Monitor.Views.Chart.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ 필터 툴바 ══ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Collector" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text2Brush}" FontSize="12" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding Collectors}"
                      SelectedItem="{Binding SelectedCollector}"
                      DisplayMemberPath="Name"
                      Width="160" Margin="0,0,16,0"/>

            <TextBlock Text="PLC" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text2Brush}" FontSize="12" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding AvailablePlcIds}"
                      SelectedItem="{Binding SelectedPlcId}"
                      Width="120" Margin="0,0,16,0"/>

            <TextBlock Text="Tag" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text2Brush}" FontSize="12" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding AvailableTags}"
                      SelectedItem="{Binding SelectedTag}"
                      DisplayMemberPath="TagId"
                      Width="160"/>
        </StackPanel>

        <!-- ══ 차트 카드 ══ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12">
            <oxy:PlotView Model="{Binding PlotModel}"
                          Background="Transparent"/>
        </Border>
    </Grid>
</UserControl>
