<!-- ══════════════════════════════════════════════════════════
     IIoT.Monitor · Views/Dashboard/DashboardView.xaml
     역할: [대시보드] 탭 — 탭 없이 한 화면에 전체 요약(D 스타일)
           KPI 카드 4개 → Collector 카드 그리드 → 실시간 Tag 타일 그리드
     MN-02B: 신규
     생성: 2026-07-07
     규칙: 전부 DynamicResource — 7개 기본 테마 어디서나 동일하게 동작
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Monitor.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- ConnColor/QualColor 는 App.xaml 에서 전역 등록됨 (중복 선언 제거) -->

        <!-- KPI 카드 -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background"    Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"  Value="14"/>
            <Setter Property="Padding"       Value="18,16"/>
        </Style>
        <Style x:Key="KpiNumber" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Margin"     Value="0,4,0,0"/>
        </Style>

        <!-- Collector 카드 -->
        <Style x:Key="CollectorCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Width"           Value="230"/>
            <Setter Property="Margin"          Value="0,0,10,10"/>
        </Style>

        <!-- Tag 타일 -->
        <Style x:Key="TagTile" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="Width"           Value="150"/>
            <Setter Property="Margin"          Value="0,0,10,10"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Margin"     Value="0,20,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <!-- ══ KPI 카드 4개 ══ -->
            <UniformGrid Columns="4" Rows="1">
                <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ConnectedCollectorCount}" Style="{StaticResource KpiNumber}"
                                   Foreground="{DynamicResource AccBrush}"/>
                        <TextBlock Text="연결된 COLLECTOR" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalTagCount}" Style="{StaticResource KpiNumber}"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="전체 TAG" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{Binding GoodQualityCount}" Style="{StaticResource KpiNumber}"
                                   Foreground="{DynamicResource GreenBrush}"/>
                        <TextBlock Text="GOOD 품질" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalCollectorCount}" Style="{StaticResource KpiNumber}"
                                   Foreground="{DynamicResource Text2Brush}"/>
                        <TextBlock Text="등록된 COLLECTOR" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ══ Collector 카드 그리드 ══ -->
            <TextBlock Text="COLLECTOR" Style="{StaticResource SectionTitle}"/>
            <ItemsControl ItemsSource="{Binding Collectors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CollectorCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding HubUrl}" FontSize="10.5" FontFamily="Consolas"
                                           Foreground="{DynamicResource Text3Brush}" Margin="0,2,0,10"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="Bold"
                                           Foreground="{Binding StatusText, Converter={StaticResource ConnColor}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ══ 실시간 Tag 타일 그리드 ══ -->
            <TextBlock Text="실시간 TAG (전체 Collector 통합)" Style="{StaticResource SectionTitle}"/>
            <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TagTile}">
                            <StackPanel>
                                <DockPanel>
                                    <Ellipse Width="7" Height="7" DockPanel.Dock="Right" VerticalAlignment="Center"
                                             Fill="{Binding Quality, Converter={StaticResource QualColor}}"/>
                                    <TextBlock Text="{Binding TagId}" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                </DockPanel>
                                <TextBlock Margin="0,6,0,0">
                                    <Run Text="{Binding EngValue, StringFormat=N2}" FontSize="18" FontWeight="Bold"
                                         Foreground="{DynamicResource TextBrush}"/>
                                    <Run Text="{Binding Unit}" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding PlcId}" FontSize="10" Foreground="{DynamicResource Text3Brush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
