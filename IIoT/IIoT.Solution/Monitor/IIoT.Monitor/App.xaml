<!-- ══════════════════════════════════════════════════════════
     IIoT.Monitor · App.xaml
     역할: 애플리케이션 리소스 선언
           ① BoolToVisibilityConverter 전역 등록
           ② MN-02B: UI 컨버터(탭 활성 표시/연결상태 색상/품질 색상) 전역 등록
              — 모든 View 가 재선언 없이 {StaticResource} 로 공용 사용
     규칙:
       ① StartupUri 없음 — App.xaml.cs OnStartup 에서 창 직접 생성
          (StartupUri + Show() 동시 사용 → 이중 창 버그)
       ② 컨버터는 MergedDictionaries 안에 등록
          (최상위 ResourceDictionary 직접 등록 시 테마 전환 때 소멸)
     생성: 2026-07-07 / 수정: 2026-07-07 (MN-02B)
     ══════════════════════════════════════════════════════════ -->
<Application x:Class="IIoT.Monitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
             xmlns:mconv="clr-namespace:IIoT.Monitor.Core.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <!-- ★ BoolToVisibilityConverter 전역 등록 -->
                    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

                    <!-- ★ MN-02B: UI 디자인 개선용 컨버터 전역 등록 -->
                    <mconv:TabActiveBackgroundConverter x:Key="TabBg"/>
                    <mconv:TabActiveForegroundConverter x:Key="TabFg"/>
                    <mconv:ConnectionStatusColorConverter x:Key="ConnColor"/>
                    <mconv:QualityColorConverter x:Key="QualColor"/>

                    <!-- ★ MN-03: 알람 레벨/상태 색상 컨버터 -->
                    <mconv:AlarmLevelColorConverter x:Key="AlarmLevelColor"/>
                    <mconv:AlarmStatusColorConverter x:Key="AlarmStatusColor"/>

                    <!-- ★ MN-EX-05: 즐겨찾기 아이콘 컨버터 -->
                    <mconv:FavoriteIconConverter x:Key="FavoriteIcon"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
