<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!--
      ★ RootNamespace 명시: 파일명(IIoT.Monitor)의 . 이 네임스페이스 분리자로
        인식되는 것을 방지. App.xaml x:Class="IIoT.Monitor.App" 와 일치.
    -->
		<RootNamespace>IIoT.Monitor</RootNamespace>
		<AssemblyName>IIoT.Monitor</AssemblyName>
		<!-- ★ MN-EX-01: 트레이 아이콘(NotifyIcon)을 쓰기 위해 WinForms 활성화.
		     주의: System.Windows.Forms 는 System.Windows(WPF) 와 겹치는 타입명이
		     있으므로(MessageBox, Application 등), Forms 관련 코드 파일에서는
		     "using System.Windows.Forms;" 만 단독으로 쓰고 "using System.Windows;"
		     와 같은 파일에서 함께 열지 않는다(모호한 참조 오류 방지). -->
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<!--
    ★ FIX (2026-07-08): UseWindowsForms=true + ImplicitUsings=enable 조합은
      System.Windows.Forms 를 프로젝트 "전역" using으로 자동 추가한다.
      WPF의 System.Windows 도 전역 using이라, Application/UserControl/Brush
      등 겹치는 타입명이 프로젝트 전체(App.xaml.cs, 모든 View.xaml.cs 등)에서
      CS0104(모호한 참조) 오류를 일으켰다.
      → System.Windows.Forms 의 "전역" using만 제거(어셈블리 참조는 유지).
        TrayNotificationService.cs 처럼 실제로 Forms 타입이 필요한 파일은
        그 파일 안에서만 "using System.Windows.Forms;" 를 개별 선언해서 쓴다.
  -->
	<ItemGroup>
		<Using Remove="System.Windows.Forms" />
	</ItemGroup>

	<!--
    ★ FIX (MN-01B, 2026-07-07): Microsoft.AspNetCore.App FrameworkReference 제거했었음.
      MN-Base-0에서 MN-05를 미리 대비해 선반영했으나, 당시엔 SignalR.Client 패키지와
      버전 충돌이 있어 제거하고 MN-05 시점에 재검토하기로 했었다 (Ver History v7.10 참조).
  -->
	<!--
    ★ MN-05 (2026-07-08): FrameworkReference 재도입.
      Monitor가 이제 ①Collector에 접속하는 클라이언트(SignalR.Client)이면서
      동시에 ②웹 브라우저용 자체 Hub를 호스팅(ASP.NET Core)해야 하므로 필수.
      지난 충돌의 원인은 Microsoft.Extensions.DependencyInjection을 8.0.0으로
      "명시 고정"했던 것 — 지금은 그 명시 버전을 완전히 제거하고
      FrameworkReference가 제공하는 공유 프레임워크 버전을 그대로 쓰도록 하여
      재충돌을 피한다. (만약 이번에도 NU1605/다운그레이드 오류가 나면,
      오류 메시지의 요구 버전을 확인해 PackageReference로 그 버전 이상을
      명시적으로 재고정할 것 — 오류 빠른 참조표 패턴 참고)
  -->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<!-- Microsoft.Extensions.DependencyInjection: 명시 버전 지정 안 함 —
		     FrameworkReference(Microsoft.AspNetCore.App)가 제공하는 버전을 그대로 사용 -->
		<!-- MN-01B: Collector SignalR Hub 접속용 클라이언트 (다중 HubConnection) -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.*" />
		<!-- MN-06: 실시간 차트. Collector C-13과 동일 버전 고정
		     (오류 참조표 "NU1701 SkiaSharp" 패턴 — LiveChartsCore 대신 이 버전 사용) -->
		<PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- lssLib BCL — 로그 -->
		<ProjectReference Include="..\..\..\..\Base\BCL\DB\lssLib.DB.Sqlite\lssLib.DB.Sqlite.csproj" />

		<!-- ★ MN-EX-02: lssLib BCL — SQLite (알람 이력 저장) -->
		<ProjectReference Include="..\..\..\..\Base\BCL\DB\lssLib.DB\lssLib.DB.csproj" />
		<ProjectReference Include="..\..\..\..\Base\BCL\log\lssLib.Log\lssLib.Log.csproj" />

		<!-- WPF 테마 (v1.5) -->
		<ProjectReference Include="..\..\UI\Themes\IIoT.UI.Themes\IIoT.UI.Themes.csproj" />
	</ItemGroup>

</Project>