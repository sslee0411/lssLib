<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Contracts\IIoT.Contracts.csproj" />
	</ItemGroup>

	<!--
  ══════════════════════════════════════════════════════════
    빌드 후 자동 복사 — Plugins/ 폴더로 이동
    솔루션 구조 (Git 기준):
      IIoT.Solution\
        Studio\IIoT.Studio\bin\$(Configuration)\net8.0-windows\Plugins\     ← Studio 대상
        Collector\IIoT.Collector\bin\$(Configuration)\net8.0-windows\Plugins\ ← Collector 대상
        Plugins\IIoT.Driver.Virtual\                                          ← 현재 위치
    C-02: ModbusTcp/Mitsubishi 와 동일 패턴 — Collector 경로 처음부터 활성화
          (실제 PLC 없이 Collector 단독 테스트가 목적이므로 Studio 복사는 생략 가능하나
           Studio PLC 편집기에서도 동일하게 선택 가능하도록 동일 적용)
  ══════════════════════════════════════════════════════════
  -->
	<PropertyGroup>
		<SolutionRoot>$(MSBuildProjectDirectory)\..\..</SolutionRoot>

		<StudioPluginDir>$(SolutionRoot)\Studio\IIoT.Studio\bin\$(Configuration)\net8.0-windows\Plugins</StudioPluginDir>

		<CollectorPluginDir>$(SolutionRoot)\Collector\IIoT.Collector\bin\$(Configuration)\net8.0-windows\Plugins</CollectorPluginDir>
	</PropertyGroup>

	<!-- Studio Plugins/ 자동 복사 -->
	<Target Name="CopyToStudioPlugins" AfterTargets="Build">
		<MakeDir Directories="$(StudioPluginDir)" Condition="!Exists('$(StudioPluginDir)')"/>
		<Copy
		  SourceFiles="$(OutputPath)$(AssemblyName).dll"
		  DestinationFolder="$(StudioPluginDir)"
		  SkipUnchangedFiles="true"
		  OverwriteReadOnlyFiles="true"/>
		<Message
		  Text="[Virtual] → Studio Plugins/ 복사: $(StudioPluginDir)"
		  Importance="High"/>
	</Target>

	<!-- Collector Plugins/ 자동 복사 -->
	<Target Name="CopyToCollectorPlugins" AfterTargets="Build">
		<MakeDir Directories="$(CollectorPluginDir)" Condition="!Exists('$(CollectorPluginDir)')"/>
		<Copy
		  SourceFiles="$(OutputPath)$(AssemblyName).dll"
		  DestinationFolder="$(CollectorPluginDir)"
		  SkipUnchangedFiles="true"
		  OverwriteReadOnlyFiles="true"/>
		<Message
		  Text="[Virtual] → Collector Plugins/ 복사: $(CollectorPluginDir)"
		  Importance="High"/>
	</Target>

</Project>