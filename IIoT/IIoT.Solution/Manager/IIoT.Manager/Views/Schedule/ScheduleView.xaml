<!-- ══════════════════════════════════════════════════════════
     IIoT.Manager · Views/Schedule/ScheduleView.xaml
     역할: [스케줄] 탭 — 스케줄 관리 (요구사항 4-2-8)
           추가 폼(프로그램·동작·시각·요일) + 목록(활성 토글·삭제)
     MG-07: 신규
     생성: 2026-07-09
     규칙:
       ① DynamicResource 필수 (버튼: 테마 정식 스타일 — 버그 #9 교훈)
       ② UserControl.Resources 는 UserControl 직계 자식
       ③ ComboBox → PropCombo 스타일 필수 (시스템 컬러 우회)
       ④ Grid 는 Padding 불가 → Border.Padding 사용 (MC3072)
       ⑧ DisplayMemberPath + ItemTemplate 동시 사용 금지 → ItemTemplate 만 사용
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Manager.Views.Schedule.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="16,12"/>
        </Style>
    </UserControl.Resources>

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 추가 폼 -->
                <RowDefinition Height="*"/>     <!-- 목록 -->
                <RowDefinition Height="Auto"/>  <!-- 상태 -->
            </Grid.RowDefinitions>

            <!-- § 스케줄 추가 폼 -->
            <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="스케줄 추가"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="프로그램:"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <!-- 규칙 ⑧: ItemTemplate 만 사용 (DisplayMemberPath 병용 금지) -->
                        <ComboBox Width="150"
                                  Style="{DynamicResource PropCombo}"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding ProcessOptions}"
                                  SelectedItem="{Binding SelectedProcess}"
                                  Margin="0,0,14,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="동작:"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="90"
                                  Style="{DynamicResource PropCombo}"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding ActionOptions}"
                                  SelectedItem="{Binding SelectedAction}"
                                  Margin="0,0,14,0"/>

                        <TextBlock Text="시각(HH:mm):"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="70"
                                 Style="{DynamicResource PropInput}"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,14,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="요일:"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ItemsControl ItemsSource="{Binding DayOptions}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected}"
                                              FontSize="12"
                                              Foreground="{DynamicResource Text2Brush}"
                                              Margin="0,0,10,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="➕ 추가"
                                Style="{DynamicResource PrimaryBtn}"
                                Command="{Binding AddCommand}"
                                Margin="16,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- § 스케줄 목록 -->
            <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="등록된 스케줄 (체크 = 활성, 30초 주기 검사로 도래 시 자동 실행)"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,8"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Schedules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="🗑 삭제"
                                                Style="{DynamicResource DangerBtn}"
                                                FontSize="11" Padding="8,3"
                                                Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <CheckBox IsChecked="{Binding Enabled}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding SummaryText}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- § 상태 -->
            <TextBlock Grid.Row="2"
                       Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{DynamicResource Text2Brush}"/>

        </Grid>
    </Border>

</UserControl>
