<!-- ══════════════════════════════════════════════════════════
     IIoT.Manager · Views/Dashboard/DashboardView.xaml
     역할: [대시보드] 탭 — 전체 요약 (상태 집계 칩 + 프로그램 미니 목록 +
           최근 이벤트 + 시스템 정보)
     MG-05: 신규 — Monitor 대시보드(D스타일) 룩앤필 준용
     생성: 2026-07-09
     규칙:
       ① DynamicResource 필수 (Trigger Setter 포함)
       ② UserControl.Resources 는 UserControl 직계 자식
       ④ Grid 는 Padding 불가 → Border.Padding 사용 (MC3072)
     ══════════════════════════════════════════════════════════ -->
<UserControl x:Class="IIoT.Manager.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 요약 칩 카드 -->
        <Style x:Key="SummaryChip" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="20,14"/>
            <Setter Property="Margin"          Value="0,0,12,0"/>
            <Setter Property="Width"           Value="150"/>
        </Style>

        <Style x:Key="ChipNumber" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ChipLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
        </Style>

        <!-- 섹션 카드 -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="16,12"/>
        </Style>
    </UserControl.Resources>

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 요약 칩 -->
                <RowDefinition Height="Auto"/>  <!-- 프로그램 미니 목록 -->
                <RowDefinition Height="*"/>     <!-- 최근 이벤트 -->
                <RowDefinition Height="Auto"/>  <!-- 시스템 정보 -->
            </Grid.RowDefinitions>

            <!-- § 요약 칩 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Style="{StaticResource SummaryChip}">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalCount}"
                                   Style="{StaticResource ChipNumber}"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="전체 프로그램" Style="{StaticResource ChipLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryChip}">
                    <StackPanel>
                        <TextBlock Text="{Binding RunningCount}"
                                   Style="{StaticResource ChipNumber}"
                                   Foreground="{DynamicResource GreenBrush}"/>
                        <TextBlock Text="실행 중" Style="{StaticResource ChipLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryChip}">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorCount}"
                                   Style="{StaticResource ChipNumber}"
                                   Foreground="{DynamicResource YellowBrush}"/>
                        <TextBlock Text="응답 없음" Style="{StaticResource ChipLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryChip}">
                    <StackPanel>
                        <TextBlock Text="{Binding StoppedCount}"
                                   Style="{StaticResource ChipNumber}"
                                   Foreground="{DynamicResource RedBrush}"/>
                        <TextBlock Text="정지" Style="{StaticResource ChipLabel}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- § 프로그램 미니 목록 (상태점 + 이름 + 응답시간) -->
            <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="프로그램 현황"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Main.Processes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,28,2">
                                    <Ellipse Width="9" Height="9"
                                             VerticalAlignment="Center"
                                             Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource RedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="실행 중">
                                                        <Setter Property="Fill" Value="{DynamicResource GreenBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="응답 없음">
                                                        <Setter Property="Fill" Value="{DynamicResource YellowBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Info.Name}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  "
                                               FontSize="12"
                                               Foreground="{DynamicResource Text3Brush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PingText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Text2Brush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- § 최근 이벤트 -->
            <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="최근 이벤트"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,8"/>
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding History.Events}"
                              Background="Transparent"
                              BorderThickness="0"
                              FontSize="12"
                              FontFamily="Consolas, Courier New"
                              VirtualizingPanel.IsVirtualizing="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimeText}"
                                               Width="70"
                                               Foreground="{DynamicResource Text3Brush}"/>
                                    <TextBlock Text="{Binding Program}"
                                               Width="120"
                                               Foreground="{DynamicResource AccBrush}"/>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{DynamicResource Text2Brush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="2,1"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

            <!-- § 시스템 정보 -->
            <Border Grid.Row="3" Style="{StaticResource SectionCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="가동 시간: "
                               FontSize="11"
                               Foreground="{DynamicResource Text3Brush}"/>
                    <TextBlock Text="{Binding UptimeText}"
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"/>
                    <TextBlock Text="    설정: "
                               FontSize="11"
                               Foreground="{DynamicResource Text3Brush}"/>
                    <TextBlock Text="{Binding SettingsPath}"
                               FontSize="11"
                               Foreground="{DynamicResource Text2Brush}"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</UserControl>
