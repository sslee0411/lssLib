<!-- ══════════════════════════════════════════════════════════
     IIoT.Manager · App.xaml
     역할: 애플리케이션 리소스 선언
           ① BoolToVisibilityConverter 전역 등록
     규칙:
       ① StartupUri 없음 — App.xaml.cs OnStartup 에서 창 직접 생성
          (StartupUri + Show() 동시 사용 → 이중 창 버그)
       ② 컨버터는 MergedDictionaries 안에 등록
          (최상위 ResourceDictionary 직접 등록 시 테마 전환 때 소멸)
     생성: 2026-07-09 (MG-Base-0)
     ══════════════════════════════════════════════════════════ -->
<Application x:Class="IIoT.Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <!-- ★ BoolToVisibilityConverter 전역 등록 -->
                    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
