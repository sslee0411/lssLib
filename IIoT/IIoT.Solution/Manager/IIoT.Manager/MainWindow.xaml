<!-- ══════════════════════════════════════════════════════════
     IIoT.Manager · MainWindow.xaml
     역할: 메인 창
     MG-Base-0: 빈 창 + 테마 (헤더 56px: 타이틀 + ThemePickerButton)
     MG-01: 본문에 ProcessStatusHost(ContentControl) + 하단 상태바 추가
            (DI 필요 View → ContentControl + 코드 주입 패턴)
     MG-04: 탭바(48px) 추가 — [프로세스][로그] 2탭, LogViewerHost 신설.
            탭 전환은 Visibility 토글 (콘텐츠 유지 — 로그 수신 지속)
     생성: 2026-07-09 / 수정: 2026-07-09 (MG-04)
     규칙:
       ① DynamicResource 필수 (StaticResource → 테마 전환 시 깨짐)
       ② BoolToVisibility: Window.Resources 직접 등록
       ③ xmlns:uc assembly="IIoT.UI.Themes" (크로스-프로젝트 xmlns)
       ④ DI 필요 View → ContentControl + 코드 주입 패턴
       ⑤ 탭 버튼 CommandParameter 는 string → ViewModel int.TryParse 처리
     ══════════════════════════════════════════════════════════ -->
<Window x:Class="IIoT.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:IIoT.UI.Themes.Controls;assembly=IIoT.UI.Themes"
        Title="IIoT Manager — 통합 관리"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- ★ MG-04: 탭 버튼 필(pill) 스타일 — 선택 여부는 각 버튼의 DataTrigger 로 처리 -->
        <Style x:Key="TabBtnBase" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="4,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 탭 0 (프로세스) 선택 시 강조 -->
        <Style x:Key="TabBtn0" TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcessTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 탭 1 (로그) 선택 시 강조 -->
        <Style x:Key="TabBtn1" TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLogTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ★ MG-05: 탭 2 (대시보드) 선택 시 강조 -->
        <Style x:Key="TabBtn2" TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDashboardTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ★ MG-06: 탭 3 (배포) 선택 시 강조 -->
        <Style x:Key="TabBtn3" TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeployTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ★ MG-07: 탭 4 (스케줄) 선택 시 강조 -->
        <Style x:Key="TabBtn4" TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsScheduleTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ★ C-SET-01 후속: 탭 5 (환경설정) 선택 시 강조 -->
        <Style x:Key="TabBtn5" TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ★ HM-22: 탭 6 (원격 설정) 선택 시 강조 -->
        <Style x:Key="TabBtn6" TargetType="Button" BasedOn="{StaticResource TabBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRemoteSettingsTab}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccFaintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- § 헤더 (56px) -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="IIoT.Manager"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  통합 관리"
                               FontSize="12"
                               Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 테마 선택 버튼 (우측) -->
                <uc:ThemePickerButton DockPanel.Dock="Right"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- § MG-04: 탭바 (48px) -->
        <Border DockPanel.Dock="Top"
                Height="48"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="12,0">
                <Button Content="⚙ 프로세스"
                        Style="{StaticResource TabBtn0}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="0"/>
                <Button Content="📋 로그"
                        Style="{StaticResource TabBtn1}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="1"/>
                <!-- ★ MG-05 -->
                <Button Content="📊 대시보드"
                        Style="{StaticResource TabBtn2}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="2"/>
                <!-- ★ MG-06 -->
                <Button Content="🚀 배포"
                        Style="{StaticResource TabBtn3}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="3"/>
                <!-- ★ MG-07 -->
                <Button Content="⏰ 스케줄"
                        Style="{StaticResource TabBtn4}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="4"/>
                <!-- ★ C-SET-01 후속 -->
                <Button Content="⚙ 환경설정"
                        Style="{StaticResource TabBtn5}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="5"/>
                <!-- ★ HM-22 -->
                <Button Content="🌐 원격 설정"
                        Style="{StaticResource TabBtn6}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="6"/>
            </StackPanel>
        </Border>

        <!-- § 하단 상태바 (26px) — 마지막 갱신 시각 -->
        <Border DockPanel.Dock="Bottom"
                Height="26"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11"
                       Foreground="{DynamicResource Text3Brush}"
                       VerticalAlignment="Center"
                       Margin="16,0"/>
        </Border>

        <!-- § 본문 — 탭별 호스트 (Visibility 토글: 숨김 탭도 수신 지속) -->
        <Grid>
            <ContentControl x:Name="ProcessStatusHost"
                            Visibility="{Binding IsProcessTab, Converter={StaticResource BoolToVisibility}}"/>
            <ContentControl x:Name="LogViewerHost"
                            Visibility="{Binding IsLogTab, Converter={StaticResource BoolToVisibility}}"/>
            <!-- ★ MG-05 -->
            <ContentControl x:Name="DashboardHost"
                            Visibility="{Binding IsDashboardTab, Converter={StaticResource BoolToVisibility}}"/>
            <!-- ★ MG-06 -->
            <ContentControl x:Name="DeployHost"
                            Visibility="{Binding IsDeployTab, Converter={StaticResource BoolToVisibility}}"/>
            <!-- ★ MG-07 -->
            <ContentControl x:Name="ScheduleHost"
                            Visibility="{Binding IsScheduleTab, Converter={StaticResource BoolToVisibility}}"/>
            <!-- ★ C-SET-01 후속 -->
            <ContentControl x:Name="SettingsHost"
                            Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVisibility}}"/>
            <!-- ★ HM-22 -->
            <ContentControl x:Name="RemoteSettingsHost"
                            Visibility="{Binding IsRemoteSettingsTab, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

    </DockPanel>

</Window>
