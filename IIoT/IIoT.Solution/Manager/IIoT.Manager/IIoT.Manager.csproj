<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!--
      ★ RootNamespace 명시: 파일명(IIoT.Manager)의 . 이 네임스페이스 분리자로
        인식되는 것을 방지. App.xaml x:Class="IIoT.Manager.App" 와 일치.
        (Monitor MN-Base-0 과 동일 패턴)
    -->
		<RootNamespace>IIoT.Manager</RootNamespace>
		<AssemblyName>IIoT.Manager</AssemblyName>
		<!-- ★ MG-EX-01: 트레이 아이콘(NotifyIcon)용 WinForms 활성화.
		     Forms 타입이 필요한 파일(TrayService.cs)에서만
		     "using System.Windows.Forms;" 단독 선언해서 사용 -->
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<!--
    ★ MG-EX-01 (Monitor 버그 #12 교훈): UseWindowsForms=true + ImplicitUsings=enable
      조합은 System.Windows.Forms 를 전역 using 으로 추가해 WPF System.Windows 와
      CS0104(모호한 참조)를 프로젝트 전체에 유발 → 전역 using 만 제거(어셈블리 참조 유지)
  -->
	<ItemGroup>
		<Using Remove="System.Windows.Forms" />
	</ItemGroup>

	<!--
    ★ MG-Base-0 (2026-07-09): 최소 구성 원칙.
      Monitor 버그 #1 교훈 — FrameworkReference(ASP.NET Core) 선반영이
      SignalR.Client 와 버전 충돌을 일으켰음. Manager 는 웹 호스팅이 필요한
      Step 이 오기 전까지 FrameworkReference 를 추가하지 않는다.
      ※ FrameworkReference 가 없으므로 Microsoft.Extensions.DependencyInjection
        은 PackageReference 로 명시 추가 (Monitor 버그 #2 교훈 — 8.0.0 고정은
        낮아서 다운그레이드 오류 유발 → 8.0.1 이상 사용)
  -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
		<!-- ★ MG-EX-06: 응답시간 추세 스파크라인. Monitor MN-06/Collector C-13 과
		     동일 버전 고정 (오류 참조표 "NU1701 SkiaSharp" 패턴 —
		     LiveChartsCore 대신 이 버전 사용) -->
		<PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- lssLib BCL — 로그 -->
		<ProjectReference Include="..\..\..\..\Base\BCL\log\lssLib.Log\lssLib.Log.csproj" />

		<!-- ★ MG-EX-04: lssLib BCL — SQLite (이벤트 이력 영구 저장, Monitor MN-EX-02 패턴) -->
		<ProjectReference Include="..\..\..\..\Base\BCL\DB\lssLib.DB\lssLib.DB.csproj" />
		<ProjectReference Include="..\..\..\..\Base\BCL\DB\lssLib.DB.Sqlite\lssLib.DB.Sqlite.csproj" />

		<!-- WPF 테마 (v1.5) -->
		<ProjectReference Include="..\..\UI\Themes\IIoT.UI.Themes\IIoT.UI.Themes.csproj" />

		<!-- ★ MG-03: 헬스체크 파이프명 규칙 공유 (HealthPipeServer.GetPipeName) -->
		<ProjectReference Include="..\..\Contracts\IIoT.Contracts.csproj" />
	</ItemGroup>

</Project>
