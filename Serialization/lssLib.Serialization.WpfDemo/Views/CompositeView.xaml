<UserControl x:Class="lssLib.Serialization.WpfDemo.Views.CompositeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:lssLib.Serialization.WpfDemo.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 시나리오 목록 -->
        <StackPanel Grid.Column="0">

            <!-- 기본 시나리오 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="⚡ Binary + Extensions 종합" Style="{StaticResource SectionLabel}"
                               FontSize="12" Foreground="#1E88E5" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock FontSize="10" Foreground="#78909C" TextWrapping="Wrap" Margin="0,0,0,8">
                        파싱·스케일링·직렬화·CRC를 조합한 실전 패턴
                    </TextBlock>
                    <Button Content="① ADC 센서 프레임 파싱 + 스케일링"    Click="OnAdcSensor"   Style="{StaticResource Btn}"/>
                    <Button Content="② 금융 데이터 프레임 (decimal 정밀)"  Click="OnFinancial"   Style="{StaticResource GreenBtn}"/>
                    <Button Content="③ 암호화 프레임 (XOR) 투명 파싱"      Click="OnEncrypted"   Style="{StaticResource PurpleBtn}"/>
                    <Button Content="④ 다중 프레임 슬라이딩 윈도우"         Click="OnSliding"     Style="{StaticResource OrangeBtn}"/>
                    <Button Content="⑤ CRC 검증 후 조건부 파싱"            Click="OnCrcVerify"   Style="{StaticResource TealBtn}"/>
                    <Button Content="⑥ JSON 설정 → 스키마 동적 생성"       Click="OnDynSchema"   Style="{StaticResource RedBtn}"/>
                    <Button Content="⑦ 파싱 → Scale → CSV 파이프라인"      Click="OnPipeline"    Style="{StaticResource Btn}"/>
                    <Button Content="⑧ struct ↔ byte[] 직렬화 왕복"        Click="OnStructRound" Style="{StaticResource GreenBtn}"/>
                </StackPanel>
            </Border>

            <!-- BufferWriter 시나리오 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="✏️ BufferWriter 시나리오 (★신규)" Style="{StaticResource SectionLabel}"
                               FontSize="12" Foreground="#43A047" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Button Content="⑨ 요청 프레임 생성 + 응답 파싱"       Click="OnWriterRequest"  Style="{StaticResource GreenBtn}"/>
                    <Button Content="⑩ Writer → Parser 왕복 검증"          Click="OnWriterRoundtrip" Style="{StaticResource TealBtn}"/>
                </StackPanel>
            </Border>

            <!-- RingBuffer 시나리오 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="🔄 RingBuffer 시나리오 (★신규)" Style="{StaticResource SectionLabel}"
                               FontSize="12" Foreground="#E65100" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Button Content="⑪ 수신 스트림 → 프레임 자동 추출"    Click="OnRingBuffer"    Style="{StaticResource OrangeBtn}"/>
                    <Button Content="⑫ 가변 길이 프레임 + Thread-safe 시뮬" Click="OnRingVariable" Style="{StaticResource RedBtn}"/>
                </StackPanel>
            </Border>

            <!-- BufferDiff 시나리오 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="🔍 BufferDiff 시나리오 (★신규)" Style="{StaticResource SectionLabel}"
                               FontSize="12" Foreground="#7B1FA2" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Button Content="⑬ 프레임 변경 감지 (설정 비교)"       Click="OnDiffBasic"    Style="{StaticResource PurpleBtn}"/>
                    <Button Content="⑭ 마스킹 비교 (CRC/타임스탬프 제외)"  Click="OnDiffMasked"   Style="{StaticResource TealBtn}"/>
                    <Button Content="⑮ 스키마 기반 필드 단위 비교"          Click="OnDiffFields"   Style="{StaticResource Btn}"/>
                    <Button Content="⑯ 펌웨어 패치 생성 + 적용"            Click="OnDiffPatch"    Style="{StaticResource OrangeBtn}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 오른쪽: 시나리오 설명 + 결과 -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 시나리오 설명 -->
                <Border Grid.Row="0" Background="#E8F5E9" CornerRadius="6"
                        BorderBrush="#A5D6A7" BorderThickness="1"
                        Padding="10,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="ScenTitle" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#2E7D32" Text="← 시나리오를 선택하세요"/>
                        <TextBlock x:Name="ScenDesc" FontSize="10" Foreground="#388E3C"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="실행 결과" Style="{StaticResource SectionLabel}"
                               DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="지우기" Click="OnClear"
                            Padding="10,3" FontSize="11" Background="#ECEFF1"
                            Foreground="#546E7A" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Right" Margin="0"/>
                </DockPanel>

                <TextBox Grid.Row="2" x:Name="Out" Style="{StaticResource ResultBox}" MinHeight="450"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

