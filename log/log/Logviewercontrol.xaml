<UserControl x:Class="log.LogViewerControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:local="clr-namespace:log"
            Loaded="UserControl_Loaded"
            Unloaded="UserControl_Unloaded">

   <UserControl.Resources>

       <!-- 레벨 → 배경색 변환기 -->
       <local:LogLevelToBrushConverter x:Key="LevelToBrush"/>
       <local:LogLevelToForegroundConverter x:Key="LevelToFg"/>

       <!-- ListView 행 스타일 -->
       <Style x:Key="LogRowStyle" TargetType="ListViewItem">
           <Setter Property="Background"
                   Value="{Binding Level, Converter={StaticResource LevelToBrush}}"/>
           <Setter Property="Foreground"
                   Value="{Binding Level, Converter={StaticResource LevelToFg}}"/>
           <Setter Property="FontFamily" Value="Consolas"/>
           <Setter Property="FontSize"   Value="12"/>
           <Setter Property="Height"     Value="22"/>
           <Setter Property="Padding"    Value="0"/>
           <Setter Property="BorderThickness" Value="0"/>
           <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
           <Style.Triggers>
               <Trigger Property="IsMouseOver" Value="True">
                   <Setter Property="Opacity" Value="0.85"/>
               </Trigger>
               <Trigger Property="IsSelected" Value="True">
                   <Setter Property="BorderBrush"     Value="#4A90D9"/>
                   <Setter Property="BorderThickness" Value="0,0,0,1"/>
               </Trigger>
           </Style.Triggers>
       </Style>

       <!-- 레벨 뱃지 스타일 -->
       <Style x:Key="LevelBadgeStyle" TargetType="TextBlock">
           <Setter Property="FontFamily"  Value="Consolas"/>
           <Setter Property="FontSize"    Value="11"/>
           <Setter Property="FontWeight"  Value="Bold"/>
           <Setter Property="HorizontalAlignment" Value="Center"/>
           <Setter Property="VerticalAlignment"   Value="Center"/>
       </Style>

       <!-- 툴바 버튼 스타일 -->
       <Style x:Key="ToolBtnStyle" TargetType="Button">
           <Setter Property="Padding"         Value="10,3"/>
           <Setter Property="Margin"          Value="2,0"/>
           <Setter Property="Background"      Value="#3C3F41"/>
           <Setter Property="Foreground"      Value="#BBBBBB"/>
           <Setter Property="BorderBrush"     Value="#555555"/>
           <Setter Property="BorderThickness" Value="1"/>
           <Setter Property="Cursor"          Value="Hand"/>
           <Setter Property="Template">
               <Setter.Value>
                   <ControlTemplate TargetType="Button">
                       <Border Background="{TemplateBinding Background}"
                               BorderBrush="{TemplateBinding BorderBrush}"
                               BorderThickness="{TemplateBinding BorderThickness}"
                               CornerRadius="3" Padding="{TemplateBinding Padding}"/>
                       <ControlTemplate.Triggers>
                           <Trigger Property="IsMouseOver" Value="True">
                               <Setter Property="Background" Value="#4E5254"/>
                           </Trigger>
                           <Trigger Property="IsPressed"   Value="True">
                               <Setter Property="Background" Value="#2B2D2F"/>
                           </Trigger>
                       </ControlTemplate.Triggers>
                   </ControlTemplate>
               </Setter.Value>
           </Setter>
       </Style>

       <!-- 툴바 ComboBox 스타일 -->
       <Style x:Key="ToolComboStyle" TargetType="ComboBox">
           <Setter Property="Background"  Value="#3C3F41"/>
           <Setter Property="Foreground"  Value="#CCCCCC"/>
           <Setter Property="BorderBrush" Value="#555555"/>
           <Setter Property="Height"      Value="24"/>
           <Setter Property="Padding"     Value="6,2"/>
           <Setter Property="FontFamily"  Value="Segoe UI"/>
           <Setter Property="FontSize"    Value="12"/>
       </Style>

       <!-- 툴바 TextBox 스타일 -->
       <Style x:Key="ToolTextStyle" TargetType="TextBox">
           <Setter Property="Background"   Value="#3C3F41"/>
           <Setter Property="Foreground"   Value="#CCCCCC"/>
           <Setter Property="BorderBrush"  Value="#555555"/>
           <Setter Property="CaretBrush"   Value="#CCCCCC"/>
           <Setter Property="Height"       Value="24"/>
           <Setter Property="Padding"      Value="6,2"/>
           <Setter Property="FontFamily"   Value="Segoe UI"/>
           <Setter Property="FontSize"     Value="12"/>
           <Setter Property="VerticalContentAlignment" Value="Center"/>
       </Style>

   </UserControl.Resources>

   <Grid>
       <Grid.RowDefinitions>
           <RowDefinition Height="38"/>
           <RowDefinition Height="*"/>
           <RowDefinition Height="24"/>
       </Grid.RowDefinitions>

       <Border Grid.Row="0" Background="#2B2D2F"
               BorderBrush="#404040" BorderThickness="0,0,0,1">
           <DockPanel Margin="6,0" VerticalAlignment="Center">
               <TextBlock Text="레벨" Foreground="#AAAAAA" FontSize="11"
                          VerticalAlignment="Center" Margin="0,0,4,0"/>
               <ComboBox x:Name="CmbLevel" Width="80"
                         Style="{StaticResource ToolComboStyle}"
                         SelectionChanged="CmbLevel_SelectionChanged">
                   <ComboBoxItem Content="ALL"   IsSelected="True"/>
                   <ComboBoxItem Content="DEBUG"/>
                   <ComboBoxItem Content="INFO"/>
                   <ComboBoxItem Content="WARN"/>
                   <ComboBoxItem Content="ERROR"/>
                   <ComboBoxItem Content="FATAL"/>
               </ComboBox>
               <TextBlock Text="출처" Foreground="#AAAAAA" FontSize="11"
                          VerticalAlignment="Center" Margin="10,0,4,0"/>
               <TextBox x:Name="TxtSource" Width="110"
                        Style="{StaticResource ToolTextStyle}"
                        TextChanged="TxtFilter_TextChanged"/>
               <TextBlock Text="검색" Foreground="#AAAAAA" FontSize="11"
                          VerticalAlignment="Center" Margin="10,0,4,0"/>
               <TextBox x:Name="TxtSearch" Width="150"
                        Style="{StaticResource ToolTextStyle}"
                        TextChanged="TxtFilter_TextChanged"/>
               <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                           HorizontalAlignment="Right" VerticalAlignment="Center">
                   <CheckBox x:Name="ChkAutoScroll"
                             Content="자동스크롤" IsChecked="True"
                             Foreground="#AAAAAA" FontSize="11"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                   <Button Content="지우기"   Style="{StaticResource ToolBtnStyle}"
                           Click="BtnClear_Click"/>
                   <Button Content="내보내기" Style="{StaticResource ToolBtnStyle}"
                           Click="BtnExport_Click"/>
               </StackPanel>
           </DockPanel>
       </Border>

       <ListView x:Name="LvLog" Grid.Row="1"
                 Background="#1E1E1E"
                 BorderThickness="0"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource LogRowStyle}">
           <ListView.View>
               <GridView>
                   <GridViewColumn Width="185">
                       <GridViewColumn.HeaderTemplate>
                           <DataTemplate>
                               <TextBlock Text="날짜/시간" Foreground="#AAAAAA" FontWeight="SemiBold"/>
                           </DataTemplate>
                       </GridViewColumn.HeaderTemplate>
                       <GridViewColumn.CellTemplate>
                           <DataTemplate>
                               <TextBlock Text="{Binding Date}" />
                           </DataTemplate>
                       </GridViewColumn.CellTemplate>
                   </GridViewColumn>
                   <GridViewColumn Width="62">
                       <GridViewColumn.HeaderTemplate>
                           <DataTemplate>
                               <TextBlock Text="레벨" Foreground="#AAAAAA" FontWeight="SemiBold"/>
                           </DataTemplate>
                       </GridViewColumn.HeaderTemplate>
                       <GridViewColumn.CellTemplate>
                           <DataTemplate>
                               <Border CornerRadius="2" Padding="4,1" Margin="1"
                                       Background="{Binding Level,
                                           Converter={StaticResource LevelToBrush}}">
                                   <TextBlock Text="{Binding LevelText}"
                                              Style="{StaticResource LevelBadgeStyle}"
                                              Foreground="{Binding Level,
                                                  Converter={StaticResource LevelToFg}}"/>
                               </Border>
                           </DataTemplate>
                       </GridViewColumn.CellTemplate>
                   </GridViewColumn>
                   <GridViewColumn Width="140">
                       <GridViewColumn.HeaderTemplate>
                           <DataTemplate>
                               <TextBlock Text="출처 (Source)" Foreground="#AAAAAA" FontWeight="SemiBold"/>
                           </DataTemplate>
                       </GridViewColumn.HeaderTemplate>
                       <GridViewColumn.CellTemplate>
                           <DataTemplate>
                               <TextBlock Text="{Binding Source}"
                                          TextTrimming="CharacterEllipsis"
                                          ToolTip="{Binding Source}"/>
                           </DataTemplate>
                       </GridViewColumn.CellTemplate>
                   </GridViewColumn>
                   <GridViewColumn Width="580">
                       <GridViewColumn.HeaderTemplate>
                           <DataTemplate>
                               <TextBlock Text="내용 (Contents)" Foreground="#AAAAAA" FontWeight="SemiBold"/>
                           </DataTemplate>
                       </GridViewColumn.HeaderTemplate>
                       <GridViewColumn.CellTemplate>
                           <DataTemplate>
                               <TextBlock Text="{Binding Contents}"
                                          TextTrimming="CharacterEllipsis"
                                          ToolTip="{Binding Contents}"/>
                           </DataTemplate>
                       </GridViewColumn.CellTemplate>
                   </GridViewColumn>
               </GridView>
           </ListView.View>
       </ListView>

       <Border Grid.Row="2" Background="#2B2D2F"
               BorderBrush="#404040" BorderThickness="0,1,0,0">
           <DockPanel Margin="8,0">
               <TextBlock x:Name="TxtStatus"
                          Foreground="#888888" FontSize="11"
                          VerticalAlignment="Center" Text="대기 중"/>
               <TextBlock x:Name="TxtCount"
                          DockPanel.Dock="Right"
                          Foreground="#666666" FontSize="11"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"/>
           </DockPanel>
       </Border>

   </Grid>
</UserControl>
