<Window x:Class="logMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:logMVVM"
        Title="Log Viewer (MVVM)" Height="720" Width="1100"
        Background="#1E1E1E"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 설정 정보 바 -->
            <RowDefinition Height="50"/>
            <!-- 테스트 버튼 바 -->
            <RowDefinition Height="*"/>
            <!-- 로그 뷰어 -->
        </Grid.RowDefinitions>

        <!-- ══ 설정 정보 바 ══ -->
        <Border Grid.Row="0" Background="#1A1A1A"
                BorderBrush="#333" BorderThickness="0,0,0,1" Padding="10,4">
            <TextBlock x:Name="TxtConfigInfo"
                       Foreground="#555" FontSize="10"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ══ 테스트 버튼 바 ══ -->
        <Border Grid.Row="1" Background="#252526"
                BorderBrush="#404040" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">

                <TextBlock Text="테스트:" Foreground="#888" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Button Content="DEBUG" Width="70" Height="28" Margin="3,0"
                        Background="#3C3F41" Foreground="#AAAAAA"
                        BorderBrush="#555" Click="BtnDebug_Click"/>
                <Button Content="INFO"  Width="70" Height="28" Margin="3,0"
                        Background="#1A3A1A" Foreground="#55CC55"
                        BorderBrush="#336633" Click="BtnInfo_Click"/>
                <Button Content="WARN"  Width="70" Height="28" Margin="3,0"
                        Background="#3A2E00" Foreground="#FFCC00"
                        BorderBrush="#665500" Click="BtnWarn_Click"/>
                <Button Content="ERROR" Width="70" Height="28" Margin="3,0"
                        Background="#3A1010" Foreground="#FF6666"
                        BorderBrush="#662222" Click="BtnError_Click"/>
                <Button Content="FATAL" Width="70" Height="28" Margin="3,0"
                        Background="#600000" Foreground="White"
                        BorderBrush="#990000" Click="BtnFatal_Click"/>

                <Separator Margin="10,0" Background="#404040"/>

                <Button Content="연속 50건" Width="80" Height="28" Margin="3,0"
                        Background="#2D4A6E" Foreground="#88BBFF"
                        BorderBrush="#3A6090" Click="BtnBurst_Click"/>
                <Button Content="AOP 테스트" Width="90" Height="28" Margin="3,0"
                        Background="#3A2D5A" Foreground="#BB88FF"
                        BorderBrush="#553388" Click="BtnAop_Click"/>

            </StackPanel>
        </Border>

        <!-- ══ LogViewerControl (MVVM 적용) ══ -->
        <local:LogViewerControl Grid.Row="2"/>

    </Grid>
</Window>
