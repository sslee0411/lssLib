<!-- ══════════════════════════════════════════════════════════════════════
     BasicRwView.xaml  —  탭①: INI / JSON / XML 설정 읽기·쓰기 데모
     ══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="lssLib.Config.Demo.Views.BasicRwView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 왼쪽: 설정 입력 ─────────────────────────────── -->
        <StackPanel Grid.Column="0">

            <!-- 형식 선택 -->
            <GroupBox Header="① 파일 형식 및 경로">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="형식" Style="{StaticResource LblField}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CbFormat" Grid.Row="0" Grid.Column="1"
                              SelectedIndex="1">
                        <ComboBoxItem Content="INI"/>
                        <ComboBoxItem Content="JSON"/>
                        <ComboBoxItem Content="XML"/>
                    </ComboBox>
                    <Button Grid.Row="0" Grid.Column="2"
                            Content="파일 선택…"
                            Style="{StaticResource BtnSecondary}"
                            Margin="8,0,0,0" Height="32"
                            Click="BtnBrowse_Click"/>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="경로" Style="{StaticResource LblField}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TbFilePath" Grid.Row="2" Grid.Column="1"
                             Grid.ColumnSpan="2"
                             Style="{StaticResource TbBase}"
                             Height="30" Text="config/app.json"/>
                </Grid>
            </GroupBox>

            <!-- 섹션·키·값 입력 -->
            <GroupBox Header="② 섹션 / 키 / 값 입력">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="섹션" Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbSection" Style="{StaticResource TbBase}" Height="30" Text="Network"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="키" Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TbKey"     Style="{StaticResource TbBase}" Height="30" Text="Host"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="값" Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TbValue"   Style="{StaticResource TbBase}" Height="30" Text="192.168.1.100"/>
                </Grid>
            </GroupBox>

            <!-- 샘플 데이터 -->
            <GroupBox Header="③ 샘플 데이터 자동 채우기">
                <WrapPanel>
                    <Button Content="네트워크 샘플" Style="{StaticResource BtnSecondary}"
                            Margin="0,0,8,0" Click="BtnSampleNetwork_Click"/>
                    <Button Content="DB 샘플"       Style="{StaticResource BtnSecondary}"
                            Margin="0,0,8,0" Click="BtnSampleDb_Click"/>
                    <Button Content="앱 설정 샘플"  Style="{StaticResource BtnSecondary}"
                            Click="BtnSampleApp_Click"/>
                </WrapPanel>
            </GroupBox>

            <!-- 액션 버튼 -->
            <GroupBox Header="④ 액션">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="💾  저장 (Save)"   Style="{StaticResource BtnPrimary}"
                                Margin="0,0,8,0" Click="BtnSave_Click"/>
                        <Button Content="📂  로드 (Load)"   Style="{StaticResource BtnSuccess}"
                                Margin="0,0,8,0" Click="BtnLoad_Click"/>
                        <Button Content="➕  항목 추가"     Style="{StaticResource BtnSecondary}"
                                Margin="0,0,8,0" Click="BtnSet_Click"/>
                        <Button Content="🗑  항목 제거"     Style="{StaticResource BtnDanger}"
                                Click="BtnRemove_Click"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="🔍  값 조회"       Style="{StaticResource BtnSecondary}"
                                Margin="0,0,8,0" Click="BtnGet_Click"/>
                        <Button Content="🗂  전체 보기"     Style="{StaticResource BtnSecondary}"
                                Margin="0,0,8,0" Click="BtnDump_Click"/>
                        <Button Content="🧹  초기화"        Style="{StaticResource BtnDanger}"
                                Click="BtnClear_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- 타입 변환 조회 -->
            <GroupBox Header="⑤ 타입 변환 조회 (GetInt / GetBool / GetDouble)">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="섹션" Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbQSection" Style="{StaticResource TbBase}" Height="30" Text="App"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="키" Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TbQKey"     Style="{StaticResource TbBase}" Height="30" Text="MaxRetry"/>
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="GetInt"    Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" Click="BtnGetInt_Click"/>
                        <Button Content="GetBool"   Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" Click="BtnGetBool_Click"/>
                        <Button Content="GetDouble" Style="{StaticResource BtnSecondary}" Click="BtnGetDouble_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

        </StackPanel>

        <!-- ── 오른쪽: 출력 ───────────────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <!-- 파일 미리보기 -->
            <GroupBox Grid.Row="0" Header="📄 파일 내용 미리보기">
                <TextBox x:Name="TbFilePreview"
                         Style="{StaticResource TbOutput}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </GroupBox>

            <!-- 콘솔 출력 -->
            <GroupBox Grid.Row="2" Header="🖥 출력 로그">
                <Grid>
                    <TextBox x:Name="TbLog"
                             Style="{StaticResource TbOutput}"
                             Height="130"
                             VerticalScrollBarVisibility="Auto"/>
                    <Button Content="지우기"
                            Style="{StaticResource BtnDanger}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Padding="8,3" Margin="0,2,2,0"
                            FontSize="11"
                            Click="BtnClearLog_Click"/>
                </Grid>
            </GroupBox>
        </Grid>

    </Grid>
</UserControl>
