<!-- ══════════════════════════════════════════════════════════════════════
     ValidationView.xaml  —  탭⑤: ConfigSchema + ConfigValidator 데모
     ══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="lssLib.Config.Demo.Views.ValidationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 왼쪽: 스키마 + 설정 입력 ─────────────────── -->
        <StackPanel Grid.Column="0">

            <!-- 스키마 프리셋 -->
            <GroupBox Header="① 검증 스키마 프리셋">
                <StackPanel>
                    <TextBlock Text="프리셋을 선택하면 규칙과 테스트 데이터가 자동으로 설정됩니다."
                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="🌐 네트워크 스키마" Style="{StaticResource BtnSecondary}"
                                Margin="0,0,6,6" Click="BtnPresetNetwork_Click"/>
                        <Button Content="🗄 DB 스키마"       Style="{StaticResource BtnSecondary}"
                                Margin="0,0,6,6" Click="BtnPresetDb_Click"/>
                        <Button Content="⚙ 앱 설정 스키마"  Style="{StaticResource BtnSecondary}"
                                Click="BtnPresetApp_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- 스키마 규칙 보기 -->
            <GroupBox Header="② 현재 스키마 규칙">
                <TextBox x:Name="TbSchemaRules"
                         Style="{StaticResource TbOutput}"
                         Height="160"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"/>
            </GroupBox>

            <!-- 테스트 설정 입력 -->
            <GroupBox Header="③ 테스트 설정 입력 (오류값 포함 시 실패 확인)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="섹션" Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbVSection" Style="{StaticResource TbBase}" Height="30" Text="Network"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="키"   Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TbVKey"     Style="{StaticResource TbBase}" Height="30" Text="Host"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="값"   Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TbVValue"   Style="{StaticResource TbBase}" Height="30" Text="192.168.1.100"/>

                    <WrapPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2">
                        <Button Content="값 추가"       Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" Click="BtnVSet_Click"/>
                        <Button Content="잘못된 값 삽입" Style="{StaticResource BtnDanger}"   Margin="0,0,6,0" Click="BtnVSetBad_Click"/>
                        <Button Content="필수 키 삭제"  Style="{StaticResource BtnDanger}"   Click="BtnVDelete_Click"/>
                    </WrapPanel>
                </Grid>
            </GroupBox>

            <!-- 검증 실행 -->
            <GroupBox Header="④ 검증 실행">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="✅  검증 실행"          Style="{StaticResource BtnPrimary}"
                                Margin="0,0,8,4" Click="BtnValidate_Click"/>
                        <Button Content="🔥  ThrowIfInvalid"    Style="{StaticResource BtnDanger}"
                                Margin="0,0,8,4" Click="BtnThrow_Click"/>
                        <Button Content="⚙  기본값 자동 적용"   Style="{StaticResource BtnSuccess}"
                                Margin="0,0,8,4" Click="BtnApplyDefaults_Click"/>
                        <Button Content="🧹  초기화"             Style="{StaticResource BtnSecondary}"
                                Click="BtnVClear_Click"/>
                    </WrapPanel>

                    <!-- 결과 배지 -->
                    <Border x:Name="BdResult" Background="#E2E8F0"
                            CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                        <TextBlock x:Name="TbResultBadge"
                                   Text="검증 전" FontSize="14" FontWeight="Bold"
                                   Foreground="#64748B" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </GroupBox>

        </StackPanel>

        <!-- ── 오른쪽: 결과 출력 ──────────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>

            <!-- 현재 설정 + 검증 결과 상세 -->
            <GroupBox Grid.Row="0" Header="📋 현재 설정 / 검증 결과 상세">
                <TextBox x:Name="TbValidationResult"
                         Style="{StaticResource TbOutput}"
                         VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

            <!-- 로그 -->
            <GroupBox Grid.Row="2" Header="🖥 출력 로그">
                <Grid>
                    <TextBox x:Name="TbLog" Style="{StaticResource TbOutput}"
                             Height="130" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="지우기" Style="{StaticResource BtnDanger}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="8,3" Margin="0,2,2,0" FontSize="11"
                            Click="BtnClearLog_Click"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
