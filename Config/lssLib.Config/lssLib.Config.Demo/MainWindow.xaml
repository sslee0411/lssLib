<!-- ══════════════════════════════════════════════════════════════════════
     lssLib.Config.Demo · MainWindow.xaml
     탭: ① 기본 R/W  ② 암호화  ③ FileWatcher  ④ 장비 트리
         ⑤ 검증  ⑥ 트랜잭션  ⑦ 마이그레이션·프로파일
     ══════════════════════════════════════════════════════════════════════ -->
<Window x:Class="lssLib.Config.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:lssLib.Config.Demo.Views"
        Title="lssLib.Config Demo  —  v2.0"
        Width="1100" Height="790"
        MinWidth="960" MinHeight="660"
        Background="#F8FAFC"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ── 헤더 ──────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#1E3A5F">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="⚙" FontSize="22" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="lssLib.Config" FontSize="18" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text=" · 설정 관리 모듈 데모"
                           FontSize="14" Foreground="#93C5FD" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <TextBlock Text="v2.0 · .NET 8.0  |  Validation · Transaction · Migration · Profile"
                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 탭 ────────────────────────────────────────────── -->
        <TabControl Grid.Row="1" Background="#F8FAFC" BorderThickness="0" Padding="0">

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄 " FontSize="13"/>
                        <TextBlock Text="기본 R/W"/>
                    </StackPanel>
                </TabItem.Header>
                <views:BasicRwView/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔐 " FontSize="13"/>
                        <TextBlock Text="암호화"/>
                    </StackPanel>
                </TabItem.Header>
                <views:EncryptionView/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👁 " FontSize="13"/>
                        <TextBlock Text="변경 감지"/>
                    </StackPanel>
                </TabItem.Header>
                <views:WatcherView/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌳 " FontSize="13"/>
                        <TextBlock Text="장비 트리"/>
                    </StackPanel>
                </TabItem.Header>
                <views:TreeView/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✅ " FontSize="13"/>
                        <TextBlock Text="스키마 검증"/>
                    </StackPanel>
                </TabItem.Header>
                <views:ValidationView/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄 " FontSize="13"/>
                        <TextBlock Text="트랜잭션"/>
                    </StackPanel>
                </TabItem.Header>
                <views:TransactionView/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔀 " FontSize="13"/>
                        <TextBlock Text="마이그레이션·프로파일"/>
                    </StackPanel>
                </TabItem.Header>
                <views:MigrationView/>
            </TabItem>

        </TabControl>

        <!-- ── 상태바 ─────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#1E293B">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock x:Name="TbStatus" Text="준비"
                           FontSize="12" Foreground="#94A3B8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
