<!-- ══════════════════════════════════════════════════════════════════════
     WatcherView.xaml  —  탭③: FileSystemWatcher 런타임 변경 감지 데모
     ══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="lssLib.Config.Demo.Views.WatcherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 왼쪽: 제어판 ──────────────────────────────── -->
        <StackPanel Grid.Column="0">

            <!-- 감시 설정 -->
            <GroupBox Header="① 감시 파일 설정">
                <StackPanel>
                    <TextBlock Style="{StaticResource LblField}" Text="파일 경로"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TbWatchPath" Grid.Column="0"
                                 Style="{StaticResource TbBase}" Height="30"
                                 Text="config/watch_demo.json"/>
                        <Button Grid.Column="2" Content="…"
                                Style="{StaticResource BtnSecondary}"
                                Width="32" Click="BtnBrowseWatch_Click"/>
                    </Grid>

                    <TextBlock Style="{StaticResource LblField}" Text="디바운스 지연 (ms)" Margin="0,10,0,4"/>
                    <TextBox x:Name="TbDebounce" Style="{StaticResource TbBase}"
                             Height="30" Text="300"/>
                </StackPanel>
            </GroupBox>

            <!-- 감시 제어 -->
            <GroupBox Header="② 감시 제어">
                <WrapPanel>
                    <Button x:Name="BtnStartWatch" Content="▶  감시 시작"
                            Style="{StaticResource BtnSuccess}"
                            Margin="0,0,8,4" Click="BtnStartWatch_Click"/>
                    <Button x:Name="BtnStopWatch" Content="⏹  감시 중단"
                            Style="{StaticResource BtnDanger}"
                            Margin="0,0,8,4" IsEnabled="False"
                            Click="BtnStopWatch_Click"/>
                    <Button Content="🔄  파일 새로고침"
                            Style="{StaticResource BtnSecondary}"
                            Margin="0,0,8,4" Click="BtnReloadFile_Click"/>
                </WrapPanel>
            </GroupBox>

            <!-- 파일 편집 (변경 유발) -->
            <GroupBox Header="③ 파일 내용 편집 (저장 시 변경 감지됨)">
                <StackPanel>
                    <TextBlock Style="{StaticResource LblField}" Text="섹션"/>
                    <TextBox x:Name="TbWSection" Style="{StaticResource TbBase}"
                             Height="30" Margin="0,0,0,6" Text="Runtime"/>
                    <TextBlock Style="{StaticResource LblField}" Text="키"/>
                    <TextBox x:Name="TbWKey" Style="{StaticResource TbBase}"
                             Height="30" Margin="0,0,0,6" Text="Counter"/>
                    <TextBlock Style="{StaticResource LblField}" Text="값"/>
                    <TextBox x:Name="TbWValue" Style="{StaticResource TbBase}"
                             Height="30" Margin="0,0,0,8" Text="1"/>
                    <WrapPanel>
                        <Button Content="💾  항목 추가 후 저장"
                                Style="{StaticResource BtnPrimary}"
                                Margin="0,0,8,0" Click="BtnAddAndSave_Click"/>
                        <Button Content="자동 증가 테스트"
                                Style="{StaticResource BtnSecondary}"
                                Click="BtnAutoIncrement_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- 변경 감지 이벤트 카운터 -->
            <GroupBox Header="④ 감지 이벤트 통계">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="감지 횟수" Style="{StaticResource LblField}"/>
                        <TextBlock x:Name="TbDetectCount" Text="0"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#2563EB"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="마지막 감지" Style="{StaticResource LblField}"/>
                        <TextBlock x:Name="TbLastDetect" Text="-"
                                   FontSize="12" Foreground="#475569"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

        </StackPanel>

        <!-- ── 오른쪽: 출력 ───────────────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <!-- 현재 설정 내용 -->
            <GroupBox Grid.Row="0" Header="📋 현재 설정 내용 (변경 감지 시 자동 갱신)">
                <TextBox x:Name="TbCurrentConfig"
                         Style="{StaticResource TbOutput}"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"/>
            </GroupBox>

            <!-- 이벤트 로그 -->
            <GroupBox Grid.Row="2" Header="🖥 변경 감지 이벤트 로그">
                <Grid>
                    <TextBox x:Name="TbLog"
                             Style="{StaticResource TbOutput}"
                             Height="130"
                             VerticalScrollBarVisibility="Auto"/>
                    <Button Content="지우기" Style="{StaticResource BtnDanger}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="8,3" Margin="0,2,2,0" FontSize="11"
                            Click="BtnClearLog_Click"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
