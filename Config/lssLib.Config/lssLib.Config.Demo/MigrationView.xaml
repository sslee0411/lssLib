<!-- ══════════════════════════════════════════════════════════════════════
     MigrationView.xaml  —  탭⑦: ConfigMigration + ConfigProfileManager
     ══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="lssLib.Config.Demo.Views.MigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 왼쪽: 제어 ──────────────────────────────── -->
        <StackPanel Grid.Column="0">

            <!-- 마이그레이션 -->
            <GroupBox Header="① 설정 마이그레이션 (버전 간 자동 변환)">
                <StackPanel>
                    <TextBlock Text="등록된 경로: v1.0 → v2.0 → v3.0"
                               FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="현재 버전" Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                        <ComboBox  Grid.Column="1" x:Name="CbFromVersion" SelectedIndex="0">
                            <ComboBoxItem Content="1.0"/>
                            <ComboBoxItem Content="2.0"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
                        <TextBlock Grid.Column="3" Text="목표 버전" Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                        <ComboBox  Grid.Column="4" x:Name="CbToVersion" SelectedIndex="1">
                            <ComboBoxItem Content="2.0"/>
                            <ComboBoxItem Content="3.0"/>
                        </ComboBox>
                    </Grid>

                    <WrapPanel>
                        <Button Content="🔀  마이그레이션 실행"    Style="{StaticResource BtnPrimary}"
                                Margin="0,0,8,0" Click="BtnMigrate_Click"/>
                        <Button Content="🔀  전체 실행 (1→3)"     Style="{StaticResource BtnSuccess}"
                                Margin="0,0,8,0" Click="BtnMigrateAll_Click"/>
                        <Button Content="📋  규칙 보기"           Style="{StaticResource BtnSecondary}"
                                Click="BtnShowRules_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- v1.0 설정 로드 -->
            <GroupBox Header="② 버전별 샘플 설정 로드">
                <StackPanel>
                    <TextBlock Text="구버전 설정을 로드하여 마이그레이션 효과를 확인합니다."
                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="📂  v1.0 설정 로드" Style="{StaticResource BtnSecondary}"
                                Margin="0,0,8,0" Click="BtnLoadV1_Click"/>
                        <Button Content="📂  v2.0 설정 로드" Style="{StaticResource BtnSecondary}"
                                Click="BtnLoadV2_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- 프로파일 -->
            <GroupBox Header="③ 환경별 프로파일 (Base → Env → Local)">
                <StackPanel>
                    <TextBlock Text="각 버튼은 base.json + 환경별 오버라이드를 병합하여 로드합니다."
                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="활성 프로파일" Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbActiveProfile" Grid.Column="1"
                                   Text="없음"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#2563EB"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <WrapPanel>
                        <Button Content="🌱  Development" Style="{StaticResource BtnSuccess}"
                                Margin="0,0,8,0" Click="BtnProfileDev_Click"/>
                        <Button Content="🏭  Production"  Style="{StaticResource BtnDanger}"
                                Margin="0,0,8,0" Click="BtnProfileProd_Click"/>
                        <Button Content="🔬  Staging"     Style="{StaticResource BtnSecondary}"
                                Click="BtnProfileStaging_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- 저장소 초기화 -->
            <GroupBox Header="④ 초기화">
                <WrapPanel>
                    <Button Content="🧹  저장소 초기화" Style="{StaticResource BtnDanger}"
                            Margin="0,0,8,0" Click="BtnClearStore_Click"/>
                    <Button Content="📋  현재 설정 보기" Style="{StaticResource BtnSecondary}"
                            Click="BtnDumpStore_Click"/>
                </WrapPanel>
            </GroupBox>

        </StackPanel>

        <!-- ── 오른쪽: 결과 출력 ──────────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <!-- 설정 현황 -->
            <GroupBox Grid.Row="0" Header="📋 설정 현황 (마이그레이션·프로파일 전후 비교)">
                <TextBox x:Name="TbStoreView"
                         Style="{StaticResource TbOutput}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </GroupBox>

            <!-- 로그 -->
            <GroupBox Grid.Row="2" Header="🖥 마이그레이션 / 프로파일 로그">
                <Grid>
                    <TextBox x:Name="TbLog" Style="{StaticResource TbOutput}"
                             Height="140" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="지우기" Style="{StaticResource BtnDanger}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="8,3" Margin="0,2,2,0" FontSize="11"
                            Click="BtnClearLog_Click"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
