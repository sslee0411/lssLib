<Window x:Class="lssLib.DB.WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:lssLib.DB.WpfDemo.Pages"
        Title="lssLib.DB — Provider Demo"
        Height="720" Width="1100"
        Background="{StaticResource BrushBg}"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- ── 헤더 ── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushPrimary}"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗄️  lssLib.DB"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="  Provider Demo — InfluxDB · MSSQL · Oracle · MySQL · SQLite"
                           FontSize="13" Foreground="#CCDDFF"
                           VerticalAlignment="Bottom" Margin="0,0,0,2"/>
            </StackPanel>
        </Border>

        <!-- ── 상태바 ── -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="#EEEEEE" BorderBrush="{StaticResource BrushBorder}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusBar" Text="준비"
                           Style="{StaticResource TxtStatus}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ── 탭 본문 ── -->
        <TabControl x:Name="MainTab"
                    Background="{StaticResource BrushBg}"
                    BorderThickness="0"
                    Padding="0">

            <!-- InfluxDB 탭 -->
            <TabItem Header="🔵  InfluxDB">
                <pages:InfluxDbPage x:Name="PageInflux"/>
            </TabItem>

            <!-- MSSQL 탭 -->
            <TabItem Header="🔷  MSSQL">
                <pages:MsSqlPage x:Name="PageMsSql"/>
            </TabItem>

            <!-- Oracle 탭 -->
            <TabItem Header="🔴  Oracle">
                <pages:OraclePage x:Name="PageOracle"/>
            </TabItem>

            <!-- MySQL 탭 -->
            <TabItem Header="🟢  MySQL">
                <pages:MySqlPage x:Name="PageMySql"/>
            </TabItem>

            <!-- SQLite 탭 -->
            <TabItem Header="🟡  SQLite">
                <pages:SqlitePage x:Name="PageSqlite"/>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
