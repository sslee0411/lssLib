<UserControl x:Class="lssLib.DB.WpfDemo.Pages.InfluxDbPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- §1 연결 설정 -->
        <GroupBox Grid.Row="0" Header="연결 설정">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="URL" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" x:Name="TxtUrl"
                           Text="http://localhost:8086"
                           Style="{StaticResource TxtInput}"/>
                <TextBlock Grid.Column="2" Text="Token" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox   Grid.Column="3" x:Name="TxtToken"
                           Text="my-token"
                           Style="{StaticResource TxtInput}"/>
                <TextBlock Grid.Column="4" Text="Org" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox   Grid.Column="5" x:Name="TxtOrg"
                           Text="my-org"
                           Style="{StaticResource TxtInput}"/>
                <TextBlock Grid.Column="6" Text="Bucket" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox   Grid.Column="7" x:Name="TxtBucket"
                           Text="sensor-data"
                           Style="{StaticResource TxtInput}"/>
                <Button    Grid.Column="9" Content="연결"
                           Style="{StaticResource BtnPrimary}"
                           Margin="8,0,4,0" Width="70"
                           Click="BtnConnect_Click"/>
                <Button    Grid.Column="10" Content="Health"
                           Style="{StaticResource BtnSuccess}"
                           Width="70"
                           Click="BtnPing_Click"/>
            </Grid>
        </GroupBox>

        <!-- §2 작업 패널 -->
        <GroupBox Grid.Row="1" Header="작업">
            <StackPanel Orientation="Horizontal">
                <!-- Flux 쿼리 -->
                <TextBlock Text="Flux" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtFlux"
                         Width="380" Style="{StaticResource TxtInput}"
                         Text="from(bucket:&quot;sensor-data&quot;) |&gt; range(start: -1h) |&gt; filter(fn: (r) =&gt; r._measurement == &quot;sensor_data&quot;)"/>
                <Button Content="조회" Style="{StaticResource BtnPrimary}"
                        Margin="6,0" Width="60" Click="BtnQuery_Click"/>
                <!-- 쓰기 -->
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,2"/>
                <TextBlock Text="Plant" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="TxtWritePlant" Width="60" Text="A01" Style="{StaticResource TxtInput}"/>
                <TextBlock Text="Value" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox x:Name="TxtWriteValue" Width="60" Text="72.5" Style="{StaticResource TxtInput}"/>
                <Button Content="Write" Style="{StaticResource BtnSuccess}"
                        Margin="6,0" Width="60" Click="BtnWrite_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- §3 결과 그리드 -->
        <GroupBox Grid.Row="2" Header="결과">
            <DataGrid x:Name="DgResult"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      AlternatingRowBackground="#F9F9F9"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      FontSize="12"/>
        </GroupBox>

        <!-- §4 로그 -->
        <GroupBox Grid.Row="3" Header="로그" MaxHeight="110">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtLog"
                         IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="11"
                         Background="Transparent" BorderThickness="0"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
