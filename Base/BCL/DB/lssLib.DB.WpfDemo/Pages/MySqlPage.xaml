<UserControl x:Class="lssLib.DB.WpfDemo.Pages.MySqlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- §1 연결 설정 -->
        <GroupBox Grid.Row="0" Header="연결 설정">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ConnStr" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" x:Name="TxtConnStr"
                           Text="Server=localhost;Database=IIoT;Uid=root;Pwd=password;"
                           Style="{StaticResource TxtInput}" Margin="0,0,8,0"/>
                <Button    Grid.Column="2" Content="연결"
                           Style="{StaticResource BtnPrimary}"
                           Width="70" Click="BtnConnect_Click"/>
            </Grid>
        </GroupBox>

        <!-- §2 작업 패널 -->
        <GroupBox Grid.Row="1" Header="작업">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SQL" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtSql" Width="340" Style="{StaticResource TxtInput}"
                         Text="SELECT * FROM sensor_data ORDER BY reg_dt DESC LIMIT 50"/>
                <Button Content="조회" Style="{StaticResource BtnPrimary}"
                        Margin="6,0" Width="60" Click="BtnQuery_Click"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,2"/>
                <TextBlock Text="SP" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtSpName" Width="140" Style="{StaticResource TxtInput}"
                         Text="SP_SENSOR_GET"/>
                <TextBlock Text="IN_DATA" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox x:Name="TxtInData" Width="100" Style="{StaticResource TxtInput}"
                         Text="A01"/>
                <Button Content="SP 호출" Style="{StaticResource BtnSuccess}"
                        Margin="6,0" Width="70" Click="BtnCallSp_Click"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,2"/>
                <Button Content="배치 INSERT" Style="{StaticResource BtnDanger}"
                        Click="BtnBatch_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- §3 결과 그리드 -->
        <GroupBox Grid.Row="2" Header="결과">
            <DataGrid x:Name="DgResult"
                      AutoGenerateColumns="True" IsReadOnly="True"
                      AlternatingRowBackground="#F9F9F9"
                      GridLinesVisibility="Horizontal" BorderThickness="0" FontSize="12"/>
        </GroupBox>

        <!-- §4 로그 -->
        <GroupBox Grid.Row="3" Header="로그" MaxHeight="110">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="11"
                         Background="Transparent" BorderThickness="0"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
