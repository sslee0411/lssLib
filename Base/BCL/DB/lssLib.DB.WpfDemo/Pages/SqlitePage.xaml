<UserControl x:Class="lssLib.DB.WpfDemo.Pages.SqlitePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- §1 연결 설정 -->
        <GroupBox Grid.Row="0" Header="연결 설정">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="DB 파일" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" x:Name="TxtDbPath"
                           Style="{StaticResource TxtInput}" Margin="0,0,8,0"/>
                <Button    Grid.Column="2" Content="찾기"
                           Style="{StaticResource BtnPrimary}"
                           Width="50" Margin="0,0,4,0" Click="BtnBrowse_Click"/>
                <Button    Grid.Column="3" Content="연결 / 생성"
                           Style="{StaticResource BtnSuccess}"
                           Width="90" Click="BtnConnect_Click"/>
            </Grid>
        </GroupBox>

        <!-- §2 작업 패널 -->
        <GroupBox Grid.Row="1" Header="작업">
            <StackPanel Orientation="Horizontal">
                <Button Content="테이블 초기화" Style="{StaticResource BtnPrimary}"
                        Margin="0,0,6,0" Click="BtnEnsureTable_Click"/>
                <Button Content="WAL 모드"  Style="{StaticResource BtnSuccess}"
                        Margin="0,0,6,0" Click="BtnWal_Click"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                <TextBox x:Name="TxtSql" Width="320" Style="{StaticResource TxtInput}"
                         Text="SELECT * FROM sensor_config ORDER BY id DESC LIMIT 50"/>
                <Button Content="조회" Style="{StaticResource BtnPrimary}"
                        Margin="6,0" Width="60" Click="BtnQuery_Click"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                <Button Content="Upsert 5건"  Style="{StaticResource BtnSuccess}"
                        Margin="0,0,6,0" Click="BtnUpsert_Click"/>
                <Button Content="전체 삭제"   Style="{StaticResource BtnDanger}"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- §3 결과 그리드 -->
        <GroupBox Grid.Row="2" Header="결과">
            <DataGrid x:Name="DgResult"
                      AutoGenerateColumns="True" IsReadOnly="True"
                      AlternatingRowBackground="#F9F9F9"
                      GridLinesVisibility="Horizontal" BorderThickness="0" FontSize="12"/>
        </GroupBox>

        <!-- §4 로그 -->
        <GroupBox Grid.Row="3" Header="로그" MaxHeight="110">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="11"
                         Background="Transparent" BorderThickness="0"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
