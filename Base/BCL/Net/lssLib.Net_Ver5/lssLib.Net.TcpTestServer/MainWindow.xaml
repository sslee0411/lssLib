<Window x:Class="lssLib.Net.TcpTestServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="lssLib.Net TCP 테스트 서버"
        Width="700" Height="540"
        MinWidth="580" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 제어 패널 -->
            <RowDefinition Height="Auto"/>
            <!-- 상태 표시 -->
            <RowDefinition Height="*"/>
            <!-- 로그 -->
            <RowDefinition Height="Auto"/>
            <!-- 하단 버튼 -->
        </Grid.RowDefinitions>

        <!-- ① 제어 패널 -->
        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="포트:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox   Grid.Column="1" x:Name="TxtPort" Text="9000"
                           VerticalAlignment="Center" Padding="4,2"/>

                <TextBlock Grid.Column="2" Text="모드:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <ComboBox  Grid.Column="3" x:Name="CmbMode" VerticalAlignment="Center"
                           SelectionChanged="CmbMode_SelectionChanged">
                    <ComboBoxItem Tag="Push"
                                  Content="Push — Passive 클라이언트 테스트"
                                  IsSelected="True"/>
                    <ComboBoxItem Tag="Echo"
                                  Content="Echo — RequestResponse 클라이언트 테스트"/>
                </ComboBox>

                <TextBlock Grid.Column="4" x:Name="LblInterval" Text="간격(ms):"
                           VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox   Grid.Column="5" x:Name="TxtInterval" Text="500"
                           VerticalAlignment="Center" Padding="4,2"/>

                <Button Grid.Column="7" x:Name="BtnStartStop" Content="▶ 시작"
                        Width="72" Height="28" Click="BtnStartStop_Click"
                        Background="#2196F3" Foreground="White" FontWeight="Bold"
                        BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- ② 상태 표시 -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 상태 표시 (동그라미 + 텍스트) -->
                <Ellipse Grid.Column="0" x:Name="StatusDot"
                         Width="12" Height="12" Fill="#9E9E9E"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="1" x:Name="LblStatus"
                           Text="정지" VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Column="2" Text="연결:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="3" x:Name="LblClients" Text="0개"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="전송:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="LblSent" Text="0" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="수신:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="LblReceived" Text="0" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ③ 로그 -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
            <TextBox x:Name="TxtLog"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     Padding="6"
                     Background="#1E1E1E" Foreground="#D4D4D4"
                     BorderThickness="0"/>
        </Border>

        <!-- ④ 하단 버튼 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="로그 지우기" Click="BtnClear_Click"
                    Width="90" Height="26" Margin="0,0,6,0"/>
            <TextBlock x:Name="LblMaxLog" Text="(최대 500줄)"
                       VerticalAlignment="Center" Foreground="#888" FontSize="11"/>
        </StackPanel>
    </Grid>
</Window>
