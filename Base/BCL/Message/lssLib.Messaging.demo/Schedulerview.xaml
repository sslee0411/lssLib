<UserControl x:Class="lssLib.Messaging.Demo.Views.SchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBg}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             왼쪽: 스케줄 등록 컨트롤
             ══════════════════════════════════════════════ -->
        <StackPanel Grid.Column="0">

            <!-- 설명 -->
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="⏰  AsyncScheduler — 비동기 스케줄러"
                               Foreground="{StaticResource BrushAccent2}"
                               FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource BrushTextDim}"
                               LineHeight="18">
                        각 작업은 독립 Task 루프에서 실행됩니다.
                        Pause/Resume/Cancel로 개별 제어가 가능합니다.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 작업 등록 -->
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="① 작업 등록" Style="{StaticResource SectionLabel}"/>

                    <!-- 센서 폴링 -->
                    <Border Background="#1A1E2D" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="📊 센서 폴링" Foreground="{StaticResource BrushAccent2}"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="간격(초): " Foreground="{StaticResource BrushTextDim}"
                                           FontSize="10" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtSensorInterval"
                                         Text="3" Width="40" Height="22"
                                         Background="#111827" Foreground="{StaticResource BrushText}"
                                         BorderBrush="{StaticResource BrushBorder}"
                                         TextAlignment="Center" FontSize="11"/>
                            </StackPanel>
                            <Button x:Name="BtnStartSensor"
                                    Content="▶ 시작"
                                    Style="{StaticResource BtnSuccess}"
                                    Padding="0,5"
                                    Click="BtnStartSensor_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 하트비트 -->
                    <Border Background="#1E2820" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="💓 하트비트 체크" Foreground="#4ADE80"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="간격(초): " Foreground="{StaticResource BrushTextDim}"
                                           FontSize="10" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtHeartbeatInterval"
                                         Text="5" Width="40" Height="22"
                                         Background="#111827" Foreground="{StaticResource BrushText}"
                                         BorderBrush="{StaticResource BrushBorder}"
                                         TextAlignment="Center" FontSize="11"/>
                            </StackPanel>
                            <Button x:Name="BtnStartHeartbeat"
                                    Content="▶ 시작"
                                    Style="{StaticResource BtnSuccess}"
                                    Padding="0,5"
                                    Click="BtnStartHeartbeat_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 1회 실행 -->
                    <Border Background="#2D1B1B" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="⏱️ 지연 후 1회 실행" Foreground="#FBBF24"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="지연(초): " Foreground="{StaticResource BrushTextDim}"
                                           FontSize="10" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtOnceDelay"
                                         Text="4" Width="40" Height="22"
                                         Background="#111827" Foreground="{StaticResource BrushText}"
                                         BorderBrush="{StaticResource BrushBorder}"
                                         TextAlignment="Center" FontSize="11"/>
                            </StackPanel>
                            <Button Content="▶ 등록"
                                    Style="{StaticResource BtnWarn}"
                                    Padding="0,5"
                                    Click="BtnStartOnce_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- N회 제한 -->
                    <Border Background="#1A1A22" CornerRadius="4" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="🔢 N회 제한 반복" Foreground="#94A3B8"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="간격: " Foreground="{StaticResource BrushTextDim}"
                                               FontSize="10" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtLimitedInterval"
                                             Text="2" Width="32" Height="22"
                                             Background="#111827" Foreground="{StaticResource BrushText}"
                                             BorderBrush="{StaticResource BrushBorder}"
                                             TextAlignment="Center" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="횟수: " Foreground="{StaticResource BrushTextDim}"
                                               FontSize="10" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtLimitedMax"
                                             Text="5" Width="32" Height="22"
                                             Background="#111827" Foreground="{StaticResource BrushText}"
                                             BorderBrush="{StaticResource BrushBorder}"
                                             TextAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="▶ 등록"
                                    Style="{StaticResource BtnGray}"
                                    Padding="0,5"
                                    Click="BtnStartLimited_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 전체 제어 -->
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="② 전체 제어" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="⏸ 전체 정지"
                                Style="{StaticResource BtnWarn}"
                                Click="BtnPauseAll_Click"/>
                        <Button Grid.Column="2" Content="▶ 전체 재개"
                                Style="{StaticResource BtnSuccess}"
                                Click="BtnResumeAll_Click"/>
                    </Grid>
                    <Button Content="⏹ 전체 종료"
                            Style="{StaticResource BtnDanger}"
                            Click="BtnStopAll_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══════════════════════════════════════════════
             오른쪽: 작업 목록 + 실행 로그
             ══════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 작업 목록 헤더 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="등록된 작업"
                           Foreground="{StaticResource BrushText}"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTaskCount"
                           Text="(0개)"
                           Foreground="{StaticResource BrushTextDim}"
                           FontSize="11"
                           Margin="90,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 작업 목록 (DataGrid 스타일) -->
            <Border Grid.Row="1"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlTasks" Margin="8"/>
                </ScrollViewer>
            </Border>

            <!-- 실행 로그 헤더 -->
            <Grid Grid.Row="2" Margin="0,12,0,8">
                <TextBlock Text="실행 로그"
                           Foreground="{StaticResource BrushText}"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Content="지우기" Style="{StaticResource BtnGray}"
                        Padding="8,4" FontSize="10"
                        HorizontalAlignment="Right"
                        Click="BtnClearLog_Click"/>
            </Grid>

            <!-- 실행 로그 -->
            <ListBox x:Name="LstLog" Grid.Row="3"
                     Style="{StaticResource LogListBox}"/>
        </Grid>
    </Grid>
</UserControl>
