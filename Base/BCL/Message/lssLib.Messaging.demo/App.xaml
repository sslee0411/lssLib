
<Application x:Class="lssLib.Messaging.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ── 공통 색상 ──────────────────────────────── -->
        <SolidColorBrush x:Key="BrushBg"        Color="#1E1E2E"/>
        <SolidColorBrush x:Key="BrushPanel"     Color="#2A2A3E"/>
        <SolidColorBrush x:Key="BrushBorder"    Color="#3A3A5E"/>
        <SolidColorBrush x:Key="BrushAccent"    Color="#7C6AF7"/>
        <SolidColorBrush x:Key="BrushAccent2"   Color="#56CFE1"/>
        <SolidColorBrush x:Key="BrushSuccess"   Color="#4ADE80"/>
        <SolidColorBrush x:Key="BrushWarn"      Color="#FBBF24"/>
        <SolidColorBrush x:Key="BrushError"     Color="#F87171"/>
        <SolidColorBrush x:Key="BrushText"      Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BrushTextDim"   Color="#94A3B8"/>
        <SolidColorBrush x:Key="BrushCritical"  Color="#FF6B6B"/>

        <!-- ── 공통 버튼 스타일 ──────────────────────────── -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Foreground"   Value="{StaticResource BrushText}"/>
            <Setter Property="Background"   Value="{StaticResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="14,7"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#22863A"/>
        </Style>
        <Style x:Key="BtnWarn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#B45309"/>
        </Style>
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#991B1B"/>
        </Style>
        <Style x:Key="BtnGray" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#374151"/>
        </Style>

        <!-- ── ListBox 스타일 ──────────────────────────────── -->
        <Style x:Key="LogListBox" TargetType="ListBox">
            <Setter Property="Background"         Value="#111827"/>
            <Setter Property="Foreground"         Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush"        Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="FontFamily"         Value="Consolas"/>
            <Setter Property="FontSize"           Value="11"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- ── 섹션 라벨 ──────────────────────────────────── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource BrushAccent2}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,5"/>
        </Style>

        <!-- ── 값 표시 TextBlock ──────────────────────────── -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="FontWeight"  Value="Bold"/>
        </Style>

        <!-- ── 구분선 ──────────────────────────────────────── -->
        <Style x:Key="Divider" TargetType="Separator">
            <Setter Property="Background"  Value="{StaticResource BrushBorder}"/>
            <Setter Property="Margin"      Value="0,8"/>
        </Style>

    </Application.Resources>
</Application>
