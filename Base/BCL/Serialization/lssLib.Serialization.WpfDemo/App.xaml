<Application x:Class="Serialization.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Serialization"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ── 색상 ───────────────────────────────────────────── -->
        <SolidColorBrush x:Key="PrimaryBrush"  Color="#1E88E5"/>
        <SolidColorBrush x:Key="SuccessBrush"  Color="#43A047"/>
        <SolidColorBrush x:Key="WarnBrush"     Color="#FB8C00"/>
        <SolidColorBrush x:Key="DangerBrush"   Color="#E53935"/>
        <SolidColorBrush x:Key="PurpleBrush"   Color="#7B1FA2"/>
        <SolidColorBrush x:Key="TealBrush"     Color="#00695C"/>
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#F5F7FA"/>
        <SolidColorBrush x:Key="BorderBrush"   Color="#DEE2E8"/>

        <!-- ── 기본 버튼 ──────────────────────────────────────── -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Margin"          Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 색상별 버튼 변형 ───────────────────────────────── -->
        <Style x:Key="GreenBtn"  BasedOn="{StaticResource Btn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>
        <Style x:Key="OrangeBtn" BasedOn="{StaticResource Btn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WarnBrush}"/>
        </Style>
        <Style x:Key="PurpleBtn" BasedOn="{StaticResource Btn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
        </Style>
        <Style x:Key="TealBtn"   BasedOn="{StaticResource Btn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TealBrush}"/>
        </Style>
        <Style x:Key="RedBtn"    BasedOn="{StaticResource Btn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <!-- ── 입력창 ─────────────────────────────────────────── -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── 결과 출력창 (다크 터미널) ────────────────────────── -->
        <Style x:Key="ResultBox" TargetType="TextBox">
            <Setter Property="Background"  Value="#1E1E2E"/>
            <Setter Property="Foreground"  Value="#CDD6F4"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="IsReadOnly"  Value="True"/>
            <Setter Property="AcceptsReturn"   Value="True"/>
            <Setter Property="TextWrapping"    Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding"     Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ── 섹션 레이블 ───────────────────────────────────── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- ── 카드 Border ───────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush"  Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="14"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
        </Style>
    </Application.Resources>
</Application>
