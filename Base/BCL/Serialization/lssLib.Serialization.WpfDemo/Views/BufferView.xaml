<UserControl x:Class="lssLib.Serialization.WpfDemo.Views.BufferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:lssLib.Serialization.WpfDemo.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 1. 카드 레이아웃 스타일 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. 라벨 스타일 -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#78909C"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 3. 입력창 스타일 -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 4. 기본 버튼 스타일 (Base) -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 5. 색상별 버튼들 -->
        <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#1E88E5"/>
            <!-- Blue -->
        </Style>
        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#43A047"/>
            <!-- Green -->
        </Style>
        <Style x:Key="PurpleBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#8E24AA"/>
            <!-- Purple -->
        </Style>
        <Style x:Key="OrangeBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#FB8C00"/>
            <!-- Orange -->
        </Style>
        <Style x:Key="TealBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#00897B"/>
            <!-- Teal -->
        </Style>
        <Style x:Key="RedBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#E53935"/>
            <!-- Red -->
        </Style>

        <!-- 6. 결과창 스타일 -->
        <Style x:Key="ResultBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#1E293B"/>
            <!-- 다크 배경 -->
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 입력 패널 -->
        <StackPanel Grid.Column="0">

            <!-- BufferParser -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="🔍 BufferParser — 읽기" Style="{StaticResource SectionLabel}"
                               FontSize="12" Foreground="#1E88E5" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="HEX 버퍼 입력" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="HexIn" Style="{StaticResource InputBox}" Height="36"
                             Margin="0,0,0,8"
                             Text="AA 03 00 0C 00 00 03 E9 41 20 00 00 48 65 6C 6C 6F 00"/>
                    <TextBlock Text="스키마 정의  (offset, BufType, size, name)"
                               Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="SchemaIn" Style="{StaticResource InputBox}"
                             AcceptsReturn="True" Height="100" FontSize="11" Margin="0,0,0,10"
                             Text="0,UInt8,1,STX&#x0a;1,UInt8,1,FC&#x0a;2,UInt16BE,1,Length&#x0a;4,UInt32BE,1,Seq&#x0a;8,FloatBE,1,Value&#x0a;12,StringAscii,6,Name"/>
                    <Button Content="▶ 스키마 파싱 (Add)"       Click="OnSchemaAdd"   Style="{StaticResource Btn}"/>
                    <Button Content="▶ Then() 자동 offset"      Click="OnSchemaThen"  Style="{StaticResource GreenBtn}"/>
                    <Button Content="▶ 직접 읽기 (ReadXxx)"     Click="OnDirect"      Style="{StaticResource PurpleBtn}"/>
                    <Button Content="▶ 배열 읽기"                Click="OnArrayRead"   Style="{StaticResource OrangeBtn}"/>
                    <Button Content="▶ 비트 필드 / HexDump"     Click="OnBitRead"     Style="{StaticResource TealBtn}"/>
                </StackPanel>
            </Border>

            <!-- BufferWriter -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="✏️ BufferWriter — 쓰기" Style="{StaticResource SectionLabel}"
                               FontSize="12" Foreground="#43A047" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Button Content="▶ Write 체이닝으로 프레임 생성"    Click="OnWriterChain"  Style="{StaticResource GreenBtn}"/>
                    <Button Content="▶ WriteDecimalLE / Array"          Click="OnWriterDecimal" Style="{StaticResource TealBtn}"/>
                    <Button Content="▶ PatchByte — 체크섬 나중 삽입"   Click="OnWriterPatch"  Style="{StaticResource OrangeBtn}"/>
                    <Button Content="▶ ToParser — 왕복 검증"            Click="OnWriterVerify" Style="{StaticResource PurpleBtn}"/>
                </StackPanel>
            </Border>

            <!-- StreamParser -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="🌊 StreamParser — 스트림 탐색" Style="{StaticResource SectionLabel}"
                               FontSize="12" Foreground="#E65100" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Button Content="▶ FindNext — 고정 길이 프레임"     Click="OnStreamFixed"    Style="{StaticResource OrangeBtn}"/>
                    <Button Content="▶ 가변 길이 프레임 (Length 필드)"  Click="OnStreamVariable" Style="{StaticResource RedBtn}"/>
                    <Button Content="▶ 다중 STX 패턴"                   Click="OnStreamMultiStx" Style="{StaticResource PurpleBtn}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 오른쪽 결과 -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="실행 결과" Style="{StaticResource SectionLabel}"
                               DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="지우기" Click="OnClear"
                            Padding="10,3" FontSize="11" Background="#ECEFF1"
                            Foreground="#546E7A" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Right" Margin="0"/>
                </DockPanel>
                <TextBox Grid.Row="1" x:Name="Out" Style="{StaticResource ResultBox}" MinHeight="520"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
