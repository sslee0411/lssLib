<UserControl x:Class="lssLib.Serialization.WpfDemo.Views.HookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:lssLib.Serialization.WpfDemo.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="HEX 버퍼 입력" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="HexIn" Style="{StaticResource InputBox}" Height="38" Margin="0,0,0,10"
                             Text="AA 03 00 0C 00 00 03 E9 41 20 00 00"/>
                    <TextBlock Text="XOR 복호화 키 (hex, 예: AA)" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="XorKey" Style="{StaticResource InputBox}" Height="30" Margin="0,0,0,10" Text="AA"/>
                    <Button Content="▶ WithLog — 읽기 로그"        Click="OnWithLog"    Style="{StaticResource Btn}"/>
                    <Button Content="▶ WithXorDecrypt — XOR 복호화" Click="OnXorDecrypt"  Style="{StaticResource GreenBtn}"/>
                    <Button Content="▶ WithStats — 통계 수집"        Click="OnWithStats"  Style="{StaticResource PurpleBtn}"/>
                    <Button Content="▶ OnParseDone — 완료 콜백"      Click="OnParseDone"  Style="{StaticResource OrangeBtn}"/>
                    <Button Content="▶ WithOffset — 슬라이딩 윈도우" Click="OnWithOffset" Style="{StaticResource TealBtn}"/>
                    <Button Content="▶ WithPreprocess — 커스텀 변환" Click="OnPreprocess" Style="{StaticResource RedBtn}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="훅 체이닝 결과" Style="{StaticResource SectionLabel}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="지우기" Click="OnClear" Padding="10,3" FontSize="11" Background="#ECEFF1" Foreground="#546E7A" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Margin="0"/>
                </DockPanel>
                <TextBox Grid.Row="1" x:Name="Out" Style="{StaticResource ResultBox}" MinHeight="500"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

