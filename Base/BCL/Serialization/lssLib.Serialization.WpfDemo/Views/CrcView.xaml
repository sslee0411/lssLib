<UserControl x:Class="lssLib.Serialization.WpfDemo.Views.CrcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:lssLib.Serialization.WpfDemo.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="HEX 입력" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="DataIn" Style="{StaticResource InputBox}" Height="38" Margin="0,0,0,10"
                             Text="AA 01 00 0C 00 00 03 E9"/>
                    <Button Content="▶ 전체 알고리즘 비교"             Click="OnAll"      Style="{StaticResource Btn}"/>
                    <Button Content="▶ AppendCrc32 / VerifyCrc32"     Click="OnAppend"   Style="{StaticResource GreenBtn}"/>
                    <Button Content="▶ Crc8Sht — SHT3x 전용"          Click="OnCrc8Sht"  Style="{StaticResource PurpleBtn}"/>
                    <Button Content="▶ Crc8Custom — 커스텀 다항식"     Click="OnCustom"   Style="{StaticResource OrangeBtn}"/>
                    <Button Content="▶ Crc16Modbus — Modbus RTU"      Click="OnModbus"   Style="{StaticResource TealBtn}"/>
                    <Button Content="▶ offset / length 지정"           Click="OnOffset"   Style="{StaticResource RedBtn}"/>
                    <Button Content="▶ XOR — NMEA GPS 체크섬"          Click="OnXorNmea"  Style="{StaticResource Btn}"/>
                    <Button Content="▶ Sum8 / Sum8Twos — 프레임 검증"  Click="OnSum8"     Style="{StaticResource GreenBtn}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="CRC 결과" Style="{StaticResource SectionLabel}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="지우기" Click="OnClear" Padding="10,3" FontSize="11" Background="#ECEFF1" Foreground="#546E7A" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Margin="0"/>
                </DockPanel>
                <TextBox Grid.Row="1" x:Name="Out" Style="{StaticResource ResultBox}" MinHeight="500"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
