<Window x:Class="lssLib.Serialization.WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:lssLib.Serialization.WpfDemo.Views"
        Title="lssLib.Serialization v4 — Binary + Extensions Demo"
        Height="860" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="NavTab" TargetType="TabItem">
            <Setter Property="Padding"    Value="18,10"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <TextBlock Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#1E88E5"/>
                                <Setter Property="Foreground"  Value="#1E88E5"/>
                                <Setter Property="FontWeight"  Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F0F4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 헤더 -->
        <Border DockPanel.Dock="Top" Background="#1E88E5" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="lssLib" FontSize="20" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=".Serialization" FontSize="16"
                               Foreground="#BBDEFB" VerticalAlignment="Center"/>
                    <Border Background="#1565C0" CornerRadius="12" Padding="8,2" Margin="10,0,0,0">
                        <TextBlock Text="v4.0  ·  Binary + Extensions" FontSize="10"
                                   Foreground="#E3F2FD"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="lssLib.Binary" FontSize="10" Foreground="#90CAF9" Margin="0,0,12,0"/>
                    <TextBlock Text="lssLib.Extensions" FontSize="10" Foreground="#90CAF9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 탭 -->
        <TabControl Background="White" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BorderBrush}">

            <!-- 1. BufferParser 기본 -->
            <TabItem Header="🔍  BufferParser" Style="{StaticResource NavTab}">
                <v:BufferView/>
            </TabItem>

            <!-- 2. 확장 메서드 훅 -->
            <TabItem Header="🔗  훅 체이닝" Style="{StaticResource NavTab}">
                <v:HookView/>
            </TabItem>

            <!-- 3. decimal 전용 -->
            <TabItem Header="💰  Decimal" Style="{StaticResource NavTab}">
                <v:DecimalView/>
            </TabItem>

            <!-- 4. TypeParser + 직렬화 -->
            <TabItem Header="🔤  Text" Style="{StaticResource NavTab}">
                <v:TypeView/>
            </TabItem>

            <!-- 5. Scale 수치 변환 -->
            <TabItem Header="📐  Scale" Style="{StaticResource NavTab}">
                <v:ScaleView/>
            </TabItem>

            <!-- 6. CRC / Checksum -->
            <TabItem Header="🔒  CRC" Style="{StaticResource NavTab}">
                <v:CrcView/>
            </TabItem>

            <!-- 7. 종합 예제 -->
            <TabItem Header="⚡  종합 예제" Style="{StaticResource NavTab}">
                <v:CompositeView/>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
