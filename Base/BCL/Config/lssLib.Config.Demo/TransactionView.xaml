<!-- ══════════════════════════════════════════════════════════════════════
     TransactionView.xaml  —  탭⑥: Commit / Rollback / Undo / Redo 데모
     ══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="lssLib.Config.Demo.Views.TransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 왼쪽: 제어 ──────────────────────────────── -->
        <StackPanel Grid.Column="0">

            <!-- 트랜잭션 변경 입력 -->
            <GroupBox Header="① 트랜잭션 변경 입력">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="섹션" Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbTxSection" Style="{StaticResource TbBase}" Height="30" Text="Network"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="키"   Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TbTxKey"     Style="{StaticResource TbBase}" Height="30" Text="Host"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="값"   Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TbTxValue"   Style="{StaticResource TbBase}" Height="30" Text="10.0.0.1"/>
                </Grid>
            </GroupBox>

            <!-- 트랜잭션 제어 -->
            <GroupBox Header="② 트랜잭션 제어">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="⬤  트랜잭션 시작"  Style="{StaticResource BtnPrimary}"
                                Margin="0,0,6,0" Click="BtnBegin_Click"/>
                        <Button Content="➕  Set 추가"      Style="{StaticResource BtnSecondary}"
                                Margin="0,0,6,0" Click="BtnTxSet_Click"/>
                        <Button Content="🗑  Remove 추가"  Style="{StaticResource BtnSecondary}"
                                Click="BtnTxRemove_Click"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="✅  Commit"    Style="{StaticResource BtnSuccess}"
                                Margin="0,0,6,0" Click="BtnCommit_Click"/>
                        <Button Content="↩  Rollback"  Style="{StaticResource BtnDanger}"
                                Margin="0,0,6,0" Click="BtnRollback_Click"/>
                        <Button Content="💾  저장"      Style="{StaticResource BtnSecondary}"
                                Click="BtnTxSave_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- Undo / Redo -->
            <GroupBox Header="③ Undo / Redo (커밋 이력)">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Undo 스택 깊이" Style="{StaticResource LblField}"/>
                            <TextBlock x:Name="TbUndoDepth" Text="0"
                                       FontSize="28" FontWeight="Bold" Foreground="#2563EB"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Redo 스택 깊이" Style="{StaticResource LblField}"/>
                            <TextBlock x:Name="TbRedoDepth" Text="0"
                                       FontSize="28" FontWeight="Bold" Foreground="#64748B"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel>
                        <Button x:Name="BtnUndo" Content="↩  Undo"
                                Style="{StaticResource BtnSecondary}"
                                Margin="0,0,8,0" IsEnabled="False"
                                Click="BtnUndo_Click"/>
                        <Button x:Name="BtnRedo" Content="↪  Redo"
                                Style="{StaticResource BtnSecondary}"
                                IsEnabled="False"
                                Click="BtnRedo_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- 샘플 시나리오 -->
            <GroupBox Header="④ 샘플 시나리오">
                <StackPanel>
                    <Button Content="🔧  시나리오: 네트워크 설정 변경 + Commit"
                            Style="{StaticResource BtnPrimary}"
                            Margin="0,0,0,6" Click="BtnScenario1_Click"/>
                    <Button Content="💥  시나리오: 변경 후 Rollback"
                            Style="{StaticResource BtnDanger}"
                            Margin="0,0,0,6" Click="BtnScenario2_Click"/>
                    <Button Content="🔁  시나리오: Commit × 3 → Undo × 2 → Redo"
                            Style="{StaticResource BtnSecondary}"
                            Click="BtnScenario3_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- 트랜잭션 상태 -->
            <Border Background="#1E293B" CornerRadius="6" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="트랜잭션 상태" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TbTxStatus"
                               Text="비활성"
                               FontSize="14" FontWeight="Bold"
                               Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ── 오른쪽: 설정 현황 + 로그 ──────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <!-- 현재 저장소 상태 -->
            <GroupBox Grid.Row="0" Header="📋 현재 설정 저장소 상태 (Commit 후 반영)">
                <TextBox x:Name="TbStoreState"
                         Style="{StaticResource TbOutput}"
                         VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

            <!-- 로그 -->
            <GroupBox Grid.Row="2" Header="🖥 트랜잭션 이벤트 로그">
                <Grid>
                    <TextBox x:Name="TbLog" Style="{StaticResource TbOutput}"
                             Height="140" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="지우기" Style="{StaticResource BtnDanger}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="8,3" Margin="0,2,2,0" FontSize="11"
                            Click="BtnClearLog_Click"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
