<!-- ══════════════════════════════════════════════════════════════════════
     TreeView.xaml  —  탭④: 장비 트리 (JSON/XML 파일 → 트리 뷰어 포함)
     레이아웃: [파일 로더 + 트리] | [노드 편집] | [JSON 미리보기 + 노드 상세]
     ══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="lssLib.Config.Demo.Views.TreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <Grid Margin="14,12,14,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════
             왼쪽 열: ① 파일 로더  ②  WPF 트리 뷰
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ① 파일 로더 ──────────────────────────────── -->
            <GroupBox Grid.Row="0" Header="📂 JSON / XML 파일 로드">
                <StackPanel>

                    <!-- 경로 입력 + 찾아보기 -->
                    <TextBlock Text="파일 경로" Style="{StaticResource LblField}"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TbFilePath"
                                 Grid.Column="0"
                                 Style="{StaticResource TbBase}"
                                 Height="30"
                                 FontSize="11"
                                 Text=""
                                 ToolTip="JSON 또는 XML 파일 경로"/>
                        <Button  Grid.Column="2"
                                 Content="…"
                                 Style="{StaticResource BtnSecondary}"
                                 Height="30"
                                 FontSize="13"
                                 Click="BtnBrowse_Click"
                                 ToolTip="파일 선택 대화상자 열기"/>
                    </Grid>

                    <!-- 로드 버튼 -->
                    <WrapPanel Margin="0,0,0,4">
                        <Button Content="📂  파일 로드"
                                Style="{StaticResource BtnPrimary}"
                                Margin="0,0,6,0"
                                Click="BtnLoadFile_Click"/>
                        <Button Content="🔄  새로고침"
                                Style="{StaticResource BtnSecondary}"
                                Margin="0,0,6,0"
                                Click="BtnReloadFile_Click"
                                ToolTip="마지막으로 로드한 파일을 다시 읽기"/>
                        <Button Content="💾  JSON 저장"
                                Style="{StaticResource BtnSuccess}"
                                Click="BtnSaveJson_Click"/>
                    </WrapPanel>

                    <!-- 최근 파일 목록 -->
                    <TextBlock Text="최근 파일" Style="{StaticResource LblField}" Margin="0,6,0,2"/>
                    <ListBox x:Name="LbRecent"
                             Height="72"
                             Background="#0F172A"
                             Foreground="#94D668"
                             FontFamily="Consolas"
                             FontSize="11"
                             BorderThickness="1"
                             BorderBrush="#334155"
                             SelectionChanged="LbRecent_SelectionChanged"/>

                </StackPanel>
            </GroupBox>

            <!-- ② WPF 트리 뷰 ─────────────────────────────── -->
            <GroupBox Grid.Row="2" Header="🌳 장비 트리">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TreeView x:Name="TvDevices"
                              Grid.Row="0"
                              Background="#0F172A"
                              Foreground="#94D668"
                              FontFamily="Consolas"
                              FontSize="12"
                              BorderThickness="0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectedItemChanged="TvDevices_SelectedItemChanged"/>

                    <!-- 통계 바 -->
                    <Border Grid.Row="1"
                            Background="#1E293B"
                            Padding="8,4"
                            Margin="0,4,0,0"
                            CornerRadius="4">
                        <TextBlock x:Name="TbTreeStats"
                                   Text="총 0 노드"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                    </Border>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             중앙 열: 노드 편집 + 저장·로드 액션
             ══════════════════════════════════════════════════ -->
        <StackPanel Grid.Column="2">

            <!-- 노드 추가 -->
            <GroupBox Header="① 노드 추가">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="유형"
                               Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1"
                               x:Name="CbNodeType" SelectedIndex="0"
                               SelectionChanged="CbNodeType_Changed">
                        <ComboBoxItem Content="🏭  Group  (그룹/라인/공장)"/>
                        <ComboBoxItem Content="🖥  Device (PLC/서버/컨트롤러)"/>
                        <ComboBoxItem Content="📡  Sensor (온도/압력/유량)"/>
                        <ComboBoxItem Content="🏷  Tag    (PLC 메모리 주소)"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="이름"
                               Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1"
                               x:Name="TbNodeName" Style="{StaticResource TbBase}" Height="30"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="설명"
                               Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="4" Grid.Column="1"
                               x:Name="TbNodeDesc" Style="{StaticResource TbBase}" Height="30"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="속성"
                               Style="{StaticResource LblField}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" x:Name="PnlProps"/>

                    <WrapPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2">
                        <Button Content="➕  추가" Style="{StaticResource BtnPrimary}"
                                Margin="0,0,8,0" Click="BtnAddNode_Click"/>
                        <Button Content="샘플 트리" Style="{StaticResource BtnSecondary}"
                                Click="BtnBuildSample_Click"/>
                    </WrapPanel>
                </Grid>
            </GroupBox>

            <!-- 선택 노드 편집 -->
            <GroupBox Header="② 선택 노드 편집">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="키"
                                   Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="0" Grid.Column="1"
                                   x:Name="TbPropKey" Style="{StaticResource TbBase}" Height="30" Text="ip"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="값"
                                   Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="2" Grid.Column="1"
                                   x:Name="TbPropValue" Style="{StaticResource TbBase}" Height="30" Text="192.168.1.1"/>
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="프로퍼티 추가" Style="{StaticResource BtnSecondary}"
                                Margin="0,0,6,0" Click="BtnSetProp_Click"/>
                        <Button Content="🔼  위로"      Style="{StaticResource BtnSecondary}"
                                Margin="0,0,6,0" Click="BtnMoveUp_Click"/>
                        <Button Content="🗑  제거"       Style="{StaticResource BtnDanger}"
                                Click="BtnRemoveNode_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- 저장·로드 -->
            <GroupBox Header="③ 저장 / 로드">
                <WrapPanel>
                    <Button Content="💾 XML 저장"  Style="{StaticResource BtnSuccess}"
                            Margin="0,0,6,4" Click="BtnSaveXml_Click"/>
                    <Button Content="📂 XML 로드"  Style="{StaticResource BtnSecondary}"
                            Margin="0,0,6,4" Click="BtnLoadXml_Click"/>
                    <Button Content="🧹 초기화"    Style="{StaticResource BtnDanger}"
                            Margin="0,0,6,4" Click="BtnClearTree_Click"/>
                </WrapPanel>
            </GroupBox>

        </StackPanel>

        <!-- ══════════════════════════════════════════════════
             오른쪽 열: JSON 원본 미리보기 + 선택 노드 상세 + 로그
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <!-- JSON 미리보기 -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <!-- 선택 노드 상세 -->
                <RowDefinition Height="210"/>
                <RowDefinition Height="8"/>
                <!-- 로그 -->
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>

            <!-- JSON 원본 미리보기 ──────────────────────── -->
            <GroupBox Grid.Row="0" Header="📄 파일 원본 (JSON / XML) 미리보기">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 파일 정보 바 -->
                    <Border Grid.Row="0"
                            Background="#1E3A5F"
                            CornerRadius="4,4,0,0"
                            Padding="8,4"
                            Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TbFileInfo"
                                       Grid.Column="0"
                                       Text="파일 미로드"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="#93C5FD"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="복사"
                                        Style="{StaticResource BtnSecondary}"
                                        Padding="8,2" FontSize="11"
                                        Margin="0,0,4,0"
                                        Click="BtnCopyJson_Click"/>
                                <Button Content="정렬"
                                        Style="{StaticResource BtnSecondary}"
                                        Padding="8,2" FontSize="11"
                                        Click="BtnFormatJson_Click"
                                        ToolTip="JSON 들여쓰기 정렬"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 파일 내용 -->
                    <TextBox Grid.Row="1"
                             x:Name="TbJsonPreview"
                             Style="{StaticResource TbOutput}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontSize="11"
                             IsReadOnly="True"/>
                </Grid>
            </GroupBox>

            <!-- 선택 노드 상세 ──────────────────────────── -->
            <GroupBox Grid.Row="2" Header="🔍 선택 노드 상세">
                <TextBox x:Name="TbNodeDetail"
                         Style="{StaticResource TbOutput}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         FontSize="11"
                         IsReadOnly="True"/>
            </GroupBox>

            <!-- 출력 로그 ────────────────────────────────── -->
            <GroupBox Grid.Row="4" Header="🖥 출력 로그">
                <Grid>
                    <TextBox x:Name="TbLog"
                             Style="{StaticResource TbOutput}"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="11"/>
                    <Button Content="지우기"
                            Style="{StaticResource BtnDanger}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="8,3" Margin="0,2,2,0" FontSize="11"
                            Click="BtnClearLog_Click"/>
                </Grid>
            </GroupBox>

        </Grid>
    </Grid>
</UserControl>
