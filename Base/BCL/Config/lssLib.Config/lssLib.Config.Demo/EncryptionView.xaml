<!-- ══════════════════════════════════════════════════════════════════════
     EncryptionView.xaml  —  탭②: AES-256-GCM 암호화 설정값 데모
     ══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="lssLib.Config.Demo.Views.EncryptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 왼쪽: 입력 ─────────────────────────────────── -->
        <StackPanel Grid.Column="0">

            <!-- 암호화 키 설정 -->
            <GroupBox Header="① 암호화 패스워드 설정 (PBKDF2-SHA256)">
                <StackPanel>
                    <TextBlock Style="{StaticResource LblField}" Text="패스워드"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PbPassword" Grid.Column="0"
                                     Height="30" Padding="8,5"
                                     FontSize="13"
                                     BorderBrush="#CBD5E1" BorderThickness="1"/>
                        <Button Grid.Column="2" Content="키 설정"
                                Style="{StaticResource BtnPrimary}"
                                Click="BtnSetPassword_Click"/>
                    </Grid>
                    <TextBlock x:Name="TbKeyStatus"
                               Text="⚠ 키 미설정" FontSize="12"
                               Foreground="#DC2626" Margin="0,6,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 암호화 항목 입력 -->
            <GroupBox Header="② 암호화 설정값 추가">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="섹션"  Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbEncSection" Style="{StaticResource TbBase}" Height="30" Text="Credentials"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="키"    Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TbEncKey" Style="{StaticResource TbBase}" Height="30" Text="DbPassword"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="평문값" Style="{StaticResource LblField}" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TbEncPlain" Style="{StaticResource TbBase}" Height="30" Text="P@ssw0rd!"/>

                    <CheckBox  Grid.Row="6" Grid.Column="1"
                               x:Name="ChkEncrypt"
                               Content="파일 저장 시 암호화 적용 (IsEncrypted = true)"
                               IsChecked="True"/>
                </Grid>
            </GroupBox>

            <!-- 샘플 암호화 항목 -->
            <GroupBox Header="③ 샘플 암호화 항목 추가">
                <WrapPanel>
                    <Button Content="DB 패스워드"    Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="BtnSampleDbPass_Click"/>
                    <Button Content="API 토큰"        Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="BtnSampleApiToken_Click"/>
                    <Button Content="암호화 키"       Style="{StaticResource BtnSecondary}" Click="BtnSampleSecret_Click"/>
                </WrapPanel>
            </GroupBox>

            <!-- 액션 -->
            <GroupBox Header="④ 액션">
                <WrapPanel>
                    <Button Content="🔐  항목 추가 (암호화)"  Style="{StaticResource BtnPrimary}"
                            Margin="0,0,8,4" Click="BtnAddEncrypted_Click"/>
                    <Button Content="💾  JSON 저장"          Style="{StaticResource BtnSuccess}"
                            Margin="0,0,8,4" Click="BtnSaveEncrypted_Click"/>
                    <Button Content="📂  JSON 로드·복호화"   Style="{StaticResource BtnSecondary}"
                            Margin="0,0,8,4" Click="BtnLoadDecrypt_Click"/>
                    <Button Content="🔓  직접 복호화 테스트" Style="{StaticResource BtnSecondary}"
                            Margin="0,0,8,4" Click="BtnDecryptTest_Click"/>
                    <Button Content="🧹  초기화"             Style="{StaticResource BtnDanger}"
                            Click="BtnClearEnc_Click"/>
                </WrapPanel>
            </GroupBox>

            <!-- 현재 저장소 -->
            <GroupBox Header="⑤ 현재 저장소 (평문으로 표시)">
                <TextBox x:Name="TbStoreView"
                         Style="{StaticResource TbOutput}"
                         Height="120"
                         VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

        </StackPanel>

        <!-- ── 오른쪽: 출력 ───────────────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <!-- 파일 내용 (ENC: 접두사 확인) -->
            <GroupBox Grid.Row="0" Header="📄 저장된 파일 내용 (ENC: 확인)">
                <TextBox x:Name="TbFileView"
                         Style="{StaticResource TbOutput}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </GroupBox>

            <!-- 로그 -->
            <GroupBox Grid.Row="2" Header="🖥 출력 로그">
                <Grid>
                    <TextBox x:Name="TbLog"
                             Style="{StaticResource TbOutput}"
                             Height="130"
                             VerticalScrollBarVisibility="Auto"/>
                    <Button Content="지우기" Style="{StaticResource BtnDanger}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="8,3" Margin="0,2,2,0" FontSize="11"
                            Click="BtnClearLog_Click"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
