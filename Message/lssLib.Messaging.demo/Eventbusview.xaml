<UserControl x:Class="lssLib.Messaging.Demo.Views.EventBusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBg}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             왼쪽: 발행 컨트롤
             ══════════════════════════════════════════════ -->
        <StackPanel Grid.Column="0">

            <!-- 설명 -->
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="📡  EventBus — Pub/Sub 패턴"
                               Foreground="{StaticResource BrushAccent2}"
                               FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource BrushTextDim}"
                               LineHeight="18">
                        메시지를 발행(Publish)하면 구독(Subscribe)한 모든 핸들러가 독립적으로 수신합니다.
                        발행자는 구독자를 알 필요가 없습니다.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 구독 제어 -->
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="① 구독 설정" Style="{StaticResource SectionLabel}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnSubSensor"  Grid.Column="0"
                                Content="📊 센서 구독"
                                Style="{StaticResource BtnSuccess}"
                                Click="BtnSubSensor_Click"/>
                        <Button x:Name="BtnUnsubSensor" Grid.Column="2"
                                Content="✖ 구독 해제"
                                Style="{StaticResource BtnGray}"
                                IsEnabled="False"
                                Click="BtnUnsubSensor_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnSubNetwork" Grid.Column="0"
                                Content="🌐 네트워크 구독"
                                Style="{StaticResource BtnSuccess}"
                                Click="BtnSubNetwork_Click"/>
                        <Button x:Name="BtnUnsubNetwork" Grid.Column="2"
                                Content="✖ 구독 해제"
                                Style="{StaticResource BtnGray}"
                                IsEnabled="False"
                                Click="BtnUnsubNetwork_Click"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnSubAlarm" Grid.Column="0"
                                Content="🚨 알람 구독"
                                Style="{StaticResource BtnSuccess}"
                                Click="BtnSubAlarm_Click"/>
                        <Button x:Name="BtnUnsubAlarm" Grid.Column="2"
                                Content="✖ 구독 해제"
                                Style="{StaticResource BtnGray}"
                                IsEnabled="False"
                                Click="BtnUnsubAlarm_Click"/>
                    </Grid>

                    <!-- 구독자 수 -->
                    <Border Background="#111827" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="현재 구독자 수: "
                                       Foreground="{StaticResource BrushTextDim}" FontSize="11"/>
                            <TextBlock x:Name="TxtSubCount"
                                       Text="0"
                                       Foreground="{StaticResource BrushSuccess}"
                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 이벤트 발행 -->
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="② 이벤트 발행 (Publish)" Style="{StaticResource SectionLabel}"/>

                    <!-- 센서 -->
                    <TextBlock Text="센서 데이터" Foreground="{StaticResource BrushTextDim}"
                               FontSize="10" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="📊 1회 발행"
                                Style="{StaticResource BtnBase}"
                                Click="BtnPublishSensor_Click"/>
                        <Button Grid.Column="2" Content="🔄 연속 발행 (5회)"
                                Style="{StaticResource BtnBase}"
                                Click="BtnPublishSensorBurst_Click"/>
                    </Grid>

                    <!-- 네트워크 -->
                    <TextBlock Text="네트워크 상태" Foreground="{StaticResource BrushTextDim}"
                               FontSize="10" Margin="0,4,0,4"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🟢 연결됨"
                                Style="{StaticResource BtnSuccess}"
                                Click="BtnPublishConnected_Click"/>
                        <Button Grid.Column="2" Content="🔴 연결 끊김"
                                Style="{StaticResource BtnDanger}"
                                Click="BtnPublishDisconnected_Click"/>
                    </Grid>

                    <!-- 알람 -->
                    <TextBlock Text="알람" Foreground="{StaticResource BrushTextDim}"
                               FontSize="10" Margin="0,4,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="⚠️ 경고 알람"
                                Style="{StaticResource BtnWarn}"
                                Click="BtnPublishWarn_Click"/>
                        <Button Grid.Column="2" Content="🚨 긴급 알람"
                                Style="{StaticResource BtnDanger}"
                                Click="BtnPublishCritical_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 비동기 발행 -->
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="③ 비동기 발행 (PublishAsync)" Style="{StaticResource SectionLabel}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="10"
                               Foreground="{StaticResource BrushTextDim}" Margin="0,0,0,8">
                        모든 핸들러가 병렬 실행됩니다.
                    </TextBlock>
                    <Button Content="⚡ 비동기 발행 (센서)"
                            Style="{StaticResource BtnBase}"
                            Click="BtnPublishAsync_Click"/>
                    <Button Content="🗑️ 전체 구독 해제"
                            Style="{StaticResource BtnGray}"
                            Margin="0,6,0,0"
                            Click="BtnClearAll_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══════════════════════════════════════════════
             오른쪽: 수신 로그
             ══════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>

            <!-- 수신 로그 헤더 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="수신 로그"
                           Foreground="{StaticResource BrushText}"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="총 수신: "
                               Foreground="{StaticResource BrushTextDim}" FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalReceived"
                               Text="0"
                               Foreground="{StaticResource BrushAccent2}"
                               FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="지우기" Style="{StaticResource BtnGray}"
                            Padding="8,4" FontSize="10"
                            Click="BtnClearLog_Click"/>
                </StackPanel>
            </Grid>

            <!-- 메인 수신 로그 -->
            <ListBox x:Name="LstEvents" Grid.Row="1"
                     Style="{StaticResource LogListBox}"/>

            <!-- 현재 상태 패널 -->
            <TextBlock Grid.Row="2" Text="현재 상태"
                       Foreground="{StaticResource BrushText}"
                       FontSize="12" FontWeight="SemiBold"
                       Margin="0,12,0,8"/>

            <!-- 상태 카드 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 센서 상태 카드 -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="📊 마지막 센서"
                                   Foreground="{StaticResource BrushAccent2}"
                                   FontSize="11" Margin="0,0,0,10"/>
                        <TextBlock Text="온도"
                                   Foreground="{StaticResource BrushTextDim}" FontSize="10"/>
                        <TextBlock x:Name="TxtLastTemp"
                                   Text="—"
                                   Foreground="{StaticResource BrushWarn}"
                                   FontFamily="Consolas" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="습도"
                                   Foreground="{StaticResource BrushTextDim}" FontSize="10"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="TxtLastHum"
                                   Text="—"
                                   Foreground="{StaticResource BrushAccent2}"
                                   FontFamily="Consolas" FontSize="16"/>
                        <TextBlock Text="배터리"
                                   Foreground="{StaticResource BrushTextDim}" FontSize="10"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="TxtLastBattery"
                                   Text="—"
                                   Foreground="{StaticResource BrushSuccess}"
                                   FontFamily="Consolas" FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- 네트워크 상태 카드 -->
                <Border Grid.Column="2"
                        Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="🌐 네트워크"
                                   Foreground="{StaticResource BrushAccent2}"
                                   FontSize="11" Margin="0,0,0,10"/>
                        <TextBlock Text="상태"
                                   Foreground="{StaticResource BrushTextDim}" FontSize="10"/>
                        <TextBlock x:Name="TxtNetStatus"
                                   Text="—"
                                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextDim}"/>
                        <TextBlock Text="호스트"
                                   Foreground="{StaticResource BrushTextDim}" FontSize="10"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="TxtNetHost"
                                   Text="—"
                                   Foreground="{StaticResource BrushText}"
                                   FontFamily="Consolas" FontSize="13"/>
                        <TextBlock Text="지연"
                                   Foreground="{StaticResource BrushTextDim}" FontSize="10"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="TxtNetLatency"
                                   Text="—"
                                   Foreground="{StaticResource BrushAccent2}"
                                   FontFamily="Consolas" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- 알람 카드 -->
                <Border Grid.Column="4"
                        Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="🚨 마지막 알람"
                                   Foreground="{StaticResource BrushAccent2}"
                                   FontSize="11" Margin="0,0,0,10"/>
                        <TextBlock Text="심각도"
                                   Foreground="{StaticResource BrushTextDim}" FontSize="10"/>
                        <TextBlock x:Name="TxtAlarmSeverity"
                                   Text="—"
                                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextDim}"/>
                        <TextBlock Text="출처"
                                   Foreground="{StaticResource BrushTextDim}" FontSize="10"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="TxtAlarmSource"
                                   Text="—"
                                   Foreground="{StaticResource BrushText}"
                                   FontFamily="Consolas" FontSize="13"/>
                        <TextBlock Text="메시지"
                                   Foreground="{StaticResource BrushTextDim}" FontSize="10"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="TxtAlarmMsg"
                                   Text="—"
                                   Foreground="{StaticResource BrushText}"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
