<UserControl x:Class="lssLib.Messaging.Demo.Views.CommandQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBg}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             왼쪽: 커맨드 등록 컨트롤
             ══════════════════════════════════════════════ -->
        <StackPanel Grid.Column="0">

            <!-- 설명 -->
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="📋  CommandQueue — 우선순위 큐"
                               Foreground="{StaticResource BrushAccent2}"
                               FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource BrushTextDim}"
                               LineHeight="18">
                        커맨드를 큐에 등록하면 우선순위(Critical→High→Normal→Low) 순으로 처리됩니다.
                        실행 순서와 동시성이 보장됩니다.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 우선순위별 등록 -->
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="① 우선순위별 커맨드 등록" Style="{StaticResource SectionLabel}"/>

                    <!-- Critical -->
                    <Border Background="#2D1B1B" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="🔴  Critical — 비상 정지"
                                           Foreground="#FF6B6B" FontSize="11" FontWeight="Bold"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="다른 모든 커맨드보다 먼저 처리됩니다."
                                           Foreground="{StaticResource BrushTextDim}" FontSize="10"/>
                            </StackPanel>
                            <Button Content="등록" HorizontalAlignment="Right"
                                    Style="{StaticResource BtnDanger}"
                                    Padding="10,5" FontSize="11"
                                    Click="BtnEnqueueCritical_Click"/>
                        </Grid>
                    </Border>

                    <!-- High -->
                    <Border Background="#1E2820" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="🟠  High — 알림 전송"
                                           Foreground="#FBBF24" FontSize="11" FontWeight="Bold"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="사용자 응답이 필요한 작업에 사용합니다."
                                           Foreground="{StaticResource BrushTextDim}" FontSize="10"/>
                            </StackPanel>
                            <Button Content="등록" HorizontalAlignment="Right"
                                    Style="{StaticResource BtnWarn}"
                                    Padding="10,5" FontSize="11"
                                    Click="BtnEnqueueHigh_Click"/>
                        </Grid>
                    </Border>

                    <!-- Normal -->
                    <Border Background="#1A1E2D" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="🔵  Normal — 데이터 처리"
                                           Foreground="#7C6AF7" FontSize="11" FontWeight="Bold"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="일반 업무 처리 기본값입니다."
                                           Foreground="{StaticResource BrushTextDim}" FontSize="10"/>
                            </StackPanel>
                            <Button Content="등록" HorizontalAlignment="Right"
                                    Style="{StaticResource BtnBase}"
                                    Padding="10,5" FontSize="11"
                                    Click="BtnEnqueueNormal_Click"/>
                        </Grid>
                    </Border>

                    <!-- Low -->
                    <Border Background="#1A1A22" CornerRadius="4" Padding="8,6">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="⚪  Low — 파일 저장"
                                           Foreground="#94A3B8" FontSize="11" FontWeight="Bold"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="지연 허용 백그라운드 작업입니다."
                                           Foreground="{StaticResource BrushTextDim}" FontSize="10"/>
                            </StackPanel>
                            <Button Content="등록" HorizontalAlignment="Right"
                                    Style="{StaticResource BtnGray}"
                                    Padding="10,5" FontSize="11"
                                    Click="BtnEnqueueLow_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 일괄 등록 -->
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="② 일괄 등록 (우선순위 역순으로 넣기)"
                               Style="{StaticResource SectionLabel}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="10"
                               Foreground="{StaticResource BrushTextDim}" Margin="0,0,0,8">
                        Low → Normal → High → Critical 순으로 등록해도 처리 순서는 반대입니다.
                    </TextBlock>
                    <Button Content="⚡ 4종 동시 등록"
                            Style="{StaticResource BtnBase}"
                            Click="BtnEnqueueAll_Click"/>
                    <Button Content="📦 람다 커맨드 등록"
                            Style="{StaticResource BtnGray}"
                            Margin="0,6,0,0"
                            Click="BtnEnqueueLambda_Click"/>
                </StackPanel>
            </Border>

            <!-- 큐 제어 -->
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="③ 큐 제어" Style="{StaticResource SectionLabel}"/>
                    <Button Content="🗑️ 대기 커맨드 전체 삭제"
                            Style="{StaticResource BtnDanger}"
                            Click="BtnClearQueue_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══════════════════════════════════════════════
             오른쪽: 실행 결과
             ══════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
            </Grid.RowDefinitions>

            <!-- 통계 헤더 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="실행 로그"
                               Foreground="{StaticResource BrushText}"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="지우기" Style="{StaticResource BtnGray}"
                        Padding="8,4" FontSize="10"
                        HorizontalAlignment="Right"
                        Click="BtnClearLog_Click"/>
            </Grid>

            <!-- 실행 로그 -->
            <ListBox x:Name="LstResults" Grid.Row="1"
                     Style="{StaticResource LogListBox}"/>

            <!-- 통계 라벨 -->
            <TextBlock Grid.Row="2" Text="누적 통계"
                       Foreground="{StaticResource BrushText}"
                       FontSize="12" FontWeight="SemiBold"
                       Margin="0,12,0,8"/>

            <!-- 통계 카드 4개 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 대기 -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="대기 중"
                                   Foreground="{StaticResource BrushTextDim}"
                                   FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtPending"
                                   Text="0"
                                   Foreground="{StaticResource BrushWarn}"
                                   FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="커맨드"
                                   Foreground="{StaticResource BrushTextDim}"
                                   FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 처리 완료 -->
                <Border Grid.Column="2"
                        Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="처리 완료"
                                   Foreground="{StaticResource BrushTextDim}"
                                   FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtProcessed"
                                   Text="0"
                                   Foreground="{StaticResource BrushSuccess}"
                                   FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="커맨드"
                                   Foreground="{StaticResource BrushTextDim}"
                                   FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 실패 -->
                <Border Grid.Column="4"
                        Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="실패"
                                   Foreground="{StaticResource BrushTextDim}"
                                   FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtFailed"
                                   Text="0"
                                   Foreground="{StaticResource BrushError}"
                                   FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="커맨드"
                                   Foreground="{StaticResource BrushTextDim}"
                                   FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 마지막 실행 시간 -->
                <Border Grid.Column="6"
                        Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="마지막 소요"
                                   Foreground="{StaticResource BrushTextDim}"
                                   FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLastElapsed"
                                   Text="—"
                                   Foreground="{StaticResource BrushAccent2}"
                                   FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="ms"
                                   Foreground="{StaticResource BrushTextDim}"
                                   FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
